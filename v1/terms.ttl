<https://ptpge.org/v1/printing/configurations/orientation/landscape> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:altLabel "Horisontal"@da,
        "Tværformat"@da,
        "Horizontal"@en,
        "Landscape orientation"@en,
        "Wide"@en,
        "क्षैतिज"@hi,
        "चौड़ा"@hi,
        "लेटा हुआ"@hi,
        "लैंडस्केप दिशा"@hi,
        "Horisontal"@nb,
        "Liggende"@nb,
        "Horizontaal"@nl,
        "landscape"@pl,
        "orientacja pozioma"@pl,
        "poziomo"@pl,
        "deitado"@pt,
        "horizontal"@pt,
        "largo"@pt,
        "orientação paisagem"@pt,
        "Horisontell"@sv ;
    skos:broader <https://ptpge.org/v1/printing/configurations/orientation> ;
    skos:definition "Rektangulær orientering, hvor det vandrette mål er større end det lodrette — bruges til regneark, præsentationer, certifikater og panoramafotografier."@da,
        "Rechteckige Ausrichtung, bei der die horizontale Abmessung größer ist als die vertikale — eingesetzt für Tabellenkalkulationen, Präsentationen, Urkunden und Panoramafotografien."@de,
        "Rectangular orientation where the horizontal dimension is greater than the vertical — used for spreadsheets, presentations, certificates, and panoramic photographs."@en,
        "Orientación horizontal donde la anchura es mayor que la altura. Habitual para presentaciones, calendarios y planos."@es,
        "आयताकार अभिविन्यास जिसमें क्षैतिज आयाम ऊर्ध्वाधर से बड़ा है — स्प्रेडशीट, प्रस्तुतियों, प्रमाणपत्रों और पैनोरमिक तस्वीरों में।"@hi,
        "水平方向の寸法が垂直方向より大きい長方形の向き — 表計算、プレゼンテーション、証書、パノラマ写真に使用される。"@ja,
        "Rektangulær orientering der den horisontale dimensjonen er større enn den vertikale — brukt for regneark, presentasjoner, diplomer og panoramabilder."@nb,
        "Rechthoekige oriëntatie waarbij de horizontale maat groter is dan de verticale — gebruikt voor spreadsheets, presentaties, certificaten en panoramafoto's."@nl,
        "Orientacja prostokątna, w której wymiar poziomy jest większy od pionowego — używana do arkuszy kalkulacyjnych, prezentacji, certyfikatów i zdjęć panoramicznych."@pl,
        "Orientação retangular em que a dimensão horizontal é maior que a vertical — usada em planilhas, apresentações, certificados e fotografias panorâmicas."@pt,
        "Rektangulär orientering där det horisontella måttet är större än det vertikala — används för kalkylblad, presentationer, certifikat och panoramafotografier."@sv,
        "宽度大于高度的横向方向。常用于演示文稿、日历和平面图。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§LANDSCAPE" ;
    skos:prefLabel "Liggende"@da,
        "Querformat"@de,
        "Landscape"@en,
        "Horizontal (Apaisado)"@es,
        "लैंडस्केप"@hi,
        "横向き"@ja,
        "Landskap"@nb,
        "Liggend"@nl,
        "Pozioma"@pl,
        "Paisagem"@pt,
        "Liggande"@sv,
        "横向"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78" ;
            ptpge:mappingRow "crosswalk row 21" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/print-standards/crpc1> a skos:Concept ;
    dcterms:created "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "CRPC 1"@en,
        "Characterized Reference Printing Condition 1"@en,
        "CRPC 1"@hi,
        "Characterized Reference Printing Condition 1"@hi,
        "CRPC 1"@pl,
        "Characterized Reference Printing Condition 1"@pl,
        "CRPC 1"@pt,
        "Characterized Reference Printing Condition 1"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/print-standards> ;
    skos:definition "Karakteriseret referencetrykbetingelse 1 i ISO/PAS 15339-2:2015 (CGATS 21-2): typisk coldset-avistryk — det mindste farverum af de syv. Procesuafhængige referencebetingelser der spænder over de trykbare farverum."@da,
        "Charakterisierte Referenzdruckbedingung 1 nach ISO/PAS 15339-2:2015 (CGATS 21-2): typischer Coldset-Zeitungsdruck — der kleinste Farbraum der sieben. Prozessunabhängige Referenzbedingungen über die Spanne der druckbaren Farbräume."@de,
        "Characterized Reference Printing Condition 1 of ISO/PAS 15339-2:2015 (CGATS 21-2): typical coldset newsprint — the smallest gamut of the seven. Process-agnostic reference conditions spanning the range of printable gamuts."@en,
        "Condición de impresión de referencia caracterizada 1 de ISO/PAS 15339-2:2015 (CGATS 21-2): impresión coldset típica en papel prensa — la gama más pequeña de las siete. Condiciones de referencia independientes del proceso que abarcan las gamas imprimibles."@es,
        "ISO/PAS 15339-2:2015 (CGATS 21-2) की Characterized Reference Printing Condition 1: सामान्य कोल्डसेट न्यूज़प्रिंट — सातों में सबसे छोटा गैमट। मुद्रण-योग्य गैमट की सीमा को समेटने वाली प्रक्रिया-निरपेक्ष संदर्भ स्थितियाँ।"@hi,
        "ISO/PAS 15339-2:2015（CGATS 21-2）の特性化参照印刷条件 1：典型的なコールドセット新聞印刷 — 7条件中最小の色域。印刷可能な色域の範囲をカバーする、プロセス非依存の参照条件。"@ja,
        "Karakterisert referanse-trykkbetingelse 1 i ISO/PAS 15339-2:2015 (CGATS 21-2): typisk coldset-avistrykk — det minste fargerommet av de sju. Prosessuavhengige referansebetingelser som spenner over de trykkbare fargerommene."@nb,
        "Gekarakteriseerde referentiedrukconditie 1 van ISO/PAS 15339-2:2015 (CGATS 21-2): typische coldset-krantendruk — het kleinste kleurbereik van de zeven. Procesonafhankelijke referentiecondities die het bereik van drukbare kleurbereiken omspannen."@nl,
        "Characterized Reference Printing Condition 1 wg ISO/PAS 15339-2:2015 (CGATS 21-2): typowy coldsetowy papier gazetowy — najmniejszy gamut z siedmiu. Warunki odniesienia niezależne od procesu, obejmujące zakres drukowalnych gamutów."@pl,
        "Characterized Reference Printing Condition 1 da ISO/PAS 15339-2:2015 (CGATS 21-2): papel-jornal coldset típico — o menor gamut dos sete. Condições de referência independentes de processo que abrangem a gama de gamuts imprimíveis."@pt,
        "Karakteriserat referenstryckvillkor 1 i ISO/PAS 15339-2:2015 (CGATS 21-2): typiskt coldset-tidningstryck — det minsta färgomfånget av de sju. Processoberoende referensvillkor som spänner över de tryckbara färgomfången."@sv,
        "ISO/PAS 15339-2:2015（CGATS 21-2）特性化参考印刷条件 1：典型冷固新闻纸印刷——七个条件中色域最小。与工艺无关、覆盖可印刷色域范围的参考条件。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§CRPC1" ;
    skos:prefLabel "CRPC1"@da,
        "CRPC1"@en,
        "CRPC1"@hi,
        "CRPC1"@nb,
        "CRPC1"@nl,
        "CRPC1"@pl,
        "CRPC1"@pt,
        "CRPC1"@sv ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-03" .

<https://ptpge.org/v1/printing/standards/print-standards/crpc2> a skos:Concept ;
    dcterms:created "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "CRPC 2"@en,
        "Characterized Reference Printing Condition 2"@en,
        "CRPC 2"@hi,
        "Characterized Reference Printing Condition 2"@hi,
        "CRPC 2"@pl,
        "Characterized Reference Printing Condition 2"@pl,
        "CRPC 2"@pt,
        "Characterized Reference Printing Condition 2"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/print-standards> ;
    skos:definition "Karakteriseret referencetrykbetingelse 2 i ISO/PAS 15339-2:2015 (CGATS 21-2): typisk heatset-tryk på forbedret avispapir — moderat farverum. Procesuafhængige referencebetingelser der spænder over de trykbare farverum."@da,
        "Charakterisierte Referenzdruckbedingung 2 nach ISO/PAS 15339-2:2015 (CGATS 21-2): typischer Heatset-Druck auf verbessertem Zeitungspapier — moderater Farbraum. Prozessunabhängige Referenzbedingungen über die Spanne der druckbaren Farbräume."@de,
        "Characterized Reference Printing Condition 2 of ISO/PAS 15339-2:2015 (CGATS 21-2): typical heatset printing on improved newsprint — moderate gamut. Process-agnostic reference conditions spanning the range of printable gamuts."@en,
        "Condición de impresión de referencia caracterizada 2 de ISO/PAS 15339-2:2015 (CGATS 21-2): impresión heatset típica en papel prensa mejorado — gama moderada. Condiciones de referencia independientes del proceso que abarcan las gamas imprimibles."@es,
        "ISO/PAS 15339-2:2015 (CGATS 21-2) की Characterized Reference Printing Condition 2: उन्नत न्यूज़प्रिंट पर सामान्य हीटसेट मुद्रण — मध्यम गैमट। मुद्रण-योग्य गैमट की सीमा को समेटने वाली प्रक्रिया-निरपेक्ष संदर्भ स्थितियाँ।"@hi,
        "ISO/PAS 15339-2:2015（CGATS 21-2）の特性化参照印刷条件 2：改良新聞用紙への典型的なヒートセット印刷 — 中程度の色域。印刷可能な色域の範囲をカバーする、プロセス非依存の参照条件。"@ja,
        "Karakterisert referanse-trykkbetingelse 2 i ISO/PAS 15339-2:2015 (CGATS 21-2): typisk heatset-trykk på forbedret avispapir — moderat fargerom. Prosessuavhengige referansebetingelser som spenner over de trykkbare fargerommene."@nb,
        "Gekarakteriseerde referentiedrukconditie 2 van ISO/PAS 15339-2:2015 (CGATS 21-2): typische heatset-druk op verbeterd krantenpapier — gematigd kleurbereik. Procesonafhankelijke referentiecondities die het bereik van drukbare kleurbereiken omspannen."@nl,
        "Characterized Reference Printing Condition 2 wg ISO/PAS 15339-2:2015 (CGATS 21-2): typowy druk heatsetowy na ulepszonym papierze gazetowym — umiarkowany gamut. Warunki odniesienia niezależne od procesu, obejmujące zakres drukowalnych gamutów."@pl,
        "Characterized Reference Printing Condition 2 da ISO/PAS 15339-2:2015 (CGATS 21-2): impressão heatset típica em papel-jornal melhorado — gamut moderado. Condições de referência independentes de processo que abrangem a gama de gamuts imprimíveis."@pt,
        "Karakteriserat referenstryckvillkor 2 i ISO/PAS 15339-2:2015 (CGATS 21-2): typiskt heatset-tryck på förbättrat tidningspapper — måttligt färgomfång. Processoberoende referensvillkor som spänner över de tryckbara färgomfången."@sv,
        "ISO/PAS 15339-2:2015（CGATS 21-2）特性化参考印刷条件 2：改良新闻纸上的典型热固印刷——中等色域。与工艺无关、覆盖可印刷色域范围的参考条件。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§CRPC2" ;
    skos:prefLabel "CRPC2"@da,
        "CRPC2"@en,
        "CRPC2"@hi,
        "CRPC2"@nb,
        "CRPC2"@nl,
        "CRPC2"@pl,
        "CRPC2"@pt,
        "CRPC2"@sv ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-03" .

<https://ptpge.org/v1/printing/standards/print-standards/crpc3> a skos:Concept ;
    dcterms:created "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "CRPC 3"@en,
        "Characterized Reference Printing Condition 3"@en,
        "CRPC 3"@hi,
        "Characterized Reference Printing Condition 3"@hi,
        "CRPC 3"@pl,
        "Characterized Reference Printing Condition 3"@pl,
        "CRPC 3"@pt,
        "Characterized Reference Printing Condition 3"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/print-standards> ;
    skos:definition "Karakteriseret referencetrykbetingelse 3 i ISO/PAS 15339-2:2015 (CGATS 21-2): enkelt tryk på mat ubestrøget træfrit papir. Procesuafhængige referencebetingelser der spænder over de trykbare farverum."@da,
        "Charakterisierte Referenzdruckbedingung 3 nach ISO/PAS 15339-2:2015 (CGATS 21-2): einfacher Druck auf mattem ungestrichenem holzfreiem Papier. Prozessunabhängige Referenzbedingungen über die Spanne der druckbaren Farbräume."@de,
        "Characterized Reference Printing Condition 3 of ISO/PAS 15339-2:2015 (CGATS 21-2): utility printing on matte uncoated wood-free paper. Process-agnostic reference conditions spanning the range of printable gamuts."@en,
        "Condición de impresión de referencia caracterizada 3 de ISO/PAS 15339-2:2015 (CGATS 21-2): impresión básica en papel no estucado mate libre de madera. Condiciones de referencia independientes del proceso que abarcan las gamas imprimibles."@es,
        "ISO/PAS 15339-2:2015 (CGATS 21-2) की Characterized Reference Printing Condition 3: मैट अनकोटेड वुड-फ़्री काग़ज़ पर उपयोगिता मुद्रण। मुद्रण-योग्य गैमट की सीमा को समेटने वाली प्रक्रिया-निरपेक्ष संदर्भ स्थितियाँ।"@hi,
        "ISO/PAS 15339-2:2015（CGATS 21-2）の特性化参照印刷条件 3：マット非塗工上質紙への汎用印刷。印刷可能な色域の範囲をカバーする、プロセス非依存の参照条件。"@ja,
        "Karakterisert referanse-trykkbetingelse 3 i ISO/PAS 15339-2:2015 (CGATS 21-2): enkelt trykk på matt ubestrøket trefritt papir. Prosessuavhengige referansebetingelser som spenner over de trykkbare fargerommene."@nb,
        "Gekarakteriseerde referentiedrukconditie 3 van ISO/PAS 15339-2:2015 (CGATS 21-2): eenvoudig drukwerk op mat ongestreken houtvrij papier. Procesonafhankelijke referentiecondities die het bereik van drukbare kleurbereiken omspannen."@nl,
        "Characterized Reference Printing Condition 3 wg ISO/PAS 15339-2:2015 (CGATS 21-2): druk użytkowy na matowym niepowlekanym papierze bezdrzewnym. Warunki odniesienia niezależne od procesu, obejmujące zakres drukowalnych gamutów."@pl,
        "Characterized Reference Printing Condition 3 da ISO/PAS 15339-2:2015 (CGATS 21-2): impressão utilitária em papel não revestido fosco sem pasta mecânica. Condições de referência independentes de processo que abrangem a gama de gamuts imprimíveis."@pt,
        "Karakteriserat referenstryckvillkor 3 i ISO/PAS 15339-2:2015 (CGATS 21-2): enkelt tryck på matt obestruket träfritt papper. Processoberoende referensvillkor som spänner över de tryckbara färgomfången."@sv,
        "ISO/PAS 15339-2:2015（CGATS 21-2）特性化参考印刷条件 3：哑光非涂布无木浆纸上的通用印刷。与工艺无关、覆盖可印刷色域范围的参考条件。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§CRPC3" ;
    skos:prefLabel "CRPC3"@da,
        "CRPC3"@en,
        "CRPC3"@hi,
        "CRPC3"@nb,
        "CRPC3"@nl,
        "CRPC3"@pl,
        "CRPC3"@pt,
        "CRPC3"@sv ;
    skos:related <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps5-wood-free-uncoated> ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-03" .

<https://ptpge.org/v1/printing/standards/print-standards/crpc4> a skos:Concept ;
    dcterms:created "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "CRPC 4"@en,
        "Characterized Reference Printing Condition 4"@en,
        "CRPC 4"@hi,
        "Characterized Reference Printing Condition 4"@hi,
        "CRPC 4"@pl,
        "Characterized Reference Printing Condition 4"@pl,
        "CRPC 4"@pt,
        "Characterized Reference Printing Condition 4"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/print-standards> ;
    skos:definition "Karakteriseret referencetrykbetingelse 4 i ISO/PAS 15339-2:2015 (CGATS 21-2): generelt tryk på superkalandreret papir. Procesuafhængige referencebetingelser der spænder over de trykbare farverum."@da,
        "Charakterisierte Referenzdruckbedingung 4 nach ISO/PAS 15339-2:2015 (CGATS 21-2): allgemeiner Druck auf superkalandriertem Papier. Prozessunabhängige Referenzbedingungen über die Spanne der druckbaren Farbräume."@de,
        "Characterized Reference Printing Condition 4 of ISO/PAS 15339-2:2015 (CGATS 21-2): general printing on supercalendered paper. Process-agnostic reference conditions spanning the range of printable gamuts."@en,
        "Condición de impresión de referencia caracterizada 4 de ISO/PAS 15339-2:2015 (CGATS 21-2): impresión general en papel supercalandrado. Condiciones de referencia independientes del proceso que abarcan las gamas imprimibles."@es,
        "ISO/PAS 15339-2:2015 (CGATS 21-2) की Characterized Reference Printing Condition 4: सुपरकैलेंडर्ड काग़ज़ पर सामान्य मुद्रण। मुद्रण-योग्य गैमट की सीमा को समेटने वाली प्रक्रिया-निरपेक्ष संदर्भ स्थितियाँ।"@hi,
        "ISO/PAS 15339-2:2015（CGATS 21-2）の特性化参照印刷条件 4：スーパーカレンダー紙への一般印刷。印刷可能な色域の範囲をカバーする、プロセス非依存の参照条件。"@ja,
        "Karakterisert referanse-trykkbetingelse 4 i ISO/PAS 15339-2:2015 (CGATS 21-2): generelt trykk på superkalandrert papir. Prosessuavhengige referansebetingelser som spenner over de trykkbare fargerommene."@nb,
        "Gekarakteriseerde referentiedrukconditie 4 van ISO/PAS 15339-2:2015 (CGATS 21-2): algemeen drukwerk op supergekalanderd papier. Procesonafhankelijke referentiecondities die het bereik van drukbare kleurbereiken omspannen."@nl,
        "Characterized Reference Printing Condition 4 wg ISO/PAS 15339-2:2015 (CGATS 21-2): druk ogólny na papierze superkalandrowanym. Warunki odniesienia niezależne od procesu, obejmujące zakres drukowalnych gamutów."@pl,
        "Characterized Reference Printing Condition 4 da ISO/PAS 15339-2:2015 (CGATS 21-2): impressão geral em papel supercalandrado. Condições de referência independentes de processo que abrangem a gama de gamuts imprimíveis."@pt,
        "Karakteriserat referenstryckvillkor 4 i ISO/PAS 15339-2:2015 (CGATS 21-2): allmänt tryck på superkalandrerat papper. Processoberoende referensvillkor som spänner över de tryckbara färgomfången."@sv,
        "ISO/PAS 15339-2:2015（CGATS 21-2）特性化参考印刷条件 4：超级压光纸上的一般印刷。与工艺无关、覆盖可印刷色域范围的参考条件。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§CRPC4" ;
    skos:prefLabel "CRPC4"@da,
        "CRPC4"@en,
        "CRPC4"@hi,
        "CRPC4"@nb,
        "CRPC4"@nl,
        "CRPC4"@pl,
        "CRPC4"@pt,
        "CRPC4"@sv ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-03" .

