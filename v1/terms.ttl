    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/technologies/printing-technologies/digital/inkjet/uv-inkjet> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:42:30+00:00"^^xsd:dateTime ;
    skos:altLabel "UV-cured inkjet"@en,
        "UV-क्योर्ड इंकजेट"@hi,
        "UV-blekkskriver"@nb,
        "atramentowy utwardzany UV"@pl,
        "druk UV"@pl,
        "Inkjet UV"@pt,
        "Jato de tinta curado por UV"@pt ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-technologies/digital/inkjet> ;
    skos:definition "Inkjetvariant med UV-hærdende blæk, der forbliver flydende, indtil de udsættes for ultraviolet lys, som øjeblikkeligt polymeriserer dem til en fast film. Dominerende inden for storformat-flatbedtryk, skilteproduktion og på stive ikke-porøse substrater."@da,
        "Inkjet-Variante mit UV-härtenden Tinten, die flüssig bleiben, bis sie ultraviolettem Licht ausgesetzt werden, das sie sofort zu einem festen Film polymerisiert. Dominant im Großformat-Flachbettdruck, Schilderbau und auf festen, nicht porösen Bedruckstoffen."@de,
        "Inkjet variant using UV-curable inks that remain liquid until exposed to ultraviolet light, which polymerizes them instantly into a solid film. Dominant in wide-format flatbed printing, sign-making, and on rigid non-porous substrates."@en,
        "Variante de inyección de tinta con tintas curables por luz ultravioleta — la tinta se solidifica al instante al exponerse a UV. Habitual en gran formato y signage industrial."@es,
        "इंकजेट वेरिएंट जिसमें UV-क्योरेबल स्याही पराबैंगनी प्रकाश के संपर्क तक तरल रहती है, जो उसे तुरंत ठोस परत में पॉलिमराइज़ करता है। वाइड-फॉर्मेट फ़्लैटबेड छपाई, साइन-मेकिंग और कठोर गैर-सरंध्र सब्सट्रेट पर प्रमुख।"@hi,
        "紫外線にさらされるまで液体のままで、紫外線によって瞬時に固体膜に重合するUV硬化インキを使用するインクジェットのバリアント。大判フラットベッド印刷、サイン制作、剛性のある非多孔質基材で主流。"@ja,
        "Inkjet-variant som bruker UV-herdbare blekk som forblir flytende inntil de eksponeres for ultrafiolett lys, som polymeriserer dem umiddelbart til en fast film. Dominerende i storformat flatbed-trykk, skiltproduksjon og på stive ikke-porøse substrater."@nb,
        "Inkjetvariant met uv-hardende inkten die vloeibaar blijven tot blootstelling aan ultraviolet licht, dat ze onmiddellijk polymeriseert tot een vaste film. Dominant in grootformaat-flatbeddruk, signmaking en op stijve niet-poreuze substraten."@nl,
        "Wariant druku atramentowego z atramentami utwardzanymi UV, które pozostają ciekłe do chwili naświetlenia ultrafioletem, natychmiast polimeryzującym je w stałą warstwę. Dominujący w płaskim druku wielkoformatowym, produkcji reklamy i na sztywnych nieporowatych podłożach."@pl,
        "Variante de jato de tinta que usa tintas curáveis por UV, que permanecem líquidas até serem expostas à luz ultravioleta, que as polimeriza instantaneamente num filme sólido. Dominante na impressão flatbed de grande formato, na comunicação visual e em substratos rígidos não porosos."@pt,
        "Inkjetvariant med UV-härdande bläck som förblir flytande tills de exponeras för ultraviolett ljus, vilket polymeriserar dem omedelbart till en fast film. Dominerande inom storformats-flatbäddstryck, skylttillverkning och på styva icke-porösa substrat."@sv,
        "使用紫外线固化油墨的喷墨变体 —— 油墨暴露于UV时立即固化。在大幅面和工业标识中常见。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC§UV-INKJET" ;
    skos:prefLabel "UV-inkjet"@da,
        "UV-Inkjet"@de,
        "UV Inkjet"@en,
        "Inyección UV"@es,
        "UV इंकजेट"@hi,
        "UVインクジェット"@ja,
        "UV-blekkstråle"@nb,
        "UV-inkjet"@nl,
        "Atramentowy UV"@pl,
        "Jato de tinta UV"@pt,
        "UV-inkjet"@sv,
        "UV喷墨"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "technologies" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.12 · p.81",
                "§5.5.2 · p.111",
                "§6.31 · p.196" ;
            ptpge:mappingRow "crosswalk row 17" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "DigitalPrinting",
                "DigitalPrintingParams",
                "ProductionIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/technologies/printing-technologies/digital/nano> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:42:30+00:00"^^xsd:dateTime ;
    skos:altLabel "Nanographic printing"@en,
        "Nanography"@en,
        "नैनोग्राफ़िक प्रिंटिंग"@hi,
        "नैनोग्राफ़ी"@hi,
        "Nanografi"@nb,
        "druk nanograficzny"@pl,
        "nanografia"@pl,
        "Impressão nanográfica"@pt,
        "Nanografia"@pt ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-technologies/digital> ;
    skos:definition "Landa Digital Printings proprietære Nanographic Printing-proces — bruger ultrafine pigmentpartikler i vandbaseret blæk, overført via en opvarmet gummidug. Kombinerer digital variabilitet med offsetlignende billedkvalitet og substratfleksibilitet."@da,
        "Landa Digital Printings firmeneigenes Nanographic-Printing-Verfahren — verwendet ultrafeine Pigmentpartikel in wasserbasierter Tinte, die über ein beheiztes Gummituch übertragen wird. Verbindet digitale Variabilität mit offsetähnlicher Bildqualität und Bedruckstoff-Flexibilität."@de,
        "Landa Digital Printing's proprietary Nanographic Printing process — uses ultra-fine pigment particles in water-based ink, transferred via a heated rubber blanket. Combines digital variability with offset-like image quality and substrate flexibility."@en,
        "Tecnologías basadas en nano-partículas de tinta (notablemente Landa Digital) — las partículas extremadamente pequeñas producen una capa fina y de gran brillo sobre el sustrato."@es,
        "Landa Digital Printing की स्वामित्व वाली Nanographic Printing प्रक्रिया — जल-आधारित स्याही में अति-सूक्ष्म पिगमेंट कण, गर्म रबर ब्लैंकेट से स्थानांतरित। डिजिटल परिवर्तनशीलता को ऑफसेट-जैसी छवि गुणवत्ता और सब्सट्रेट लचीलेपन से जोड़ती है।"@hi,
        "Landa Digital Printingの独自のNanographic Printingプロセス — 水性インキ中の超微細顔料粒子を使用し、加熱されたゴムブランケットを介して転写する。デジタルの可変性とオフセット品質の画質、基材柔軟性を兼ね備える。"@ja,
        "Landa Digital Printings proprietære Nanographic Printing-prosess — bruker ultrafine pigmentpartikler i vannbasert blekk, overført via et oppvarmet gummiteppe. Kombinerer digital variabilitet med offset-lignende bildekvalitet og substrat-fleksibilitet."@nb,
        "Het eigen Nanographic Printing-proces van Landa Digital Printing — gebruikt ultrafijne pigmentdeeltjes in inkt op waterbasis, overgebracht via een verwarmde rubberdoek. Combineert digitale variabiliteit met offsetachtige beeldkwaliteit en substraatflexibiliteit."@nl,
        "Własnościowy proces Nanographic Printing firmy Landa Digital Printing — wykorzystuje ultradrobne cząstki pigmentu w atramencie wodnym, przenoszone przez podgrzewany gumowy obciąg. Łączy cyfrową zmienność z jakością obrazu i elastycznością podłoży zbliżonymi do offsetu."@pl,
        "O processo proprietário Nanographic Printing da Landa Digital Printing — usa partículas de pigmento ultrafinas em tinta à base de água, transferidas por uma blanqueta de borracha aquecida. Combina a variabilidade digital com qualidade de imagem e flexibilidade de substrato semelhantes ao offset."@pt,
        "Landa Digital Printings proprietära Nanographic Printing-process — använder ultrafina pigmentpartiklar i vattenbaserat bläck, överförda via en uppvärmd gummiduk. Kombinerar digital variabilitet med offsetlik bildkvalitet och substratflexibilitet."@sv,
        "基于纳米颗粒油墨的技术（尤其是Landa Digital）—— 极小的颗粒在承印物上产生薄而高光泽的层。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC§NANO" ;
    skos:prefLabel "Nano"@da,
        "Nano"@de,
        "Nano"@en,
        "Impresión Nano"@es,
        "नैनो"@hi,
        "ナノ"@ja,
        "Nano"@nb,
        "Nano"@nl,
        "Nano"@pl,
        "Nano"@pt,
        "Nano"@sv,
        "纳米印刷"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "technologies" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.12 · p.81",
                "§5.5.2 · p.111",
                "§6.31 · p.196" ;
            ptpge:mappingRow "crosswalk row 17" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "DigitalPrinting",
                "DigitalPrintingParams",
                "ProductionIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/technologies/printing-technologies/digital/riso> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:42:30+00:00"^^xsd:dateTime ;
    skos:altLabel "Digital duplicator"@en,
        "Risograph"@en,
        "डिजिटल डुप्लीकेटर"@hi,
        "रिसोग्राफ़"@hi,
        "Risograf"@nb,
        "Risograph"@pl,
        "powielacz cyfrowy"@pl,
        "Duplicador digital"@pt,
        "Risografia"@pt,
        "Risograph"@pt ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-technologies/digital> ;
    skos:definition "Stencilbaseret digital dupliceringsteknik udviklet af RISO Kagaku Corporation — hurtig og økonomisk til tryk i korte og mellemlange serier af mest tekst og enkel grafik. En digital efterkommer af stencilmaskinen."@da,
        "Schablonenbasierte digitale Vervielfältigungstechnologie, entwickelt von der RISO Kagaku Corporation — schnell und wirtschaftlich für kleine bis mittlere Auflagen, hauptsächlich für Text und einfache Grafiken. Ein digitaler Nachfahre des Mimeografen."@de,
        "Stencil-based digital duplication technology developed by RISO Kagaku Corporation — fast and economical for short-to-medium run printing of mostly text and simple graphics. A digital descendant of mimeograph."@en,
        "Duplicador digital Riso — tecnología económica de alta velocidad similar a la serigrafía digital, con tintas a base de soja. Usada para tiradas medias en escuelas, iglesias y producción ligera."@es,
        "RISO Kagaku Corporation द्वारा विकसित स्टेंसिल-आधारित डिजिटल डुप्लीकेशन तकनीक — मुख्यतः पाठ और सरल ग्राफ़िक्स के शॉर्ट से मीडियम रन के लिए तेज़ और किफ़ायती। मिमियोग्राफ़ का डिजिटल वंशज।"@hi,
        "理想科学工業（RISO Kagaku Corporation）が開発したステンシルベースのデジタル謄写技術 — テキストや簡単なグラフィックスが大半を占める短～中量印刷において高速かつ経済的。謄写版のデジタル後継。"@ja,
        "Sjablongbasert digital duplikeringsteknologi utviklet av RISO Kagaku Corporation — rask og økonomisk for kort-til-middel-opplag-trykk av mest tekst og enkel grafikk. En digital etterkommer av mimeograf."@nb,
        "Sjabloongebaseerde digitale dupliceertechnologie, ontwikkeld door RISO Kagaku Corporation — snel en voordelig voor drukwerk in kleine tot middelgrote oplagen van vooral tekst en eenvoudige graphics. Een digitale afstammeling van de stencilmachine."@nl,
        "Cyfrowa technologia powielania oparta na matrycach, opracowana przez RISO Kagaku Corporation — szybka i ekonomiczna dla krótkich i średnich nakładów głównie tekstu i prostej grafiki. Cyfrowy potomek powielacza."@pl,
        "Tecnologia de duplicação digital a estêncil desenvolvida pela RISO Kagaku Corporation — rápida e econômica para impressão de tiragem curta a média, sobretudo de texto e gráficos simples. Descendente digital do mimeógrafo."@pt,
        "Schablonbaserad digital dupliceringsteknik utvecklad av RISO Kagaku Corporation — snabb och ekonomisk för tryck i korta till medellånga serier av mestadels text och enkel grafik. En digital ättling till stencilapparaten."@sv,
        "Riso数码油印机——类似数码丝印的经济高速技术，使用大豆基油墨。用于学校、教堂和轻量生产的中等印次。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC§RISO" ;
    skos:prefLabel "Riso"@da,
        "Riso"@de,
        "Riso"@en,
        "Riso (Duplicador Digital)"@es,
        "रिसो"@hi,
        "Riso"@ja,
        "Riso"@nb,
        "Riso"@nl,
        "Riso"@pl,
        "Riso"@pt,
        "Riso"@sv,
        "Riso（数码油印）"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "technologies" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.12 · p.81",
                "§5.5.2 · p.111",
                "§6.31 · p.196" ;
            ptpge:mappingRow "crosswalk row 17" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "DigitalPrinting",
                "DigitalPrintingParams",
                "ProductionIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/technologies/printing-technologies/hybrid/hybrid-flexo> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:42:30+00:00"^^xsd:dateTime ;
    skos:altLabel "Hybrid printing"@en,
        "हाइब्रिड प्रिंटिंग"@hi,
        "Hybrid flexo"@nb,
        "druk hybrydowy"@pl,
        "fleksografia hybrydowa"@pl,
        "Impressão híbrida"@pt ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-technologies/hybrid> ;
    skos:definition "Flexopresse suppleret med en eller flere digitale trykstationer inline — typisk inkjet til variable data, personalisering eller korte farveskift inden for et langt flexooplag. Almindeligt inden for etiket-, emballage- og bølgepapproduktion."@da,
        "Flexodruckmaschine, ergänzt um eine oder mehrere digitale Inline-Druckstationen — typischerweise Inkjet für variable Daten, Personalisierung oder Kurzfarbwechsel innerhalb einer langen Flexoauflage. Üblich in der Etiketten-, Verpackungs- und Wellpappenproduktion."@de,
        "Flexographic press augmented with one or more inline digital print stations — typically inkjet for variable data, personalization, or short-run color changes within a long flexo run. Common in label, packaging, and corrugated production."@en,
        "Prensa flexográfica complementada con una o más estaciones de inyección digital en línea — permite añadir variabilidad o personalización a tiradas largas de packaging."@es,
        "एक या अधिक इनलाइन डिजिटल प्रिंट स्टेशनों से युक्त फ़्लेक्सोग्राफ़िक प्रेस — आमतौर पर लंबे फ़्लेक्सो रन के भीतर वेरिएबल डेटा, वैयक्तिकरण या शॉर्ट-रन रंग बदलाव के लिए इंकजेट। लेबल, पैकेजिंग और कोरुगेटेड उत्पादन में आम।"@hi,
        "1つ以上のインラインデジタルプリントステーションを備えたフレキソ印刷機 — 通常、長納期のフレキソ業務内のバリアブルデータ、パーソナライゼーション、短納期色変更にインクジェットを使用する。ラベル、パッケージ、段ボール生産で一般的。"@ja,
        "Fleksografisk presse utvidet med en eller flere inline digitale trykkstasjoner — vanligvis inkjet for variabel data, personalisering eller korttopplag fargeendringer innenfor et langt flexo-opplag. Vanlig i etikett-, emballasje- og bølgepapp-produksjon."@nb,
        "Flexopers aangevuld met een of meer digitale drukstations inline — doorgaans inkjet voor variabele data, personalisatie of korte kleurwissels binnen een lange flexo-oplage. Gebruikelijk in etiketten-, verpakkings- en golfkartonproductie."@nl,
        "Maszyna fleksograficzna uzupełniona jednym lub kilkoma cyfrowymi zespołami drukującymi w linii — zwykle atramentowymi dla danych zmiennych, personalizacji lub krótkoseryjnych zmian koloru w długim nakładzie flekso. Typowa w produkcji etykiet, opakowań i tektury falistej."@pl,
        "Impressora flexográfica ampliada com uma ou mais estações digitais em linha — normalmente jato de tinta para dados variáveis, personalização ou trocas de cor em tiragem curta dentro de uma tiragem flexo longa. Comum na produção de rótulos, embalagens e papelão ondulado."@pt,
        "Flexopress kompletterad med en eller flera digitala tryckstationer inline — typiskt inkjet för variabeldata, personalisering eller korta kulörbyten inom en lång flexoupplaga. Vanligt inom etikett-, förpacknings- och wellpapproduktion."@sv,
        "配有一个或多个联线数码喷墨工位的柔印机 —— 允许在长印次包装中添加可变性或个性化。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC§HYBRID-FLEXO" ;
    skos:prefLabel "Hybridflexo"@da,
        "Hybrider Flexodruck"@de,
        "Hybrid Flexo"@en,
        "Flexografía Híbrida"@es,
        "हाइब्रिड फ़्लेक्सो"@hi,
        "ハイブリッドフレキソ"@ja,
        "Hybrid fleksografi"@nb,
        "Hybride flexo"@nl,
        "Flekso hybrydowe"@pl,
        "Flexo híbrida"@pt,
        "Hybridflexo"@sv,
        "混合柔印"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "technologies" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/schemas/quote/1> a ptpge:Schema ;
    dcterms:created "2026-10-09T17:30:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-10T22:10:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/schemas> ;
    skos:definition "A printer's answer to one request: the same configuration (the ptpge-cfs/1 fingerprint it was asked for), a quantity, a price in one currency, delivery terms and a validity period, addressed to the buyer who asked. Together with the request it is one deal; its acceptance is the event an implementation acts on. Not published at a known path — it has a recipient."@en,
        "Et trykkeris svar på én forespørsel: samme konfigurasjon (ptpge-cfs/1-fingeravtrykket det ble spurt om), et antall, en pris i én valuta, leveringsvilkår og en gyldighetsperiode, adressert til kjøperen som spurte. Sammen med forespørselen utgjør det én handel; aksepten er hendelsen en implementasjon handler på. Publiseres ikke på kjent sti – det har en mottaker."@nb ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "SCH:QUOTE" ;
    skos:prefLabel "Quote"@en,
        "Tilbud"@nb ;
    ptpge:holds "price · quantity · delivery · validity, for one configuration" ;
    ptpge:jsonSchema <https://ptpge.org/v1/schemas/quote/1.schema.json> ;
    ptpge:level "element" ;
    ptpge:schemaVersion 1 ;
    ptpge:stage "published" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-10-12" ;
    ptpge:writtenBy "a printer, in answer to a request" .

<https://ptpge.org/v1/schemas/request/1> a ptpge:Schema ;
    dcterms:created "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-10T22:10:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/schemas> ;
    skos:definition "A buyer's or agent's ask: one validated configuration (bindings on vocabulary URIs, resolving to a ptpge-cfs/1 fingerprint) plus quantity and delivery terms, addressed to one or many vendors. The document a receiving system acts on without a human in between."@en,
        "A buyer's or agent's ask: one validated configuration (bindings on vocabulary URIs, resolving to a ptpge-cfs/1 fingerprint) plus quantity and delivery terms, addressed to one or many vendors. The document a receiving system acts on without a human in between."@nb ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "SCH:REQUEST" ;
    skos:prefLabel "Request"@en,
        "Forespørsel"@nb ;
    ptpge:holds "a configuration + quantity, asked of one or many vendors" ;
    ptpge:jsonSchema <https://ptpge.org/v1/schemas/request/1.schema.json> ;
    ptpge:level "element" ;
    ptpge:schemaVersion 1 ;
    ptpge:stage "published" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-10-12" ;
    ptpge:writtenBy "a buyer or an agent" .

<https://ptpge.org/v1/schemas/supplier-catalogue/1> a ptpge:Schema ;
    dcterms:created "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-10T21:40:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/schemas> ;
    skos:definition "A maker's own series, grades and models, each mapped to the generic terms it embodies (substrate, weight, technology). Written and kept current by the maker; carries the maker's identity (/v1/suppliers/…). The vocabulary stays free of company names because this document exists."@en,
        "Produsentens egne serier, kvaliteter og modeller, hver knyttet til de generiske termene den representerer (substrat, vekt, teknologi). Skrives og holdes à jour av produsenten; bærer produsentens identitet (/v1/suppliers/…). Vokabularet holdes fritt for firmanavn fordi dette dokumentet finnes."@nb ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "SCH:SUPPLIER-CATALOGUE" ;
    skos:prefLabel "Supplier catalogue"@en,
        "Produsentkatalog"@nb ;
    ptpge:holds "the maker's series, grades and models, mapped to generic terms" ;
    ptpge:jsonSchema <https://ptpge.org/v1/schemas/supplier-catalogue/1.schema.json> ;
    ptpge:level "element" ;
    ptpge:schemaVersion 1 ;
    ptpge:stage "published" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-10-12" ;
    ptpge:writtenBy "a paper or equipment maker" .

