    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:status "deprecated" ;
    ptpge:version "2026-10-06" .

<https://ptpge.org/v1/printing/management/workflow/efficiency-tools/automation-integration/xerox-freeflow-core> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:isReplacedBy <https://ptpge.org/v1/printing/management/workflow/efficiency-tools/automation-integration> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:29:35+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/management/workflow/efficiency-tools/automation-integration> ;
    skos:definition "Xerox FreeFlow Core — workflow-automatiseringsplatform optimeret til Xerox' digitale produktionspresser med ordremodtagelse, preflight, automatiseret rutning og integration med Xerox' pressestyring."@da,
        "Xerox FreeFlow Core — auf Xerox-Digitalproduktionsmaschinen optimierte Workflow-Automatisierungsplattform, die Auftragsannahme, Preflight, automatisches Routing und Integration mit den Xerox-Maschinensteuerungen bietet."@de,
        "Xerox FreeFlow Core — workflow automation platform optimized for Xerox digital production presses, providing job intake, preflight, automated routing, and integration with Xerox press controllers."@en,
        "Plataforma de automatización del flujo de trabajo de Xerox para producción digital — automatiza preflight, imposición y procesamiento previo a la prensa."@es,
        "Xerox FreeFlow Core — Xerox डिजिटल प्रोडक्शन प्रेस के लिए अनुकूलित वर्कफ़्लो स्वचालन प्लेटफ़ॉर्म, जॉब इनटेक, प्रीफ़्लाइट, स्वचालित रूटिंग और Xerox प्रेस कंट्रोलरों से एकीकरण।"@hi,
        "Xerox FreeFlow Core — Xeroxデジタル生産印刷機向けに最適化されたワークフロー自動化プラットフォーム。ジョブ受付、プリフライト、自動ルーティング、Xerox印刷機コントローラーとの統合を提供する。"@ja,
        "Xerox FreeFlow Core — workflow-automasjonsplattform optimalisert for Xerox digitale produksjonspresser, med jobb-mottak, preflight, automatisert ruting og integrasjon med Xerox press-kontrollere."@nb,
        "Xerox FreeFlow Core — workflowautomatiseringsplatform geoptimaliseerd voor Xerox' digitale productiepersen, met orderintake, preflight, geautomatiseerde routering en integratie met Xerox-persbesturing."@nl,
        "Xerox FreeFlow Core — platforma automatyzacji workflow zoptymalizowana pod maszyny cyfrowe Xerox, zapewniająca przyjęcie zlecenia, preflight, automatyczne kierowanie i integrację z kontrolerami maszyn Xerox."@pl,
        "Xerox FreeFlow Core — plataforma de automação de fluxo de trabalho otimizada para impressoras digitais de produção Xerox, com entrada de trabalhos, preflight, roteamento automatizado e integração com os controladores de impressora Xerox."@pt,
        "Xerox FreeFlow Core — automationsplattform optimerad för Xerox digitala produktionspressar, med jobbintag, preflight, automatiserad dirigering och integration med Xerox presskontrollers."@sv,
        "Xerox面向数码生产的工作流程自动化平台——自动化印前、拼版和印刷前处理。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§XEROX-FREEFLOW-CORE" ;
    skos:prefLabel "Xerox FreeFlow Core"@da,
        "Xerox FreeFlow Core"@de,
        "Xerox FreeFlow Core"@en,
        "Xerox FreeFlow Core"@es,
        "Xerox FreeFlow Core"@hi,
        "Xerox FreeFlow Core"@ja,
        "Xerox FreeFlow Core"@nb,
        "Xerox FreeFlow Core"@nl,
        "Xerox FreeFlow Core"@pl,
        "Xerox FreeFlow Core"@pt,
        "Xerox FreeFlow Core"@sv,
        "Xerox FreeFlow Core"@zh-Hans ;
    ptpge:deprecatedOn "2026-10-06"^^xsd:date ;
    ptpge:deprecationReason "A brand is a term only when the trade uses it as a standard, never when it is a product one buys (SD-0097). This is a product: it belongs in the maker's supplier catalogue and in a printer's vendor declaration as capability. Use the generic parent in the vocabulary; this URI keeps resolving."@en,
        "Et merke er en term bare når bransjen bruker det som en standard, aldri når det er et produkt man kjøper (SD-0097). Dette er et produkt: det hører hjemme i produsentens katalog og i trykkeriets leverandørdeklarasjon som kapasitet. Bruk den generiske forelderen i vokabularet; denne URI-en fortsetter å svare."@nb ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:status "deprecated" ;
    ptpge:version "2026-10-06" .

<https://ptpge.org/v1/printing/management/workflow/file-preparation/impositioning> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:altLabel "imposition"@en,
        "page imposition"@en,
        "इम्पोज़िशन"@hi,
        "पेज इम्पोज़िशन"@hi,
        "montasje"@nb,
        "utskyting"@nb,
        "impozycja stron"@pl,
        "montaż elektroniczny"@pl,
        "rozmieszczenie użytków"@pl,
        "imposição de páginas"@pt,
        "montagem"@pt ;
    skos:broader <https://ptpge.org/v1/printing/management/workflow/file-preparation> ;
    skos:definition "Arrangering af flere sider på ét trykark, så siderne efter tryk, falsning og skæring står i korrekt rækkefølge i det færdige produkt. Kritisk for bøger, brochurer og alt flersidet."@da,
        "Anordnung mehrerer Seiten auf einem einzelnen Druckbogen, sodass die Seiten nach Druck, Falzen und Schneiden in der korrekten Reihenfolge im fertigen Produkt erscheinen. Unverzichtbar für Bücher, Broschüren und alle bogenbasierten Bindungsarten."@de,
        "Arrangement of multiple pages on a single press sheet so that, after printing, folding, and cutting, the pages appear in correct sequence in the finished product. Critical for books, brochures, and any signature-based bindery."@en,
        "Disposición de páginas individuales sobre un pliego de impresión para que, tras imprimir, plegar y cortar, queden en el orden correcto en el producto final."@es,
        "एक ही प्रेस शीट पर कई पेजों की व्यवस्था ताकि छपाई, फ़ोल्डिंग और कटिंग के बाद पेज तैयार उत्पाद में सही क्रम में आएँ। पुस्तकों, ब्रोशर और किसी भी सिग्नेचर-आधारित बाइंडरी के लिए महत्वपूर्ण।"@hi,
        "印刷、折り、断裁の後、完成品でページが正しい順序で表示されるように、複数のページを1枚の印刷シートに配置する作業。書籍、ブローシュア、折り丁ベースの製本に不可欠。"@ja,
        "Arrangering av flere sider på et enkelt presseark slik at sidene etter trykk, folding og kutting fremstår i riktig rekkefølge i det ferdige produktet. Kritisk for bøker, brosjyrer og enhver signaturbasert innbinding."@nb,
        "Het schikken van meerdere pagina's op één drukvel zodat de pagina's na drukken, vouwen en snijden in de juiste volgorde in het eindproduct staan. Cruciaal voor boeken, brochures en alles wat meerpagina is."@nl,
        "Rozmieszczenie wielu stron na jednym arkuszu drukowym tak, aby po zadrukowaniu, złożeniu i przycięciu strony pojawiły się we właściwej kolejności w gotowym produkcie. Kluczowe dla książek, broszur i każdej introligatorni pracującej na składkach."@pl,
        "Arranjo de várias páginas numa única folha de máquina de modo que, após impressão, dobra e corte, as páginas apareçam na sequência correta no produto acabado. Crítico para livros, folhetos e qualquer encadernação baseada em cadernos."@pt,
        "Placering av flera sidor på ett och samma tryckark så att sidorna efter tryck, falsning och skärning hamnar i rätt ordning i den färdiga produkten. Avgörande för böcker, broschyrer och all arkbaserad bokbindning."@sv,
        "将单个页面在印刷纸张上的排布，使得在印刷、折页和裁切后页面在最终产品中按正确顺序排列。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§IMPOSITIONING" ;
    skos:prefLabel "Udskydning"@da,
        "Ausschießen"@de,
        "Impositioning"@en,
        "Imposición"@es,
        "इम्पोज़िशनिंग"@hi,
        "面付け"@ja,
        "Påtegning / imposition"@nb,
        "Impositie (uitschieten)"@nl,
        "Impozycja"@pl,
        "Imposição"@pt,
        "Utskjutning"@sv,
        "拼版"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.4.21 · p.105",
                "§5.4.22 · p.107",
                "§5.4.8 · p.94",
                "§6.52 · p.212",
                "§6.6 · p.147" ;
            ptpge:mappingRow "crosswalk row 7" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "BinderySignature",
                "Imposition",
                "Layout",
                "SheetOptimizing",
                "Stripping" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/certifications/industry> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards/certifications> ;
    skos:definition "Branchespecifikke mærker udstedt af nationale eller sektorielle trykorganisationer for at anerkende medlemmer eller produkter, der opfylder branchedefinerede kriterier."@da,
        "Branchenspezifische Kennzeichnungen, die von nationalen oder sektoralen Druckorganisationen vergeben werden, um Mitglieder oder Produkte auszuzeichnen, die branchendefinierte Kriterien erfüllen."@de,
        "Industry-specific marks issued by national or sectoral printing organizations to recognize members or products meeting industry-defined criteria."@en,
        "Marcas específicas de la industria emitidas por organizaciones nacionales o sectoriales de impresión para reconocer a miembros o productos que cumplen criterios definidos por el sector."@es,
        "राष्ट्रीय या क्षेत्रीय मुद्रण संगठनों द्वारा जारी उद्योग-विशिष्ट चिह्न, जो उद्योग-परिभाषित मानदंड पूरे करने वाले सदस्यों या उत्पादों को मान्यता देते हैं।"@hi,
        "国内または業種別の印刷業界団体が、業界が定めた基準を満たす会員または製品を認定するために発行する、業界固有のマーク。"@ja,
        "Bransjespesifikke merker utstedt av nasjonale eller sektorspesifikke trykkeriorganisasjoner som anerkjenner medlemmer eller produkter som oppfyller bransjedefinerte kriterier."@nb,
        "Branchespecifieke keurmerken, uitgegeven door nationale of sectorale drukorganisaties, ter erkenning van leden of producten die aan branchegedefinieerde criteria voldoen."@nl,
        "Znaki branżowe nadawane przez krajowe lub sektorowe organizacje poligraficzne w celu wyróżnienia członków lub produktów spełniających kryteria określone przez branżę."@pl,
        "Marcas específicas do setor emitidas por organizações gráficas nacionais ou setoriais para reconhecer membros ou produtos que cumprem critérios definidos pelo setor."@pt,
        "Branschspecifika märken utfärdade av nationella eller sektoriella tryckeriorganisationer för att erkänna medlemmar eller produkter som uppfyller branschdefinierade kriterier."@sv,
        "由国家或部门印刷组织颁发的特定行业标志，用于认可符合行业定义标准的成员或产品。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/certifications/industry/trykt-i-norge> ;
    skos:notation "P:ST-CER-INDU" ;
    skos:prefLabel "Branche"@da,
        "Branche"@de,
        "Industry"@en,
        "Industria"@es,
        "उद्योग"@hi,
        "業界"@ja,
        "Bransje"@nb,
        "Branche"@nl,
        "Branżowe"@pl,
        "Setoriais"@pt,
        "Bransch"@sv,
        "行业"@zh-Hans ;
    skos:scopeNote "Umfasst Herkunftskennzeichnungen (Trykt i Norge), Mitgliedschaften in Branchenverbänden und sektorspezifische Anerkennungsprogramme. Internationale Zertifizierungen (ISO, FSC) werden in benachbarten Unterkategorien geführt."@de,
        "Includes country-of-origin marks (Trykt i Norge), trade-association memberships, and sector-specific recognition programs. International certifications (ISO, FSC) are handled in adjacent sub-categories."@en,
        "Incluye marcas de país de origen (Trykt i Norge), pertenencias a asociaciones comerciales y programas sectoriales de reconocimiento. Las certificaciones internacionales (ISO, FSC) se gestionan en sub-categorías adyacentes."@es,
        "मूल-देश चिह्न (Trykt i Norge), व्यापार-संघ सदस्यताएँ और क्षेत्र-विशिष्ट मान्यता कार्यक्रम शामिल। अंतरराष्ट्रीय प्रमाणन (ISO, FSC) निकटवर्ती उप-श्रेणियों में।"@hi,
        "原産国マーク（Trykt i Norge）、業界団体への所属、業種固有の認定プログラムを含む。国際認証（ISO、FSC）は隣接サブカテゴリで扱う。"@ja,
        "Inkluderer opprinnelsesmerker (Trykt i Norge), bransjeforeningsmedlemskap, og sektorspesifikke anerkjennelsesprogrammer. Internasjonale sertifiseringer (ISO, FSC) håndteres i tilstøtende underkategorier."@nb,
        "Inclui marcas de país de origem (Trykt i Norge), filiações a associações de classe e programas de reconhecimento setorial. Certificações internacionais (ISO, FSC) ficam em subcategorias adjacentes."@pt,
        "包括原产地标志（Trykt i Norge）、行业协会会员资格和部门特定认可项目。国际认证（ISO、FSC）在相邻子分类下处理。"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.7 · p.336" ;
            ptpge:mappingRow "crosswalk row 5" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Certification" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/certifications/quality> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards/certifications> ;
    skos:definition "Generiske ledelsessystemstandarder, der dokumenterer at en organisation har dokumenterede og vedligeholdte effektive kvalitetsprocesser."@da,
        "Allgemeine Managementsystem-Normen, die belegen, dass eine Organisation effektive Qualitätsprozesse dokumentiert und aufrechterhält."@de,
        "Generic management-system standards demonstrating that an organization has documented and maintains effective quality processes."@en,
        "Normas genéricas de sistemas de gestión que demuestran que una organización ha documentado y mantiene procesos de calidad efectivos."@es,
        "सामान्य प्रबंधन-प्रणाली मानक जो दर्शाते हैं कि संगठन ने प्रभावी गुणवत्ता प्रक्रियाएँ दस्तावेज़ीकृत की हैं और बनाए रखता है।"@hi,
        "組織が文書化された有効な品質プロセスを保有し維持していることを実証する、汎用的なマネジメントシステム規格。"@ja,
        "Generiske ledelsessystem-standarder som dokumenterer at en organisasjon har innført og opprettholder effektive kvalitetsprosesser."@nb,
        "Generieke managementsysteemstandaarden die aantonen dat een organisatie gedocumenteerde en onderhouden effectieve kwaliteitsprocessen heeft."@nl,
        "Ogólne standardy systemów zarządzania potwierdzające, że organizacja udokumentowała i utrzymuje skuteczne procesy jakości."@pl,
        "Normas genéricas de sistemas de gestão que demonstram que uma organização documentou e mantém processos de qualidade eficazes."@pt,
        "Generiska ledningssystemstandarder som visar att en organisation har dokumenterade och underhållna effektiva kvalitetsprocesser."@sv,
        "证明组织已记录并维护有效质量过程的通用管理系统标准。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/certifications/quality/iso-9001> ;
    skos:notation "P:ST-CER-QUAL" ;
    skos:prefLabel "Kvalitet"@da,
        "Qualität"@de,
        "Quality"@en,
        "Calidad"@es,
        "गुणवत्ता"@hi,
        "品質"@ja,
        "Kvalitet"@nb,
        "Kwaliteit"@nl,
        "Jakościowe"@pl,
        "Qualidade"@pt,
        "Kvalitet"@sv,
        "质量"@zh-Hans ;
    skos:scopeNote "Im Mittelpunkt steht ISO 9001 — anwendbar auf Druckereien wie auf jede andere Organisation. Branchenspezifische Prozesszertifizierungen und Umweltmanagementsysteme werden separat geführt."@de,
        "Centered on ISO 9001 — applicable to printers as to any organization. Industry-specific process certifications and environmental management systems are tracked separately."@en,
        "Centrada en ISO 9001 — aplicable a imprentas como a cualquier organización. Las certificaciones específicas de procesos de impresión y los sistemas de gestión ambiental se rastrean por separado."@es,
        "ISO 9001 पर केंद्रित — प्रिंटरों पर वैसे ही लागू जैसे किसी भी संगठन पर। उद्योग-विशिष्ट प्रक्रिया प्रमाणन और पर्यावरण प्रबंधन प्रणालियाँ अलग दर्ज।"@hi,
        "ISO 9001を中心とする — 印刷会社にも他の組織と同様に適用される。業種固有の工程認証および環境マネジメントシステムは別途扱う。"@ja,
        "Sentrert rundt ISO 9001 — gyldig for trykkerier på lik linje med enhver organisasjon. Bransjespesifikke prosessertifiseringer og miljøledelsessystemer spores separat."@nb,
        "Centrada na ISO 9001 — aplicável a impressores como a qualquer organização. Certificações de processo específicas do setor e sistemas de gestão ambiental são registrados separadamente."@pt,
        "以ISO 9001为中心——适用于印刷厂以及任何组织。行业特定的工艺认证和环境管理系统另行跟踪。"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.7 · p.336" ;
            ptpge:mappingRow "crosswalk row 5" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Certification" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/color-profiles/icc-profiles> a skos:Concept ;
    dcterms:created "2026-06-18T10:00:07+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "ICC"@en,
        "ICC colour profile"@en,
        "color profile"@en,
        "colour profile"@en,
        "ICC"@hi,
        "ICC रंग प्रोफ़ाइल"@hi,
        "रंग प्रोफ़ाइल"@hi,
        "ICC-profil"@nb,
        "fargeprofil"@nb,
        "ICC"@pl,
        "profil barw ICC"@pl,
        "profil barwny"@pl,
        "profil kolorów"@pl,
        "ICC"@pt,
        "perfil de cor"@pt,
        "perfil de cor ICC"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/color-profiles> ;
    skos:definition "ICC-farveprofiler (ICC.1), der karakteriserer enheds-/tilstandsfarve til farvestyrede arbejdsgange."@da,
        "ICC-Farbprofile (ICC.1), die Geräte-/Bedingungsfarbe für farbgemanagte Workflows charakterisieren."@de,
        "ICC colour profiles (ICC.1) characterising device/condition colour for managed workflows."@en,
        "Perfiles de color ICC (ICC.1) que caracterizan el color de dispositivo/condición para flujos con gestión de color."@es,
        "प्रबंधित वर्कफ़्लो के लिए डिवाइस/स्थिति रंग का लक्षण-वर्णन करने वाली ICC रंग प्रोफ़ाइल (ICC.1)।"@hi,
        "カラーマネジメントされたワークフローのためにデバイス／印刷条件の色を特性化する ICC カラープロファイル（ICC.1）。"@ja,
        "ICC-fargeprofiler (ICC.1) som karakteriserer enhets-/betingelsesfarge for fargestyrte arbeidsflyter."@nb,
        "ICC-kleurprofielen (ICC.1) die apparaat-/conditiekleur karakteriseren voor kleurbeheerde workflows."@nl,
        "Profile barw ICC (ICC.1) charakteryzujące barwę urządzenia/warunków w przepływach z zarządzaniem barwą."@pl,
        "Perfis de cor ICC (ICC.1) que caracterizam a cor de dispositivo/condição para fluxos de trabalho gerenciados."@pt,
        "ICC-färgprofiler (ICC.1) som karakteriserar enhets-/tillståndsfärg för färghanterade arbetsflöden."@sv,
        "ICC 色彩配置文件（ICC.1），为色彩管理工作流程描述设备/印刷条件的色彩特性。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§ICC-PROFILES" ;
    skos:prefLabel "ICC-profiler"@da,
        "ICC-Profile"@de,
        "ICC Profiles"@en,
        "Perfiles ICC"@es,
        "ICC प्रोफ़ाइल"@hi,
        "ICC プロファイル"@ja,
        "ICC-profielen"@nl,
        "Profile ICC"@pl,
        "Perfis ICC"@pt,
        "ICC-profiler"@sv,
        "ICC 配置文件"@zh-Hans ;
