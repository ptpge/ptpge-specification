        "パーティクルボード"@ja,
        "Sponplate"@nb,
        "Spaanplaat"@nl,
        "Płyta wiórowa"@pl,
        "Aglomerado"@pt,
        "Spånskiva"@sv,
        "刨花板"@zh-Hans ;
