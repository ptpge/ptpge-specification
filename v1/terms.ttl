    skos:prefLabel "Trådhæftning"@da,
        "Fadenheftung"@de,
        "Sewn Binding"@en,
        "Sewn Binding"@es,
        "सिलाई बाइंडिंग (सेक्शन स्यून)"@hi,
        "Sewn Binding"@ja,
        "Trådbinding"@nb,
        "Genaaid binden"@nl,
        "Oprawa szyta"@pl,
        "Costura"@pt,
        "Trådbindning"@sv,
        "Sewn Binding"@zh-Hans ;
