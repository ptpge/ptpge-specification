        "NCS नोटेशन"@hi,
        "Natural Color System"@hi,
        "Natural Colour System"@hi,
        "ナチュラルカラーシステム"@ja,
        "NCS-farger"@nb,
        "Natural Colour System"@nb,
        "Natural Colour System"@nl,
        "Natural Colour System"@pl,
