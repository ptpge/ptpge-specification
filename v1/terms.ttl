            ptpge:aspectRatio 2.0 ;
            ptpge:height 2378.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 1189.0 ] ;
    ptpge:level "element" ;
