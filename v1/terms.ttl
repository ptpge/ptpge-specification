<https://ptpge.org/v1/variables/substrate/substrate-weight> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "GSM"@en,
        "Grammage"@en,
        "Paper Weight"@en,
        "GSM"@hi,
        "काग़ज़ का वज़न"@hi,
        "ग्रामेज"@hi,
        "पेपर वेट"@hi,
        "Gramvekt"@nb,
        "Papirvekt"@nb,
        "g/m²"@pl,
        "gramatura"@pl,
        "gramatura papieru"@pl,
        "g/m²"@pt,
        "gramatura"@pt,
        "gramatura do papel"@pt,
        "peso do papel"@pt ;
    skos:broader <https://ptpge.org/v1/variables/substrate> ;
    skos:definition "Konfigurerbar akse: Substratvægt. Et trykt produkt konfigureres langs denne variabel (numerisk, enkeltvalg, i g/m²). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Grammatur. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (numerisch, Einfachauswahl, in g/m²). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Substrate Weight. A printed product is configured along this variable (numeric, single selection, in gsm). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Gramaje. Un producto impreso se configura a lo largo de esta variable (numérico, selección única, en g/m²). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: सब्सट्रेट का वज़न (ग्रामेज)। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (संख्यात्मक, एकल चयन, GSM में)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：坪量。印刷物はこの変数に沿って構成される（数値、単一選択、g/m²単位）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Substratvekt. Et trykkprodukt konfigureres langs denne variabelen (numeric, single valg, i gsm). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Substraatgewicht. Een drukproduct wordt langs deze variabele geconfigureerd (numeriek, enkelvoudig, in g/m²). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Gramatura podłoża. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (numeryczna, wybór pojedynczy, w g/m²). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Gramatura do Substrato. Um impresso é configurado ao longo desta variável (numérico, seleção única, em g/m²). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Substratvikt. En trycksak konfigureras längs denna variabel (numerisk, enkelval, i g/m²). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：克重。印刷品沿此变量进行配置（数值，单选，以 g/m² 计）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:SB§SUBSTRATE-WEIGHT" ;
    skos:prefLabel "Substratvægt"@da,
        "Grammatur"@de,
        "Substrate Weight"@en,
        "Gramaje"@es,
        "सब्सट्रेट का वज़न"@hi,
        "坪量"@ja,
        "Substratvekt"@nb,
        "Substraatgewicht"@nl,
        "Gramatura podłoża"@pl,
        "Gramatura do substrato"@pt,
        "Substratvikt"@sv,
        "克重"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "numeric" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvilken papirvægt?"@da,
        "Welches Papiergewicht?"@de,
        "How heavy a paper?"@en,
        "¿Qué gramaje?"@es,
        "कागज़ कितना भारी?"@hi,
        "紙の厚さ（坪量）は？"@ja,
        "Hvor tykt papir?"@nb,
        "Welk papiergewicht?"@nl,
        "Jaka gramatura?"@pl,
        "Que gramagem?"@pt,
        "Vilken pappersvikt?"@sv,
        "纸张多重？"@zh-Hans ;
    ptpge:rangeMax 600.0 ;
    ptpge:rangeMin 40.0 ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:unit "gsm" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights> ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/certifications/environmental/fsc> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "FSC certified"@en,
        "Forest Stewardship Council"@en,
        "FSC प्रमाणित"@hi,
        "Forest Stewardship Council"@hi,
        "FSC-sertifisert"@nb,
        "Forest Stewardship Council"@pl,
        "certyfikat FSC"@pl,
        "papier FSC"@pl,
        "Certificado FSC"@pt,
        "Forest Stewardship Council"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/certifications/environmental> ;
    skos:definition "Forest Stewardship Council-certificering: en sporbarheds- og skovforvaltningsstandard, der kun lader en tryksag bære FSC-mærket, hvis papiret kan spores gennem hvert leverandørled fra ansvarligt forvaltet skov. Den mest anerkendte miljøreference for tryksager, ofte et krav fra offentlige og større virksomhedskøbere."@da,
        "Zertifizierung des Forest Stewardship Council: ein Standard für Chain-of-Custody und Waldbewirtschaftung, der einem Druckerzeugnis nur dann erlaubt, das FSC-Label zu tragen, wenn dessen Papier von verantwortungsvoll bewirtschafteten Wäldern über alle Lieferanten hinweg rückverfolgbar ist. Die am weitesten anerkannte Umweltauszeichnung für Druckerzeugnisse, oft von öffentlichen Auftraggebern und Großunternehmen gefordert."@de,
        "Forest Stewardship Council certification: a chain-of-custody and forest-management standard that lets a printed product carry the FSC label only if its paper is traceable through every supplier from a responsibly-managed forest. The most widely recognized environmental credential for printed goods, often required by public-sector and large-corporate buyers."@en,
        "Certificación del Forest Stewardship Council: norma de cadena de custodia y gestión forestal que permite que un producto impreso lleve el sello FSC solo si su papel es rastreable a través de cada proveedor desde un bosque certificado."@es,
        "Forest Stewardship Council प्रमाणन: चेन-ऑफ़-कस्टडी और वन-प्रबंधन मानक जो मुद्रित उत्पाद को FSC लेबल तभी देता है जब उसका काग़ज़ हर आपूर्तिकर्ता से होकर ज़िम्मेदारी से प्रबंधित वन तक ट्रेस किया जा सके। मुद्रित वस्तुओं के लिए सबसे व्यापक रूप से मान्य पर्यावरणीय प्रमाण, प्रायः सार्वजनिक-क्षेत्र और बड़े कॉर्पोरेट ख़रीदारों द्वारा अनिवार्य।"@hi,
        "Forest Stewardship Council（森林管理協議会）認証：印刷物がFSCラベルを表示できるのは、その用紙が責任ある森林管理の下で生産され、全てのサプライヤーを通じて追跡可能な場合に限られる、加工流通過程（CoC）および森林管理の規格。印刷物に対して最も広く認知されている環境認証であり、公共部門および大企業の調達において必須要件とされることが多い。"@ja,
        "Forest Stewardship Council-sertifisering: en chain-of-custody- og skogforvaltningsstandard som gjør at en trykksak kan bære FSC-merket kun dersom papiret er sporbart gjennom hver leverandør fra en ansvarlig forvaltet skog. Den mest anerkjente miljøsertifiseringen for trykte produkter, ofte påkrevd av offentlige innkjøpere og store bedrifter."@nb,
        "Forest Stewardship Council-certificering: een chain-of-custody- en bosbeheerstandaard die drukwerk alleen het FSC-label laat dragen als het papier traceerbaar is door elke leveranciersschakel vanaf verantwoord beheerd bos. Het meest erkende milieukeurmerk voor drukwerk, vaak vereist door publieke en grote zakelijke inkopers."@nl,
        "Certyfikacja Forest Stewardship Council: standard łańcucha dostaw i gospodarki leśnej, który pozwala produktowi drukowanemu nosić znak FSC tylko wtedy, gdy jego papier jest identyfikowalny przez każdego dostawcę aż do odpowiedzialnie zarządzanego lasu. Najszerzej rozpoznawane poświadczenie środowiskowe dla druków, często wymagane przez nabywców z sektora publicznego i dużych korporacji."@pl,
        "Certificação do Forest Stewardship Council: norma de cadeia de custódia e manejo florestal que permite a um produto impresso levar o selo FSC apenas se o seu papel for rastreável por todos os fornecedores até uma floresta manejada de forma responsável. A credencial ambiental mais reconhecida para produtos impressos, muitas vezes exigida por compradores do setor público e grandes empresas."@pt,
        "Forest Stewardship Council-certifiering: en spårbarhets- och skogsbruksstandard som låter en trycksak bära FSC-märket endast om dess papper är spårbart genom varje leverantörsled från ansvarsfullt brukad skog. Den mest erkända miljömeriten för trycksaker, ofta ett krav från offentliga och större företagsköpare."@sv,
        "Forest Stewardship Council认证：产销监管链和森林管理标准，只有当印刷品的纸张可追溯至认证森林的每一供应商时，才能携带FSC标志。"@zh-Hans ;
    skos:exactMatch <http://www.wikidata.org/entity/Q468515> ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§FSC" ;
    skos:prefLabel "FSC®"@da,
        "FSC ®"@de,
        "FSC ®"@en,
        "FSC ®"@es,
        "FSC ®"@hi,
        "FSC ®"@ja,
        "FSC ®"@nb,
        "FSC®"@nl,
        "FSC ®"@pl,
        "FSC ®"@pt,
        "FSC®"@sv,
        "FSC ®（森林管理委员会认证）"@zh-Hans ;
    skos:scopeNote "FSC zertifiziert Quelle und Lieferkette von Faserstoffen. ISO 14001 hingegen zertifiziert das gesamte Umweltmanagementsystem der Druckerei."@de,
        "FSC certifies the source and chain of custody of fibrous materials. ISO 14001 by contrast certifies the printer's overall environmental management system."@en,
        "FSC रेशेदार सामग्री के स्रोत और चेन-ऑफ़-कस्टडी को प्रमाणित करता है। इसके विपरीत ISO 14001 प्रिंटर की समग्र पर्यावरण प्रबंधन प्रणाली को प्रमाणित करता है।"@hi,
        "FSCは繊維材料の出所と加工流通過程（CoC）を認証する。一方ISO 14001は印刷会社の環境マネジメントシステム全体を認証する。"@ja,
        "FSC sertifiserer kilden og sporbarhets­kjeden for fiber­råstoff. ISO 14001 sertifiserer derimot trykkeriets samlede miljø­styringssystem."@nb,
        "O FSC certifica a origem e a cadeia de custódia de materiais fibrosos. A ISO 14001, por contraste, certifica o sistema global de gestão ambiental do impressor."@pt ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.7 · p.336" ;
            ptpge:mappingRow "crosswalk row 5" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Certification" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/surface-finish/lamination/gloss> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Gloss laminate"@en,
        "Gloss laminated"@en,
        "Glossy Lamination"@en,
        "Glossy lamination"@en,
        "High-gloss lamination"@en,
        "ग्लॉस लैमिनेट"@hi,
        "ग्लॉसी लैमिनेशन"@hi,
        "चमकीला लैमिनेशन"@hi,
        "हाई-ग्लॉस लैमिनेशन"@hi,
        "Blank laminering"@nb,
        "Glanslaminat"@nb,
        "Glanslaminering"@nb,
        "Glans laminaat"@nl,
        "Glanzend gelamineerd"@nl,
        "folia błysk"@pl,
        "folia błyszcząca"@pl,
        "laminat błyszczący"@pl,
        "BOPP brilho"@pt,
        "laminado brilho"@pt,
        "laminação brilhante"@pt,
        "plastificação brilho"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/surface-finish/lamination> ;
    skos:definition "Blank plastfilm lamineret på den trykte overflade. Giver en stærkt reflekterende, skinnende finish, der intensiverer trykkets farver. Modstår slid og fugt. Almindelig på emballage, omslag og salgsmateriale."@da,
        "Glänzender Kunststofffilm, der auf die bedruckte Oberfläche laminiert wird. Bietet ein stark reflektierendes, glänzendes Finish."@de,
        "Gloss plastic film laminated to the printed surface. Provides a highly reflective, shiny finish that intensifies the colors of the underlying print. Resists scuffing and moisture. Common on packaging, brochures, and high-impact marketing materials."@en,
        "Película plástica brillante laminada sobre la superficie impresa. Proporciona un acabado muy reflectante que intensifica los colores de la impresión. Resiste el roce y la humedad. Común en packaging, folletos y materiales de marketing de alto impacto."@es,
        "छपी सतह पर लैमिनेट की गई ग्लॉस प्लास्टिक फ़िल्म। बहुत परावर्तक, चमकीली फ़िनिश जो नीचे के प्रिंट के रंग गहरे करती है। रगड़ और नमी रोकती है। पैकेजिंग, ब्रोशर और हाई-इम्पैक्ट मार्केटिंग सामग्री में आम।"@hi,
        "印刷面に貼り合わせるグロスフィルム。高い反射性で下の印刷の色を鮮やかに見せる。擦れや湿気に強い。パッケージ、パンフレット、インパクト重視のマーケティング資料で一般的。"@ja,
        "Glansig plastikkfilm laminert til den trykte overflaten. Gir en svært reflekterende, blank finish som intensiverer fargene i den underliggende trykken. Motstår skrap og fuktighet. Vanlig på emballasje, brosjyrer og high-impact markedsmateriell."@nb,
        "Glanzende kunststoffilm gelamineerd op het gedrukte oppervlak. Geeft een sterk reflecterende, glimmende afwerking die de kleuren van de onderliggende druk intensiveert. Bestand tegen slijtage en vocht."@nl,
        "Błyszcząca folia laminowana na zadrukowanej powierzchni. Daje silnie odbijające, lśniące wykończenie, które intensyfikuje kolory druku. Odporne na otarcia i wilgoć. Typowe dla opakowań, folderów i wyrazistych materiałów marketingowych."@pl,
        "Filme plástico brilhante laminado sobre a superfície impressa. Dá um acabamento muito reflexivo e lustroso que intensifica as cores do impresso. Resiste a arranhões e umidade. Comum em embalagens, folhetos e materiais de marketing de alto impacto."@pt,
        "Blank plastfilm laminerad på tryckytan. Ger en starkt reflekterande, glansig finish som förstärker det underliggande tryckets färger. Motstår skavning och fukt. Vanlig på förpackningar, broschyrer och slagkraftigt marknadsmaterial."@sv,
        "复合在印刷表面的亮光塑料薄膜。高反射效果使底层印刷色彩更鲜艳。耐蹭划与潮气。常见于包装、手册与高冲击力营销材料。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§GLOSS-LAMINATION" ;
    skos:prefLabel "Blank laminering"@da,
        "Glanz-Laminierung"@de,
        "Gloss Lamination"@en,
        "Laminado brillante"@es,
        "ग्लॉस लैमिनेशन"@hi,
        "光沢ラミネート"@ja,
        "Glansig laminering"@nb,
        "Glanslaminaat"@nl,
        "Laminowanie błyszczące"@pl,
        "Laminação brilho"@pt,
        "Blank laminering"@sv,
        "光膜覆膜"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.9 · p.78",
                "§5.6.23 · p.125" ;
            ptpge:mappingRow "crosswalk row 45" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Laminating",
                "LaminatingIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/print-standards/iso-12647-2> a skos:Concept ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "ISO 12647"@en,
        "ISO12647-2"@en,
        "offset print standard"@en,
        "ISO 12647"@hi,
        "ISO12647-2"@hi,
        "ऑफसेट प्रिंट मानक"@hi,
        "ISO 12647"@pl,
        "ISO12647-2"@pl,
        "norma druku offsetowego"@pl,
        "ISO 12647"@pt,
        "ISO12647-2"@pt,
        "norma de impressão offset"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/print-standards> ;
    skos:definition "Processtyring for offsetlitografisk tryk — den internationale standard, der definerer trykvilkår, målværdier og tolerancer for CMYK-offset."@da,
        "Prozesskontrolle für den Offsetdruck — der internationale Standard, der Druckbedingungen, Zielwerte und Toleranzen für CMYK-Offset definiert."@de,
        "Process control for offset lithographic printing — the international standard defining print conditions, target values and tolerances for CMYK offset."@en,
        "Control de proceso para la impresión ófset — el estándar internacional que define condiciones de impresión, valores objetivo y tolerancias para el ófset CMYK."@es,
        "ऑफसेट लिथोग्राफ़िक मुद्रण का प्रक्रिया नियंत्रण — CMYK ऑफसेट के लिए प्रिंट स्थितियाँ, लक्ष्य मान और सहनशीलता परिभाषित करने वाला अंतरराष्ट्रीय मानक।"@hi,
        "オフセット印刷の工程管理 — CMYK オフセットの印刷条件、目標値、許容差を定める国際規格。"@ja,
        "Prosesskontroll for offset-litografi — den internasjonale standarden som definerer trykkbetingelser, målverdier og toleranser for CMYK-offset."@nb,
        "Processturing voor offsetlithografisch drukken — de internationale standaard die drukcondities, doelwaarden en toleranties voor CMYK-offset definieert."@nl,
        "Kontrola procesu druku offsetowego — międzynarodowa norma definiująca warunki druku, wartości docelowe i tolerancje dla offsetu CMYK."@pl,
        "Controle de processo para impressão litográfica offset — a norma internacional que define condições de impressão, valores-alvo e tolerâncias para offset CMYK."@pt,
        "Processtyrning för offsetlitografiskt tryck — den internationella standard som definierar tryckvillkor, målvärden och toleranser för CMYK-offset."@sv,
        "胶印过程控制 — 定义 CMYK 胶印的印刷条件、目标值与容差的国际标准。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
