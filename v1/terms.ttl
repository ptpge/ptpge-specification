<https://ptpge.org/v1/printing/standards/color-systems/color-spaces/cielab> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "CIE Lab"@en,
        "L*a*b*"@en,
        "Lab"@en,
        "CIE Lab"@hi,
        "L*a*b*"@hi,
        "Lab"@hi,
        "CIE Lab"@pl,
        "L*a*b*"@pl,
        "Lab"@pl,
        "CIE Lab"@pt,
        "L*a*b*"@pt,
        "Lab"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/color-spaces> ;
    skos:definition "CIE 1976 L*a*b* — et enhedsuafhængigt farverum, der tilnærmer menneskelig farveopfattelse, brugt som referencerum for farvekonvertering mellem enheder og ICC-profiltransformationer."@da,
        "CIE 1976 L*a*b* — ein geräteunabhängiger Farbraum, der die menschliche Farbwahrnehmung näherungsweise abbildet, dient als Referenzraum für Farbkonvertierungen zwischen Geräten und für ICC-Profil-Transformationen."@de,
        "CIE 1976 L*a*b* — a device-independent color space approximating human color perception, used as the reference space for color conversion between devices and ICC profile transformations."@en,
        "Espacio de color independiente del dispositivo definido por la CIE en 1976, que describe los colores como tres coordenadas: L* (luminosidad), a* (rojo–verde) y b* (amarillo–azul). Utilizado como espacio de conexión de perfil en la gestión de color ICC."@es,
        "CIE 1976 L*a*b* — मानव रंग-प्रत्यक्षण का अनुमान लगाने वाला डिवाइस-स्वतंत्र रंग स्पेस, डिवाइसों के बीच रंग रूपांतरण और ICC प्रोफ़ाइल परिवर्तनों के संदर्भ स्पेस के रूप में प्रयुक्त।"@hi,
        "CIE 1976 L*a*b* — 人間の色知覚に近似したデバイス非依存の色空間。デバイス間の色変換およびICCプロファイル変換の参照色空間として使用される。"@ja,
        "CIE 1976 L*a*b* — et enhetsuavhengig fargerom som tilnærmer menneskelig fargepersepsjon, brukt som referanserom for fargekonvertering mellom enheter og ICC-profilkonverteringer."@nb,
        "CIE 1976 L*a*b* — een apparaatonafhankelijke kleurruimte die de menselijke kleurwaarneming benadert, gebruikt als referentieruimte voor kleurconversie tussen apparaten en ICC-profieltransformaties."@nl,
        "CIE 1976 L*a*b* — niezależna od urządzenia przestrzeń barw przybliżająca ludzką percepcję koloru, używana jako przestrzeń odniesienia przy konwersji barw między urządzeniami i transformacjach profili ICC."@pl,
        "CIE 1976 L*a*b* — espaço de cor independente de dispositivo que aproxima a percepção humana da cor, usado como espaço de referência para conversão de cor entre dispositivos e transformações de perfis ICC."@pt,
        "CIE 1976 L*a*b* — en enhetsoberoende färgrymd som approximerar mänsklig färguppfattning, använd som referensrymd för färgkonvertering mellan enheter och ICC-profiltransformationer."@sv,
        "由CIE于1976年定义的与设备无关的色彩空间，用三个坐标描述颜色：L*（亮度）、a*（红–绿）和b*（黄–蓝）。在ICC色彩管理中用作配置文件连接空间。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§CIELAB" ;
    skos:prefLabel "CIELAB"@da,
        "CIELAB"@de,
        "CIELAB"@en,
        "CIELAB"@es,
        "CIELAB"@hi,
        "CIELAB"@ja,
        "CIELAB"@nb,
        "CIELAB"@nl,
        "CIELAB"@pl,
        "CIELAB"@pt,
        "CIELAB"@sv,
        "CIELAB"@zh-Hans ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.14 · p.166",
                "§6.15 · p.168",
                "§6.17 · p.172" ;
            ptpge:mappingRow "crosswalk row 4" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Color",
                "ColorSpaceConversionParams",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/color-spaces/rgb> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "RGB colour space"@en,
        "RGB रंग स्पेस"@hi,
        "przestrzeń barw RGB"@pl,
        "espaço de cor RGB"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/color-spaces> ;
    skos:definition "Generisk RGB-farvemodel, der repræsenterer farver som kombinationer af rødt, grønt og blåt lys — grundlaget for skærme, sensorer og additiv lysgengivelse."@da,
        "Allgemeines RGB-Farbmodell, das Farben als Kombinationen aus Rot-, Grün- und Blaulicht darstellt — die Grundlage für Bildschirme, Sensoren und additive Lichtreproduktion."@de,
        "Generic RGB color model that represents colors as combinations of red, green, and blue light — the basis for screens, sensors, and additive light reproduction."@en,
        "Modelo de color aditivo basado en los componentes Rojo, Verde y Azul, utilizado en pantallas, sensores y archivos digitales. El RGB del trabajo debe convertirse a CMYK antes de imprimir, perdiendo parte del gamut."@es,
        "सामान्य RGB रंग मॉडल जो रंगों को लाल, हरी और नीली रोशनी के संयोजन के रूप में दर्शाता है — स्क्रीन, सेंसर और योगात्मक प्रकाश पुनरुत्पादन का आधार।"@hi,
        "赤、緑、青の光の組み合わせとして色を表現する一般的なRGB色モデル — 画面、センサー、加法混色による光の再現の基礎。"@ja,
        "Generisk RGB-fargemodell som representerer farger som kombinasjoner av rødt, grønt og blått lys — grunnlaget for skjermer, sensorer og additiv lysgjengivelse."@nb,
        "Generiek RGB-kleurmodel dat kleuren voorstelt als combinaties van rood, groen en blauw licht — de basis voor schermen, sensoren en additieve lichtweergave."@nl,
        "Ogólny model barw RGB reprezentujący kolory jako kombinacje światła czerwonego, zielonego i niebieskiego — podstawa ekranów, sensorów i addytywnej reprodukcji światła."@pl,
        "Modelo de cor RGB genérico que representa cores como combinações de luz vermelha, verde e azul — a base de telas, sensores e reprodução aditiva de luz."@pt,
        "Generisk RGB-färgmodell som representerar kulörer som kombinationer av rött, grönt och blått ljus — grunden för skärmar, sensorer och additiv ljusåtergivning."@sv,
        "基于红、绿、蓝分量的加色色彩模型，用于显示器、传感器和数字文件。作业的RGB必须在印刷前转换为CMYK，会损失部分色域。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§RGB" ;
    skos:prefLabel "RGB"@da,
        "RGB"@de,
        "RGB"@en,
        "RGB"@es,
        "RGB"@hi,
        "RGB"@ja,
        "RGB"@nb,
        "RGB"@nl,
        "RGB"@pl,
        "RGB"@pt,
        "RGB"@sv,
        "RGB"@zh-Hans ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.14 · p.166",
                "§6.15 · p.168",
                "§6.17 · p.172" ;
            ptpge:mappingRow "crosswalk row 4" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Color",
                "ColorSpaceConversionParams",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/color-spaces/srgb> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "sRGB colour space"@en,
        "sRGB रंग स्पेस"@hi,
        "przestrzeń barw sRGB"@pl,
        "espaço de cor sRGB"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/color-spaces> ;
    skos:definition "Standard-RGB — IEC 61966-2-1-specifikationen vedtaget i 1996 som standardfarverum for web, skærme, kameraer og forbrugerprintere verden over."@da,
        "Standard-RGB — die 1996 verabschiedete Spezifikation IEC 61966-2-1, weltweit Standard-Farbraum für Web, Monitore, Kameras und Consumer-Drucker."@de,
        "Standard RGB — the IEC 61966-2-1 specification adopted in 1996 as the default color space for the web, monitors, cameras, and consumer printers worldwide."@en,
        "Espacio de color RGB estandarizado para web, vídeo y dispositivos de consumo. Tiene un gamut relativamente estrecho — adecuado para pantalla, limitado para impresión a color amplio."@es,
        "Standard RGB — 1996 में अपनाया गया IEC 61966-2-1 विनिर्देश, दुनिया भर में वेब, मॉनिटर, कैमरों और उपभोक्ता प्रिंटरों का डिफ़ॉल्ट रंग स्पेस।"@hi,
        "Standard RGB — 1996年に採用されたIEC 61966-2-1仕様。世界中のウェブ、モニター、カメラ、コンシューマー向け印刷機の既定の色空間。"@ja,
        "Standard RGB — IEC 61966-2-1-spesifikasjonen vedtatt i 1996 som standard fargerom for web, skjermer, kameraer og forbrukerskrivere verden over."@nb,
        "Standaard-RGB — de IEC 61966-2-1-specificatie, in 1996 aangenomen als standaardkleurruimte voor het web, monitoren, camera's en consumentenprinters wereldwijd."@nl,
        "Standard RGB — specyfikacja IEC 61966-2-1 przyjęta w 1996 r. jako domyślna przestrzeń barw dla sieci, monitorów, aparatów i drukarek konsumenckich na całym świecie."@pl,
        "Standard RGB — a especificação IEC 61966-2-1 adotada em 1996 como espaço de cor padrão para web, monitores, câmeras e impressoras de consumo em todo o mundo."@pt,
        "Standard-RGB — IEC 61966-2-1-specifikationen antagen 1996 som standardfärgrymd för webben, bildskärmar, kameror och konsumentskrivare världen över."@sv,
        "针对网络、视频和消费设备标准化的RGB色彩空间。色域相对较窄——适合屏幕，对宽色域印刷有限。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§SRGB" ;
    skos:prefLabel "sRGB"@da,
        "sRGB"@de,
        "sRGB"@en,
        "sRGB"@es,
        "sRGB"@hi,
        "sRGB"@ja,
        "sRGB"@nb,
        "sRGB"@nl,
        "sRGB"@pl,
        "sRGB"@pt,
        "sRGB"@sv,
        "sRGB"@zh-Hans ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.14 · p.166",
                "§6.15 · p.168",
                "§6.17 · p.172" ;
            ptpge:mappingRow "crosswalk row 4" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Color",
                "ColorSpaceConversionParams",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/hexachrome> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "Hexachrome (6-colour)"@en,
        "Hexachrome"@hi,
        "Hexachrome"@pl,
        "Hexachrome"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems> ;
    skos:definition "Pantones seksfarvesystem for udvidet farveomfang (CMYK + orange + grøn). Giver et bredere farveomfang end CMYK alene og fanger cirka 90 % af Pantones staffagefarver. Historisk navn; mindre almindeligt i dag, men bruges stadig i udvalgt eksklusiv produktion."@da,
        "Pantones Sechsfarben-Extended-Gamut-Drucksystem (CMYK + Orange + Grün). Bietet einen breiteren Farbraum als reines CMYK."@de,
        "Pantone's six-color extended-gamut printing system (CMYK + Orange + Green). Provides a wider color range than CMYK alone, capturing approximately 90% of Pantone solid colors. Historical name; less common today but still used in select high-end production."@en,
        "El sistema de impresión de gama extendida de seis colores de Pantone (CMYK + Naranja + Verde). Ofrece una gama más amplia que el CMYK solo, capturando aproximadamente el 90% de los colores sólidos Pantone. Nombre histórico; menos común hoy pero aún usado en producción selecta de gama alta."@es,
        "Pantone की छह-रंग विस्तारित-गैमट मुद्रण प्रणाली (CMYK + नारंगी + हरा)। अकेले CMYK से व्यापक रंग-सीमा, लगभग 90% Pantone ठोस रंगों को समेटती है। ऐतिहासिक नाम; आज कम आम, पर चुनिंदा हाई-एंड उत्पादन में अब भी प्रयुक्त।"@hi,
        "Pantone の6色拡張ガモット印刷システム（CMYK＋オレンジ＋グリーン）。CMYK 単独より広い色域を持ち、Pantone ソリッドカラーの約90%を再現する。歴史的な名称で、今日では少ないが、一部のハイエンド生産で今も使われる。"@ja,
        "Pantones 6-fargers utvidet gamut-trykksystem (CMYK + Oransje + Grønn). Gir et bredere fargeomfang enn CMYK alene, fanger ~90% av Pantones solide farger. Historisk navn; mindre vanlig i dag, men fortsatt brukt i utvalgte high-end produksjoner."@nb,
        "Pantones zeskleurensysteem voor uitgebreid gamma (CMYK + oranje + groen). Geeft een breder kleurbereik dan CMYK alleen en vangt circa 90% van de Pantone-steunkleuren. Historische naam; vandaag minder gangbaar, maar nog gebruikt in geselecteerde high-end productie."@nl,
        "Sześciokolorowy system druku o rozszerzonym gamucie firmy Pantone (CMYK + pomarańcz + zieleń). Daje szerszy zakres barw niż sam CMYK, oddając około 90% pełnych kolorów Pantone. Nazwa historyczna; dziś rzadziej spotykana, lecz wciąż używana w wybranej produkcji z wyższej półki."@pl,
        "Sistema de impressão de gamut estendido de seis cores da Pantone (CMYK + Laranja + Verde). Oferece uma gama de cores mais ampla que o CMYK sozinho, capturando aproximadamente 90 % das cores sólidas Pantone. Nome histórico; menos comum hoje, mas ainda usado em produção de alto nível selecionada."@pt,
        "Pantones sexfärgssystem för utökad färgomfattning (CMYK + orange + grönt). Ger bredare färgomfång än enbart CMYK och fångar cirka 90 % av Pantones dekorfärger. Historiskt namn; mindre vanligt i dag men används fortfarande i utvald exklusiv produktion."@sv,
        "Pantone 的六色扩展色域印刷系统（CMYK+橙+绿）。色域比单纯 CMYK 更宽，可再现约90%的 Pantone 实色。属历史名称；如今较少见，但仍用于部分高端生产。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§HEXACHROME" ;
    skos:prefLabel "Hexachrome (6-farve)"@da,
        "Hexachrome (6-farbig)"@de,
        "Hexachrome (6-color)"@en,
        "Hexachrome (6-color)"@es,
        "Hexachrome (6-रंग)"@hi,
        "Hexachrome (6-color)"@ja,
        "Hexachrome (6-fargers)"@nb,
        "Hexachrome (6-kleuren)"@nl,
        "Hexachrome (6 kolorów)"@pl,
        "Hexachrome (6 cores)"@pt,
        "Hexachrome (6-färg)"@sv,
        "Hexachrome (6-color)"@zh-Hans ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.14 · p.166",
                "§6.15 · p.168",
                "§6.17 · p.172" ;
            ptpge:mappingRow "crosswalk row 4" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Color",
                "ColorSpaceConversionParams",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/pantone-touch7> a skos:Concept ;
    dcterms:created "2026-05-19T23:30:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems> ;
    skos:definition "Pantones 7-farvebibliotek for udvidet farveomfang (cyan, magenta, gul, sort, orange, grøn, violet). Ofte brugt som den praktiske implementering af CMYK+OGV i emballage- og kommercielt tryk."@da,
        "Pantones erweiterter Gamut 7-Farben-Farbbibliothek (Cyan, Magenta, Gelb, Schwarz, Orange, Grün, Violett)."@de,
        "Pantone's extended-gamut 7-color color library (Cyan, Magenta, Yellow, Black, Orange, Green, Violet). Often used as the practical implementation of CMYK+OGV across packaging and commercial print."@en,
        "La biblioteca de gama extendida de 7 colores de Pantone (Cian, Magenta, Amarillo, Negro, Naranja, Verde, Violeta). A menudo la implementación práctica de CMYK+OGV en packaging e impresión comercial."@es,
        "Pantone का विस्तारित-गैमट 7-रंग पुस्तकालय (सायन, मैजेंटा, पीला, काला, नारंगी, हरा, बैंगनी)। पैकेजिंग और व्यावसायिक प्रिंट में CMYK+OGV के व्यावहारिक कार्यान्वयन के रूप में प्रायः प्रयुक्त।"@hi,
        "Pantone の7色拡張ガモットカラーライブラリ（シアン、マゼンタ、イエロー、ブラック、オレンジ、グリーン、バイオレット）。パッケージや商業印刷における CMYK+OGV の実務的な実装としてよく使われる。"@ja,
        "Pantones utvidet-gamut 7-fargers fargebibliotek (Cyan, Magenta, Gul, Sort, Oransje, Grønn, Fiolett). Ofte brukt som praktisk implementasjon av CMYK+OGV på tvers av emballasje og kommersielt trykk."@nb,
        "Pantones 7-kleurenbibliotheek voor uitgebreid gamma (cyaan, magenta, geel, zwart, oranje, groen, violet). Vaak gebruikt als de praktische implementatie van CMYK+OGV in verpakkings- en commercieel drukwerk."@nl,
        "Biblioteka barw Pantone o rozszerzonym gamucie w 7 kolorach (cyjan, magenta, żółty, czarny, pomarańcz, zieleń, fiolet). Często używana jako praktyczna implementacja CMYK+OGV w opakowaniach i druku komercyjnym."@pl,
        "Biblioteca de cores de gamut estendido de 7 cores da Pantone (Ciano, Magenta, Amarelo, Preto, Laranja, Verde, Violeta). Muitas vezes usada como implementação prática de CMYK+OGV em embalagens e impressão comercial."@pt,
        "Pantones 7-färgsbibliotek för utökad färgomfattning (cyan, magenta, gult, svart, orange, grönt, violett). Ofta använt som den praktiska implementationen av CMYK+OGV inom förpacknings- och civiltryck."@sv,
        "Pantone 的7色扩展色域色库（青、品红、黄、黑、橙、绿、紫）。常作为包装与商业印刷中 CMYK+OGV 的实际实施方案。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§PANTONE-TOUCH-7" ;
    skos:prefLabel "Pantone Touch 7"@da,
        "Pantone Touch 7"@de,
        "Pantone Touch 7"@en,
        "Pantone Touch 7"@es,
        "Pantone Touch 7"@hi,
        "Pantone Touch 7"@ja,
        "Pantone Touch 7"@nb,
        "Pantone Touch 7"@nl,
        "Pantone Touch 7"@pl,
        "Pantone Touch 7"@pt,
        "Pantone Touch 7"@sv,
        "Pantone Touch 7"@zh-Hans ;
