            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/paper-size-standards/iso-216-paper-sizes> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "A series sizes"@en,
        "DIN 476"@en,
        "ISO 216"@en,
        "A श्रृंखला आकार"@hi,
        "DIN 476"@hi,
        "ISO 216"@hi,
        "DIN 476"@pl,
        "ISO 216"@pl,
        "formaty serii A"@pl,
        "DIN 476"@pt,
        "ISO 216"@pt,
        "tamanhos série A"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/paper-size-standards> ;
    skos:definition "Internationale papirformater efter ISO 216 (A-, B- og C-serierne) baseret på proportionen 1:√2, som bevarer formatet når ark halveres — bruges verden over uden for Nordamerika."@da,
        "Internationale Papierformate nach ISO 216 (A-Reihe, B-Reihe, C-Reihe), basieren auf einem Seitenverhältnis von 1:√2, das die Proportionen beim Halbieren des Bogens beibehält — weltweit außerhalb Nordamerikas verwendet."@de,
        "ISO 216 international paper sizes (A series, B series, C series) based on a 1:√2 aspect ratio that preserves proportions when sheets are halved — used worldwide outside North America."@en,
        "Norma internacional ISO 216 que define las series A y B de tamaños de papel — utilizada mundialmente fuera de Norteamérica."@es,
        "ISO 216 अंतरराष्ट्रीय काग़ज़ आकार (A, B, C श्रृंखला) 1:√2 अनुपात पर आधारित, जो शीट आधी करने पर अनुपात बनाए रखता है — उत्तर अमेरिका के बाहर दुनिया भर में प्रयुक्त।"@hi,
        "ISO 216国際用紙寸法（Aシリーズ、Bシリーズ、Cシリーズ）。シートを半分にしたときに比率が保たれる1:√2のアスペクト比に基づき、北米以外の世界中で使用される。"@ja,
        "ISO 216 internasjonale papirstørrelser (A-, B-, C-serien) basert på 1:√2-forhold som bevarer proporsjonene når ark deles i to — brukt globalt utenom Nord-Amerika."@nb,
        "Internationale papierformaten volgens ISO 216 (A-, B- en C-reeksen), gebaseerd op de verhouding 1:√2 die de vorm behoudt wanneer vellen worden gehalveerd — wereldwijd gebruikt buiten Noord-Amerika."@nl,
        "Międzynarodowe formaty papieru ISO 216 (seria A, seria B, seria C) oparte na proporcji 1:√2, która zachowuje kształt przy połowieniu arkusza — używane na całym świecie poza Ameryką Północną."@pl,
        "Tamanhos de papel internacionais ISO 216 (séries A, B e C) baseados numa proporção 1:√2 que preserva as proporções quando as folhas são divididas ao meio — usados em todo o mundo fora da América do Norte."@pt,
        "Internationella pappersformat enligt ISO 216 (A-, B- och C-serierna) baserade på proportionen 1:√2 som bevarar formatet när ark halveras — används världen över utanför Nordamerika."@sv,
        "定义A和B系列纸张尺寸的国际ISO 216标准 —— 在北美以外全球使用。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§ISO-216-PAPER-SIZES" ;
    skos:prefLabel "ISO 216-papirformater"@da,
        "ISO 216 Paper Sizes"@de,
        "ISO 216 Paper Sizes"@en,
        "Tamaños ISO 216"@es,
        "ISO 216 काग़ज़ आकार"@hi,
        "ISO 216 Paper Sizes"@ja,
        "ISO 216 Paper Sizes"@nb,
        "ISO 216-papierformaten"@nl,
        "Formaty ISO 216"@pl,
        "Tamanhos de papel ISO 216"@pt,
        "ISO 216-pappersformat"@sv,
        "ISO 216尺寸"@zh-Hans ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 2" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/paper-size-standards/iso-269-envelope-sizes> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "C series envelopes"@en,
        "ISO 269"@en,
        "C श्रृंखला लिफ़ाफ़े"@hi,
        "ISO 269"@hi,
        "ISO 269"@pl,
        "koperty serii C"@pl,
        "ISO 269"@pt,
        "envelopes série C"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/paper-size-standards> ;
    skos:definition "Kuvertformater efter ISO 269 (DL, C-serien) designet til at rumme ISO 216-ark i foldet form — DL rummer A4 foldet i tre dele, C5 rummer A4 foldet på midten, C4 rummer A4 ufoldet."@da,
        "Briefumschlagformate nach ISO 269 (DL, C-Reihe), entwickelt, um ISO-216-Papierbogen gefalzt aufzunehmen — DL fasst A4 in Drittel gefaltet, C5 fasst A4 in der Hälfte gefaltet, C4 fasst A4 ungefalzt."@de,
        "ISO 269 envelope sizes (DL, C-series) designed to hold ISO 216 paper sheets when folded — DL holds A4 folded in thirds, C5 holds A4 folded in half, C4 holds A4 unfolded."@en,
        "Norma internacional ISO 269 que define la serie C de sobres, dimensionados para contener hojas de la serie A correspondiente."@es,
        "मुड़ी ISO 216 काग़ज़ शीटों को रखने के लिए डिज़ाइन किए ISO 269 लिफ़ाफ़ा आकार (DL, C-श्रृंखला) — DL में तीन तह A4, C5 में आधा मुड़ा A4, C4 में बिना मुड़ा A4।"@hi,
        "ISO 269封筒寸法（DL、Cシリーズ）。ISO 216用紙シートを折り畳んで収納するように設計されている — DLはA4を三つ折りに、C5はA4を二つ折りに、C4はA4を折らずに収納する。"@ja,
        "ISO 269 konvoluttstørrelser (DL, C-serien) designet til å romme ISO 216-papirark når de er brettet — DL rommer A4 brettet i tre, C5 rommer A4 brettet i to, C4 rommer A4 ubrettet."@nb,
        "Envelopformaten volgens ISO 269 (DL, C-reeks), ontworpen om gevouwen ISO 216-vellen te bevatten — DL bevat een in drieën gevouwen A4, C5 een doormidden gevouwen A4, C4 een ongevouwen A4."@nl,
        "Formaty kopert ISO 269 (DL, seria C) zaprojektowane do arkuszy ISO 216 po złożeniu — DL mieści A4 złożone na trzy, C5 mieści A4 złożone na pół, C4 mieści A4 bez składania."@pl,
        "Tamanhos de envelope ISO 269 (DL, série C) projetados para conter folhas ISO 216 dobradas — o DL comporta A4 dobrado em três, o C5 comporta A4 dobrado ao meio, o C4 comporta A4 sem dobrar."@pt,
        "Kuvertformat enligt ISO 269 (DL, C-serien) designade att rymma ISO 216-ark i vikt form — DL rymmer A4 vikt i tre delar, C5 rymmer A4 vikt på mitten, C4 rymmer A4 ovikt."@sv,
        "定义C系列信封的国际ISO 269标准，按对应A系列纸张尺寸设计。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§ISO-269-ENVELOPE-SIZES" ;
    skos:prefLabel "ISO 269-kuvertformater"@da,
        "ISO 269 Envelope Sizes"@de,
        "ISO 269 Envelope Sizes"@en,
        "Tamaños ISO 269 (Sobres)"@es,
        "ISO 269 लिफ़ाफ़ा आकार"@hi,
        "ISO 269 Envelope Sizes"@ja,
        "ISO 269 Envelope Sizes"@nb,
        "ISO 269-envelopformaten"@nl,
        "Formaty kopert ISO 269"@pl,
        "Tamanhos de envelope ISO 269"@pt,
        "ISO 269-kuvertformat"@sv,
        "ISO 269 (信封)"@zh-Hans ;
