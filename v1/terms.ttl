        "Vollflächiger Lack"@de,
        "Flood Varnishing"@en,
        "Flood Varnishing"@es,
        "फ़्लड वार्निश"@hi,
        "Flood Varnishing"@ja,
        "Hellakkering"@nb,
        "Volvlaks lakken"@nl,
        "Lakierowanie pełne"@pl,
        "Verniz total"@pt,
        "Heltäckande lackering"@sv,
        "Flood Varnishing"@zh-Hans ;
