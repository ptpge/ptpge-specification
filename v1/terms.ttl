    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 93.5 ;
            ptpge:aspectRatio 1.2941 ;
            ptpge:height 11.0 ;
            ptpge:standard "ANSI" ;
            ptpge:unit "in" ;
            ptpge:width 8.5 ] ;
    ptpge:level "element" ;
