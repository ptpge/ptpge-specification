    skos:prefLabel "Leveringsmetoder"@da,
        "Versandarten"@de,
        "Delivery Methods"@en,
        "Métodos de entrega"@es,
        "डिलीवरी विधियाँ"@hi,
        "配送方法"@ja,
        "Leveringsmetoder"@nb,
        "Leveringsmethoden"@nl,
        "Sposoby dostawy"@pl,
        "Métodos de entrega"@pt,
