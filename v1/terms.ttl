        "Kenmerken"@nl,
        "Cechy"@pl,
        "Características"@pt,
        "Egenskaper"@sv,
        "特性"@zh-Hans ;
    ptpge:level "group" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

