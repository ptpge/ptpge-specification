        "Steunkleur"@nl,
        "Kolor dodatkowy"@pl,
        "Cor especial"@pt,
        "Dekorfärg"@sv,
        "专色"@zh-Hans ;
    skos:related <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems> ;
