    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/variables/substrate/substrate-thickness> a skos:Concept ;
    dcterms:created "2026-08-22T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Dicke"@de,
        "Materialdicke"@de,
        "Plattenstärke"@de,
        "Board Thickness"@en,
        "Caliper"@en,
        "Gauge"@en,
        "Material Thickness"@en,
        "Panel Thickness"@en,
        "Thickness"@en,
        "micron (µm)"@en,
        "mil"@en,
        "point (pt)"@en,
        "कैलिपर"@hi,
        "गेज"@hi,
        "पैनल की मोटाई"@hi,
        "बोर्ड की मोटाई"@hi,
        "माइक्रोन"@hi,
        "मोटाई"@hi,
        "सामग्री की मोटाई"@hi,
        "Folietykkelse"@nb,
        "Materialtykkelse"@nb,
        "Platetykkelse"@nb,
        "Tykkelse"@nb,
        "gauge"@pl,
        "grubość"@pl,
        "grubość materiału"@pl,
        "grubość panelu"@pl,
        "grubość płyty"@pl,
        "kaliber"@pl,
        "mikron (µm)"@pl,
        "mil"@pl,
        "punkt (pt)"@pl,
        "calibre"@pt,
        "espessura"@pt,
        "espessura da chapa"@pt,
        "espessura do material"@pt,
        "espessura do painel"@pt,
        "mícron"@pt ;
    skos:broader <https://ptpge.org/v1/variables/substrate> ;
    skos:definition "Konfigurerbar akse: Substrattykkelse. Et trykt produkt konfigureres langs denne variabel (numerisk, enkeltvalg, i mm; decimaler tilladt). Kanonisk enhed er millimeter; andre brancheenheder konverterer eksakt — tommer (3/16 in = 4,76 mm), amerikanske caliper-punkter (14 pt = 0,356 mm), mil (1 mil = 0,0254 mm), mikron (75 µm = 0,075 mm) og filmgauge (100 gauge = 1 mil)."@da,
        "Konfigurierbare Achse: Materialstärke. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (numerisch, Einfachauswahl, in mm; Dezimalstellen erlaubt). Kanonische Einheit ist Millimeter; andere Handelseinheiten konvertieren exakt — Zoll (3/16 in = 4,76 mm), US-Caliper-Punkte (14 pt = 0,356 mm), mil (1 mil = 0,0254 mm), Mikrometer (75 µm = 0,075 mm) und Film-Gauge (100 gauge = 1 mil)."@de,
        "Configurable axis: Substrate Thickness. A printed product is configured along this variable (numeric, single selection, in mm; decimals allowed). Canonical unit is millimetres; other trade units convert exactly — inches (3/16 in = 4.76 mm), US caliper points (14 pt = 0.014 in = 0.356 mm), mil (1 mil = 0.0254 mm), microns (75 µm = 0.075 mm) and film gauge (100 gauge = 1 mil). Typical values: foam board 3–10 mm, aluminium composite 2–4 mm, acrylic 2–10 mm, plywood 3–18 mm, magnetic foil 0.3–1 mm."@en,
        "Eje configurable: Grosor del sustrato. Un producto impreso se configura a lo largo de esta variable (numérico, selección única, en mm; se permiten decimales). La unidad canónica es el milímetro; otras unidades del sector convierten exactamente — pulgadas (3/16 in = 4,76 mm), puntos de calibre estadounidenses (14 pt = 0,356 mm), mil (1 mil = 0,0254 mm), micras (75 µm = 0,075 mm) y galga de película (100 gauge = 1 mil)."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: सब्सट्रेट की मोटाई। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (संख्यात्मक, एकल चयन, मिमी में; दशमलव मान्य)। मानक इकाई मिलीमीटर है; बिरादरी की अन्य इकाइयाँ सटीक रूपांतरित होती हैं — इंच (3/16 इंच = 4.76 मिमी), US कैलिपर पॉइंट (14 pt = 0.014 इंच = 0.356 मिमी), मिल (1 मिल = 0.0254 मिमी), माइक्रोन (75 µm = 0.075 मिमी) और फ़िल्म गेज (100 गेज = 1 मिल)। सामान्य मान: फ़ोम बोर्ड 3–10 मिमी, एल्युमिनियम कंपोज़िट 2–4 मिमी, ऐक्रेलिक 2–10 मिमी, प्लाईवुड 3–18 मिमी, चुंबकीय शीट 0.3–1 मिमी।"@hi,
        "構成可能な軸：基材厚。印刷物はこの変数に沿って構成される（数値、単一選択、mm単位、小数可）。正準単位はミリメートル。他の業界単位は正確に換算される — インチ（3/16 in = 4.76 mm）、米国キャリパーポイント（14 pt = 0.356 mm）、ミル（1 mil = 0.0254 mm）、ミクロン（75 µm = 0.075 mm）、フィルムゲージ（100 gauge = 1 mil）。"@ja,
        "Konfigurerbar akse: Substrattykkelse. Et trykkprodukt konfigureres langs denne variabelen (numerisk, enkeltvalg, i mm; desimaler tillatt). Kanonisk enhet er millimeter; andre bransjeenheter konverterer eksakt — tommer (3/16 in = 4,76 mm), amerikanske caliper-punkter (14 pt = 0,356 mm), mil (1 mil = 0,0254 mm), mikron (75 µm = 0,075 mm) og film-gauge (100 gauge = 1 mil). Typiske verdier: skumplate 3–10 mm, aluminiumskompositt 2–4 mm, akryl 2–10 mm, kryssfiner 3–18 mm, magnetfolie 0,3–1 mm."@nb,
        "Configureerbare as: Substraatdikte. Een drukproduct wordt langs deze variabele geconfigureerd (numeriek, enkelvoudig, in mm; decimalen toegestaan). Canonieke eenheid is millimeter; andere handelseenheden converteren exact — inch (3/16 in = 4,76 mm), Amerikaanse caliper-punten (14 pt = 0,356 mm), mil (1 mil = 0,0254 mm), micron (75 µm = 0,075 mm) en filmgauge (100 gauge = 1 mil)."@nl,
        "Oś konfigurowalna: Grubość podłoża. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (numeryczna, wybór pojedynczy, w mm; dozwolone ułamki dziesiętne). Jednostka kanoniczna to milimetry; inne jednostki branżowe przeliczają się dokładnie — cale (3/16 in = 4,76 mm), amerykańskie punkty grubości (14 pt = 0,014 in = 0,356 mm), mil (1 mil = 0,0254 mm), mikrony (75 µm = 0,075 mm) i gauge folii (100 gauge = 1 mil). Typowe wartości: płyta piankowa 3–10 mm, aluminium kompozytowe 2–4 mm, akryl 2–10 mm, sklejka 3–18 mm, folia magnetyczna 0,3–1 mm."@pl,
        "Eixo configurável: Espessura do Substrato. Um impresso é configurado ao longo desta variável (numérico, seleção única, em mm; decimais permitidos). A unidade canônica é o milímetro; outras unidades do ofício convertem-se exatamente — polegadas (3/16 in = 4,76 mm), pontos de calibre norte-americanos (14 pt = 0,014 in = 0,356 mm), mil (1 mil = 0,0254 mm), mícrons (75 µm = 0,075 mm) e gauge de filme (100 gauge = 1 mil). Valores típicos: foam board 3–10 mm, ACM 2–4 mm, acrílico 2–10 mm, compensado 3–18 mm, manta magnética 0,3–1 mm."@pt,
        "Konfigurerbar axel: Substrattjocklek. En trycksak konfigureras längs denna variabel (numerisk, enkelval, i mm; decimaler tillåtna). Kanonisk enhet är millimeter; andra branschenheter konverterar exakt — tum (3/16 in = 4,76 mm), amerikanska caliper-punkter (14 pt = 0,356 mm), mil (1 mil = 0,0254 mm), mikron (75 µm = 0,075 mm) och filmgauge (100 gauge = 1 mil)."@sv,
        "可配置轴：基材厚度。印刷品沿此变量进行配置（数值，单选，以毫米计；允许小数）。规范单位为毫米；其他行业单位可精确换算——英寸（3/16 in = 4.76 mm）、美制卡尺点（14 pt = 0.356 mm）、密耳（1 mil = 0.0254 mm）、微米（75 µm = 0.075 mm）和薄膜规格（100 gauge = 1 mil）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:SB§SUBSTRATE-THICKNESS" ;
    skos:prefLabel "Substrattykkelse"@da,
        "Materialstärke"@de,
        "Substrate Thickness"@en,
        "Grosor del sustrato"@es,
        "सब्सट्रेट की मोटाई"@hi,
        "基材厚"@ja,
        "Substrattykkelse"@nb,
        "Substraatdikte"@nl,
        "Grubość podłoża"@pl,
        "Espessura do substrato"@pt,
        "Substrattjocklek"@sv,
        "基材厚度"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "numeric" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvor tyk?"@da,
        "Wie dick?"@de,
        "How thick?"@en,
        "¿Qué grosor?"@es,
        "कितना मोटा?"@hi,
        "厚さは？"@ja,
        "Hvor tykk?"@nb,
        "Hoe dik?"@nl,
        "Jaka grubość?"@pl,
        "Que espessura?"@pt,
        "Hur tjock?"@sv,
        "多厚？"@zh-Hans ;
    ptpge:rangeMax 100.0 ;
    ptpge:rangeMin 0.01 ;
    ptpge:scope "product" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 34" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:unit "mm" ;
    ptpge:version "2026-08-22" .

<https://ptpge.org/v1/printing/configurations/formats/arch-series> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats> ;
    skos:definition "Arkitektpapirformater (Arch A til Arch E3), der bruges i nordamerikanske arkitekt- og ingeniørtegninger, med proportioner optimeret til teknisk tegning."@da,
        "Architekten-Papierformate (Arch A bis Arch E3), eingesetzt für nordamerikanische Architektur- und Konstruktionszeichnungen, mit für das technische Zeichnen optimierten Proportionen."@de,
        "Architectural paper sizes (Arch A through Arch E3) used in North American architectural and engineering drawings, with proportions optimized for technical drafting."@en,
        "Tamaños arquitectónicos de papel (Arch A a Arch E3) utilizados en planos arquitectónicos y de ingeniería en Norteamérica, con proporciones optimizadas para dibujo técnico."@es,
        "उत्तर अमेरिकी वास्तु और इंजीनियरिंग चित्रों में प्रयुक्त वास्तु काग़ज़ आकार (Arch A से Arch E3), तकनीकी ड्राफ़्टिंग के लिए अनुकूलित अनुपात।"@hi,
        "建築用用紙寸法（Arch A〜Arch E3）。北米の建築・エンジニアリング図面で使用され、技術製図に最適化された比率。"@ja,
        "Arkitekturpapirstørrelser (Arch A til Arch E3) brukt i nordamerikanske arkitektur- og ingeniørtegninger, med proporsjoner optimalisert for teknisk tegning."@nb,
        "Architectenpapierformaten (Arch A tot Arch E3), gebruikt in Noord-Amerikaanse architectuur- en engineeringtekeningen, met verhoudingen geoptimaliseerd voor technisch tekenen."@nl,
        "Architektoniczne formaty papieru (Arch A do Arch E3) używane w północnoamerykańskich rysunkach architektonicznych i inżynierskich, o proporcjach zoptymalizowanych pod kreślenie techniczne."@pl,
        "Tamanhos de papel arquitetônicos (Arch A a Arch E3) usados em desenhos arquitetônicos e de engenharia na América do Norte, com proporções otimizadas para desenho técnico."@pt,
        "Arkitektpappersformat (Arch A till Arch E3) som används i nordamerikanska arkitekt- och ingenjörsritningar, med proportioner optimerade för tekniskt ritande."@sv,
        "用于北美建筑和工程图纸的建筑纸张尺寸（Arch A到Arch E3），比例针对技术制图优化。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-a>,
        <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-b>,
        <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-c>,
        <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-d>,
        <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-e>,
        <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-e1>,
        <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-e2>,
        <https://ptpge.org/v1/printing/configurations/formats/arch-series/arch-e3> ;
    skos:notation "P:CF-FMT-ARCH" ;
    skos:prefLabel "Arch-serien"@da,
        "Arch-Reihe"@de,
        "Arch Series"@en,
        "Serie Arch (Arquitectónica)"@es,
        "Arch सीरीज़"@hi,
        "Arch判"@ja,
        "Arch-serie"@nb,
        "Arch-reeks"@nl,
        "Seria Arch"@pl,
        "Série Arch"@pt,
        "Arch-serien"@sv,
        "建筑系列（Arch）"@zh-Hans ;
    skos:scopeNote "Insgesamt acht Größen. Arch A bis Arch E1 folgen der klassischen Architektenstaffelung; Arch E2 und E3 sind weniger verbreitete Konstruktionsformate. Die Seitenverhältnisse betragen 4:3 oder 3:2 — für technische Zeichnungen besser geeignet als das ANSI-Verhältnis von 1:1,29."@de,
        "Eight sizes total. Arch A through Arch E1 follow the standard architectural progression; Arch E2 and E3 are less common engineering sizes. Aspect ratios are 4:3 or 3:2 — better suited to technical drawings than the ANSI 1:1.29 ratio."@en,
        "Ocho tamaños en total. De Arch A a Arch E1 siguen la progresión arquitectónica estándar; Arch E2 y E3 son tamaños de ingeniería menos comunes. Las relaciones de aspecto son 4:3 o 3:2 — más adecuadas para dibujo técnico que la 1:√2 de la serie ISO."@es,
        "कुल आठ आकार। Arch A से Arch E1 मानक वास्तु क्रम का पालन करते हैं; Arch E2 और E3 कम प्रचलित इंजीनियरिंग आकार हैं। अनुपात 4:3 या 3:2 — ANSI के 1:1.29 अनुपात से तकनीकी चित्रों के लिए बेहतर।"@hi,
        "全部で8サイズ。Arch A〜Arch E1は標準的な建築用進行に従う。Arch E2およびE3は使用頻度が低いエンジニアリングサイズ。アスペクト比は4:3または3:2 — ANSIの1:1.29比率より技術図面に適する。"@ja,
        "Åtte størrelser totalt. Arch A til Arch E1 følger standard arkitekturprogresjonen; Arch E2 og E3 er mindre vanlige ingeniørstørrelser. Sideforhold er 4:3 eller 3:2 — bedre egnet for tekniske tegninger enn ANSI 1:1,29."@nb,
        "Oito tamanhos no total. Arch A a Arch E1 seguem a progressão arquitetônica padrão; Arch E2 e E3 são tamanhos de engenharia menos comuns. As proporções são 4:3 ou 3:2 — mais adequadas a desenhos técnicos que a proporção ANSI de 1:1,29."@pt,
        "共八种尺寸。Arch A到Arch E1遵循标准建筑级数；Arch E2和E3是较不常见的工程尺寸。宽高比为4:3或3:2——比ISO的1:√2更适合技术制图。"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/configurations/formats/rollups> a skos:Concept ;
    dcterms:created "2026-08-21T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats> ;
    skos:definition "Standardkassettestørrelser til udtrækkelige roll-up-bannerstandere, europæisk (cm) og amerikansk (in) familie. Hvert format angiver den synlige grafik i monteret stand; tryklængden får et kassettespecifikt monteringstillæg (produktionsgeometri, publiceret nominelt som mountingAllowance på hvert format)."@da,
        "Standard-Kassettengrößen für ausziehbare Roll-up-Bannerdisplays, europäische (cm) und US-amerikanische (in) Familien. Jedes Format benennt die sichtbare Grafik im montierten Zustand; die Drucklänge erhält eine kassettenspezifische Montagezugabe (Produktionsgeometrie, nominell als mountingAllowance je Format veröffentlicht)."@de,
        "Standard cassette sizes for retractable roll-up banner stands, European (cm) and US (in) families. Each format names the visible graphic once mounted; the printed length adds a cassette-specific mounting allowance (production geometry, published nominally as mountingAllowance on each format)."@en,
        "Tamaños de casete estándar para expositores enrollables retráctiles, familias europea (cm) y estadounidense (in). Cada formato nombra el gráfico visible una vez montado; la longitud impresa añade un margen de montaje específico del casete (geometría de producción, publicada nominalmente como mountingAllowance en cada formato)."@es,
        "रिट्रैक्टेबल रोल-अप बैनर स्टैंड के मानक कैसेट आकार, यूरोपीय (सेमी) और US (इंच) परिवार। हर फ़ॉर्मेट लगाने के बाद दिखने वाले ग्राफ़िक का नाम है; छपी लंबाई में कैसेट-विशेष माउंटिंग भत्ता जुड़ता है (उत्पादन ज्यामिति, हर फ़ॉर्मेट पर mountingAllowance के रूप में नाममात्र प्रकाशित)।"@hi,
        "引き出し式ロールアップバナースタンドの標準カセットサイズ。欧州（cm）系と米国（in）系。 各判型は設置後に見える印刷面を示す。印刷長にはカセット固有の取付余白が加わる（生産上の寸法。各判型に mountingAllowance として名目値を公開）。"@ja,
        "Standard kassettstørrelser for uttrekkbare roll-up-bannerstativ, europeisk (cm) og amerikansk (in) familie. Hvert format angir den synlige grafikken i montert stand; trykklengden får et kassettspesifikt monteringstillegg (produksjonsgeometri, publisert nominelt som mountingAllowance på hvert format)."@nb,
        "Standaard cassetteformaten voor uittrekbare roll-upbannerdisplays, Europese (cm) en Amerikaanse (in) families. Elk formaat benoemt de zichtbare grafiek in gemonteerde toestand; de druklengte krijgt een cassettespecifieke montagetoeslag (productiegeometrie, nominaal gepubliceerd als mountingAllowance per formaat)."@nl,
        "Standardowe rozmiary kaset zwijanych stojaków roll-up, rodziny europejska (cm) i amerykańska (cale). Każdy format nazywa widoczną grafikę po zamontowaniu; długość druku zwiększa się o naddatek montażowy właściwy dla kasety (geometria produkcyjna, publikowana nominalnie jako mountingAllowance na każdym formacie)."@pl,
        "Tamanhos de cassete padrão para porta-banners retráteis roll-up, famílias europeia (cm) e americana (in). Cada formato nomeia o gráfico visível depois de montado; o comprimento impresso acrescenta uma folga de montagem específica do cassete (geometria de produção, publicada nominalmente como mountingAllowance em cada formato)."@pt,
        "Standardkassettstorlekar för utdragbara roll-up-bannerställ, europeisk (cm) och amerikansk (in) familj. Varje format anger den synliga grafiken i monterat läge; trycklängden får ett kassettspecifikt monteringstillägg (produktionsgeometri, publicerat nominellt som mountingAllowance per format)."@sv,
        "可伸缩易拉宝展架的标准卡匣尺寸，分欧洲（cm）与美国（in）两个系列。 每个规格指安装后可见的画面；印刷长度需加上卡匣专属的安装余量（生产几何尺寸，以 mountingAllowance 在各规格上发布名义值）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-100x200>,
        <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-120x200>,
        <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-150x200>,
        <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-200x200>,
        <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-23-5x80-in>,
        <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-33-5x80-in>,
        <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-47x80-in>,
        <https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-85x200> ;
    skos:notation "P:CF-FMT-RLUP" ;
    skos:prefLabel "Roll-up-formater"@da,
        "Roll-up-Formate"@de,
        "Roll-up Banner Sizes"@en,
        "Formatos de roll-up"@es,
        "रोल-अप बैनर आकार"@hi,
        "ロールアップサイズ"@ja,
        "Roll-up-formater"@nb,
        "Roll-upformaten"@nl,
        "Formaty roll-upów"@pl,
        "Tamanhos de roll-up"@pt,
        "Roll-up-format"@sv,
        "易拉宝尺寸"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
