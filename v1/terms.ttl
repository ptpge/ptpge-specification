            ptpge:sourceElement "ShapeCuttingIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/embellishments/embossing/foil> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Combination embossing"@en,
        "Foil and emboss"@en,
        "Foil emboss"@en,
        "कॉम्बिनेशन एम्बॉसिंग"@hi,
        "फ़ॉइल उभार"@hi,
        "फ़ॉइल एम्बॉस"@hi,
        "फ़ॉइल और एम्बॉस"@hi,
        "Foliepreg"@nb,
        "folia z tłoczeniem"@pl,
        "tłoczenie kombinowane"@pl,
        "hot stamping em relevo"@pt,
        "relevo com hot stamping"@pt,
        "relevo e foil"@pt,
        "relevo metalizado"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/embellishments/embossing> ;
    skos:definition "Prægning kombineret med varmfolieprægning i én operation — reliefet hæves OG dækkes med en metallisk eller pigmenteret folie. Den visuelt mest markante enkeltforædling, ofte brugt på luksusprodukter."@da,
        "Prägung kombiniert mit Heißfolienprägung in einem Arbeitsgang — das Relief ist erhaben UND mit einer metallischen oder pigmentierten Folie bedeckt."@de,
        "Embossing combined with hot-foil stamping in one operation — the relief is raised AND covered with a metallic or pigmented foil. The most visually impactful single embellishment, frequently used on luxury packaging logos."@en,
        "Gofrado combinado con estampación de foil en caliente en una sola operación — el relieve queda elevado Y cubierto con un foil metálico o pigmentado. La ornamentación individual de mayor impacto visual, frecuente en logotipos de packaging de lujo."@es,
        "एक ही क्रिया में एम्बॉसिंग और हॉट-फ़ॉइल स्टैंपिंग — उभार भी और उस पर मेटैलिक या रंजित फ़ॉइल भी। सबसे प्रभावशाली एकल सजावटी प्रभाव, लक्ज़री पैकेजिंग के लोगो पर अक्सर प्रयुक्त।"@hi,
        "エンボスとホットフォイル（箔押し）を1工程で組み合わせる — レリーフを盛り上げ、同時にメタリックまたは顔料箔で覆う。単体の加飾として最も視覚的インパクトが強く、高級パッケージのロゴによく使われる。"@ja,
        "Embossing kombinert med varmfolie-preging i én operasjon — relieffen er hevet OG dekket med en metallisk eller pigmentert folie. Den mest visuelt effektfulle enkeltforedlingen, ofte brukt på luksusemballasje-logoer."@nb,
        "Preging gecombineerd met warmfoliedruk in één bewerking — het reliëf wordt verhoogd ÉN bedekt met een metallic of gepigmenteerde folie. De visueel meest opvallende enkelvoudige veredeling, vaak op luxeproducten."@nl,
        "Tłoczenie połączone z folią na gorąco w jednej operacji — relief jest wypukły I pokryty folią metaliczną lub pigmentowaną. Najbardziej efektowne pojedyncze uszlachetnienie, często stosowane do logo na opakowaniach luksusowych."@pl,
        "Relevo combinado com hot stamping em uma única operação — o relevo é elevado E coberto com foil metálico ou pigmentado. O enobrecimento único de maior impacto visual, muito usado em logotipos de embalagens de luxo."@pt,
        "Prägling kombinerad med varmfoliering i en operation — reliefen är upphöjd OCH täckt med metallisk eller pigmenterad folie. Den visuellt mest slagkraftiga enskilda dekoren, ofta använd på lyxförpackningars logotyper."@sv,
        "压凸与烫印一次完成的组合工艺 — 浮雕既凸起又覆以金属或颜料箔。视觉冲击力最强的单项装饰工艺，常用于奢华包装标志。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§FOIL" ;
    skos:prefLabel "Folieprægning (relief)"@da,
        "Folienhochprägung"@de,
        "Foil Embossing"@en,
        "Relieve con lámina"@es,
        "फ़ॉइल एम्बॉसिंग"@hi,
        "箔エンボス"@ja,
        "Folie-embossing"@nb,
        "Foliepreging (reliëf)"@nl,
        "Tłoczenie z folią"@pl,
        "Relevo com foil"@pt,
        "Folieprägling"@sv,
        "烫箔凸压"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.6 · p.74" ;
            ptpge:mappingRow "crosswalk row 25" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "EmbossingIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ],
        [ dcterms:bibliographicCitation "§4.6 · p.74",
                "§5.6.12 · p.118",
                "§6.32 · p.197" ;
            ptpge:mappingRow "crosswalk row 27" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Embossing",
                "EmbossingIntent",
                "EmbossingParams" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/embellishments/none> a skos:Concept ;
    dcterms:created "2026-09-22T11:55:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-11T10:05:00+00:00"^^xsd:dateTime ;
    skos:altLabel "Uden folie"@da,
        "Uden prægning"@da,
        "Ohne Folie"@de,
        "Ohne Prägung"@de,
        "Ohne Veredelung"@de,
        "No embossing"@en,
        "No finishing effects"@en,
        "No foil"@en,
        "Plain"@en,
        "Sin efectos"@es,
        "Sin estampado"@es,
        "Sin relieve"@es,
        "बिना एम्बॉसिंग"@hi,
        "बिना प्रभाव"@hi,
        "बिना फ़ॉइल"@hi,
        "सादा"@hi,
        "エンボスなし"@ja,
        "箔なし"@ja,
        "Uten effekter"@nb,
        "Uten folie"@nb,
        "Uten preging"@nb,
        "Zonder folie"@nl,
        "Zonder preging"@nl,
        "bez folii"@pl,
        "bez tłoczenia"@pl,
        "liso"@pt,
        "sem efeitos"@pt,
        "sem foil"@pt,
        "sem relevo"@pt,
        "Utan folie"@sv,
        "Utan prägling"@sv,
        "不压凹凸"@zh-Hans,
        "不烫金"@zh-Hans ;
    skos:broader <https://ptpge.org/v1/printing/features/embellishments> ;
    skos:definition "Ingen forædling på fladen: ingen folie, prægning eller punkteffekt. Et udtrykkeligt udsagn, forskelligt fra at lade aksen stå uspecificeret (hvilket lader leverandøren foreslå en effekt). Står alene: tåler ingen anden forædlingsværdi på samme flade."@da,
        "Keine Veredelung auf der Seite: keine Folie, keine Prägung, kein Spot-Effekt. Eine ausdrückliche Aussage, im Unterschied zur offen gelassenen Achse (bei der der Anbieter einen Effekt vorschlagen darf). Steht allein: duldet keinen anderen Veredelungswert auf derselben Seite."@de,
        "No embellishment on the face: no foil, embossing, debossing or spot effect. An explicit statement, distinct from leaving the axis unspecified (which lets the vendor propose an effect). Stands alone: it tolerates no other embellishment value on the same face."@en,
        "Sin ornamentación en la cara: sin estampado, relieve, bajorrelieve ni efecto localizado. Una declaración explícita, distinta de dejar el eje sin especificar (que permite al proveedor proponer un efecto). Va sola: no tolera otro valor de ornamentación en la misma cara."@es,
        "सतह पर कोई सजावटी प्रभाव नहीं: न फ़ॉइल, न एम्बॉसिंग, न डिबॉसिंग, न स्पॉट प्रभाव। एक स्पष्ट कथन, अक्ष को अनिर्दिष्ट छोड़ने से अलग (जो विक्रेता को प्रभाव सुझाने देता है)। अकेला रहता है: उसी सतह पर कोई अन्य एम्बेलिशमेंट मान सहन नहीं करता।"@hi,
        "面に加飾を施さない：箔、エンボス、デボス、スポット効果なし。軸を未指定のままにするのとは異なる明示的な指定。単独値：同じ面に他の加飾値を許さない。"@ja,
        "Ingen dekor på flaten: verken folie, preging eller punkteffekt. Et eksplisitt utsagn, forskjellig fra å la aksen stå uspesifisert (som lar leverandøren foreslå en effekt). Står alene: tåler ingen annen dekor-verdi på samme flate."@nb,
        "Geen veredeling op het vlak: geen folie, preging of spot-effect. Een expliciete uitspraak, anders dan de as open laten (waarbij de leverancier een effect mag voorstellen). Staat alleen: duldt geen andere veredelingswaarde op hetzelfde vlak."@nl,
        "Brak uszlachetnienia na tej stronie: bez folii, tłoczenia ani efektu punktowego. Wyraźne oświadczenie, w odróżnieniu od pozostawienia osi nieokreślonej (co pozwala dostawcy zaproponować efekt). Wartość samodzielna: nie toleruje innej wartości uszlachetnienia na tej samej stronie."@pl,
        "Nenhum enobrecimento na face: sem foil, relevo alto, relevo baixo ou efeito localizado. Uma declaração explícita, distinta de deixar o eixo sem especificar (o que permite ao fornecedor propor um efeito). Vai sozinho: não tolera outro valor de enobrecimento na mesma face."@pt,
        "Ingen dekor på sidan: ingen folie, prägling eller punkteffekt. Ett uttryckligt påstående, skilt från att lämna axeln ospecificerad (vilket låter leverantören föreslå en effekt). Står ensam: tål inget annat dekorvärde på samma sida."@sv,
        "该面不作任何装饰工艺：不烫金、不压凸、不压凹、无局部效果。明确的声明，不同于将该轴留空（由供应商提议）。独立值：同一面上不容许其他装饰工艺值。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§NO-EMBELLISHMENT" ;
    skos:prefLabel "Ingen (uden forædling)"@da,
        "Keine (keine Veredelung)"@de,
        "None (no embellishment)"@en,
        "Ninguno (sin ornamentación)"@es,
        "कोई नहीं (बिना सजावटी प्रभाव)"@hi,
        "なし（加飾なし）"@ja,
        "Ingen (uten dekor)"@nb,
        "Geen (zonder veredeling)"@nl,
        "Brak (bez uszlachetnienia)"@pl,
        "Nenhum (sem enobrecimento)"@pt,
        "Ingen (utan dekor)"@sv,
        "无（无装饰工艺）"@zh-Hans ;
    ptpge:deprecatedOn "2026-10-11"^^xsd:date ;
    ptpge:deprecationReason "Absence is the specification's way of saying «none» (SD-0098, extended 2026-10-11 to embellishment): an effect the buyer does not ask for is not applied — foil, embossing, debossing and spot effects are additive, and a face with no embellishment binding is complete and fingerprintable. An explicit «none» value would make two identical products hash differently. No successor; this URI keeps resolving. The alt-labels remain useful as synonyms for «no embellishment» in mappers."@en,
        "Fravær er spesifikasjonens måte å si «ingen» på (SD-0098, utvidet 11.10.2026 til embellishment): en effekt kjøperen ikke ber om, blir ikke påført — folie, preging og punkteffekter er additive, og en flate uten embellishment-binding er komplett og kan fingeravtrykkes. En eksplisitt «ingen»-verdi ville gitt to like produkter ulikt fingeravtrykk. Ingen etterfølger; URI-en fortsetter å løse opp. Alt-etikettene forblir nyttige som synonymer for «ingen effekt» i mappere."@nb ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:level "element" ;
    ptpge:standalone true ;
    ptpge:status "deprecated" ;
    ptpge:version "2026-10-11" .

<https://ptpge.org/v1/printing/features/embellishments/spot-aqueous-varnish> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Aqueous coating"@en,
        "Spot AQ"@en,
        "Spot aqueous"@en,
        "एक्वियस कोटिंग"@hi,
        "जल-आधारित वार्निश"@hi,
        "स्पॉट AQ"@hi,
        "स्पॉट एक्वियस"@hi,
        "Akvalakk"@nb,
        "Vannbasert lakk"@nb,
        "lakier akrylowy wybiórczy"@pl,
        "lakier dyspersyjny"@pl,
        "lakier wodny wybiórczy"@pl,
        "verniz AQ"@pt,
        "verniz aquoso"@pt,
        "verniz de água localizado"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/embellishments> ;
    skos:definition "Vandbaseret lak påført udvalgte designelementer. Mere miljøvenlig end UV-lak, men med mere afdæmpet glans. Påføres inline på pressen som heldækkende lag eller selektivt via et lakværk."@da,
        "Wasserbasierter Lack, der auf bestimmte Designelemente aufgebracht wird. Umweltfreundlicher als UV-Lack, jedoch mit dezenterem Glanz."@de,
        "Water-based varnish applied to specific design elements. More environmentally friendly than UV varnish but with a subtler sheen. Applied inline on press as a flood coat or selectively via a press tower."@en,
        "Barniz al agua aplicado a elementos concretos del diseño. Más respetuoso con el medio ambiente que el barniz UV pero con un brillo más sutil. Se aplica en línea en máquina, como capa completa o de forma selectiva mediante un cuerpo de barnizado."@es,
        "विशिष्ट डिज़ाइन तत्वों पर लगाया गया जल-आधारित वार्निश। UV वार्निश से अधिक पर्यावरण-अनुकूल पर हल्की चमक। प्रेस पर इनलाइन फ़्लड कोट के रूप में या प्रेस टावर से चुनिंदा जगह।"@hi,
        "デザインの特定要素に塗布する水性ニス。UV ニスより環境負荷が低いが、光沢は控えめ。印刷機のインラインで全面またはニスユニットによる部分塗布で施される。"@ja,
        "Vannbasert lakk påført spesifikke design-elementer. Mer miljøvennlig enn UV-lakk, men med subtilere glans. Påført inline på pressen som flood-coat eller selektivt via et press-tårn."@nb,
        "Waterbasislak op geselecteerde ontwerpelementen. Milieuvriendelijker dan UV-lak, maar met subtielere glans. Inline op de pers aangebracht als volvlakslaag of selectief via een lakwerk."@nl,
        "Lakier wodny nanoszony na wybrane elementy projektu. Bardziej przyjazny środowisku niż lakier UV, lecz o subtelniejszym połysku. Nanoszony w linii na maszynie jako lakier pełny lub wybiórczo z wieży lakierującej."@pl,
        "Verniz à base de água aplicado em elementos específicos do design. Mais ecológico que o verniz UV, mas com brilho mais sutil. Aplicado em linha na impressora, como verniz total ou seletivamente por uma torre de verniz."@pt,
        "Vattenbaserad lack applicerad på specifika designelement. Mer miljövänlig än UV-lack men med diskretare lyster. Appliceras i linje i pressen som heltäckande skikt eller selektivt via ett lacktorn."@sv,
        "施加于特定设计元素的水性上光油。比 UV 上光更环保，但光泽更含蓄。在印刷机上联线施加，可整面涂布或经上光单元选择性施加。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§SPOT-AQUEOUS-VARNISH" ;
    skos:prefLabel "Partiel dispersionslak"@da,
        "Spot-Wasserlack"@de,
        "Spot Aqueous Varnish"@en,
        "Barniz acuoso localizado"@es,
        "स्पॉट एक्वियस वार्निश"@hi,
