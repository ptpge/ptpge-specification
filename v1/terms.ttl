<https://ptpge.org/v1/printing/standards/paper-size-standards/japanese-paper-sizes> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "JIS"@en,
        "JIS B sizes"@en,
        "JIS"@hi,
        "JIS B आकार"@hi,
        "JIS"@pl,
        "formaty JIS B"@pl,
        "JIS"@pt,
        "tamanhos JIS B"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/paper-size-standards> ;
    skos:definition "Papirformater efter Japanese Industrial Standards (JIS) — JIS B-serien afviger fra ISO B-seriens dimensioner og er optimeret til det japanske marked og traditionelle dokumenter."@da,
        "Papierformate nach Japanese Industrial Standards (JIS) — die JIS-B-Reihe weicht von den Maßen der ISO-B-Reihe ab und ist für den japanischen Markt und traditionelle Dokumente optimiert."@de,
        "Japanese Industrial Standards (JIS) paper sizes — the JIS B series differs from ISO B-series dimensions, optimized for the Japanese market and traditional documents."@en,
        "Norma japonesa Industrial Standard (JIS) para tamaños de papel — incluye la serie B japonesa, ligeramente diferente de la serie B de ISO 216."@es,
        "Japanese Industrial Standards (JIS) काग़ज़ आकार — JIS B श्रृंखला ISO B-श्रृंखला के आयामों से भिन्न, जापानी बाज़ार और पारंपरिक दस्तावेज़ों के लिए अनुकूलित।"@hi,
        "日本産業規格（JIS）の用紙寸法 — JIS BシリーズはISO Bシリーズと寸法が異なり、日本市場および伝統的な文書に最適化されている。"@ja,
        "Japanese Industrial Standards (JIS) papirstørrelser — JIS B-serien skiller seg fra ISO B-serien i dimensjoner, optimalisert for det japanske markedet og tradisjonelle dokumenter."@nb,
        "Papierformaten volgens Japanese Industrial Standards (JIS) — de JIS B-reeks wijkt af van de ISO B-reeksafmetingen en is geoptimaliseerd voor de Japanse markt en traditionele documenten."@nl,
        "Formaty papieru Japanese Industrial Standards (JIS) — seria JIS B różni się wymiarami od serii B ISO, zoptymalizowana pod rynek japoński i tradycyjne dokumenty."@pl,
        "Tamanhos de papel das Japanese Industrial Standards (JIS) — a série JIS B difere das dimensões da série B ISO, otimizada para o mercado japonês e documentos tradicionais."@pt,
        "Pappersformat enligt Japanese Industrial Standards (JIS) — JIS B-serien skiljer sig från ISO B-seriens dimensioner och är optimerad för den japanska marknaden och traditionella dokument."@sv,
        "日本工业标准（JIS）的纸张尺寸 —— 包括与ISO 216 B系列略有不同的日本B系列。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§JAPANESE-PAPER-SIZES" ;
    skos:prefLabel "Japanske papirformater (JIS)"@da,
        "Japanese Paper Sizes (JIS)"@de,
        "Japanese Paper Sizes (JIS)"@en,
        "Tamaños Japoneses (JIS)"@es,
        "जापानी काग़ज़ आकार (JIS)"@hi,
        "Japanese Paper Sizes (JIS)"@ja,
        "Japanese Paper Sizes (JIS)"@nb,
        "Japanse papierformaten (JIS)"@nl,
        "Japońskie formaty papieru (JIS)"@pl,
        "Tamanhos de papel japoneses (JIS)"@pt,
        "Japanska pappersformat (JIS)"@sv,
        "日本尺寸 (JIS)"@zh-Hans ;
