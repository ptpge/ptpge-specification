            ptpge:sourceElement "LayoutElementProduction" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/creation/imaging-graphics> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:altLabel "image editing"@en,
        "imaging"@en,
        "photo editing"@en,
        "इमेजिंग"@hi,
        "छवि संपादन"@hi,
        "फ़ोटो संपादन"@hi,
        "bildebehandling"@nb,
        "edycja zdjęć"@pl,
        "obróbka obrazu"@pl,
        "retusz"@pl,
        "edição de foto"@pt,
        "edição de imagem"@pt,
        "imagem"@pt ;
    skos:broader <https://ptpge.org/v1/printing/management/creation> ;
    skos:definition "Fotoredigering, billedmanipulation og vektorgrafik — den tekniske klargøring af visuelle elementer til trykfiler. Værktøjer omfatter Adobe Photoshop (raster) og Illustrator (vektor)."@da,
        "Bildbearbeitung, Bildmanipulation und Vektorgrafik-Erstellung — die technische Vorbereitung visueller Assets für die Verwendung in Druckdateien. Werkzeuge sind Adobe Photoshop (Raster) und Illustrator (Vektor)."@de,
        "Photo editing, image manipulation, and vector graphic creation — the technical preparation of visual assets for inclusion in print files. Tools include Adobe Photoshop (raster) and Illustrator (vector)."@en,
        "Tratamiento de imágenes y creación de elementos gráficos para el producto impreso — edición fotográfica, retoque, creación vectorial, gestión de capas."@es,
        "फ़ोटो संपादन, छवि हेरफेर और वेक्टर ग्राफ़िक निर्माण — प्रिंट फ़ाइलों में शामिल करने के लिए दृश्य संपत्तियों की तकनीकी तैयारी। औज़ारों में Adobe Photoshop (रास्टर) और Illustrator (वेक्टर)।"@hi,
        "写真編集、画像加工、ベクターグラフィック制作 — 印刷ファイルに含めるための視覚資産の技術的準備。ツールにはAdobe Photoshop（ラスター）とIllustrator（ベクター）がある。"@ja,
        "Fotoredigering, bildemanipulasjon og opprettelse av vektorgrafikk — den tekniske forberedelsen av visuelle elementer for inkludering i trykkfiler. Verktøy inkluderer Adobe Photoshop (raster) og Illustrator (vektor)."@nb,
        "Fotobewerking, beeldmanipulatie en vectorgraphics — de technische voorbereiding van visuele elementen voor drukbestanden. Tools zijn onder meer Adobe Photoshop (raster) en Illustrator (vector)."@nl,
        "Edycja zdjęć, obróbka obrazów i tworzenie grafiki wektorowej — techniczne przygotowanie materiałów wizualnych do włączenia w pliki drukarskie. Narzędzia obejmują Adobe Photoshop (raster) i Illustrator (wektor)."@pl,
        "Edição de fotos, manipulação de imagens e criação de gráficos vetoriais — a preparação técnica de ativos visuais para inclusão em arquivos de impressão. As ferramentas incluem Adobe Photoshop (raster) e Illustrator (vetor)."@pt,
        "Bildredigering, bildbehandling och vektorgrafik — den tekniska förberedelsen av visuella tillgångar för tryckfiler. Verktyg inkluderar Adobe Photoshop (raster) och Illustrator (vektor)."@sv,
        "印刷品图像处理和图形元素创建——照片编辑、修饰、矢量创建、图层管理。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§IMAGING-GRAPHICS" ;
    skos:prefLabel "Billedbehandling & grafik"@da,
        "Imaging & Grafik"@de,
        "Imaging & Graphics"@en,
        "Imagen y Gráficos"@es,
        "इमेजिंग और ग्राफ़िक्स"@hi,
        "イメージングとグラフィック"@ja,
        "Bilde- & grafikkbehandling"@nb,
        "Beeldbewerking & graphics"@nl,
        "Obrazowanie i grafika"@pl,
        "Imagem e gráficos"@pt,
        "Bild & grafik"@sv,
        "图像与图形"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.4.11 · p.98" ;
            ptpge:mappingRow "crosswalk row 6" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "LayoutElementProduction" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/creation/prepress-preparation> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:altLabel "pre-press"@en,
        "prepress"@en,
        "प्री-प्रेस"@hi,
        "प्रीप्रेस"@hi,
        "forhåndstrykk"@nb,
        "prepress"@nb,
        "prepress"@pl,
        "przygotowalnia"@pl,
        "przygotowanie do druku"@pl,
        "prepress"@pt,
        "pré-impressão"@pt ;
    skos:broader <https://ptpge.org/v1/printing/management/creation> ;
    skos:definition "Endelig teknisk klargøring af filer til produktion — farveseparation, trapping, opsætning af beskæring og slug, skriftindlejring og overholdelse af PDF/X-standarder. Broen mellem Kreation og Kvalitetssikring."@da,
        "Letzte technische Aufbereitung der Dateien für die Produktion — Farbseparation, Trapping, Anschnitt- und Slug-Einrichtung, Schrifteneinbettung und Konformität mit PDF/X-Standards. Bindeglied zwischen Creation und Qualitätssicherung."@de,
        "Final technical preparation of files for production — color separation, trapping, bleed and slug setup, font embedding, and compliance with PDF/X standards. The bridge between Creation and Quality Assurance."@en,
        "Operaciones de pre-prensa que convierten el diseño aprobado en un archivo listo para imprimir — comprobación de fuentes, perfiles de color, sangrados, marcas de corte."@es,
        "उत्पादन के लिए फ़ाइलों की अंतिम तकनीकी तैयारी — रंग सेपरेशन, ट्रैपिंग, ब्लीड और स्लग सेटअप, फ़ॉन्ट एम्बेडिंग और PDF/X मानकों का अनुपालन। निर्माण और गुणवत्ता आश्वासन के बीच का पुल।"@hi,
        "生産用ファイルの最終的な技術準備 — 色分解、トラッピング、ブリードとスラグ設定、フォント埋め込み、PDF/X規格への適合。CreationとQuality Assuranceの間の橋渡し。"@ja,
        "Endelig teknisk forberedelse av filer for produksjon — fargeseparasjon, trapping, oppsett av utfall og slug, fontinnbygging og samsvar med PDF/X-standarder. Broen mellom Creation og Quality Assurance."@nb,
        "Definitieve technische voorbereiding van bestanden voor productie — kleurscheiding, trapping, afloop- en slug-instelling, lettertype-insluiting en naleving van PDF/X-standaarden. De brug tussen Creatie en Kwaliteitsborging."@nl,
        "Końcowe techniczne przygotowanie plików do produkcji — separacja barw, trapping, ustawienie spadów i pola informacyjnego, osadzanie fontów i zgodność ze standardami PDF/X. Pomost między Tworzeniem a Zapewnieniem jakości."@pl,
        "Preparação técnica final dos arquivos para produção — separação de cor, trapping, configuração de sangria e slug, incorporação de fontes e conformidade com as normas PDF/X. A ponte entre Criação e Garantia de qualidade."@pt,
        "Slutlig teknisk förberedelse av filer för produktion — färgseparation, trapping, utfall och slug, typsnittsinbäddning och efterlevnad av PDF/X-standarder. Bron mellan Skapande och Kvalitetssäkring."@sv,
        "将批准的设计转换为印刷就绪文件的印前操作——字体检查、色彩配置文件、出血、裁切标记。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§PREPRESS-PREPARATION" ;
    skos:prefLabel "Prepress-klargøring"@da,
        "Druckvorstufenvorbereitung"@de,
        "Prepress Preparation"@en,
        "Preparación Pre-prensa"@es,
        "प्रीप्रेस तैयारी"@hi,
        "プリプレス準備"@ja,
        "Prepress-klargjøring"@nb,
        "Prepressvoorbereiding"@nl,
        "Przygotowanie prepress"@pl,
        "Preparação de pré-impressão"@pt,
        "Prepressförberedelse"@sv,
        "印前准备"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.4.11 · p.98" ;
            ptpge:mappingRow "crosswalk row 6" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "LayoutElementProduction" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/creation/typography-layout> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:altLabel "layout"@en,
        "typesetting"@en,
        "typography"@en,
        "टाइपसेटिंग"@hi,
        "टाइपोग्राफ़ी"@hi,
        "लेआउट"@hi,
        "ombrekking"@nb,
        "typografi"@nb,
        "skład"@pl,
        "łamanie"@pl,
        "composição"@pt,
        "diagramação"@pt,
        "layout"@pt,
        "tipografia"@pt ;
    skos:broader <https://ptpge.org/v1/printing/management/creation> ;
    skos:definition "Komposition af tekst og arrangement af sideelementer — skriftvalg, spatiering, hierarki, grids og de sideniveau-designvalg, der gør indhold til en læsbar, visuelt sammenhængende side."@da,
        "Textsatz und Anordnung der Seitenelemente — Schriftauswahl, Abstände, Hierarchie, Raster und die Seitenebenen-Designentscheidungen, die Inhalte in ein lesbares, visuell stimmiges Produkt verwandeln."@de,
        "Composition of text and arrangement of page elements — typeface selection, spacing, hierarchy, grids, and the page-level design decisions that turn content into a readable, visually coherent product."@en,
        "Composición de texto y diseño de página — tipografía, tamaños, interlineado, distribución en página, jerarquía visual."@es,
        "पाठ का संयोजन और पेज तत्वों की व्यवस्था — टाइपफ़ेस चयन, स्पेसिंग, पदानुक्रम, ग्रिड और वे पेज-स्तरीय डिज़ाइन निर्णय जो सामग्री को पठनीय, दृश्य रूप से सुसंगत उत्पाद बनाते हैं।"@hi,
        "テキストの組版とページ要素の配置 — 書体選択、字間、階層、グリッド、コンテンツを読みやすく視覚的に一貫した製品に変えるページレベルのデザイン判断。"@ja,
        "Komposisjon av tekst og arrangement av sideelementer — valg av skrifttyper, avstand, hierarki, rutenett og sidenivå-designvalg som gjør innhold til et leselig og visuelt sammenhengende produkt."@nb,
        "Compositie van tekst en schikking van pagina-elementen — letterkeuze, spatiëring, hiërarchie, grids en de paginabrede ontwerpbeslissingen die inhoud omzetten in een leesbare, visueel samenhangende pagina."@nl,
        "Kompozycja tekstu i rozmieszczenie elementów strony — dobór krojów pisma, odstępy, hierarchia, siatki oraz decyzje projektowe na poziomie strony, które zamieniają treść w czytelny, wizualnie spójny produkt."@pl,
        "Composição de texto e arranjo dos elementos de página — escolha de tipos, espaçamento, hierarquia, grades e as decisões de design no nível da página que transformam conteúdo num produto legível e visualmente coerente."@pt,
        "Sättning av text och arrangemang av sidelement — typsnittsval, avstånd, hierarki, gridsystem och de sidnivåbeslut som gör innehåll till en läsbar, visuellt sammanhållen produkt."@sv,
        "文本组版和页面设计——字体、大小、行距、页面分布、视觉层次。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§TYPOGRAPHY-LAYOUT" ;
    skos:prefLabel "Typografi & layout"@da,
        "Typografie & Layout"@de,
        "Typography & Layout"@en,
        "Tipografía y Maquetación"@es,
        "टाइपोग्राफ़ी और लेआउट"@hi,
        "タイポグラフィとレイアウト"@ja,
        "Typografi & layout"@nb,
        "Typografie & opmaak"@nl,
        "Typografia i skład"@pl,
        "Tipografia e layout"@pt,
        "Typografi & layout"@sv,
        "字体与版式"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.4.11 · p.98" ;
            ptpge:mappingRow "crosswalk row 6" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "LayoutElementProduction" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/quality-assurance/color-calibration> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:altLabel "Colour Calibration"@en,
        "kalibracja kolorów"@pl ;
    skos:broader <https://ptpge.org/v1/printing/management/quality-assurance> ;
    skos:definition "Proces til at måle og justere en trykenhed eller skærm, så dens faktiske farveoutput matcher et specificeret mål — med spektrofotometre til at aflæse trykte felter og software til at bygge korrektionskurver."@da,
        "Verfahren zur Messung und Anpassung eines Druckgeräts oder Displays, sodass dessen tatsächliche Farbausgabe mit einem festgelegten Sollwert übereinstimmt — mithilfe von Spektralfotometern werden Druckmuster gemessen und Software erzeugt Kalibrierkurven."@de,
        "Process of measuring and adjusting a printing device or display so its actual color output matches a specified target — using spectrophotometers to read printed patches and software to build calibration curves."@en,
        "Proceso de ajustar dispositivos (monitores, escáneres, prensas) para que reproduzcan colores de forma consistente y conforme a un objetivo establecido."@es,
        "मुद्रण उपकरण या डिस्प्ले को मापने और समायोजित करने की प्रक्रिया ताकि उसका वास्तविक रंग आउटपुट निर्दिष्ट लक्ष्य से मेल खाए — छपे पैच पढ़ने के लिए स्पेक्ट्रोफ़ोटोमीटर और अंशांकन वक्र बनाने के लिए सॉफ़्टवेयर।"@hi,
        "印刷機またはディスプレイの実際の色出力が指定されたターゲットに一致するように測定および調整する工程 — 分光測色計で印刷パッチを読み取り、ソフトウェアでキャリブレーションカーブを作成する。"@ja,
        "Prosess for å måle og justere en trykkenhet eller skjerm slik at faktisk fargeutgang matcher et spesifisert mål — bruker spektrofotometre til å avlese trykte patcher og programvare til å bygge kalibreringskurver."@nb,
        "Proces van meten en bijstellen van een drukapparaat of scherm zodat de werkelijke kleuruitvoer overeenkomt met een gespecificeerd doel — met spectrofotometers die gedrukte velden meten en software die correctiecurven opbouwt."@nl,
        "Proces pomiaru i regulacji urządzenia drukującego lub wyświetlacza tak, aby jego rzeczywisty wynik barwny odpowiadał zadanemu celowi — z użyciem spektrofotometrów do odczytu zadrukowanych pól i oprogramowania do budowy krzywych kalibracyjnych."@pl,
        "Processo de medir e ajustar um dispositivo de impressão ou monitor para que sua saída real de cor corresponda a um alvo especificado — usando espectrofotômetros para ler amostras impressas e software para construir curvas de calibração."@pt,
        "Processen att mäta och justera en tryckenhet eller bildskärm så att dess faktiska färgutmatning matchar ett angivet mål — med spektrofotometrar som läser tryckta fält och programvara som bygger kalibreringskurvor."@sv,
        "调整设备（显示器、扫描仪、印刷机）以一致且符合既定目标地再现颜色的过程。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§COLOR-CALIBRATION" ;
    skos:prefLabel "Farvekalibrering"@da,
        "Farbkalibrierung"@de,
        "Color Calibration"@en,
        "Calibración de Color"@es,
        "रंग अंशांकन"@hi,
        "カラーキャリブレーション"@ja,
        "Farge-kalibrering"@nb,
        "Kleurkalibratie"@nl,
        "Kalibracja barw"@pl,
        "Calibração de cor"@pt,
        "Färgkalibrering"@sv,
        "色彩校准"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/quality-assurance/proofing/postpress-proofing> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:altLabel "post-press proofing"@en,
        "पोस्ट-प्रेस प्रूफ़िंग"@hi,
        "kontrola po druku"@pl,
        "prova pós-impressão"@pt ;
    skos:broader <https://ptpge.org/v1/printing/management/quality-assurance/proofing> ;
    skos:definition "Verifikation udført efter trykkørslen — en prøve fra produktionen undersøges for at bekræfte, at farve, register, færdiggørelse og samlet kvalitet matcher det godkendte prepress-prøvetryk."@da,
        "Verifizierung nach dem Druckdurchlauf — Untersuchung eines Produktionsmusters, um zu bestätigen, dass Farbe, Passer, Veredelung und Gesamtqualität dem freigegebenen Druckvorstufen-Proof entsprechen. Erfasst druckbedingte Abweichungen und Veredelungsfehler."@de,
        "Verification performed after the press run — examining a sample from production to confirm color, registration, finishing, and overall quality match the approved prepress proof. Catches press-related drift and finishing errors."@en,
        "Verificación realizada después de la tirada para confirmar que el producto coincide con la prueba aprobada — comparación visual y, opcionalmente, medición espectrofotométrica."@es,
        "प्रेस रन के बाद किया गया सत्यापन — उत्पादन के नमूने की जाँच ताकि पुष्टि हो कि रंग, रजिस्ट्रेशन, फ़िनिशिंग और समग्र गुणवत्ता अनुमोदित प्रीप्रेस प्रूफ़ से मेल खाती है। प्रेस-संबंधी विचलन और फ़िनिशिंग त्रुटियाँ पकड़ता है।"@hi,
        "印刷機運転後に行われる検証 — 生産物のサンプルを審査し、色、見当合わせ、仕上げ、全体的な品質が承認済みの製版校正と一致することを確認する。印刷機関連のドリフトおよび仕上げエラーを捕捉する。"@ja,
        "Verifikasjon utført etter pressekjøringen — undersøker en prøve fra produksjonen for å bekrefte at farge, registrering, etterbehandling og samlet kvalitet matcher det godkjente prepress-proofet. Fanger presse-relatert drift og etterbehandlingsfeil."@nb,
        "Verificatie na de drukgang — een monster uit de productie wordt onderzocht om te bevestigen dat kleur, register, afwerking en algehele kwaliteit overeenkomen met de goedgekeurde prepressproef."@nl,
        "Weryfikacja wykonywana po nakładzie — badanie próbki z produkcji w celu potwierdzenia, że barwa, pasowanie, wykończenie i ogólna jakość odpowiadają zatwierdzonemu proofowi prepress. Wyłapuje dryf maszyny i błędy wykończenia."@pl,
        "Verificação realizada após a tiragem — exame de uma amostra da produção para confirmar que cor, registro, acabamento e qualidade geral correspondem à prova de pré-impressão aprovada. Captura desvios de máquina e erros de acabamento."@pt,
        "Verifiering utförd efter tryckningen — ett produktionsprov granskas för att bekräfta att färg, passning, efterbehandling och helhetskvalitet motsvarar det godkända förprovet. Fångar tryckdrift och efterbehandlingsfel."@sv,
        "印刷后进行的验证，确认产品与批准的校样相符 —— 视觉比较以及可选的分光光度测量。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§POSTPRESS-PROOFING" ;
    skos:prefLabel "Prøve efter tryk"@da,
        "Postpress-Proofing"@de,
        "Postpress Proofing"@en,
        "Pruebas Post-prensa"@es,
        "पोस्टप्रेस प्रूफ़िंग"@hi,
        "ポストプレス校正"@ja,
        "Etterpress-proofing"@nb,
        "Proef na het drukken"@nl,
        "Proofing po druku"@pl,
        "Provas pós-impressão"@pt,
        "Efterkontroll (postpress)"@sv,
        "印后校样"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.5 · p.73",
                "§5.3.1 · p.87",
                "§6.3 · p.144" ;
            ptpge:mappingRow "crosswalk row 14" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Approval",
                "ApprovalParams",
                "ContentCheckIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/quality-assurance/proofing/prepress-proofing/adobeacrobat-pro-dc> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
