<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/textured-paper> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:altLabel "Struktureret papir (bestrøget eller ubestrøget)"@da,
        "Strukturpapier (gestrichen oder ungestrichen)"@de,
        "Textured Paper (Coated or uncoated)"@en,
        "Textured Stock"@en,
        "एम्बॉस्ड पेपर"@hi,
        "टेक्सचर पेपर"@hi,
        "बनावटदार काग़ज़"@hi,
        "लिनन पेपर"@hi,
        "Preget papir"@nb,
        "Strukturert papir (bestrøket eller ubestrøket)"@nb,
        "Strukturpapir"@nb,
        "Gestructureerd papier (gestreken of ongestreken)"@nl,
        "papier fakturowany (powlekany lub niepowlekany)"@pl,
        "papier strukturalny"@pl,
        "papier z fakturą"@pl,
        "papel gofrado"@pt,
        "papel linho"@pt,
        "papel texturizado"@pt,
        "papel vergê"@pt,
        "Strukturpapper (bestruket eller obestruket)"@sv ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces> ;
    skos:definition "Papir med taktil overfladestruktur — vergé, ribbet, lærred, filt eller prægede strukturer. Bestrøget eller ubestrøget. Bruges til eksklusivt kontorpapir, invitationer og designdrevne projekter."@da,
        "Papier mit haptischer Oberflächenstruktur — geripptes, gestreiftes, leinenartiges, filzartiges oder geprägtes Muster. Gestrichen oder ungestrichen. Eingesetzt für Premium-Korrespondenzpapier, Einladungen und designgetriebene Projekte."@de,
        "Paper with a tactile surface pattern — laid, ribbed, linen, felt, or embossed textures. Coated or uncoated. Used for premium stationery, invitations, and design-driven projects."@en,
        "Papel con textura física aplicada durante la fabricación — verjurado, estriado, gofrado, marcado en relieve. Aporta carácter táctil distintivo."@es,
        "स्पर्शनीय सतह पैटर्न वाला काग़ज़ — लेड, रिब्ड, लिनन, फ़ेल्ट या एम्बॉस्ड बनावट। कोटेड या अनकोटेड। प्रीमियम स्टेशनरी, निमंत्रणों और डिज़ाइन-प्रधान परियोजनाओं में।"@hi,
        "触覚的な表面パターンを持つ紙 — レイド、リブ、リネン、フェルト、エンボスなど。塗工または非塗工。プレミアム便箋、招待状、デザイン主導のプロジェクトに使用される。"@ja,
        "Papir med taktilt overflatemønster — vannhalt, ribbet, linned, filt eller preget struktur. Belagt eller ubelagt. Brukt til premium-brevpapir, invitasjoner og designdrevne prosjekter."@nb,
        "Papier met een voelbaar oppervlaktepatroon — vergé, geribd, linnen, vilt of gepreegde structuren. Gestreken of ongestreken. Gebruikt voor exclusief briefpapier, uitnodigingen en designgedreven projecten."@nl,
        "Papier o wyczuwalnym wzorze powierzchni — żeberkowanym, prążkowanym, lnianym, filcowym lub tłoczonym. Powlekany lub niepowlekany. Używany do papeterii premium, zaproszeń i projektów o wysokich wymaganiach projektowych."@pl,
        "Papel com padrão tátil de superfície — vergê, canelado, linho, feltro ou gofrado. Revestido ou não. Usado em papelaria premium, convites e projetos orientados por design."@pt,
        "Papper med taktil ytstruktur — randat, ribbat, linne-, filt- eller präglade strukturer. Bestruket eller obestruket. Används för exklusivt kontorsmateriel, inbjudningar och designdrivna projekt."@sv,
        "在制造过程中施加物理纹理的纸 —— 条纹、罗纹、压花、浮雕。带来独特的触感特征。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:SB§TEXTURED-PAPER" ;
    skos:prefLabel "Struktureret papir"@da,
        "Strukturpapier"@de,
        "Textured Paper"@en,
        "Papel Texturado"@es,
        "टेक्सचर्ड काग़ज़"@hi,
        "テクスチャ紙（コートまたは非コート）"@ja,
        "Strukturert papir"@nb,
        "Gestructureerd papier"@nl,
        "Papier fakturowany"@pl,
        "Papel texturizado"@pt,
        "Strukturpapper"@sv,
        "纹理纸"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "substrates" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.11 · p.79",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 29" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media",
                "MediaIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/technologies/printing-technologies/analog/flexo> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:42:30+00:00"^^xsd:dateTime ;
    skos:altLabel "Flexografi"@da,
        "Flexotryk"@da,
        "Flexographic printing"@en,
        "Flexography"@en,
        "फ़्लेक्सोग्राफ़िक मुद्रण"@hi,
        "फ़्लेक्सोग्राफ़ी"@hi,
        "Fleksografi"@nb,
        "flexografie"@nl,
        "druk fleksograficzny"@pl,
        "flekso"@pl,
        "Flexografia"@pt,
        "Impressão flexográfica"@pt,
        "Flexografi"@sv,
        "Flexotryck"@sv ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-technologies/analog> ;
    skos:definition "En analog trykproces med fleksible reliefplader og hurtigttørrende flydende farver, kørt på rullefødte presser i høj hastighed. Den dominerende teknologi for trykt emballage — etiketter, fleksibel emballage, bølgepapkasser — og for avis- og magasinarbejde i store mængder."@da,
        "Ein analoges Druckverfahren, das flexible Hochdruckplatten und schnell trocknende flüssige Druckfarben verwendet und auf Rollendruckmaschinen mit hoher Geschwindigkeit läuft. Die dominante Technologie für bedruckte Verpackungen — Etiketten, flexible Verpackungen, Wellpappe — sowie für hochvolumige Zeitungs- und Magazinaufträge."@de,
        "An analog printing process using flexible relief plates and fast-drying liquid inks, run on web-fed presses at high speed. The dominant technology for printed packaging — labels, flexible packaging, corrugated boxes — and for high-volume newspaper and magazine work."@en,
        "Tecnología de impresión en relieve que utiliza planchas de polímero flexible montadas sobre cilindros. Dominante en packaging por su capacidad de imprimir sobre sustratos no uniformes."@es,
        "लचीली रिलीफ़ प्लेटों और जल्दी सूखने वाली तरल स्याही का एनालॉग मुद्रण प्रक्रिया, वेब-फ़ेड प्रेस पर उच्च गति से चलती है। छपी पैकेजिंग — लेबल, लचीली पैकेजिंग, कोरुगेटेड बॉक्स — और उच्च-मात्रा अख़बार व पत्रिका कार्य की प्रमुख तकनीक।"@hi,
        "柔軟な凸版と速乾性の液体インキを使用し、輪転印刷機で高速に運転されるアナログ印刷工程。印刷パッケージ — ラベル、軟包装、段ボール — および大量の新聞・雑誌業務における主要技術。"@ja,
        "En analog trykkeprosess som bruker fleksible relieffplater og hurtigtørkende flytende blekk, kjørt på rull-matede presser i høy hastighet. Den dominerende teknologien for trykt emballasje — etiketter, fleksibel emballasje, bølgepappkasser — og for store opplag av aviser og magasiner."@nb,
        "Een analoog drukproces met flexibele reliëfplaten en sneldrogende vloeibare inkten, gedraaid op rolgevoede persen op hoge snelheid. De dominante technologie voor bedrukte verpakkingen — etiketten, flexibele verpakkingen, golfkartonnen dozen — en voor kranten- en magazinewerk in hoge volumes."@nl,
        "Analogowy proces druku z użyciem elastycznych form wypukłych i szybkoschnących farb ciekłych, prowadzony na maszynach zwojowych z dużą prędkością. Dominująca technologia druku opakowań — etykiet, opakowań giętkich, pudeł z tektury falistej — oraz wysokonakładowych gazet i czasopism."@pl,
        "Processo analógico de impressão que usa chapas flexíveis em relevo e tintas líquidas de secagem rápida, rodado em impressoras de bobina em alta velocidade. A tecnologia dominante para embalagens impressas — rótulos, embalagens flexíveis, caixas de papelão ondulado — e para grandes volumes de jornais e revistas."@pt,
        "En analog tryckprocess med flexibla reliefplåtar och snabbtorkande flytande bläck, körd på rullmatade pressar i hög hastighet. Den dominerande teknologin för tryckta förpackningar — etiketter, flexibla förpackningar, wellpapplådor — och för tidnings- och tidskriftsarbete i höga volymer."@sv,
        "使用安装在滚筒上的柔性聚合物印版的凸版印刷技术。在包装中占主导地位，能够在不均匀承印物上印刷。"@zh-Hans ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1043861> ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC§FLEXO" ;
    skos:prefLabel "Flexo"@da,
        "Flexodruck"@de,
        "Flexo"@en,
        "Flexografía"@es,
        "फ़्लेक्सो"@hi,
        "フレキソ印刷"@ja,
        "Fleksografi"@nb,
        "Flexo"@nl,
        "Fleksografia"@pl,
        "Flexo"@pt,
        "Flexo"@sv,
        "柔印"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "technologies" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.12 · p.81",
                "§5.5.1 · p.110" ;
            ptpge:mappingRow "crosswalk row 16" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "ConventionalPrinting",
                "ProductionIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/variables/substrate> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/variables> ;
    skos:definition "Substrat-konfigurationsvariabler — de substratakser et trykt produkt kan konfigureres langs."@da,
        "Bedruckstoff-Konfigurationsvariablen — die Bedruckstoffachsen, entlang derer ein Druckprodukt konfiguriert werden kann."@de,
        "Substrate configuration variables — the substrate axes a printed product can be configured along."@en,
        "Variables de configuración de sustrato — los ejes de sustrato a lo largo de los cuales puede configurarse un producto impreso."@es,
        "सब्सट्रेट कॉन्फ़िगरेशन वेरिएबल — वे सब्सट्रेट (छपाई सामग्री) अक्ष जिनके साथ मुद्रित उत्पाद कॉन्फ़िगर किया जा सकता है।"@hi,
        "基材の構成変数 — 印刷物を構成できる基材の軸。"@ja,
        "Substrat konfigurasjonsvariabler — substrat-aksene et trykkprodukt kan konfigureres langs."@nb,
        "Substraat-configuratievariabelen — de substraatassen waarlangs een drukproduct kan worden geconfigureerd."@nl,
        "Zmienne konfiguracyjne podłoża — osie podłoża, wzdłuż których można skonfigurować produkt drukowany."@pl,
        "Variáveis de configuração de substrato — os eixos de substrato ao longo dos quais um impresso pode ser configurado."@pt,
        "Konfigurationsvariabler för substrat — de substrataxlar en trycksak kan konfigureras längs."@sv,
        "承印材料配置变量 — 印刷品可沿其配置的承印材料轴。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/variables/substrate/substrate-class>,
        <https://ptpge.org/v1/variables/substrate/substrate-coating>,
        <https://ptpge.org/v1/variables/substrate/substrate-color>,
        <https://ptpge.org/v1/variables/substrate/substrate-fibre>,
        <https://ptpge.org/v1/variables/substrate/substrate-finish>,
        <https://ptpge.org/v1/variables/substrate/substrate-thickness>,
        <https://ptpge.org/v1/variables/substrate/substrate-type>,
        <https://ptpge.org/v1/variables/substrate/substrate-weight> ;
    skos:notation "VAR:SB" ;
    skos:prefLabel "Substrat"@da,
        "Bedruckstoff"@de,
        "Substrate"@en,
        "Sustrato"@es,
        "सब्सट्रेट"@hi,
        "基材"@ja,
        "Substrat"@nb,
        "Substraat"@nl,
        "Podłoże"@pl,
        "Substrato"@pt,
        "Substrat"@sv,
        "承印材料"@zh-Hans ;
    ptpge:level "group" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/completions/packaging> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:12:20+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/completions> ;
    skos:definition "Materialer og metoder til at beskytte, samle og sende det færdige trykte produkt — fra enkeltkuverter til palleterede forsendelser."@da,
        "Materialien und Methoden zum Schutz, zur Bündelung und zum Versand des fertigen Druckerzeugnisses — vom einzelnen Briefumschlag bis zur palettierten Lieferung."@de,
        "Materials and methods used to protect, group, and ship the finished printed product — from individual envelopes to pallet-loaded shipments."@en,
        "Materiales y métodos utilizados para proteger, agrupar y enviar el producto impreso terminado — desde sobres individuales hasta envíos paletizados."@es,
        "तैयार मुद्रित उत्पाद को बचाने, समूहबद्ध करने और भेजने की सामग्री और विधियाँ — अलग-अलग लिफ़ाफ़ों से लेकर पैलेट पर लदी खेप तक।"@hi,
        "完成した印刷物を保護、まとめ、出荷するために使用される材料と方法 — 個別の封筒からパレット積みの出荷まで。"@ja,
        "Materialer og metoder brukt til å beskytte, gruppere og forsende det ferdige trykte produktet — fra individuelle konvolutter til palleterte forsendelser."@nb,
        "Materialen en methoden om het afgewerkte drukproduct te beschermen, te bundelen en te verzenden — van losse enveloppen tot palletzendingen."@nl,
        "Materiały i metody stosowane do ochrony, grupowania i wysyłki gotowego produktu drukowanego — od pojedynczych kopert po przesyłki paletowe."@pl,
        "Materiais e métodos usados para proteger, agrupar e expedir o impresso acabado — de envelopes individuais a remessas paletizadas."@pt,
        "Material och metoder för att skydda, gruppera och skicka den färdiga tryckta produkten — från enskilda kuvert till pallastade leveranser."@sv,
        "保护、分组和运输印刷成品所使用的材料和方法——从单个信封到整托盘装运。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/completions/packaging/banding>,
        <https://ptpge.org/v1/printing/completions/packaging/bubble-wrap>,
        <https://ptpge.org/v1/printing/completions/packaging/cardboard-boxes>,
        <https://ptpge.org/v1/printing/completions/packaging/envelopes>,
        <https://ptpge.org/v1/printing/completions/packaging/palletized-packaging>,
        <https://ptpge.org/v1/printing/completions/packaging/postal-trays>,
        <https://ptpge.org/v1/printing/completions/packaging/roll-paper>,
        <https://ptpge.org/v1/printing/completions/packaging/shrink-wrap>,
        <https://ptpge.org/v1/printing/completions/packaging/tubes> ;
    skos:notation "P:CP-PKG" ;
    skos:prefLabel "Emballering"@da,
        "Verpackung"@de,
        "Packaging"@en,
        "Embalaje"@es,
        "पैकेजिंग"@hi,
        "パッケージ"@ja,
        "Emballasje"@nb,
        "Verpakking"@nl,
        "Pakowanie"@pl,
        "Embalagem"@pt,
        "Emballage"@sv,
        "包装"@zh-Hans ;
    skos:scopeNote "Umfasst Schutzmaterialien (Luftpolsterfolie, Schrumpffolie), Versandbehälter (Wellpappkartons, Versandrohre, Briefumschläge) und Großmengenhandhabung (palettierte Verpackung, Rollenpapier-Versand). Wenn die Verpackung selbst ein Druckerzeugnis ist, fällt sie als hergestelltes Produkt unter die reguläre Taxonomie."@de,
        "Includes protective materials (bubble wrap, shrink wrap), shipping containers (cardboard boxes, tubes, envelopes), and bulk handling (palletized packaging, roll paper). The packaging itself can be a printed product, in which case it falls under the regular taxonomy as the product being made."@en,
        "Incluye materiales protectores (plástico de burbujas, film retráctil), contenedores de envío (cajas de cartón, tubos, sobres) y manejo a granel (embalaje paletizado, papel en rollo). El embalaje mismo puede ser un producto impreso."@es,
        "सुरक्षात्मक सामग्री (बबल रैप, श्रिंक रैप), शिपिंग कंटेनर (गत्ते के डिब्बे, ट्यूब, लिफ़ाफ़े) और थोक हैंडलिंग (पैलेट पैकेजिंग, रोल) शामिल। पैकेजिंग स्वयं मुद्रित उत्पाद हो सकती है; तब वह बनाए जा रहे उत्पाद के रूप में नियमित वर्गीकरण में आती है।"@hi,
        "保護材（プチプチ、シュリンクラップ）、輸送容器（段ボール箱、筒、封筒）、大量取扱（パレット梱包、巻き紙）を含む。梱包そのものが印刷物である場合は、製造される製品として通常のタクソノミーに分類される。"@ja,
        "Inkluderer beskyttelsesmateriale (bobleplast, krympeplast), forsendelsesbeholdere (pappkartonger, tuber, konvolutter) og bulkhåndtering (palletert emballasje, rullpapir). Selve emballasjen kan være et trykt produkt, i hvilket tilfelle det faller under den vanlige taksonomien som produktet som lages."@nb,
        "Inclui materiais de proteção (plástico-bolha, filme retrátil), recipientes de envio (caixas de papelão, tubos, envelopes) e manuseio a granel (paletização, rolo). A própria embalagem pode ser um impresso; nesse caso, entra na taxonomia regular como o produto que está sendo feito."@pt,
        "包括保护材料（气泡膜、收缩膜）、运输容器（瓦楞纸箱、纸筒、信封）和大宗处理（托盘式包装、卷筒纸）。包装本身可以是一种印刷品。"@zh-Hans ;
    ptpge:group "completions" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.6.25 · p.126",
                "§5.6.28 · p.128",
                "§5.6.3 · p.113",
                "§5.6.39 · p.135",
                "§6.10 · p.161" ;
            ptpge:mappingRow "crosswalk row 48" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "BoxPacking",
                "Bundle",
                "Palletizing",
                "Shrinking",
                "Wrapping" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/completions/structural-finishing> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-16T10:40:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/completions> ;
    skos:definition "Efterbehandlingsoperationer, der skærer, riller eller former selve substratet — udstansning, laserskæring, kiss-cutting, rilning, perforering og fræsning."@da,
        "Weiterverarbeitung, die den Bedruckstoff selbst schneidet, rillt oder formt — Stanzen, Laserschneiden, Kiss-Cutting, Rillen, Perforation und Fräsen."@de,
        "Finishing operations that cut, crease or shape the substrate itself — die-cutting, laser-cutting, kiss-cutting, scoring, perforation and routing."@en,
        "Operaciones de acabado que cortan, hienden o dan forma al propio sustrato — troquelado, corte láser, kiss-cut, hendido, perforado y fresado."@es,
        "वे फ़िनिशिंग क्रियाएँ जो सब्सट्रेट को ही काटती, क्रीज़ करती या आकार देती हैं — डाई-कटिंग, लेज़र-कटिंग, किस-कटिंग, स्कोरिंग, परफ़ोरेशन और राउटिंग।"@hi,
        "基材そのものを切断・スジ入れ・成形する後加工 — 型抜き、レーザーカット、キスカット、スジ入れ、ミシン目、ルーター加工。"@ja,
        "Etterbehandling som skjærer, riller eller former selve substratet — stansing, laserskjæring, kiss-cutting, rilling, perforering og fresing."@nb,
        "Afwerkingsbewerkingen die het substraat zelf snijden, rillen of vormen — stansen, lasersnijden, kiss-cutting, rillen, perforeren en frezen."@nl,
        "Operacje wykończeniowe, które tną, bigują lub kształtują samo podłoże — wykrawanie, cięcie laserowe, nacinanie warstwy wierzchniej, bigowanie, perforacja i frezowanie."@pl,
        "Operações de acabamento que cortam, vincam ou dão forma ao próprio substrato — corte especial, corte a laser, meio-corte, vinco, picote e fresagem."@pt,
        "Efterbehandlingsoperationer som skär, bigar eller formar själva substratet — stansning, laserskärning, kiss-cutting, bigning, perforering och fräsning."@sv,
        "对承印材料本身进行切割、压痕或成形的印后工序 — 模切、激光切割、半切、压痕、打孔线与铣切。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/completions/structural-finishing/die-cutting>,
        <https://ptpge.org/v1/printing/completions/structural-finishing/drilling>,
        <https://ptpge.org/v1/printing/completions/structural-finishing/guillotine-cutting>,
        <https://ptpge.org/v1/printing/completions/structural-finishing/kiss-cutting>,
        <https://ptpge.org/v1/printing/completions/structural-finishing/laser-cutting>,
        <https://ptpge.org/v1/printing/completions/structural-finishing/perforation>,
        <https://ptpge.org/v1/printing/completions/structural-finishing/routing>,
        <https://ptpge.org/v1/printing/completions/structural-finishing/scoring> ;
    skos:notation "P:CP-MFN" ;
    skos:prefLabel "Strukturel efterbehandling"@da,
        "Strukturelle Weiterverarbeitung"@de,
        "Structural Finishing"@en,
        "Structural Finishing"@es,
        "संरचनात्मक फ़िनिशिंग"@hi,
        "Structural Finishing"@ja,
        "Strukturell etterbehandling"@nb,
        "Structurele afwerking"@nl,
        "Obróbka konstrukcyjna"@pl,
        "Acabamento estrutural"@pt,
        "Strukturell efterbehandling"@sv,
        "Structural Finishing"@zh-Hans ;
    ptpge:group "completions" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/configurations/winding-direction> a skos:Concept ;
    dcterms:created "2026-09-05T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/v1/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations> ;
    skos:definition "Hvordan en færdig etiket eller sticker ligger på rullen: rullet med tryksiden ud eller ind, og hvilken kant der forlader rullen først (top, bund, højre eller venstre). De otte positioner følger FINAT-nummereringen, der bruges i hele den selvklæbende etiketbranche (1–4 trykside ud, 5–8 trykside ind), og som XJDF overtager som Component/@WindingResult. Synligt for køberen: en applikator accepterer kun én retning."@da,
        "Wie ein fertiges Etikett auf der Rolle liegt: mit der Druckseite außen oder innen gewickelt, und welche Kante die Rolle zuerst verlässt (oben, unten, rechts oder links). Die acht Positionen folgen der FINAT-Nummerierung der Haftetikettenbranche (1–4 Druckseite außen, 5–8 innen), die XJDF als Component/@WindingResult übernimmt. Käuferrelevant: ein Spender akzeptiert nur eine Richtung."@de,
        "How a finished label or sticker sits on its roll: wound with the printed face outside or inside, and which edge of the label leaves the roll first (top, bottom, right or left). The eight positions follow the FINAT numbering used throughout the self-adhesive label trade (1–4 face out, 5–8 face in), which XJDF adopts as Component/@WindingResult. Buyer-visible: an applicator accepts one direction only."@en,
        "Cómo queda una etiqueta o adhesivo acabado en su bobina: bobinado con la cara impresa hacia fuera o hacia dentro, y qué borde sale primero de la bobina (superior, inferior, derecho o izquierdo). Las ocho posiciones siguen la numeración FINAT usada en el sector de la etiqueta autoadhesiva (1–4 cara fuera, 5–8 cara dentro), que XJDF adopta como Component/@WindingResult. Visible para el comprador: una aplicadora acepta una sola dirección."@es,
        "तैयार लेबल या स्टिकर रोल पर कैसे बैठता है: छपा चेहरा बाहर या अंदर लपेटा, और लेबल का कौन-सा किनारा रोल से पहले निकलता है (ऊपर, नीचे, दायाँ या बायाँ)। आठ स्थितियाँ स्वयं-चिपकने वाले लेबल उद्योग में प्रचलित FINAT क्रमांकन का पालन करती हैं (1–4 चेहरा बाहर, 5–8 चेहरा अंदर), जिसे XJDF Component/@WindingResult के रूप में अपनाता है। खरीदार को दिखने वाला: एप्लिकेटर केवल एक दिशा स्वीकार करता है।"@hi,
        "仕上がったラベルやステッカーがロール上でどう巻かれているか：印刷面が外巻きか内巻きか、そしてどの辺が先に繰り出されるか（上・下・右・左）。8 つの位置は粘着ラベル業界で用いられる FINAT 番号（1〜4 が外巻き、5〜8 が内巻き）に従い、XJDF はこれを Component/@WindingResult として採用している。購入者に見える属性：ラベラーは一方向しか受け付けない。"@ja,
        "Hvordan en ferdig etikett eller sticker ligger på rullen: viklet med trykksiden ut eller inn, og hvilken kant som forlater rullen først (topp, bunn, høyre eller venstre). De åtte posisjonene følger FINAT-nummereringen som brukes i hele etikettbransjen (1–4 trykkside ut, 5–8 trykkside inn), og som XJDF adopterer som Component/@WindingResult. Kjøpersynlig: en applikator tar imot én retning."@nb,
        "Hoe een afgewerkt etiket of sticker op de rol zit: gewikkeld met de bedrukte zijde buiten of binnen, en welke rand de rol als eerste verlaat (boven, onder, rechts of links). De acht posities volgen de FINAT-nummering die in de zelfklevende-etikettenbranche wordt gebruikt (1–4 beeld buiten, 5–8 beeld binnen), door XJDF overgenomen als Component/@WindingResult. Zichtbaar voor de koper: een applicator accepteert één richting."@nl,
        "Jak gotowa etykieta lub naklejka leży na roli: nawinięta zadrukowaną stroną na zewnątrz lub do wewnątrz oraz która krawędź etykiety schodzi z roli jako pierwsza (górna, dolna, prawa lub lewa). Osiem pozycji odpowiada numeracji FINAT używanej w całej branży etykiet samoprzylepnych (1–4 stroną na zewnątrz, 5–8 stroną do wewnątrz), którą XJDF przyjmuje jako Component/@WindingResult. Widoczne dla nabywcy: aplikator przyjmuje tylko jeden kierunek."@pl,
        "Como um rótulo ou adesivo acabado fica no rolo: enrolado com a face impressa para fora ou para dentro, e qual borda do rótulo sai primeiro do rolo (superior, inferior, direita ou esquerda). As oito posições seguem a numeração FINAT usada em todo o setor de etiquetas autoadesivas (1–4 face para fora, 5–8 face para dentro), que o XJDF adota como Component/@WindingResult. Visível ao comprador: um aplicador aceita apenas um sentido."@pt,
        "Hur en färdig etikett eller dekal sitter på rullen: rullad med tryckytan utåt eller inåt, och vilken kant som lämnar rullen först (topp, botten, höger eller vänster). De åtta lägena följer FINAT-numreringen som används i hela den självhäftande etikettbranschen (1–4 tryck ut, 5–8 tryck in), som XJDF tar upp som Component/@WindingResult. Synligt för köparen: en applikator tar bara en riktning."@sv,
        "成品标签或贴纸在卷上的方式：印刷面朝外或朝内卷绕，以及哪一边先出卷（上、下、右或左）。八个位置遵循不干胶标签行业通用的 FINAT 编号（1–4 面朝外，5–8 面朝内），XJDF 将其采用为 Component/@WindingResult。买方可见：贴标机只接受一种方向。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/winding-direction/finat-1>,
        <https://ptpge.org/v1/printing/configurations/winding-direction/finat-2>,
        <https://ptpge.org/v1/printing/configurations/winding-direction/finat-3>,
        <https://ptpge.org/v1/printing/configurations/winding-direction/finat-4>,
        <https://ptpge.org/v1/printing/configurations/winding-direction/finat-5>,
        <https://ptpge.org/v1/printing/configurations/winding-direction/finat-6>,
        <https://ptpge.org/v1/printing/configurations/winding-direction/finat-7>,
        <https://ptpge.org/v1/printing/configurations/winding-direction/finat-8> ;
    skos:notation "P:CF-WDR" ;
    skos:prefLabel "Rulleretning"@da,
        "Wickelrichtung"@de,
        "Winding Direction"@en,
        "Sentido de bobinado"@es,
        "वाइंडिंग दिशा"@hi,
        "巻き方向"@ja,
        "Viklingsretning"@nb,
        "Wikkelrichting"@nl,
        "Kierunek nawijania"@pl,
        "Sentido de enrolamento"@pt,
        "Rullriktning"@sv,
        "卷绕方向"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.6.38 · p.113",
                "§6.18 · p.176" ;
            ptpge:mappingRow "Component@WindingResult" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Component",
                "Component@WindingResult",
                "Winding" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-05" .

<https://ptpge.org/v1/printing/features/surface-finish/lamination/silk> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Satin Lamination"@en,
        "Satin laminated"@en,
        "Satin lamination"@en,
        "Silk laminated"@en,
        "सिल्क लैमिनेट"@hi,
        "सैटिन फ़िनिश लैमिनेशन"@hi,
        "सैटिन लैमिनेशन"@hi,
        "Satenglaminering"@nb,
        "Silke-laminering"@nb,
        "Silkematt laminering"@nb,
        "folia satynowa"@pl,
        "folia silk"@pl,
        "laminat satynowy"@pl,
        "acetinado"@pt,
        "laminação cetim"@pt,
        "laminação satin"@pt,
        "laminação seda"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/surface-finish/lamination> ;
    skos:definition "Silkeplastfilm lamineret på den trykte overflade. Giver en glat, let satineret finish mellem mat og blank — hverken kedelig eller stærkt reflekterende. Diskret eksklusiv fornemmelse, ofte valgt til redaktionelt arbejde."@da,
        "Seiden-Kunststofffilm, der auf die bedruckte Oberfläche laminiert wird. Bietet ein glattes, leicht satiniertes Finish zwischen matt und glänzend."@de,
        "Silk plastic film laminated to the printed surface. Provides a smooth, slightly satin finish between matte and gloss — neither dull nor highly reflective. Subtle premium feel, often chosen for editorial and corporate communications."@en,
        "Película plástica sedosa laminada sobre la superficie impresa. Un acabado suave, ligeramente satinado, entre mate y brillo — ni apagado ni muy reflectante. Sensación premium sutil, a menudo elegida para comunicaciones editoriales y corporativas."@es,
        "छपी सतह पर लैमिनेट की गई सिल्क प्लास्टिक फ़िल्म। मैट और ग्लॉस के बीच चिकनी, हल्की सैटिन फ़िनिश — न फीकी, न ज़्यादा चमकीली। सूक्ष्म प्रीमियम अहसास, अक्सर संपादकीय और कॉर्पोरेट संचार में।"@hi,
        "印刷面に貼り合わせるシルクフィルム。マットとグロスの中間の、滑らかでわずかにサテン調の仕上げ — 沈まず、強く反射もしない。さりげない上質感があり、エディトリアルやコーポレートのコミュニケーションによく選ばれる。"@ja,
        "Silke plastikkfilm laminert til den trykte overflaten. Gir en glatt, lett satin finish mellom matt og glans — verken matt eller svært reflekterende. Subtil premium-følelse, ofte valgt for redaksjonell og bedriftskommunikasjon."@nb,
        "Silk-kunststoffilm gelamineerd op het gedrukte oppervlak. Geeft een gladde, licht satijnen afwerking tussen mat en glanzend — subtiel exclusief gevoel, vaak gekozen voor redactioneel werk."@nl,
        "Satynowa folia laminowana na zadrukowanej powierzchni. Daje gładkie, lekko satynowe wykończenie między matem a połyskiem — ani matowe, ani silnie odbijające. Subtelne odczucie premium, często wybierane do komunikacji redakcyjnej i korporacyjnej."@pl,
        "Filme plástico acetinado laminado sobre a superfície impressa. Dá um acabamento liso, levemente acetinado, entre fosco e brilho — nem opaco nem muito reflexivo. Toque premium sutil, escolhido com frequência para comunicação editorial e corporativa."@pt,
        "Silkplastfilm laminerad på tryckytan. Ger en slät, lätt satinerad finish mellan matt och blank — varken glanslös eller starkt reflekterande. Subtil premiumkänsla, ofta vald för redaktionell och företagskommunikation."@sv,
        "复合在印刷表面的丝光塑料薄膜。介于哑光与亮光之间的平滑微缎面效果 — 既不沉闷也不强反光。低调的高级质感，常用于出版物与企业宣传材料。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§SILK-LAMINATION" ;
    skos:prefLabel "Silkelaminering"@da,
        "Seiden-Laminierung"@de,
        "Silk Lamination"@en,
        "Laminado seda"@es,
        "सिल्क लैमिनेशन"@hi,
        "シルクラミネート"@ja,
        "Silke-laminering"@nb,
        "Zijdeglanslaminaat"@nl,
        "Laminowanie satynowe"@pl,
        "Laminação acetinada"@pt,
        "Silklaminering"@sv,
        "丝绒覆膜"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.9 · p.78",
                "§5.6.23 · p.125" ;
            ptpge:mappingRow "crosswalk row 45" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Laminating",
                "LaminatingIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "Colour Matching Systems"@en,
        "systemy dopasowania kolorów"@pl,
        "wzorniki kolorów"@pl ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems> ;
    skos:definition "Proprietære eller branchefælles farvebiblioteker, der giver hver farve en unik identifikator og muliggør præcis specifikation og gengivelse på tværs af leverandører og oplag."@da,
        "Proprietäre oder branchenweite Farbbibliotheken, die jeder Farbe einen eindeutigen Identifikator zuweisen und so eine exakte Spezifikation und Reproduktion über Lieferanten und Druckläufe hinweg ermöglichen."@de,
        "Proprietary or industry color libraries that assign each color a unique identifier, enabling exact specification and reproduction across vendors and print runs."@en,
        "Bibliotecas de color propietarias o industriales que asignan a cada color un identificador único, permitiendo la especificación exacta y la reproducción entre proveedores y tiradas."@es,
        "स्वामित्व या उद्योग रंग पुस्तकालय जो हर रंग को एक अद्वितीय पहचानकर्ता देते हैं, जिससे विक्रेताओं और प्रिंट रन में सटीक विनिर्देश और पुनरुत्पादन संभव होता है।"@hi,
        "各色に固有の識別子を割り当てる業界またはメーカー独自のカラーライブラリ。ベンダー間および印刷ロット間で正確な指定と再現を可能にする。"@ja,
        "Proprietære eller bransjespesifikke fargebiblioteker som tildeler hver farge en unik identifikator, slik at eksakt spesifikasjon og reproduksjon på tvers av leverandører og opplag er mulig."@nb,
        "Eigen of branchebrede kleurbibliotheken die elke kleur een unieke identificatie geven, waardoor exacte specificatie en reproductie over leveranciers en oplagen heen mogelijk is."@nl,
        "Własnościowe lub branżowe biblioteki barw przypisujące każdej barwie unikatowy identyfikator, umożliwiające dokładną specyfikację i reprodukcję między dostawcami i nakładami."@pl,
        "Bibliotecas de cor proprietárias ou setoriais que atribuem a cada cor um identificador único, permitindo especificação e reprodução exatas entre fornecedores e tiragens."@pt,
        "Proprietära eller branschgemensamma färgbibliotek som ger varje kulör en unik identifierare, vilket möjliggör exakt specifikation och återgivning över leverantörer och upplagor."@sv,
        "专属或行业色彩库，为每种颜色分配唯一标识符，实现跨供应商和印次的精确规范和再现。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/dic>,
        <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/hks>,
        <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/ncs>,
        <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/pantone-matching-system>,
        <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/ral>,
        <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/sms>,
        <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/toyo> ;
    skos:notation "P:ST-CSY-CMTC" ;
    skos:prefLabel "Farvematchsystemer"@da,
        "Farbabstimmungssysteme"@de,
        "Color Matching Systems"@en,
        "Sistemas de Igualación de Color"@es,
        "रंग मिलान प्रणालियाँ"@hi,
        "色見本システム"@ja,
        "Fargesammenligningssystemer"@nb,
        "Kleurmatchsystemen"@nl,
        "Systemy wzorcowania barw"@pl,
        "Sistemas de correspondência de cor"@pt,
        "Färgmatchningssystem"@sv,
        "色彩匹配系统"@zh-Hans ;
    skos:scopeNote "Umfasst Pantone Matching System (PMS) — den dominierenden Industriestandard — und Idealliance G7/G7+ für die Kalibrierung von Graustufen- und Farbdruckverfahren. Daraus abgeleitete unternehmenseigene Farbbibliotheken sind keine eigenständigen Einträge."@de,
        "Includes Pantone Matching System (PMS) — the dominant industry standard — and Idealliance G7/G7+ for grayscale and color-printing process calibration. Custom corporate color libraries derived from these systems are not separate entries."@en,
        "Incluye Pantone Matching System (PMS) — el estándar dominante de la industria — e Idealliance G7/G7+ para escala de grises y calibración de procesos de impresión a color. Las bibliotecas corporativas personalizadas derivadas de Pantone se rastrean como casos de uso, no como sistemas formales."@es,
        "Pantone Matching System (PMS) — प्रमुख उद्योग मानक — और ग्रेस्केल व रंग-मुद्रण प्रक्रिया अंशांकन के लिए Idealliance G7/G7+ शामिल। इन प्रणालियों से व्युत्पन्न कस्टम कॉर्पोरेट रंग पुस्तकालय अलग प्रविष्टियाँ नहीं हैं।"@hi,
        "業界の事実上の標準であるPantone Matching System（PMS）と、グレースケールおよびカラー印刷工程の校正用のIdealliance G7/G7+を含む。これらのシステムから派生したカスタム企業向けカラーライブラリは別個のエントリとはしない。"@ja,
        "Inkluderer Pantone Matching System (PMS) — den dominerende bransjestandarden — og Idealliance G7/G7+ for kalibrering av gråtoner og prosessfarger. Egendefinerte bedriftsfargebiblioteker basert på disse systemene er ikke separate oppføringer."@nb,
        "Inclui o Pantone Matching System (PMS) — a norma dominante do setor — e o G7/G7+ da Idealliance para calibração de processo em escala de cinza e impressão em cores. Bibliotecas corporativas personalizadas derivadas destes sistemas não são entradas separadas."@pt,
        "包括Pantone Matching System（PMS）——行业主导标准——以及用于灰阶和彩色印刷工艺校准的Idealliance G7/G7+。基于Pantone派生的企业自定义色彩库按用例跟踪，而非作为正式系统。"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.14 · p.166",
                "§6.15 · p.168",
                "§6.17 · p.172" ;
            ptpge:mappingRow "crosswalk row 4" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Color",
                "ColorSpaceConversionParams",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-08-27" .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes> a skos:Concept ;
    dcterms:created "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T16:40:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper> ;
    skos:definition "De fem tryksubstratklasser i ISO 12647-2:2013 (PS1–PS5) — offsetprocesstandardens egen papirklassificering, fra premium bestrøget til ubestrøget træfrit. Supplerer vægt- og overfladefacetterne; ubundet betyder uspecificeret."@da,
        "Die fünf Bedruckstoffklassen der ISO 12647-2:2013 (PS1–PS5) — die papiereigene Klassifikation des Offset-Prozessstandards, von Premium gestrichen bis ungestrichen holzfrei. Ergänzt Gewichts- und Oberflächenfacetten; ungebunden bedeutet unspezifiziert."@de,
        "The five printing-substrate classes of ISO 12647-2:2013 (PS1–PS5) — the offset process-control standard's own classification of paper, from premium coated to wood-free uncoated. Complements the weight and surface facets; unbound means unspecified."@en,
        "Las cinco clases de sustrato de impresión de ISO 12647-2:2013 (PS1–PS5): la clasificación de papel propia del estándar de control de proceso ófset, desde estucado premium hasta no estucado libre de madera. Complementa las facetas de gramaje y superficie; sin vincular significa sin especificar."@es,
        "ISO 12647-2:2013 के पाँच मुद्रण-सब्सट्रेट वर्ग (PS1–PS5) — ऑफसेट प्रक्रिया-नियंत्रण मानक का अपना काग़ज़ वर्गीकरण, प्रीमियम कोटेड से वुड-फ़्री अनकोटेड तक। वज़न और सतह पहलुओं का पूरक; अनबाउंड का अर्थ अनिर्दिष्ट।"@hi,
        "ISO 12647-2:2013 が定める5つの印刷用紙クラス（PS1–PS5）。オフセット工程管理規格自身による用紙分類で、プレミアム塗工紙から上質紙（非塗工）まで。坪量・表面のファセットを補完する。未束縛は未指定を意味する。"@ja,
        "De fem trykksubstrat-klassene i ISO 12647-2:2013 (PS1–PS5) — offset-prosesstandardens egen papirklassifisering, fra premium bestrøket til ubestrøket trefritt. Utfyller vekt- og overflatefasettene; ubundet betyr uspesifisert."@nb,
        "De vijf drukdrager-klassen van ISO 12647-2:2013 (PS1–PS5) — de papierclassificatie van de offset-procesnorm zelf, van premium gestreken tot houtvrij ongestreken. Vult de gewichts- en oppervlaktefacetten aan; ongebonden betekent niet gespecificeerd."@nl,
        "Pięć klas podłoży drukowych wg ISO 12647-2:2013 (PS1–PS5) — własna klasyfikacja papieru normy kontroli procesu offsetowego, od powlekanego premium po niepowlekany bezdrzewny. Uzupełnia aspekty gramatury i powierzchni; brak wartości oznacza nieokreślone."@pl,
        "As cinco classes de substrato de impressão da ISO 12647-2:2013 (PS1–PS5) — a própria classificação de papel da norma de controle de processo offset, do couché premium ao offset sem pasta mecânica. Complementa as facetas de gramatura e superfície; não vinculado significa não especificado."@pt,
        "De fem trycksubstratklasserna i ISO 12647-2:2013 (PS1–PS5) — offsetprocesstandardens egen pappersklassificering, från premium bestruket till obestruket träfritt. Kompletterar vikt- och ytfasetterna; obundet betyder ospecificerat."@sv,
        "ISO 12647-2:2013 定义的五个印刷承印物类别（PS1–PS5）——胶印过程控制标准自身的纸张分类，从高级涂布纸到非涂布无木浆纸。与克重和表面分面互补；未绑定即未指定。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps1-premium-coated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps2-improved-coated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps3-standard-glossy-coated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps4-standard-matte-coated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps5-wood-free-uncoated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps6-super-calendered>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps7-improved-uncoated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps8-standard-uncoated> ;
    skos:notation "P:SB-SHT-PAPR-CLS" ;
    skos:prefLabel "Papirklasser"@da,
        "Papierklassen"@de,
        "Paper Classes"@en,
        "Clases de papel"@es,
        "काग़ज़ वर्ग"@hi,
        "用紙クラス"@ja,
        "Papirklasser"@nb,
        "Papierklassen"@nl,
        "Klasy papieru"@pl,
        "Classes de papel"@pt,
        "Pappersklasser"@sv,
        "纸张类别"@zh-Hans ;
    skos:related <https://ptpge.org/v1/printing/standards/print-standards/iso-12647-2> ;
    ptpge:group "substrates" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.11 · p.79",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 29" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media",
                "MediaIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-03" .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper> ;
    skos:definition "Papirvægtkategorier målt i gram pr. kvadratmeter (g/m²) — tungere vægte giver tykkere, stivere papir, mens lettere vægte er økonomiske og lette at false."@da,
        "Grammatur-Kategorien für Papier, gemessen in Gramm pro Quadratmeter (g/m²) — höhere Grammaturen erzeugen dickeres, steiferes Papier, niedrigere sind wirtschaftlicher und leichter zu falzen."@de,
        "Paper weight categories measured in grams per square meter (gsm) — heavier weights produce thicker, stiffer paper while lighter weights are economical and easy to fold."@en,
        "Categorías de gramaje del papel medidas en gramos por metro cuadrado (gsm) — los gramajes más altos producen papel más grueso y rígido, mientras que los más bajos son económicos y fáciles de plegar."@es,
        "ग्राम प्रति वर्ग मीटर (GSM) में मापे गए काग़ज़ वज़न के वर्ग — भारी वज़न मोटा, कड़ा काग़ज़ देता है जबकि हल्का वज़न किफ़ायती और मोड़ने में आसान।"@hi,
        "1平方メートルあたりのグラム数（gsm）で測定される坪量カテゴリ — 重い坪量はより厚く硬い紙を生み、軽い坪量は経済的で折りやすい。"@ja,
        "Papirvektkategorier målt i gram per kvadratmeter (gsm) — tyngre vekter gir tykkere, stivere papir, mens lettere vekter er økonomiske og lette å brette."@nb,
        "Papiergewichtcategorieën gemeten in gram per vierkante meter (g/m²) — zwaardere gewichten geven dikker, stijver papier, terwijl lichtere gewichten economisch zijn en makkelijk vouwen."@nl,
        "Kategorie gramatury papieru mierzonej w gramach na metr kwadratowy (g/m²) — wyższe gramatury dają grubszy, sztywniejszy papier, a niższe są ekonomiczne i łatwe do składania."@pl,
        "Categorias de gramatura do papel medidas em gramas por metro quadrado (g/m²) — gramaturas maiores dão papel mais espesso e rígido, enquanto as menores são econômicas e fáceis de dobrar."@pt,
        "Papperets viktkategorier mätta i gram per kvadratmeter (g/m²) — högre vikter ger tjockare, styvare papper medan lägre vikter är ekonomiska och lätta att falsa."@sv,
        "以克/平方米（gsm）为单位测量的纸张克重类别——较重的克重产生较厚、较硬的纸，而较轻的克重经济且易于折叠。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/extra-heavy-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/extra-light-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/extra-thick-cardstock>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/heavy-medium-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/heavy-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/light-medium-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/light-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/medium-paper> ;
    skos:notation "P:SB-SHT-PAPR-PWGT" ;
    skos:prefLabel "Papirvægte"@da,
        "Papiergewichte"@de,
        "Paper Weights"@en,
        "Gramajes de Papel"@es,
        "काग़ज़ का वज़न"@hi,
        "用紙の坪量"@ja,
        "Papirvekter"@nb,
        "Papiergewichten"@nl,
        "Gramatury papieru"@pl,
        "Gramaturas de papel"@pt,
        "Pappersvikter"@sv,
        "纸张克重"@zh-Hans ;
    skos:scopeNote "Reicht von extra leicht (50–79 g/m² — Zeitungsdruck, leichte Publikationen) über mittel (150–179 g/m² — Briefpapier, Broschüren) bis zu extra-dickem Karton (450+ g/m² — Premium-Visitenkarten, Verpackungen). Die Grenze zwischen Papier und Karton liegt typischerweise bei rund 200 g/m²."@de,
        "Ranges from extra light (50–79 gsm — newsprint, lightweight publication) through medium (150–179 gsm — letterheads, brochures) to extra-thick cardstock (450+ gsm — premium business cards, packaging). The boundary between paper and cardstock typically falls around 200 gsm."@en,
        "Va desde extra ligero (50–79 gsm — papel de prensa, publicaciones ligeras) pasando por medio (150–179 gsm — membretes, folletos) hasta cartulinas extra gruesas (450+ gsm — tarjetas de visita premium, packaging). Los rangos se superponen y el gramaje exacto depende del proveedor y de la máquina."@es,
        "एक्स्ट्रा लाइट (50–79 GSM — न्यूज़प्रिंट, हल्के प्रकाशन) से मीडियम (150–179 GSM — लेटरहेड, ब्रोशर) से एक्स्ट्रा-थिक कार्डस्टॉक (450+ GSM — प्रीमियम विज़िटिंग कार्ड, पैकेजिंग) तक। काग़ज़ और कार्डस्टॉक की सीमा आमतौर पर 200 GSM के आसपास।"@hi,
        "極軽（50〜79gsm — 新聞用紙、軽量出版物）から、中量（150〜179gsm — 便箋、ブローシュア）、超厚カード紙（450gsm以上 — プレミアム名刺、パッケージ）まで及ぶ。紙とカード紙の境界は通常200gsm前後。"@ja,
        "Strekker seg fra ekstra lett (50–79 gsm — avispapir, lett publikasjon) via medium (150–179 gsm — brevhoder, brosjyrer) til ekstra tykt kartong (450+ gsm — premium-visittkort, emballasje). Grensen mellom papir og kartong ligger typisk rundt 200 gsm."@nb,
        "Vai de extra leve (50–79 g/m² — jornal, publicações leves), passando por médio (150–179 g/m² — papel timbrado, folhetos), até cartão extra grosso (450+ g/m² — cartões de visita premium, embalagens). A fronteira entre papel e cartão fica normalmente em torno de 200 g/m²."@pt,
        "范围从超轻（50–79克——新闻纸、轻型出版物）经中等（150–179克——信纸、宣传册）到超厚卡纸（450+克——优质名片、包装）。范围会重叠，确切克重取决于供应商和印刷机。"@zh-Hans ;
    ptpge:group "substrates" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.11 · p.79",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 29" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media",
                "MediaIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/technologies/printing-technologies/analog/letterpress> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:42:30+00:00"^^xsd:dateTime ;
    skos:altLabel "Højtryk"@da,
        "Relief printing"@en,
        "रिलीफ़ मुद्रण"@hi,
        "Boktrykk"@nb,
        "Høytrykk"@nb,
        "boekdruk"@nl,
        "druk typograficzny"@pl,
        "druk wypukły"@pl,
        "letterpress"@pl,
        "Impressão em relevo"@pt,
        "Impressão tipográfica"@pt,
        "Letterpress"@pt,
        "Högtryck"@sv ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-technologies/analog> ;
    skos:definition "Højtryksteknik, hvor ophøjede metal- eller polymertyper indfarves og presses mod substratet — den oprindelige masseoplagsmetode introduceret af Gutenberg i 1450’erne. Bruges i dag til taktilt eksklusivt tryk af kontortryksager og invitationer."@da,
        "Hochdrucktechnologie, bei der erhabene Metall- oder Polymerlettern eingefärbt und in den Bedruckstoff gepresst werden — die ursprüngliche Massendruckmethode, von Gutenberg in den 1450er-Jahren eingeführt. Heute eingesetzt für hochwertigen taktilen Druck von Briefpapieren und Einladungen."@de,
        "Relief printing technology where raised metal or polymer type is inked and pressed into the substrate — the original mass-printing method introduced by Gutenberg in the 1450s. Today used for premium tactile printing of stationery and invitations."@en,
        "Tecnología tradicional de impresión en relieve que utiliza tipos móviles o planchas de fotopolímero. Hoy nicho artesanal — invitaciones, papelería premium — apreciada por la huella táctil del impacto."@es,
        "रिलीफ़ मुद्रण तकनीक जिसमें उभरे धातु या पॉलिमर टाइप पर स्याही लगाकर सब्सट्रेट में दबाया जाता है — 1450 के दशक में गुटेनबर्ग द्वारा शुरू की गई मूल जन-मुद्रण विधि। आज स्टेशनरी और निमंत्रण-पत्रों की प्रीमियम स्पर्शनीय छपाई में।"@hi,
        "凸状の金属または樹脂活字にインキを着け、基材に押し付ける凸版印刷技術 — 1450年代にグーテンベルクが導入した元来の大量印刷方式。今日では便箋や招待状の高級な触覚的印刷に使用される。"@ja,
        "Relieff-trykketeknologi der opphøyd metall- eller polymertype påføres blekk og presses ned i substratet — den opprinnelige masseprodusjonsmetoden introdusert av Gutenberg på 1450-tallet. I dag brukt til premium taktil trykk av brevpapir og invitasjoner."@nb,
        "Hoogdruktechnologie waarbij verhoogde metalen of polymeer letters worden geïnkt en in het substraat gedrukt — de oorspronkelijke massadrukmethode, geïntroduceerd door Gutenberg in de jaren 1450. Vandaag gebruikt voor tactiel premium drukwerk van kantoordrukwerk en uitnodigingen."@nl,
        "Technologia druku wypukłego, w której wypukłe czcionki metalowe lub polimerowe są farbowane i wciskane w podłoże — pierwotna metoda druku masowego wprowadzona przez Gutenberga w latach 50. XV w. Dziś używana do dotykowego druku premium papeterii i zaproszeń."@pl,
        "Tecnologia de impressão em relevo em que tipos elevados de metal ou polímero são entintados e pressionados contra o substrato — o método original de impressão em massa introduzido por Gutenberg nos anos 1450. Hoje usada em impressão tátil premium de papelaria e convites."@pt,
        "Höghtrycksteknik där upphöjd metall- eller polymertyp infärgas och pressas mot substratet — den ursprungliga massupplagemetoden introducerad av Gutenberg på 1450-talet. Används i dag för taktilt premiumtryck av kontorstrycksaker och inbjudningar."@sv,
        "使用活字或光聚合物印版的传统凸版印刷技术。如今是利基的手工艺——请柬、高级文具——因压痕留下的触感印记而被欣赏。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC§LETTERPRESS" ;
    skos:prefLabel "Bogtryk"@da,
        "Buchdruck"@de,
        "Letterpress"@en,
        "Tipografía (Letterpress)"@es,
        "लेटरप्रेस"@hi,
        "活版印刷"@ja,
        "Bokstavtrykk"@nb,
        "Hoogdruk (boekdruk)"@nl,
        "Typografia"@pl,
        "Tipografia"@pt,
        "Boktryck"@sv,
        "活字印刷"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "technologies" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.12 · p.81",
                "§5.5.1 · p.110" ;
            ptpge:mappingRow "crosswalk row 16" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "ConventionalPrinting",
                "ProductionIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/ordering/use-cases> a skos:Concept ;
    dcterms:created "2026-05-20T10:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:31:34+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering> ;
    skos:definition "Kontrolleret vokabular, der beskriver hvordan trykte produkter typisk bruges. Refereres af produktskabeloner via `ptpge:typicalUse`, som er en liste af URI-referencer ind i denne kategori. Giver standardiseret købersprog til søgning, filtrering og produktmatchning."@da,
        "Kontrolliertes Vokabular, das beschreibt, wie Druckprodukte typischerweise verwendet werden. Wird von Product Templates über `ptpge:typicalUse` referenziert, eine Liste von URI-Referenzen in diese Kategorie."@de,
        "Controlled vocabulary describing how printed products are typically used. Referenced by Product Templates via `ptpge:typicalUse`, which is a list of URI references into this category. Provides standardised buyer-facing language for search, filtering, and product matching."@en,
        "Vocabulario controlado que describe cómo se utilizan típicamente los productos impresos. Es referenciado por Product Templates mediante `ptpge:typicalUse`, una lista de referencias URI dentro de esta categoría. Proporciona un lenguaje estandarizado orientado al comprador para búsqueda, filtrado y emparejamiento de productos."@es,
        "मुद्रित उत्पादों के सामान्य उपयोग का वर्णन करने वाला नियंत्रित शब्दकोश। उत्पाद टेम्पलेट `ptpge:typicalUse` के ज़रिए इसे संदर्भित करते हैं — इस श्रेणी में URI संदर्भों की सूची। खोज, फ़िल्टर और उत्पाद मिलान के लिए खरीदार-उन्मुख मानकीकृत भाषा देता है।"@hi,
        "印刷物が典型的にどのように使用されるかを記述する統制語彙。Product Templates から `ptpge:typicalUse`（このカテゴリ内のURI参照のリスト）を介して参照される。検索、フィルタリング、製品マッチングのための、購入者向けに標準化された言語を提供する。"@ja,
        "Kontrollert vokabular som beskriver hvordan trykkprodukter typisk brukes. Refereres av Product Templates via `ptpge:typicalUse`, som er en liste av URI-referanser inn i denne kategorien. Gir standardisert kjøper-rettet språk for søk, filtrering og produktmatching."@nb,
        "Gecontroleerd vocabulaire dat beschrijft hoe drukwerk doorgaans wordt gebruikt. Wordt door productsjablonen gerefereerd via `ptpge:typicalUse`, een lijst van URI-verwijzingen naar deze categorie. Biedt gestandaardiseerde kopersgerichte taal voor zoeken, filteren en productmatching."@nl,
        "Kontrolowane słownictwo opisujące typowe zastosowania produktów drukowanych. Przywoływane przez szablony produktów poprzez `ptpge:typicalUse`, będące listą odwołań URI do tej kategorii. Dostarcza ustandaryzowanego języka zorientowanego na nabywcę do wyszukiwania, filtrowania i dopasowywania produktów."@pl,
        "Vocabulário controlado que descreve como os impressos são normalmente usados. Referenciado pelos Modelos de Produto via `ptpge:typicalUse`, uma lista de referências URI para esta categoria. Fornece linguagem padronizada, voltada ao comprador, para busca, filtragem e correspondência de produtos."@pt,
        "Kontrollerad vokabulär som beskriver hur trycksaker typiskt används. Refereras av produktmallar via `ptpge:typicalUse`, en lista med URI-referenser in i denna kategori. Ger ett standardiserat köparvänt språk för sökning, filtrering och produktmatchning."@sv,
        "用于描述印刷品典型用途的受控词汇。Product Templates 通过 `ptpge:typicalUse`（指向本类目内 URI 引用的列表）进行引用。为搜索、筛选与产品匹配提供面向买方的标准化用语。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/ordering/use-cases/branding>,
        <https://ptpge.org/v1/ordering/use-cases/educational>,
        <https://ptpge.org/v1/ordering/use-cases/event-promotion>,
        <https://ptpge.org/v1/ordering/use-cases/informational>,
        <https://ptpge.org/v1/ordering/use-cases/instructional>,
        <https://ptpge.org/v1/ordering/use-cases/marketing>,
        <https://ptpge.org/v1/ordering/use-cases/networking>,
        <https://ptpge.org/v1/ordering/use-cases/packaging-presentation>,
        <https://ptpge.org/v1/ordering/use-cases/professional-contact>,
        <https://ptpge.org/v1/ordering/use-cases/wayfinding> ;
    skos:notation "O:UC" ;
    skos:prefLabel "Anvendelser"@da,
        "Anwendungsfälle"@de,
        "Use Cases"@en,
        "Casos de Uso"@es,
        "उपयोग के मामले"@hi,
        "ユースケース"@ja,
        "Bruksområder"@nb,
        "Toepassingen"@nl,
        "Przypadki użycia"@pl,
        "Casos de uso"@pt,
        "Användningsområden"@sv,
        "使用场景"@zh-Hans ;
    skos:scopeNote "v1 ships with 10 initial use cases covering the most common buyer intents. The vocabulary expands as new product domains are modelled. New values follow the standard term-addition workflow (see PTPGE-Product-Model.md § 11.3)."@en,
        "v1 में 10 प्रारंभिक उपयोग-मामले हैं जो खरीदार के सबसे आम इरादे कवर करते हैं। नए उत्पाद क्षेत्र मॉडल होने पर शब्दकोश बढ़ता है। नए मान मानक पद-जोड़ने की प्रक्रिया का पालन करते हैं (देखें PTPGE-Product-Model.md § 11.3)।"@hi,
        "A v1 traz 10 casos de uso iniciais que cobrem as intenções de compra mais comuns. O vocabulário cresce à medida que novos domínios de produto são modelados. Novos valores seguem o fluxo padrão de adição de termos (ver PTPGE-Product-Model.md § 11.3)."@pt ;
    ptpge:group "use-cases" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/colors> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Print Colours"@en,
        "छपाई के रंग"@hi,
        "प्रिंट कलर"@hi,
        "स्याही"@hi,
        "barwy druku"@pl,
        "cores de impressão"@pt,
        "tintas"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features> ;
    skos:definition "Farvelag er det inderste lag i trykklagstakken — trykfarve påført direkte på substratet. Hver farvelags-URI beskriver en kombination af farver (en farvetilstand): CMYK, Pantone-staffage, sort m.fl."@da,
        "Color Layers sind die innerste Schicht des Druckschichten-Stacks — Druckfarbe, die direkt auf das Substrat aufgebracht wird. Jede Color Layer-URI beschreibt eine Druckfarben-Kombination (einen Farbmodus): CMYK, Pantone-Sonderfarbe, nur Schwarz usw."@de,
        "Color Layers are the innermost layer of the Print Layer Stack — ink applied directly to the substrate. Each Color Layer URI describes a combination of inks (a color mode): CMYK, Pantone spot, Black-only, etc. The Color Layer URI carries the ink colorant set, the color model (subtractive / additive), and the channel count."@en,
        "Las Color Layers describen los colores aplicados directamente al sustrato — la capa más interna del Print Layer Stack. Cada URI de Color Layer representa una combinación de tintas (modo de color): CMYK, color directo Pantone, solo negro, blanco, metálico, etc. Pueden incluir referencias al vocabulario de color definido en Color Systems (bajo Standards)."@es,
        "रंग परतें प्रिंट लेयर स्टैक की सबसे भीतरी परत हैं — सीधे सब्सट्रेट पर लगी स्याही। हर रंग-परत URI स्याहियों के संयोजन (कलर मोड) का वर्णन करता है: CMYK, पैंटोन स्पॉट, केवल काला आदि। रंग-परत URI में स्याही के रंजक-सेट, रंग मॉडल (घटाव/योग) और चैनल संख्या होती है।"@hi,
        "Color Layersは印刷物に直接適用される色 — Print Layer Stackの最内層 — を記述する。各Color Layer URIはインクの組み合わせ（カラーモード）を表す：CMYK、Pantoneスポット、ブラックのみ、ホワイト、メタリックなど。Color Systems（Standards下）が定義する色彩語彙への参照を含む場合もある。"@ja,
        "Color Layers er det innerste laget i trykklags-stacken — blekk påført direkte på substratet. Hver Color Layer-URI beskriver en blekk-kombinasjon (en fargemodus): CMYK, Pantone spot, kun sort osv. Color Layer-URI-en bærer blekk-fargesett, fargemodell (subtraktiv / additiv) og kanal-antall."@nb,
        "Kleurlagen vormen de binnenste laag van de druklaagstapel — inkt direct op het substraat aangebracht. Elke kleurlaag-URI beschrijft een combinatie van inkten (een kleurmodus): CMYK, Pantone-steunkleur, zwart e.a."@nl,
        "Warstwy barwne są najgłębszą warstwą stosu warstw druku — farba nanoszona bezpośrednio na podłoże. Każde URI warstwy barwnej opisuje kombinację farb (tryb koloru): CMYK, kolor dodatkowy Pantone, tylko czerń itd. URI warstwy barwnej niesie zestaw kolorantów, model barw (subtraktywny / addytywny) i liczbę kanałów."@pl,
        "As camadas de cor são a camada mais interna da pilha de camadas de impressão — tinta aplicada diretamente no substrato. Cada URI de camada de cor descreve uma combinação de tintas (um modo de cor): CMYK, cor especial Pantone, só preto etc. A URI da camada de cor carrega o conjunto de corantes, o modelo de cor (subtrativo/aditivo) e o número de canais."@pt,
        "Färgskikt är det innersta skiktet i tryckskiktstacken — bläck applicerat direkt på substratet. Varje färgskikts-URI beskriver en kombination av bläck (ett färgläge): CMYK, Pantone-dekorfärg, endast svart, osv. Färgskikts-URI:n bär bläckuppsättningen, färgmodellen (subtraktiv/additiv) och kanalantalet."@sv,
        "Color Layers 描述直接施加于承印物的颜色——Print Layer Stack 的最内层。每个 Color Layer URI 表示一种油墨组合（颜色模式）：CMYK、Pantone 专色、单黑色、白色、金属色等。可包含对 Color Systems（位于 Standards 之下）所定义颜色词汇的引用。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/features/colors/black>,
        <https://ptpge.org/v1/printing/features/colors/cmyk>,
        <https://ptpge.org/v1/printing/features/colors/cmykog>,
        <https://ptpge.org/v1/printing/features/colors/cmykogv>,
        <https://ptpge.org/v1/printing/features/colors/none>,
        <https://ptpge.org/v1/printing/features/colors/spot-color>,
        <https://ptpge.org/v1/printing/features/colors/white> ;
    skos:notation "P:FT-COL" ;
    skos:prefLabel "Trykfarver"@da,
        "Farbschichten"@de,
        "Print Colors"@en,
        "Capas de color"@es,
        "प्रिंट रंग"@hi,
        "カラーレイヤー"@ja,
        "Trykkfarger"@nb,
        "Drukkleuren"@nl,
        "Kolory druku"@pl,
        "Cores de impressão"@pt,
        "Tryckfärger"@sv,
        "颜色层"@zh-Hans ;
    skos:related <https://ptpge.org/v1/printing/standards/color-systems> ;
    skos:scopeNote "Print Colors beschreibt die tatsächlich auf einem Druckerzeugnis angewendeten Farben — die Druckfarbschicht-Auswahl (CMYK, Pantone-Sonderfarbe, nur Schwarz, Weiß, metallic usw.). Verwandt mit, aber unterschieden von Color Systems unter Standards, das die Vokabulare und Rahmenwerke zur Farbspezifikation beschreibt. Eine Print Color kann ein Color System referenzieren (z. B. verweist eine Pantone-Sonderfarbe auf das Pantone-System)."@de,
        "Print Colors describes the actual colors applied to a printed piece — the ink layer choices (CMYK, Pantone spot, black-only, white, metallic, etc.). Related to but distinct from Color Systems under Standards, which describes the vocabularies and frameworks used to specify color. A Print Color may reference a Color System (e.g., a Pantone spot color references the Pantone system)."@en,
        "Print Colors describe los colores reales aplicados a una pieza impresa — las elecciones de capa de tinta (CMYK, color Pantone directo, solo negro, blanco, metálico, etc.). Relacionado pero distinto de Color Systems bajo Standards, que describe los vocabularios y marcos utilizados para especificar color. Un Print Color puede referenciar un Color System (p. ej., un color Pantone directo referencia el sistema Pantone)."@es,
        "प्रिंट रंग मुद्रित सामग्री पर वास्तव में लगाए गए रंगों का वर्णन करता है — स्याही परत के विकल्प (CMYK, पैंटोन स्पॉट, केवल काला, सफ़ेद, मेटैलिक आदि)। मानकों के अंतर्गत रंग प्रणालियों से संबंधित पर अलग, जो रंग निर्दिष्ट करने की शब्दावलियों और ढाँचों का वर्णन करती हैं। कोई प्रिंट रंग किसी रंग प्रणाली को संदर्भित कर सकता है (जैसे पैंटोन स्पॉट रंग पैंटोन प्रणाली को)।"@hi,
        "Print Colors は印刷物に実際に適用される色 — インク層の選択（CMYK、Pantone スポット、黒のみ、白、メタリックなど）を記述する。Standards 下の Color Systems とは関連するが区別される — Color Systems は色を指定するための語彙とフレームワークを記述する。Print Color は Color System を参照できる（例：Pantone スポットカラーは Pantone システムを参照する）。"@ja,
        "Print Colors beskriver de faktiske fargene som påføres en trykksak — blekklags-valgene (CMYK, Pantone spot, kun sort, hvit, metallisk, osv.). Relatert til, men forskjellig fra Color Systems under Standards, som beskriver vokabularene og rammeverkene som brukes til å spesifisere farge. En Print Color kan referere et Color System (f.eks. refererer en Pantone spot-farge Pantone-systemet)."@nb,
        "Cores de impressão descreve as cores realmente aplicadas ao impresso — as escolhas de camada de tinta (CMYK, cor especial Pantone, só preto, branco, metalizado etc.). Relacionado, mas distinto, de Sistemas de Cor em Normas, que descreve os vocabulários e estruturas usados para especificar cor. Uma cor de impressão pode referenciar um sistema de cor (p. ex., uma cor especial Pantone referencia o sistema Pantone)."@pt,
        "Print Colors 描述实际应用于印刷品上的颜色——油墨层的选择（CMYK、Pantone 专色、单黑色、白色、金属色等）。与 Standards 下的 Color Systems 有关但有所区别——Color Systems 描述用于指定颜色的词汇与框架。一个 Print Color 可以引用某个 Color System（例如 Pantone 专色引用 Pantone 系统）。"@zh-Hans ;
    ptpge:group "features" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.4 · p.72",
                "§6.15 · p.168" ;
            ptpge:mappingRow "crosswalk row 24" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "ColorIntent",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/embellishments/debossing> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Deboss"@en,
        "डिबॉस"@hi,
        "धँसा उभार"@hi,
        "नेगेटिव एम्बॉसिंग"@hi,
        "Nedsenket preging"@nb,
        "deboss"@pl,
        "wytłoczenie wklęsłe"@pl,
        "deboss"@pt,
        "relevo afundado"@pt,
        "relevo baixo"@pt,
        "relevo negativo"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/embellishments> ;
    skos:definition "Et reliefaftryk presset NED I substratet, der skaber et forsænket billede eller tekst. Udføres med en hanmatrice, der komprimerer substratet; ingen farve eller folie. Almindeligt på luksusemballage og visitkort."@da,
        "Ein Reliefeindruck, der IN das Substrat gepresst wird und ein vertieftes Bild oder Text erzeugt. Wird mit einem männlichen Stempel ausgeführt, der das Substrat zusammendrückt."@de,
        "A relief impression pressed INTO the substrate, creating a recessed (sunken) image or text. Done with a male die that compresses the substrate; no ink or foil involved. Common on luxury packaging, business cards, and book covers."@en,
        "Una impresión en relieve hundida EN el sustrato, creando una imagen o texto rebajado. Se hace con un troquel macho que comprime el sustrato; sin tinta ni foil. Común en packaging de lujo, tarjetas de visita y cubiertas de libros."@es,
        "सब्सट्रेट के भीतर दबाकर बनाया उभार, जिससे धँसा हुआ चित्र या पाठ बनता है। पुरुष डाई से सब्सट्रेट को दबाया जाता है; स्याही या फ़ॉइल नहीं। लक्ज़री पैकेजिंग, विज़िटिंग कार्ड और किताब के कवर में आम।"@hi,
        "基材に押し込む凹の型押しで、沈んだ画像や文字を作る。凸型で基材を圧縮する加工で、インキも箔も使わない。高級パッケージ、名刺、書籍の表紙で一般的。"@ja,
        "Et relief-inntrykk presset INN i substratet, som skaper et nedsenket bilde eller tekst. Utført med en male die som komprimerer substratet; ingen blekk eller folie involvert. Vanlig på luksusemballasje, visittkort og bok-omslag."@nb,
        "Een reliëfafdruk IN het substraat geperst, die een verdiept beeld of tekst vormt. Uitgevoerd met een patrijs die het substraat samendrukt; zonder inkt of folie. Gebruikelijk op luxeverpakkingen en visitekaartjes."@nl,
        "Reliefowe wgniecenie W podłoże, tworzące wklęsły (zagłębiony) obraz lub tekst. Wykonywane matrycą męską ściskającą podłoże; bez farby ani folii. Typowe dla opakowań luksusowych, wizytówek i okładek książek."@pl,
        "Impressão em relevo prensada PARA DENTRO do substrato, criando imagem ou texto rebaixado (afundado). Feita com uma matriz macho que comprime o substrato; sem tinta nem foil. Comum em embalagens de luxo, cartões de visita e capas de livro."@pt,
        "Ett reliefavtryck pressat IN i substratet som skapar en försänkt bild eller text. Görs med ett hanverktyg som komprimerar substratet; inget bläck eller folie inblandat. Vanligt på lyxförpackningar, visitkort och bokomslag."@sv,
        "压入承印材料内部的凹陷压印，形成下沉的图文。用阳模压缩材料完成；不用油墨或电化铝。常见于奢华包装、名片与书籍封面。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§DEBOSSING" ;
    skos:prefLabel "Dybprægning"@da,
        "Tiefprägung"@de,
        "Debossing"@en,
        "Hundido / Debossing"@es,
        "डिबॉसिंग"@hi,
        "デボス"@ja,
        "Debossing"@nb,
        "Dieppreeg (debossing)"@nl,
        "Tłoczenie wklęsłe"@pl,
        "Baixo-relevo"@pt,
        "Försänkt prägling"@sv,
        "凹压"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.6 · p.74",
                "§5.6.12 · p.118",
                "§6.32 · p.197" ;
            ptpge:mappingRow "crosswalk row 27" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Embossing",
                "EmbossingIntent",
                "EmbossingParams" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/embellishments/embossing/blind> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Blind emboss"@en,
        "Blind embossing"@en,
        "Embossed no ink"@en,
        "बिना स्याही का उभार"@hi,
        "ब्लाइंड एम्बॉस"@hi,
        "सादा एम्बॉसिंग"@hi,
        "Blindpreg"@nb,
        "suchy tłok"@pl,
        "tłoczenie bez farby"@pl,
        "ślepy tłok"@pl,
        "alto-relevo seco"@pt,
        "relevo cego"@pt,
        "relevo seco"@pt,
        "relevo sem tinta"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/embellishments/embossing> ;
    skos:definition "Prægning uden farve eller folie — det hævede relief står i substratets naturlige farve. Skaber en diskret, sofistikeret taktil effekt. Almindelig på eksklusive visitkort og luksusemballage."@da,
        "Prägung ohne Druckfarbe oder Folie — das erhabene Relief ist in der natürlichen Farbe des Substrats."@de,
        "Embossing without ink or foil — the raised relief is in the substrate's natural colour. Creates a subtle, sophisticated tactile effect. Common on premium business cards and luxury packaging."@en,
        "Gofrado sin tinta ni foil — el relieve elevado queda en el color natural del sustrato. Crea un efecto táctil sutil y sofisticado. Común en tarjetas de visita premium y packaging de lujo."@es,
        "बिना स्याही या फ़ॉइल के एम्बॉसिंग — उभार सब्सट्रेट के प्राकृतिक रंग में रहता है। सूक्ष्म, परिष्कृत स्पर्श प्रभाव। प्रीमियम विज़िटिंग कार्ड और लक्ज़री पैकेजिंग में आम।"@hi,
        "インキも箔も使わないエンボス — 盛り上がったレリーフは基材の地色のまま。控えめで上質な触感効果を生む。プレミアム名刺や高級パッケージで一般的。"@ja,
        "Embossing uten blekk eller folie — den hevede relieffen er i substratets naturlige farge. Skaper en subtil, sofistikert taktil effekt. Vanlig på premium visittkort og luksusemballasje."@nb,
        "Preging zonder inkt of folie — het verhoogde reliëf blijft in de natuurlijke substraatkleur. Creëert een subtiel, verfijnd tactiel effect. Gebruikelijk op exclusieve visitekaartjes en luxeverpakkingen."@nl,
        "Tłoczenie bez farby ani folii — wypukły relief ma naturalny kolor podłoża. Daje subtelny, wyrafinowany efekt dotykowy. Typowe dla wizytówek premium i opakowań luksusowych."@pl,
        "Relevo sem tinta nem foil — o relevo elevado fica na cor natural do substrato. Cria um efeito tátil sutil e sofisticado. Comum em cartões de visita premium e embalagens de luxo."@pt,
        "Prägling utan bläck eller folie — den upphöjda reliefen är i substratets naturfärg. Skapar en subtil, sofistikerad taktil effekt. Vanlig på exklusiva visitkort och lyxförpackningar."@sv,
        "不用油墨或电化铝的压凸 — 凸起浮雕保持材料本色。营造微妙而高级的触感效果。常见于高档名片与奢华包装。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§BLIND" ;
    skos:prefLabel "Blindprægning"@da,
        "Blindprägung"@de,
        "Blind Embossing"@en,
        "Relieve en seco / Embossing ciego"@es,
        "ब्लाइंड एम्बॉसिंग"@hi,
        "ブラインドエンボス"@ja,
        "Blind embossing"@nb,
        "Blindpreeg"@nl,
        "Tłoczenie ślepe"@pl,
        "Relevo seco"@pt,
        "Blindprägling"@sv,
        "盲压凸"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.6 · p.74",
                "§5.6.12 · p.118",
                "§6.32 · p.197" ;
            ptpge:mappingRow "crosswalk row 27" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Embossing",
                "EmbossingIntent",
                "EmbossingParams" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems> a skos:Concept ;
    dcterms:created "2026-06-18T10:00:07+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    dcterms:replaces <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/efi-fiery-xf>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/epson-ultrachrome>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/hp-indichrome> ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems> ;
    skos:definition "Proprietære leverandørsystemer for farve og udvidet farveomfang (Hexachrome, Touch 7, Riso, UltraChrome …)."@da,
        "Proprietäre Hersteller-Farb-/Tintensysteme und Extended-Gamut-Systeme (Hexachrome, Touch 7, Riso, UltraChrome …)."@de,
        "Proprietary vendor ink/colour and extended-gamut systems (Hexachrome, Touch 7, Riso, UltraChrome …)."@en,
        "Sistemas propietarios de tinta/color de fabricantes y de gama extendida (Hexachrome, Touch 7, Riso, UltraChrome …)."@es,
        "विक्रेताओं की स्वामित्व स्याही/रंग और विस्तारित-गैमट प्रणालियाँ (Hexachrome, Touch 7, Riso, UltraChrome …)।"@hi,
        "ベンダー独自のインキ／カラーおよび拡張ガモットのシステム（Hexachrome、Touch 7、Riso、UltraChrome など）。"@ja,
        "Proprietære leverandør-blekk/-farge- og utvidet-gamut-systemer (Hexachrome, Touch 7, Riso, UltraChrome …)."@nb,
        "Eigen leverancierssystemen voor inkt/kleur en uitgebreid gamma (Hexachrome, Touch 7, Riso, UltraChrome …)."@nl,
        "Własnościowe systemy farb/barw i rozszerzonego gamutu dostawców (Hexachrome, Touch 7, Riso, UltraChrome …)."@pl,
        "Sistemas proprietários de tinta/cor e de gamut estendido de fornecedores (Hexachrome, Touch 7, Riso, UltraChrome …)."@pt,
        "Proprietära leverantörssystem för bläck/färg och utökad färgomfattning (Hexachrome, Touch 7, Riso, UltraChrome …)."@sv,
        "厂商专有的油墨/色彩及扩展色域系统（Hexachrome、Touch 7、Riso、UltraChrome 等）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/efi-fiery-xf>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/epson-ultrachrome>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/hexachrome>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/hp-indichrome>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/pantone-touch7>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/riso>,
        <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/seven-color> ;
    skos:notation "P:ST-CSY-VINK" ;
    skos:prefLabel "Leverandørers farveøkosystemer"@da,
        "Hersteller-Tintensysteme"@de,
        "Vendor Ink Ecosystems"@en,
        "Ecosistemas de tinta de fabricantes"@es,
        "विक्रेता स्याही पारितंत्र"@hi,
        "ベンダーインキ体系"@ja,
        "Inktecosystemen van leveranciers"@nl,
        "Ekosystemy farb dostawców"@pl,
        "Ecossistemas de tinta de fornecedores"@pt,
        "Leverantörers bläckekosystem"@sv,
        "厂商油墨体系"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.14 · p.166",
                "§6.15 · p.168",
                "§6.17 · p.172" ;
            ptpge:mappingRow "crosswalk row 4" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Color",
                "ColorSpaceConversionParams",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/graphic-file-formats> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards> ;
    skos:definition "Filformater til at lagre og udveksle grafisk indhold — tekst, billeder, vektorgrafik og sidelayouts — gennem prepress- og trykleverancekæden."@da,
        "Dateiformate zur Speicherung und zum Austausch grafischer Inhalte — Text, Bilder, Vektorgrafiken und Seitenlayouts — über die Druckvorstufen- und Drucklieferkette hinweg."@de,
        "File formats used to store and exchange graphic content — text, images, vector art, and page layouts — across the prepress and printing supply chain."@en,
        "Formatos de archivo utilizados para almacenar e intercambiar contenido gráfico — texto, imágenes, arte vectorial y maquetaciones — a lo largo de la cadena de suministro de pre-prensa e impresión."@es,
        "प्रीप्रेस और मुद्रण आपूर्ति श्रृंखला में ग्राफ़िक सामग्री — पाठ, चित्र, वेक्टर कला और पेज लेआउट — संग्रहीत और विनिमय करने के फ़ाइल फ़ॉर्मेट।"@hi,
        "製版および印刷のサプライチェーン全体で、グラフィックコンテンツ — テキスト、画像、ベクターアート、ページレイアウト — を保存・交換するために使用されるファイル形式。"@ja,
        "Filformater som brukes til å lagre og utveksle grafisk innhold — tekst, bilder, vektorgrafikk og sideoppsett — gjennom trykkpreparasjons- og produksjonskjeden."@nb,
        "Bestandsformaten om grafische inhoud op te slaan en uit te wisselen — tekst, beelden, vectorgraphics en paginalay-outs — door de prepress- en drukleveringsketen."@nl,
        "Formaty plików używane do przechowywania i wymiany treści graficznych — tekstu, obrazów, grafiki wektorowej i układów stron — w łańcuchu dostaw prepress i druku."@pl,
        "Formatos de arquivo usados para armazenar e trocar conteúdo gráfico — texto, imagens, arte vetorial e layouts de página — ao longo da cadeia de pré-impressão e impressão."@pt,
        "Filformat för att lagra och utbyta grafiskt innehåll — text, bilder, vektorgrafik och sidlayouter — genom prepress- och tryckleveranskedjan."@sv,
        "在印前和印刷供应链中用于存储和交换图形内容（文本、图像、矢量图、版面）的文件格式。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/graphic-file-formats/hybrid-graphics>,
        <https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files>,
        <https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics>,
        <https://ptpge.org/v1/printing/standards/graphic-file-formats/vector-graphics> ;
    skos:notation "P:ST-GFF" ;
    skos:prefLabel "Grafiske filformater"@da,
        "Grafische Dateiformate"@de,
        "Graphic File Formats"@en,
        "Formatos de Archivo Gráfico"@es,
        "ग्राफ़िक फ़ाइल फ़ॉर्मेट"@hi,
        "グラフィックファイル形式"@ja,
        "Grafiske filformater"@nb,
        "Grafische bestandsformaten"@nl,
        "Formaty plików graficznych"@pl,
        "Formatos de arquivo gráfico"@pt,
        "Grafiska filformat"@sv,
        "图形文件格式"@zh-Hans ;
    skos:scopeNote "Umfasst Raster (PNG, JPEG, TIFF, RAW), Vektor (SVG), Hybrid (PDF und seine ISO-Varianten, EPS) und anwendungseigene Dateien (Adobe, Microsoft, Apple, QuarkXPress). Kompressionsalgorithmen, eingebettete Farbprofile und Schriftformate werden anderswo in der Taxonomie geführt."@de,
        "Includes raster (PNG, JPEG, TIFF, RAW), vector (SVG), hybrid (PDF and its ISO variants, EPS), and native application files (Adobe, Microsoft, Apple, QuarkXPress). Compression algorithms, embedded color profiles, and font formats live elsewhere in the taxonomy."@en,
        "Incluye raster (PNG, JPEG, TIFF, RAW), vectorial (SVG), híbridos (PDF y sus variantes ISO, EPS) y archivos nativos de aplicación (Adobe, Microsoft, Apple, QuarkXPress). Los algoritmos de compresión y los perfiles de color embebidos se rastrean dentro de cada formato."@es,
        "रास्टर (PNG, JPEG, TIFF, RAW), वेक्टर (SVG), हाइब्रिड (PDF और इसके ISO वेरिएंट, EPS) और नेटिव एप्लिकेशन फ़ाइलें (Adobe, Microsoft, Apple, QuarkXPress) शामिल। संपीड़न एल्गोरिदम, एम्बेडेड रंग प्रोफ़ाइल और फ़ॉन्ट फ़ॉर्मेट वर्गीकरण में अन्यत्र।"@hi,
        "ラスター（PNG、JPEG、TIFF、RAW）、ベクター（SVG）、ハイブリッド（PDFおよびそのISOバリアント、EPS）、ネイティブアプリケーションファイル（Adobe、Microsoft、Apple、QuarkXPress）を含む。圧縮アルゴリズム、埋め込みカラープロファイル、フォント形式は他の場所に分類される。"@ja,
        "Inkluderer raster (PNG, JPEG, TIFF, RAW), vektor (SVG), hybride (PDF og dets ISO-varianter, EPS), og programspesifikke filer (Adobe, Microsoft, Apple, QuarkXPress). Komprimeringsalgoritmer, innebygde fargeprofiler og fontformater hører til andre steder i taksonomien."@nb,
        "Inclui raster (PNG, JPEG, TIFF, RAW), vetorial (SVG), híbrido (PDF e suas variantes ISO, EPS) e arquivos nativos de aplicativos (Adobe, Microsoft, Apple, QuarkXPress). Algoritmos de compressão, perfis de cor incorporados e formatos de fonte ficam em outra parte da taxonomia."@pt,
        "包括位图（PNG、JPEG、TIFF、RAW）、矢量（SVG）、混合（PDF及其ISO变体、EPS）和应用原生文件（Adobe、Microsoft、Apple、QuarkXPress）。压缩算法和嵌入的色彩配置文件在各格式内单独跟踪。"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.19 · p.345" ;
            ptpge:mappingRow "crosswalk row 3" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "FileSpec" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/technologies/printing-technologies/analog> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:42:30+00:00"^^xsd:dateTime ;
    skos:altLabel "druk analogowy"@pl,
        "druk konwencjonalny"@pl ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-technologies> ;
    skos:definition "Traditionelle trykteknologier, der bruger en fysisk billedbærer (plade, cylinder, stencil eller blok) til at overføre farve til substratet — hele opgaven bruger samme fysiske mønster gentagne gange."@da,
        "Traditionelle Drucktechnologien, die einen physischen Bildträger (Platte, Zylinder, Sieb oder Stock) verwenden, um Tinte auf den Bedruckstoff zu übertragen — der gesamte Auftrag nutzt wiederholt dasselbe physische Muster."@de,
        "Traditional printing technologies that use a physical image carrier (plate, cylinder, screen, or block) to transfer ink to the substrate — the entire job uses the same physical pattern repeatedly."@en,
        "Tecnologías tradicionales de impresión que utilizan un portador físico de imagen (plancha, cilindro, malla o bloque) para transferir tinta al sustrato — todo el trabajo utiliza el mismo patrón físico repetidamente."@es,
        "पारंपरिक मुद्रण तकनीकें जो स्याही को सब्सट्रेट पर उतारने के लिए भौतिक छवि-वाहक (प्लेट, सिलिंडर, स्क्रीन या ब्लॉक) का उपयोग करती हैं — पूरा काम बार-बार उसी भौतिक पैटर्न से होता है।"@hi,
        "物理的な画像担体（刷版、シリンダー、スクリーン、版木）を使用してインキを基材に転写する伝統的な印刷技術 — ジョブ全体で同じ物理パターンを繰り返し使用する。"@ja,
        "Tradisjonelle trykketeknologier som bruker en fysisk bildebærer (plate, sylinder, sil eller blokk) til å overføre blekk til substratet — hele jobben bruker det samme fysiske mønsteret gjentatt."@nb,
        "Traditionele druktechnologieën die een fysieke beelddrager gebruiken (plaat, cilinder, zeef of blok) om inkt op het substraat over te brengen — de hele opdracht gebruikt herhaaldelijk hetzelfde fysieke patroon."@nl,
        "Tradycyjne technologie druku wykorzystujące fizyczny nośnik obrazu (płytę, cylinder, sito lub klocek) do przenoszenia farby na podłoże — całe zlecenie wielokrotnie używa tego samego fizycznego wzoru."@pl,
        "Tecnologias de impressão tradicionais que usam um portador físico de imagem (chapa, cilindro, tela ou bloco) para transferir tinta ao substrato — todo o trabalho usa o mesmo padrão físico repetidamente."@pt,
        "Traditionella tryckteknologier som använder en fysisk bildbärare (plåt, cylinder, schablon eller block) för att överföra bläck till substratet — hela jobbet använder samma fysiska mönster upprepade gånger."@sv,
        "使用物理图像载体（印版、滚筒、网或木块）将油墨转移到承印物的传统印刷工艺——整个作业重复使用相同的物理图案。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/flexo>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/gravure>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/intaglio>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/letterpress>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/lithography>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/offset>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/pad>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/screen>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/thermography>,
        <https://ptpge.org/v1/printing/technologies/printing-technologies/analog/woodcut> ;
    skos:notation "P:TC-PTC-ANLG" ;
    skos:prefLabel "Analog"@da,
        "Analog"@de,
        "Analog"@en,
        "Analógicas"@es,
        "एनालॉग"@hi,
        "アナログ"@ja,
        "Analog"@nb,
        "Analoog"@nl,
        "Analogowe"@pl,
        "Analógica"@pt,
        "Analog"@sv,
        "模拟"@zh-Hans ;
    skos:scopeNote "Umfasst Offset (Flachdruck, dominant im Akzidenzdruck), Flexodruck (Hochdruck, dominant in der Verpackung), Tiefdruck (Rotationstiefdruck, dominant für sehr lange Auflagen), Siebdruck (Durchdruck), Buchdruck und Holzschnitt (Hochdruck), Tampondruck (Übertragung), Thermodruck und Stichtiefdruck-Druckgrafik (Radierung, Stich, Aquatinta, Schabkunst)."@de,
        "Covers offset (planographic, dominant for commercial printing), flexography (relief, dominant for packaging), gravure (intaglio rotary, dominant for very long runs), screen printing (porous), letterpress and woodcut (relief), pad printing (transfer), thermal transfer, and intaglio printmaking (etching, engraving, aquatint, mezzotint)."@en,
        "Cubre offset (planográfico, dominante para impresión comercial), flexografía (relieve, dominante para packaging), huecograbado (intaglio rotativo, dominante para tiradas muy largas), serigrafía (poroso), tipografía, calcografía artística, xilografía y técnicas térmicas/tampografía. Las tecnologías digitales se sitúan en una sub-categoría hermana."@es,
        "ऑफसेट (प्लैनोग्राफ़िक, व्यावसायिक मुद्रण में प्रमुख), फ़्लेक्सोग्राफ़ी (रिलीफ़, पैकेजिंग में प्रमुख), ग्रेव्योर (रोटरी इंटैग्लियो, बहुत लंबे रन में प्रमुख), स्क्रीन प्रिंटिंग (सरंध्र), लेटरप्रेस और वुडकट (रिलीफ़), पैड प्रिंटिंग (ट्रांसफ़र), थर्मल ट्रांसफ़र और इंटैग्लियो प्रिंटमेकिंग (एचिंग, एनग्रेविंग, एक्वाटिंट, मेज़ोटिंट) शामिल।"@hi,
        "オフセット（平版、商業印刷で主流）、フレキソ（凸版、パッケージで主流）、グラビア（凹版輪転、超大量部数で主流）、シルクスクリーン印刷（孔版）、活版および木版（凸版）、タンポ印刷（転写）、感熱転写、凹版版画（エッチング、エングレービング、アクアチント、メゾチント）を扱う。"@ja,
        "Dekker offset (planografisk, dominerende for kommersiell trykk), fleksografi (relieff, dominerende for emballasje), gravure (intaglio roterende, dominerende for svært lange opplag), silketrykk (porøs), letterpress og tresnitt (relieff), padtrykk (overføring), termisk overføring, og intaglio-trykk (etsing, gravering, akvatinta, mezzotinta)."@nb,
        "Cobre offset (planográfico, dominante na impressão comercial), flexografia (relevo, dominante em embalagens), rotogravura (calcografia rotativa, dominante em tiragens muito longas), serigrafia (permeográfico), tipografia e xilogravura (relevo), tampografia (transferência), transferência térmica e gravura calcográfica (água-forte, buril, água-tinta, meia-tinta)."@pt,
        "涵盖胶印（平版，商业印刷的主导）、柔印（凸版，包装的主导）、凹印（凹版旋转，超长印次的主导）、丝印（孔版）、活字印刷、铜版凹印、木版以及热敏/移印技术。数码工艺位于兄弟子分类中。"@zh-Hans ;
    ptpge:group "technologies" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.12 · p.81",
                "§5.5.1 · p.110" ;
            ptpge:mappingRow "crosswalk row 16" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "ConventionalPrinting",
                "ProductionIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/variables/configuration> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
