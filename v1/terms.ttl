        "Licht papier (80–109 g/m²)"@nl,
        "Papier lekki (80–109 g/m²)"@pl,
        "Papel leve (80–109 g/m²)"@pt,
        "Lätt papper (80–109 g/m²)"@sv,
        "轻纸 (80–109克)"@zh-Hans ;
