    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-color-shades/gray-paper> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
