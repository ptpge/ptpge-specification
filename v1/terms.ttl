                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/configurations/formats/a-series> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "A Sizes"@en,
        "DIN A"@en,
        "A-formater"@nb,
        "DIN A"@pl,
        "formaty A"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats> ;
    skos:definition "Papirformater i A-serien efter ISO 216, baseret på proportionen 1:√2, som bevarer formatet når ark halveres eller fordobles. Bruges verden over uden for Nordamerika."@da,
        "ISO-216-A-Reihe-Papierformate, basierend auf einem Seitenverhältnis von 1:√2, das die Proportionen beim Halbieren oder Verdoppeln der Bogen bewahrt. Weltweit außerhalb Nordamerikas in Verwendung."@de,
        "ISO 216 A-series paper sizes, based on a 1:√2 aspect ratio that preserves proportions when sheets are halved or doubled. Used worldwide outside North America."@en,
        "Tamaños de papel de la serie A de ISO 216, basados en una relación de aspecto 1:√2 que preserva las proporciones cuando las hojas se dividen por la mitad o se duplican. Utilizados mundialmente fuera de Norteamérica."@es,
        "ISO 216 A-सीरीज़ काग़ज़ आकार, 1:√2 अनुपात पर आधारित, जो शीट को आधा या दोगुना करने पर अनुपात बनाए रखता है। उत्तर अमेरिका के बाहर पूरी दुनिया में प्रयुक्त।"@hi,
        "ISO 216 Aシリーズ用紙寸法。1:√2のアスペクト比に基づき、シートを半分または倍にしたときに比率が保たれる。北米以外の世界中で使用される。"@ja,
        "ISO 216 A-seriens papirstørrelser, basert på et 1:√2-sideforhold som bevarer proporsjonene når ark deles i to eller dobles. Brukt globalt utenom Nord-Amerika."@nb,
        "Papierformaten in de A-reeks volgens ISO 216, gebaseerd op de verhouding 1:√2, die de vorm behoudt wanneer vellen worden gehalveerd of verdubbeld. Wereldwijd gebruikt buiten Noord-Amerika."@nl,
        "Formaty papieru serii A normy ISO 216, oparte na proporcjach 1:√2, które zachowują kształt przy połowieniu lub podwajaniu arkuszy. Używane na całym świecie poza Ameryką Północną."@pl,
        "Tamanhos de papel da série A da ISO 216, baseados na proporção 1:√2, que preserva as proporções quando a folha é dividida ou dobrada ao meio. Usados no mundo todo fora da América do Norte."@pt,
        "Pappersformat i A-serien enligt ISO 216, baserade på proportionen 1:√2 som bevarar formatet när ark halveras eller dubbleras. Används världen över utanför Nordamerika."@sv,
        "ISO 216 A系列纸张尺寸，基于1:√2的宽高比，对折或对倍时保持比例。在北美以外全球使用。"@zh-Hans ;
    skos:exactMatch <https://www.iso.org/standard/36631.html> ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/formats/a-series/2a0>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/4a0>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a0>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a0-plus>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a1>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a1-plus>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a10>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a11>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a12>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a13>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a2>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a3>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a3-plus>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a4>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a4h>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a5>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a6>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a7>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a8>,
        <https://ptpge.org/v1/printing/configurations/formats/a-series/a9> ;
    skos:notation "P:CF-FMT-ASER" ;
    skos:prefLabel "A-serien (ISO 216)"@da,
        "A-Reihe (ISO 216)"@de,
        "A Series (ISO 216)"@en,
        "Serie A (ISO 216)"@es,
        "A सीरीज़ (ISO 216)"@hi,
        "A判（ISO 216）"@ja,
        "A-serie (ISO 216)"@nb,
        "A-reeks (ISO 216)"@nl,
        "Seria A (ISO 216)"@pl,
        "Série A (ISO 216)"@pt,
        "A-serien (ISO 216)"@sv,
        "A系列（ISO 216）"@zh-Hans ;
    skos:related <https://ptpge.org/v1/printing/standards/measurement-systems/metric> ;
    skos:scopeNote "Umfasst A0 bis A13 (jedes mit der Hälfte der Fläche des vorhergehenden), Übergrößen-Plus-Formate (A0+, A1+, A3+) im Druck für Beschnittzugaben sowie die seltenen Halb-A4-Formate (A4H) und Doppel-/Vierfach-A0-Formate (2A0, 4A0) für Plakate."@de,
        "Includes A0 through A13 (each half the area of the previous), oversize plus formats (A0+, A1+, A3+) used in printing for bleeds, and the rare half-A4 (A4H) and double/quadruple A0 (2A0, 4A0) sizes for posters."@en,
        "Incluye desde A0 hasta A13 (cada uno con la mitad de área del anterior), formatos plus oversize (A0+, A1+, A3+) utilizados en impresión para sangrados, y los tamaños menos comunes media A4 (A4H) y doble/cuádruple A0 (2A0, 4A0) para planos y carteles."@es,
        "A0 से A13 (हर एक पिछले का आधा क्षेत्रफल), छपाई में ब्लीड के लिए बड़े «प्लस» फ़ॉर्मेट (A0+, A1+, A3+), और पोस्टरों के लिए दुर्लभ आधा-A4 (A4H) और डबल/चौगुना A0 (2A0, 4A0) शामिल।"@hi,
        "A0からA13まで（各サイズは前のサイズの半分の面積）、印刷時のブリード用のオーバーサイズ・プラス形式（A0+、A1+、A3+）、ポスター用の希少なハーフA4（A4H）およびダブル／クアドラプルA0（2A0、4A0）サイズを含む。"@ja,
        "Inkluderer A0 til A13 (hver halvparten av arealet til den forrige), overdimensjonerte plus-formater (A0+, A1+, A3+) brukt i trykk med utfall, og de sjeldne halv-A4 (A4H) og dobbel/kvadruppel-A0-størrelsene (2A0, 4A0) for plakater."@nb,
        "Inclui A0 a A13 (cada um com metade da área do anterior), formatos «plus» superdimensionados (A0+, A1+, A3+) usados na impressão para sangria, e os raros meio-A4 (A4H) e duplo/quádruplo A0 (2A0, 4A0) para pôsteres."@pt,
        "包括A0到A13（每个面积为前一个的一半）、印刷用的加大尺寸（A0+、A1+、A3+）以及罕见的半A4（A4H）和双倍/四倍A0（2A0、4A0）。"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/light-medium-paper> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:altLabel "Light paper"@en,
        "Lightweight paper"@en,
        "लाइट पेपर"@hi,
        "हल्का काग़ज़"@hi,
        "हल्का मध्यम काग़ज़"@hi,
        "Lett papir"@nb,
        "papier lekki"@pl,
        "papier o niskiej gramaturze"@pl,
        "papel de gramatura leve"@pt,
        "papel leve"@pt ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights> ;
    skos:definition "Papir i området 110–149 g/m² — brugt til brevpapir af højere kvalitet, brochurer og kvalitetsflyers. Tungere end standard tekstpapir, men falses stadig rent."@da,
        "Papier im Bereich 110–149 g/m² — eingesetzt für hochwertigere Briefbögen, Broschüren und Qualitätsflyer. Schwerer als Standard-Textpapier, dabei dennoch sauber falzbar."@de,
        "Paper in the 110–149 gsm range — used for higher-quality letterheads, brochures, and quality flyers. Heavier than standard text paper but still folds cleanly."@en,
        "Papel de gramaje ligero a medio, 90–120 gsm — para folletos, papelería de calidad y manuales."@es,
        "110–149 GSM रेंज का काग़ज़ — बेहतर गुणवत्ता के लेटरहेड, ब्रोशर और अच्छे फ़्लायर में। मानक टेक्स्ट पेपर से भारी पर अब भी साफ़ मुड़ता है।"@hi,
        "110〜149gsmの坪量範囲の紙 — 上質な便箋、ブローシュア、上質チラシに使用される。標準的な本文用紙より重いが、それでもきれいに折ることができる。"@ja,
        "Papir i området 110–149 gsm — brukt til høyere kvalitets-brevhoder, brosjyrer og kvalitets-flyers. Tyngre enn standard tekstpapir, men bretter fortsatt rent."@nb,
        "Papier in het bereik 110–149 g/m² — gebruikt voor briefpapier van hogere kwaliteit, brochures en kwaliteitsflyers. Zwaarder dan standaard tekstpapier, maar vouwt nog steeds netjes."@nl,
        "Papier w zakresie 110–149 g/m² — używany do lepszych papierów firmowych, broszur i ulotek dobrej jakości. Cięższy niż standardowy papier tekstowy, lecz nadal składa się czysto."@pl,
        "Papel na faixa de 110–149 g/m² — usado em papel timbrado de melhor qualidade, folhetos e flyers de qualidade. Mais pesado que o papel de texto padrão, mas ainda dobra bem."@pt,
        "Papper i intervallet 110–149 g/m² — används för kvalitetsbrevpapper, broschyrer och bättre flygblad. Tyngre än vanligt textpapper men falsas fortfarande rent."@sv,
        "轻到中等克重纸，90–120克 —— 用于宣传册、优质文具和手册。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:SB§LIGHT-MEDIUM-PAPER" ;
    skos:prefLabel "Let mellempapir (110–149 g/m²)"@da,
        "Leichtes Mittelpapier (110–149 g/m²)"@de,
        "Light Medium Paper (110–149 gsm)"@en,
        "Papel Ligero-Medio (110–149 gsm)"@es,
        "लाइट मीडियम काग़ज़ (110–149 GSM)"@hi,
        "中軽量紙（110〜149 gsm）"@ja,
        "Lett medium-papir (110–149 g/m²)"@nb,
        "Licht-medium papier (110–149 g/m²)"@nl,
        "Papier lekko-średni (110–149 g/m²)"@pl,
        "Papel médio leve (110–149 g/m²)"@pt,
        "Lätt mellanpapper (110–149 g/m²)"@sv,
        "轻-中等纸 (110–149克)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "substrates" ;
    ptpge:hasProperty [ ptpge:unit "gsm" ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.11 · p.79",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 29" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media",
                "MediaIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/silk-paper> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:altLabel "Silkepapir (bestrøget)"@da,
        "Seidenmattes Papier (gestrichen)"@de,
        "Satin Paper"@en,
        "Silk Paper (Coated)"@en,
        "सिल्क आर्ट पेपर"@hi,
        "सेमी-ग्लॉस काग़ज़"@hi,
        "सैटिन पेपर"@hi,
        "Halvmatt papir"@nb,
        "Silk bestrøket"@nb,
        "Silkepapir (bestrøket)"@nb,
        "Zijdeglanspapier (gestreken)"@nl,
        "kreda satynowa"@pl,
        "kreda silk"@pl,
        "papier satynowy (powlekany)"@pl,
        "papier silk"@pl,
        "couché acetinado"@pt,
        "papel cetim"@pt,
        "papel silk"@pt,
        "semibrilho"@pt,
        "Silkpapper (bestruket)"@sv ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces> ;
    skos:definition "Bestrøget papir med satin (halvmat) finish — mellem glittet og mat. Kombinerer god farvegengivelse med reduceret genskin. Almindeligt til magasiner og kvalitetsmarkedsføring."@da,
        "Gestrichenes Papier mit seidenmatter (halbglänzender) Oberfläche — zwischen glänzend und matt. Verbindet gute Farbreproduktion mit reduzierter Blendung. Häufig bei Magazinen und hochwertigem Marketingmaterial."@de,
        "Coated paper with a satin (semi-gloss) finish — between glossy and matte. Combines good color reproduction with reduced glare. Common for magazines and quality marketing material."@en,
        "Papel estucado satinado — punto intermedio entre brillante y mate. Reduce reflejos manteniendo viveza cromática."@es,
        "सैटिन (सेमी-ग्लॉस) फ़िनिश वाला कोटेड काग़ज़ — ग्लॉसी और मैट के बीच। अच्छे रंग पुनरुत्पादन के साथ कम चमक। पत्रिकाओं और गुणवत्तापूर्ण मार्केटिंग सामग्री में आम।"@hi,
        "サテン（半光沢）仕上げの塗工紙 — グロスとマットの中間。良好な色再現とグレア低減を兼ね備える。雑誌や上質なマーケティング素材で一般的。"@ja,
        "Belagt papir med satin (halv-blank) overflate — mellom blank og matt. Kombinerer god fargegjengivelse med redusert gjenskinn. Vanlig for magasiner og kvalitetsmarkedsmateriell."@nb,
        "Gestreken papier met een satijnen (halfmatte) afwerking — tussen glanzend en mat. Combineert goede kleurweergave met minder schittering. Gebruikelijk voor magazines en kwaliteitsmarketingmateriaal."@nl,
        "Papier powlekany o satynowym (półmatowym) wykończeniu — między błyszczącym a matowym. Łączy dobrą reprodukcję barw z ograniczonymi odblaskami. Typowy dla czasopism i materiałów marketingowych dobrej jakości."@pl,
        "Papel couché com acabamento acetinado (semibrilho) — entre brilhante e fosco. Combina boa reprodução de cor com reflexo reduzido. Comum em revistas e material de marketing de qualidade."@pt,
        "Bestruket papper med satinerad (halvmatt) finish — mellan glättat och matt. Kombinerar god färgåtergivning med minskad bländning. Vanligt för tidskrifter och kvalitetsmarknadsmaterial."@sv,
        "丝光涂布纸 —— 光面和哑光之间的中间点。减少反光同时保持色彩活力。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:SB§SILK-PAPER" ;
    skos:prefLabel "Silkepapir"@da,
        "Seidenmattes Papier"@de,
        "Silk Paper"@en,
        "Papel Satinado (Silk)"@es,
        "सिल्क काग़ज़"@hi,
        "シルク紙（コート）"@ja,
        "Silkepapir"@nb,
        "Zijdeglanspapier"@nl,
        "Papier satynowy"@pl,
        "Papel acetinado"@pt,
        "Silkpapper"@sv,
        "丝面纸"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "substrates" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.11 · p.79",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 29" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media",
                "MediaIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/variables/features/embellishment> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "फ़ॉइल और एम्बॉसिंग"@hi,
        "सजावटी प्रभाव"@hi,
        "स्पेशल इफ़ेक्ट"@hi,
        "acabamento especial"@pt,
        "efeitos especiais"@pt,
        "hot stamping e relevo"@pt ;
    skos:broader <https://ptpge.org/v1/variables/features> ;
    skos:definition "Konfigurerbar akse: Forædling. Et trykt produkt konfigureres langs denne variabel (enum, flervalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Veredelung. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Mehrfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Embellishment. A printed product is configured along this variable (enum, multiple selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Ornamentación. Un producto impreso se configura a lo largo de esta variable (enum, selección múltiple). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: एम्बेलिशमेंट (सजावटी प्रभाव)। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, बहु-चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：加飾。印刷物はこの変数に沿って構成される（列挙型、複数選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Dekor. Et trykkprodukt konfigureres langs denne variabelen (enum, multiple valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Veredeling. Een drukproduct wordt langs deze variabele geconfigureerd (enum, meerkeuze). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Uszlachetnienie. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór wielokrotny). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Enobrecimento. Um impresso é configurado ao longo desta variável (enumeração, seleção múltipla). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Dekor. En trycksak konfigureras längs denna variabel (uppräkning, flerval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：装饰工艺。印刷品沿此变量进行配置（枚举，多选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:FT§EMBELLISHMENT" ;
    skos:prefLabel "Forædling"@da,
        "Veredelung"@de,
        "Embellishment"@en,
        "Ornamentación"@es,
        "एम्बेलिशमेंट"@hi,
        "加飾"@ja,
        "Dekor"@nb,
        "Veredeling"@nl,
        "Uszlachetnienie"@pl,
        "Enobrecimento"@pt,
        "Dekor"@sv,
        "装饰工艺"@zh-Hans ;
    ptpge:cardinality "multiple" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Nogen forædling?"@da,
        "Eine Veredelung?"@de,
        "Any embellishment?"@en,
        "¿Algún embellecimiento?"@es,
        "कोई सज्जा (एम्बेलिशमेंट)?"@hi,
        "加飾はありますか？"@ja,
        "Noen forsiring?"@nb,
        "Een verfraaiing?"@nl,
        "Jakieś uszlachetnienie?"@pl,
        "Algum acabamento decorativo?"@pt,
        "Någon förädling?"@sv,
        "需要装饰工艺吗？"@zh-Hans ;
    ptpge:scope "surface" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/features/embellishments> ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights/heavy-paper> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:altLabel "Light Card"@en,
        "भारी काग़ज़"@hi,
        "लाइट कार्ड"@hi,
        "हल्का कार्ड"@hi,
        "Tynn kartong"@nb,
        "karton lekki"@pl,
        "cartolina leve"@pt,
        "cartão leve"@pt ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights> ;
    skos:definition "Papir i området 240–309 g/m² — på grænsen mellem tungt papir og let karton. Bruges til postkort, visitkort (indstigsniveau) og eksklusive omslag."@da,
        "Papier im Bereich 240–309 g/m² — an der Grenze zwischen schwerem Papier und leichtem Karton. Eingesetzt für Postkarten, Visitenkarten (Einsteigerklasse) und Premium-Umschläge."@de,
        "Paper in the 240–309 gsm range — at the boundary between heavy paper and light cardstock. Used for postcards, business cards (entry level), and premium covers."@en,
        "Papel pesado, 200–250 gsm — utilizado para portadas, tarjetas postales y publicaciones premium."@es,
        "240–309 GSM रेंज का काग़ज़ — भारी काग़ज़ और हल्के कार्डस्टॉक की सीमा पर। पोस्टकार्ड, विज़िटिंग कार्ड (प्रारंभिक स्तर) और प्रीमियम कवर में।"@hi,
        "240〜309gsmの坪量範囲の紙 — 重量紙と軽量カード紙の境界に位置する。ハガキ、エントリーレベルの名刺、プレミアム表紙に使用される。"@ja,
        "Papir i området 240–309 gsm — i grenseland mellom tungt papir og lett kartong. Brukt til postkort, visittkort (enklere kvalitet) og premium-omslag."@nb,
        "Papier in het bereik 240–309 g/m² — op de grens tussen zwaar papier en licht karton. Gebruikt voor kaarten, visitekaartjes (instapniveau) en exclusieve omslagen."@nl,
        "Papier w zakresie 240–309 g/m² — na granicy między ciężkim papierem a lekkim kartonem. Używany do pocztówek, wizytówek (klasa podstawowa) i okładek premium."@pl,
        "Papel na faixa de 240–309 g/m² — na fronteira entre papel pesado e cartão leve. Usado em postais, cartões de visita (básicos) e capas premium."@pt,
        "Papper i intervallet 240–309 g/m² — på gränsen mellan tungt papper och lätt kartong. Används för vykort, visitkort (instegsnivå) och exklusiva omslag."@sv,
        "重纸，200–250克 —— 用于封面、明信片和高级出版物。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
