    skos:altLabel "NCS-farver"@da,
        "Natural Colour System"@da,
        "NCS-Farben"@de,
        "Natural Colour System"@de,
        "NCS Colour"@en,
        "NCS notation"@en,
        "Natural Color System"@en,
        "Natural Colour System"@en,
        "Natural Colour System"@es,
