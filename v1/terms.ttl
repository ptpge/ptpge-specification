        "Esko Automation Engine (Workflow)"@en,
        "Esko Automation Engine"@es,
        "Esko Automation Engine (वर्कफ़्लो)"@hi,
        "Esko Automation Engine (Workflow)"@ja,
        "Esko Automation Engine (Workflow)"@nb,
        "Esko Automation Engine (workflow)"@nl,
        "Esko Automation Engine (Workflow)"@pl,
        "Esko Automation Engine (Fluxo de trabalho)"@pt,
        "Esko Automation Engine (arbetsflöde)"@sv,
        "Esko Automation Engine"@zh-Hans ;
