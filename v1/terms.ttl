            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-08-12" .

<https://ptpge.org/v1/printing/configurations/formats/newspaper-formats/compact> a skos:Concept ;
    dcterms:created "2026-08-12T11:00:47+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "Tabloid (newspaper)"@en,
        "tabloid (gazeta)"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/newspaper-formats> ;
    skos:definition "280 × 430 mm (nominelt — de præcise mål varierer med pressen). Det kompakte avisformat, i daglig tale 'tabloid' — adskilt fra det amerikanske papirformat Tabloid (11 × 17 tommer / 279 × 432 mm), som er et renskåret kontorformat."@da,
        "280 × 430 mm (nominell — genaue Maße variieren je nach Rotation). Das kompakte Zeitungsformat, umgangssprachlich «Tabloid» — zu unterscheiden vom US-Papierformat Tabloid (11 × 17 in), einem beschnittenen Büroformat."@de,
        "280 × 430 mm (nominal — exact dimensions vary by press). The compact newspaper format, colloquially 'tabloid' — distinct from the US Tabloid paper size (11 × 17 in / 279 × 432 mm), which is a trimmed office format."@en,
        "280 × 430 mm (nominal — las dimensiones exactas varían según rotativa). El formato compacto de periódico, coloquialmente «tabloide» — distinto del tamaño de papel US Tabloid (11 × 17 in), que es un formato de oficina recortado."@es,
        "280 × 430 mm (नाममात्र — सटीक आयाम प्रेस से बदलते हैं). कॉम्पैक्ट अख़बार फ़ॉर्मेट, बोलचाल में «टैब्लॉइड» — US Tabloid काग़ज़ आकार (11 × 17 इंच / 279 × 432 मिमी) से अलग, जो ट्रिम किया ऑफ़िस फ़ॉर्मेट है।"@hi,
        "280 × 430 mm（公称 — 実寸は輪転機により異なる）。コンパクトな新聞判型で、通称「タブロイド」。事務用の断裁判型である米国のTabloid用紙サイズ（11 × 17インチ）とは別物。"@ja,
        "280 × 430 mm (nominelt — eksakte mål varierer med pressen). Det kompakte avisformatet, i dagligtale «tabloid» — distinkt fra det amerikanske Tabloid-papirformatet (11 × 17 in), som er et beskåret kontorformat."@nb,
        "280 × 430 mm (nominellt — exakta mått varierar met pressen). Het compacte krantenformaat, in de volksmond 'tabloid' — te onderscheiden van het Amerikaanse papierformaat Tabloid (11 × 17 inch / 279 × 432 mm), een schoongesneden kantoorformaat."@nl,
        "280 × 430 mm (nominalnie — dokładne wymiary zależą od maszyny). Kompaktowy format gazetowy, potocznie „tabloid” — inny niż amerykański format papieru Tabloid (11 × 17 cali / 279 × 432 mm), który jest przyciętym formatem biurowym."@pl,
        "280 × 430 mm (nominal — as dimensões exatas variam conforme a rotativa). O formato de jornal compacto, coloquialmente «tabloide» — distinto do tamanho de papel US Tabloid (11 × 17 in / 279 × 432 mm), que é um formato de escritório refilado."@pt,
        "280 × 430 mm (nominellt — exakta mått varierar med pressen). Det kompakta tidningsformatet, i dagligt tal 'tabloid' — skilt från det amerikanska pappersformatet Tabloid (11 × 17 tum / 279 × 432 mm), som är ett renskuret kontorsformat."@sv,
        "280 × 430 毫米（名义尺寸 — 具体尺寸因轮转机而异）。紧凑型报纸幅面，俗称「小报」— 区别于美国 Tabloid 纸张尺寸（11 × 17 英寸，裁切后的办公幅面）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§COMPACT" ;
    skos:prefLabel "Tabloid/Compact (280 x 430 mm)"@da,
        "Compact (280 x 430 mm)"@de,
        "Compact (280 x 430 mm)"@en,
        "Compact (280 × 430 mm)"@es,
        "Compact (280 x 430 mm)"@hi,
        "Compact (280 x 430 mm)"@ja,
        "Compact (280 x 430 mm)"@nb,
        "Compact (280 x 430 mm)"@nl,
        "Compact (280 x 430 mm)"@pl,
        "Compact (280 x 430 mm)"@pt,
        "Tabloid/Compact (280 x 430 mm)"@sv,
        "Compact (280 × 430 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 120400.0 ;
            ptpge:aspectRatio 1.5357 ;
            ptpge:height 430.0 ;
            ptpge:standard "trade convention" ;
            ptpge:unit "mm" ;
            ptpge:width 280.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-08-12" .

<https://ptpge.org/v1/printing/configurations/formats/rollups/rollup-100x200> a skos:Concept ;
    dcterms:created "2026-08-21T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/rollups> ;
    skos:definition "Roll-up-bannerformat Rollup 100 × 200 cm: europæisk standardkassettebredde til udtrækkelige bannerstandere. Formatet er den synlige grafik i monteret stand. Tryklængden får et monteringstillæg bestemt af kassetten — ekstra materiale nederst (ind i kassetten) og øverst (topskinnen) — som er produktionsgeometri udledt af producenten, ikke en del af produktidentiteten; nominelle værdier publiceres som mountingAllowance."@da,
        "Roll-up-Bannerformat Rollup 100 × 200 cm: europäische Standard-Kassettenbreite für ausziehbare Bannerdisplays. Das Format ist die sichtbare Grafik im montierten Zustand. Die Drucklänge erhält eine von der Kassette bestimmte Montagezugabe — zusätzliches Material unten (in die Kassette) und oben (Klemmleiste) —, die vom Hersteller abgeleitete Produktionsgeometrie und nicht Teil der Produktidentität ist; Nennwerte werden als mountingAllowance veröffentlicht."@de,
        "Roll-up banner format Rollup 100 × 200 cm: European standard cassette width for retractable banner stands. The format is the visible graphic once mounted. The printed length adds a mounting allowance set by the cassette — extra material at the bottom (into the cassette) and at the top (leader rail) — which is production geometry derived by the producer, not part of the product identity; nominal values are published as mountingAllowance."@en,
        "Formato de banner enrollable Rollup 100 × 200 cm: ancho de casete estándar europeo para expositores retráctiles. El formato es el gráfico visible una vez montado. La longitud impresa añade un margen de montaje definido por el casete — material extra abajo (dentro del casete) y arriba (perfil superior) —, geometría de producción derivada por el productor, no parte de la identidad del producto; los valores nominales se publican como mountingAllowance."@es,
        "रोल-अप बैनर फ़ॉर्मेट 100 × 200 cm: रिट्रैक्टेबल बैनर स्टैंड के लिए यूरोपीय मानक कैसेट चौड़ाई। फ़ॉर्मेट लगाने के बाद दिखने वाला ग्राफ़िक है। छपी लंबाई में कैसेट-निर्धारित माउंटिंग भत्ता जुड़ता है — नीचे (कैसेट के भीतर) और ऊपर (लीडर रेल) अतिरिक्त सामग्री — जो उत्पादक द्वारा निकाली गई उत्पादन ज्यामिति है, उत्पाद पहचान का हिस्सा नहीं; नाममात्र मान mountingAllowance के रूप में प्रकाशित हैं।"@hi,
        "ロールアップバナー判型 Rollup 100 × 200 cm：欧州の標準カセット幅（引き出し式バナースタンド用）。判型は設置後に見える印刷面を指す。印刷長にはカセットが決める取付余白（下部はカセット内へ、上部はトップレール用の追加材料）が加わる。これは製造者が導出する生産上の寸法であり、製品識別の一部ではない。名目値は mountingAllowance として公開される。"@ja,
        "Roll-up-bannerformat Rollup 100 × 200 cm: europeisk standard kassettbredde for uttrekkbare bannerstativ. Formatet er den synlige grafikken i montert stand. Trykklengden får et monteringstillegg bestemt av kassetten — ekstra materiale nederst (inn i kassetten) og øverst (toppskinnen) — som er produksjonsgeometri utledet av produsenten, ikke del av produktidentiteten; nominelle verdier publiseres som mountingAllowance."@nb,
        "Roll-upbannerformaat Rollup 100 × 200 cm: Europese standaard cassettebreedte voor uittrekbare bannerdisplays. Het formaat is de zichtbare grafiek in gemonteerde toestand. De druklengte krijgt een montagetoeslag bepaald door de cassette — extra materiaal onderaan (in de cassette) en bovenaan (toprail) — productiegeometrie afgeleid door de producent, geen deel van de productidentiteit; nominale waarden worden gepubliceerd als mountingAllowance."@nl,
        "Format roll-upu 100 × 200 cm: europejska standardowa szerokość kasety stojaków na banery zwijane. Format to widoczna grafika po zamontowaniu. Drukowana długość zawiera naddatek montażowy określony przez kasetę — dodatkowy materiał u dołu (do kasety) i u góry (listwa prowadząca) — będący geometrią produkcyjną wyprowadzaną przez producenta, a nie częścią tożsamości produktu; wartości nominalne publikowane są jako mountingAllowance."@pl,
        "Formato de roll-up 100 × 200 cm: largura de cassete padrão europeia para porta-banners retráteis. O formato é o gráfico visível depois de montado. O comprimento impresso acrescenta uma folga de montagem definida pelo cassete — material extra embaixo (dentro do cassete) e em cima (trilho superior) — que é geometria de produção derivada pelo produtor, não parte da identidade do produto; os valores nominais são publicados como mountingAllowance."@pt,
        "Roll-up-bannerformat Rollup 100 × 200 cm: europeisk standardkassettbredd för utdragbara bannerställ. Formatet är den synliga grafiken i monterat läge. Trycklängden får ett monteringstillägg som bestäms av kassetten — extra material nedtill (in i kassetten) och upptill (toppskenan) — vilket är produktionsgeometri som producenten härleder, inte en del av produktidentiteten; nominella värden publiceras som mountingAllowance."@sv,
        "易拉宝横幅规格 Rollup 100 × 200 cm：欧洲标准卡匣宽度（用于可伸缩横幅展架）。规格指安装后可见的画面。印刷长度需加上由卡匣决定的安装余量——底部（卷入卡匣）和顶部（上夹条）的额外材料——这是由生产者推导的生产几何尺寸，不属于产品身份；名义值以 mountingAllowance 发布。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§ROLLUP-100X200" ;
    skos:prefLabel "Rollup 100 × 200 cm"@da,
        "Rollup 100 × 200 cm"@de,
        "Rollup 100 × 200 cm"@en,
        "Rollup 100 × 200 cm"@es,
        "रोल-अप 100 × 200 cm"@hi,
        "Rollup 100 × 200 cm"@ja,
        "Rollup 100 × 200 cm"@nb,
        "Rollup 100 × 200 cm"@nl,
        "Roll-up 100 × 200 cm"@pl,
        "Roll-up 100 × 200 cm"@pt,
        "Rollup 100 × 200 cm"@sv,
        "Rollup 100 × 200 cm"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 2000000.0 ;
            ptpge:aspectRatio 2.0 ;
            ptpge:height 2000.0 ;
            ptpge:standard "convention" ;
            ptpge:unit "mm" ;
            ptpge:width 1000.0 ] ;
    ptpge:level "element" ;
    ptpge:mountingAllowance [ ptpge:unit "mm" ] ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-03" .

