        "C6 (114 × 162 mm)"@es,
        "C6 (114 x 162 mm)"@hi,
        "C6 (114 x 162 mm)"@ja,
        "C6 (114 x 162 mm)"@nb,
        "C6 (114 x 162 mm)"@nl,
        "C6 (114 x 162 mm)"@pl,
        "C6 (114 x 162 mm)"@pt,
        "C6 (114 x 162 mm)"@sv,
        "C6 (114 × 162 mm)"@zh-Hans ;
