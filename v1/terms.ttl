    ptpge:status "proposed" ;
    ptpge:version "2026-09-03" .

<https://ptpge.org/v1/printing/configurations/formats/us> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats> ;
    skos:definition "Papirformater, der er standard i USA og andre lande, som følger amerikanske konventioner (Canada, Mexico, Filippinerne, Chile)."@da,
        "Papierformate, die in den Vereinigten Staaten und in Ländern mit US-Konventionen Standard sind (Kanada, Mexiko, Philippinen, Chile)."@de,
        "Paper sizes standard in the United States and other countries that follow US conventions (Canada, Mexico, Philippines, Chile)."@en,
        "Tamaños de papel estándar en los Estados Unidos y en otros países que siguen convenciones estadounidenses (Canadá, México, Filipinas, Chile)."@es,
        "संयुक्त राज्य और US परंपराओं का पालन करने वाले अन्य देशों (कनाडा, मेक्सिको, फ़िलीपींस, चिली) के मानक काग़ज़ आकार।"@hi,
        "米国およびUS慣例に従う国（カナダ、メキシコ、フィリピン、チリ）で標準的な用紙寸法。"@ja,
        "Papirstørrelser som er standard i USA og andre land som følger amerikanske konvensjoner (Canada, Mexico, Filippinene, Chile)."@nb,
        "Papierformaten die standaard zijn in de VS en andere landen die Amerikaanse conventies volgen (Canada, Mexico, de Filipijnen, Chili)."@nl,
        "Formaty papieru standardowe w Stanach Zjednoczonych i innych krajach stosujących konwencje amerykańskie (Kanada, Meksyk, Filipiny, Chile)."@pl,
        "Tamanhos de papel padrão nos Estados Unidos e em outros países que seguem as convenções americanas (Canadá, México, Filipinas, Chile)."@pt,
        "Pappersformat som är standard i USA och andra länder som följer amerikanska konventioner (Kanada, Mexiko, Filippinerna, Chile)."@sv,
        "美国及其他遵循美国惯例的国家（加拿大、墨西哥、菲律宾、智利）使用的标准纸张尺寸。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/formats/us/government-legal>,
        <https://ptpge.org/v1/printing/configurations/formats/us/government-letter>,
        <https://ptpge.org/v1/printing/configurations/formats/us/half-letter>,
        <https://ptpge.org/v1/printing/configurations/formats/us/junior-legal>,
        <https://ptpge.org/v1/printing/configurations/formats/us/ledger>,
        <https://ptpge.org/v1/printing/configurations/formats/us/legal>,
        <https://ptpge.org/v1/printing/configurations/formats/us/letter>,
        <https://ptpge.org/v1/printing/configurations/formats/us/tabloid> ;
    skos:notation "P:CF-FMT-USER" ;
    skos:prefLabel "USA-format"@da,
        "US"@de,
        "US"@en,
        "EE. UU."@es,
        "US"@hi,
        "US（米国規格）"@ja,
        "US"@nb,
        "USA-format"@nl,
        "Formaty USA"@pl,
        "EUA"@pt,
        "USA-format"@sv,
        "美国"@zh-Hans ;
    skos:scopeNote "Umfasst Letter, Legal, Tabloid (Ledger), Half Letter, Junior Legal sowie die behördenspezifischen Formate Government Letter und Government Legal. Tabloid und Ledger haben dieselben Maße (11 × 17″), aber Tabloid impliziert Hochformat, Ledger Querformat."@de,
        "Includes Letter, Legal, Tabloid (Ledger), Half Letter, Junior Legal, and government-specific Government Letter and Government Legal. Tabloid and Ledger are dimensionally identical (11×17\") but Tabloid implies portrait orientation, Ledger landscape."@en,
        "Incluye Carta, Oficio, Tabloide (Ledger), Media Carta, Junior Legal y los específicos para uso gubernamental Government Letter y Government Legal. Tabloide y Ledger son idénticos en dimensiones (11×17\") pero Tabloide se orienta en vertical y Ledger en horizontal."@es,
        "Letter、Legal、Tabloid（Ledger）、Half Letter、Junior Legal、政府機関固有のGovernment LetterおよびGovernment Legalを含む。TabloidとLedgerは寸法的に同一（11×17インチ）だが、Tabloidは縦向き、Ledgerは横向きを意味する。"@ja,
        "Inkluderer Letter, Legal, Tabloid (Ledger), Half Letter, Junior Legal, og myndighetsstørrelsene Government Letter og Government Legal. Tabloid og Ledger har like dimensjoner (11×17\") men Tabloid impliserer portrettorientering, Ledger landskap."@nb,
        "包括Letter、Legal、Tabloid（Ledger）、Half Letter、Junior Legal以及政府专用的Government Letter和Government Legal。Tabloid和Ledger尺寸相同（11×17英寸），但Tabloid是纵向，Ledger是横向。"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/configurations/formats/us/legal> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "8.5 x 14 in"@en,
        "8.5x14"@en,
        "8.5×14"@en,
        "Legal size"@en,
        "format Legal"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/us> ;
    skos:definition "8.5 × 14 tommer (215.9 × 355.6 mm). Samme bredde som Letter, men højere — bruges i USA til juridiske dokumenter, kontrakter og formularer."@da,
        "8,5 × 14 in (215,9 × 355,6 mm). Gleiche Breite wie Letter, aber höher — verwendet in den USA für Rechtsdokumente, Verträge und Formulare."@de,
        "8.5 × 14 in (215.9 × 355.6 mm). Same width as Letter but taller — used in US for legal documents, contracts, and forms."@en,
        "Tamaño Oficio de EE. UU., 8,5 × 14 pulgadas. Habitual para documentos legales, contratos y formularios extensos."@es,
        "8.5 × 14 in (215.9 × 355.6 mm). Letter जितनी चौड़ाई पर ऊँचा — US में विधिक दस्तावेज़ों, अनुबंधों और फ़ॉर्मों में।"@hi,
        "8.5×14インチ（215.9×355.6mm）。Letterと同じ幅だが背が高い — 米国で法律文書、契約書、書式に使用される。"@ja,
        "8,5 × 14 in (215,9 × 355,6 mm). Samme bredde som Letter, men høyere — brukt i USA til juridiske dokumenter, kontrakter og skjemaer."@nb,
        "8.5 × 14 inch (215.9 × 355.6 mm). Even breed als Letter, maar hoger — in de VS gebruikt voor juridische documenten, contracten en formulieren."@nl,
        "8,5 × 14 cali (215,9 × 355,6 mm). Tej samej szerokości co Letter, lecz wyższy — używany w USA do dokumentów prawnych, umów i formularzy."@pl,
        "8.5 × 14 in (215.9 × 355.6 mm). Mesma largura do Letter, porém mais alto — usado nos EUA em documentos jurídicos, contratos e formulários."@pt,
        "8.5 × 14 tum (215.9 × 355.6 mm). Samma bredd som Letter men högre — används i USA för juridiska dokument, kontrakt och blanketter."@sv,
        "美国Legal尺寸，8.5 × 14英寸。常用于法律文件、合同和长篇表格。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§LEGAL" ;
    skos:prefLabel "Legal (8.5 x 14 tum)"@da,
        "Legal (8.5 x 14 in)"@de,
        "Legal (8.5 x 14 in)"@en,
        "Legal (216 × 356 mm / 8.5 × 14 in)"@es,
        "Legal (8.5 x 14 in)"@hi,
        "Legal (8.5 x 14 in)"@ja,
        "Legal (8.5 x 14 in)"@nb,
        "Legal (8.5 x 14 in)"@nl,
        "Legal (8.5 x 14 in)"@pl,
        "Legal (8.5 x 14 in)"@pt,
        "Legal (8.5 x 14 tum)"@sv,
        "Legal (216 × 356 mm / 8.5 × 14 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 119.0 ;
            ptpge:aspectRatio 1.6471 ;
            ptpge:height 14.0 ;
            ptpge:standard "ANSI" ;
            ptpge:unit "in" ;
            ptpge:width 8.5 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/configurations/setup-models> a skos:Concept ;
    dcterms:created "2026-05-19T13:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering> ;
    skos:definition "Opsætningsmodeller beskriver en tryksags strukturelle topologi — hvordan substratarkene er organiseret, og hvilke adresserbare flader hver side af hvert ark svarer til. Tre familier dækker hele produktspektret: Fladt ark (ét ark, 2 flader), Falset ark (ét ark med paneler) og Flersidet (flere ark, indbundet)."@da,
        "Setup-Modelle beschreiben die strukturelle Topologie eines Druckprodukts — wie die Substratbogen organisiert sind und welche adressierbaren Surfaces jede Seite jedes Bogens zuordnet. Drei Familien decken das gesamte Produktspektrum ab: Flat Sheet (ein Bogen, 2 Surfaces), Folded Sheet (ein Bogen mit Falzungen, die mehrere Paneele in 2 Surfaces gruppieren — außen/innen), und Multi-page (mehrere Bogen zusammengebunden, mit Surfaces für Cover und Inneres)."@de,
        "Setup Models describe the structural topology of a printed product — how the substrate sheets are organised, and what addressable Surfaces each side of each sheet maps to. Three families cover the entire product spectrum: Flat Sheet (single sheet, 2 surfaces), Folded Sheet (single sheet with folds creating multiple panels grouped in 2 surfaces — outside/inside), and Multi-page (multiple sheets bound together, with surfaces for cover and interior). Each Setup Model is referenced by Product Templates via `ptpge:setupModel`. Each Surface in a Setup Model has its own Print Layer Stack (Color Layer → Embellishment → Surface Finish) configured independently."@en,
        "Los Setup Models describen la topología estructural de un producto impreso — cómo se organizan las hojas de sustrato y a qué Surfaces direccionables se asigna cada cara de cada hoja. Tres familias cubren todo el espectro de productos: Flat Sheet (una hoja, 2 surfaces), Folded Sheet (una hoja con plegados que crean múltiples paneles agrupados en 2 surfaces — exterior/interior) y Multi-page (varias hojas encuadernadas, con surfaces para cubierta e interior). Cada Setup Model es referenciado por las Product Templates mediante `ptpge:setupModel`. Cada Surface de un Setup Model tiene su propia pila de capas de impresión (Color Layer → Embellishment → Surface Finish), configurada de forma independiente."@es,
        "सेटअप मॉडल मुद्रित उत्पाद की संरचनात्मक बनावट बताते हैं — सब्सट्रेट शीटें कैसे व्यवस्थित हैं, और हर शीट का हर पक्ष किन पता-योग्य सतहों से मेल खाता है। तीन परिवार पूरा उत्पाद-दायरा कवर करते हैं: फ़्लैट शीट (एक शीट, 2 सतहें), फ़ोल्डेड शीट (फ़ोल्ड वाली एक शीट, जिससे कई पैनल बनते हैं और 2 सतहों — बाहरी/भीतरी — में समूहित) और मल्टी-पेज (कई शीटें बँधी हुई, कवर और भीतरी हिस्से की सतहें)। हर सेटअप मॉडल उत्पाद टेम्पलेट द्वारा `ptpge:setupModel` से संदर्भित होता है। सेटअप मॉडल की हर सतह की अपनी प्रिंट लेयर स्टैक (रंग परत → एम्बेलिशमेंट → सतह फ़िनिश) स्वतंत्र रूप से कॉन्फ़िगर होती है।"@hi,
        "セットアップモデルは印刷物の構造的トポロジを定義する——基材シートがどのように構成され、各シートの各面がどの addressable Surface にマッピングされるかを示す。3つのファミリで製品全体をカバーする：Flat Sheet（1枚、2 surfaces）、Folded Sheet（折りにより複数パネルを2つの surfaces——outside / inside——にグループ化した1枚）、Multi-page（複数シートを綴じ合わせ、cover と interior に surfaces を持つ）。各 Setup Model は Product Templates から `ptpge:setupModel` を通じて参照される。各 Surface は独立して構成される Print Layer Stack（Color Layer → Embellishment → Surface Finish）を持つ。"@ja,
        "Oppsett-modeller beskriver den strukturelle topologien til et trykkprodukt — hvordan substrate-arkene er organisert, og hvilke adresserbare Surfaces hver side av hvert ark mapper til. Tre familier dekker hele produktspekteret: Flat Sheet (ett ark, 2 surfaces), Folded Sheet (ett ark med brett som lager flere paneler gruppert i 2 surfaces — outside/inside), og Multi-page (flere ark bundet sammen, med surfaces for cover og interior). Hver Setup Model refereres av Product Templates via `ptpge:setupModel`. Hver Surface i en Setup Model har sin egen trykklags-stack (Color Layer → Embellishment → Surface Finish) konfigurert uavhengig."@nb,
        "Opbouwmodellen beschrijven de structurele topologie van drukwerk — hoe de substraatvellen zijn georganiseerd en met welke adresseerbare vlakken elke zijde van elk vel overeenkomt. Drie families dekken het hele productspectrum: Vlak vel (één vel, 2 vlakken), Gevouwen vel (één vel met panelen) en Meerpagina (meerdere vellen, gebonden)."@nl,
        "Modele konfiguracji opisują strukturalną topologię produktu drukowanego — jak zorganizowane są arkusze podłoża i jakim adresowalnym powierzchniom odpowiada każda strona każdego arkusza. Trzy rodziny pokrywają całe spektrum produktów: Arkusz płaski (jeden arkusz, 2 powierzchnie), Arkusz złożony (jeden arkusz ze złamami tworzącymi wiele skrzydeł zgrupowanych w 2 powierzchnie — zewnętrzna/wewnętrzna) oraz Wielostronicowy (wiele arkuszy połączonych oprawą, z powierzchniami okładki i wnętrza). Każdy model konfiguracji jest przywoływany przez szablony produktów poprzez `ptpge:setupModel`. Każda powierzchnia w modelu konfiguracji ma własny stos warstw druku (warstwa barwna → uszlachetnienie → wykończenie powierzchni) konfigurowany niezależnie."@pl,
        "Os Modelos de Montagem descrevem a topologia estrutural de um impresso — como as folhas de substrato se organizam e a que Faces endereçáveis cada lado de cada folha corresponde. Três famílias cobrem todo o espectro de produtos: Folha Plana (uma folha, 2 faces), Folha Dobrada (uma folha com dobras que criam vários painéis agrupados em 2 faces — exterior/interior) e Multipágina (várias folhas encadernadas, com faces para capa e miolo). Cada Modelo de Montagem é referenciado pelos Modelos de Produto via `ptpge:setupModel`. Cada Face de um Modelo de Montagem tem sua própria pilha de camadas de impressão (Camada de cor → Enobrecimento → Acabamento de superfície), configurada de forma independente."@pt,
        "Uppbyggnadsmodeller beskriver en trycksaks strukturella topologi — hur substratarken är organiserade och vilka adresserbara ytor varje sida av varje ark motsvarar. Tre familjer täcker hela produktspektrumet: Plant ark (ett ark, 2 ytor), Falsat ark (ett ark med falsar som skapar flera paneler grupperade i 2 ytor — utsida/insida) och Flersidig (flera ark bundna samman, med ytor för omslag och inlaga). Varje uppbyggnadsmodell refereras av produktmallar via `ptpge:setupModel`. Varje yta i en uppbyggnadsmodell har sin egen tryckskiktstack (färgskikt → dekor → ytbehandling) som konfigureras oberoende."@sv,
        "Setup Models 描述印刷品的结构拓扑——承印物纸张如何组织，每张纸的每一面如何映射到可寻址的 Surfaces。三大类别覆盖完整的产品光谱：Flat Sheet（单张纸，2 个 surfaces）、Folded Sheet（单张纸折叠生成多个面板，分组为 2 个 surfaces——外侧/内侧）、Multi-page（多张纸装订在一起，分为封面与内页 surfaces）。每个 Setup Model 通过 `ptpge:setupModel` 被 Product Templates 引用。每个 Surface 拥有独立配置的 Print Layer Stack（Color Layer → Embellishment → Surface Finish）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/setup-models/display-system>,
        <https://ptpge.org/v1/printing/configurations/setup-models/flat-sheet>,
        <https://ptpge.org/v1/printing/configurations/setup-models/folded-sheet>,
        <https://ptpge.org/v1/printing/configurations/setup-models/multi-page>,
        <https://ptpge.org/v1/printing/configurations/setup-models/multi-part>,
        <https://ptpge.org/v1/printing/configurations/setup-models/roll>,
        <https://ptpge.org/v1/printing/configurations/setup-models/structural> ;
    skos:notation "P:CF-SMO" ;
    skos:prefLabel "Opsætningsmodeller"@da,
        "Setup-Modelle"@de,
        "Setup Models"@en,
        "Modelos de Configuración"@es,
        "सेटअप मॉडल"@hi,
        "セットアップモデル"@ja,
        "Oppsett-modeller"@nb,
        "Opbouwmodellen"@nl,
        "Modele konfiguracji"@pl,
        "Modelos de montagem"@pt,
        "Uppbyggnadsmodeller"@sv,
        "排版模型"@zh-Hans ;
    skos:scopeNote "Setup Models cover seven families. Three are sheet-based: Flat Sheet (single sheet, 2 surfaces — Front/Back), Folded Sheet (single sheet folded, 2 surfaces — Outside/Inside; thirteen fold variants), and Multi-page (multiple sheets bound, 6+ surfaces). Four cover non-sheet topologies: Structural (3-D die-cut packaging — boxes, cartons, bags), Roll (continuous labels/stickers on reel), Multi-part (carbonless/NCR stacked parts), and Display System (a wide-format graphic bundled with reusable hardware — roll-ups, stands). Setup Model is topology, not technology: wide-format products that are topologically flat (banners, rigid signs, posters, canvas) use Flat Sheet and express their wide-format nature via Technology/Substrate."@en,
        "सेटअप मॉडल सात परिवार कवर करते हैं। तीन शीट-आधारित: फ़्लैट शीट (एक शीट, 2 सतहें — आगे/पीछे), फ़ोल्डेड शीट (एक मुड़ी शीट, 2 सतहें — बाहरी/भीतरी; तेरह फ़ोल्ड वेरिएंट) और मल्टी-पेज (कई शीटें बँधी, 5+ सतहें)। चार ग़ैर-शीट बनावटें: संरचनात्मक (3-D डाई-कट पैकेजिंग — डिब्बे, कार्टन, थैले), रोल (रील पर सतत लेबल/स्टिकर), मल्टी-पार्ट (कार्बनलेस/NCR परतें) और डिस्प्ले सिस्टम (पुन: प्रयोज्य हार्डवेयर के साथ वाइड-फॉर्मेट ग्राफ़िक — रोल-अप, स्टैंड)। सेटअप मॉडल बनावट है, तकनीक नहीं: बनावट में सपाट वाइड-फॉर्मेट उत्पाद (बैनर, कठोर साइन, पोस्टर, कैनवास) फ़्लैट शीट का उपयोग करते हैं और अपनी वाइड-फॉर्मेट प्रकृति तकनीक/सब्सट्रेट से व्यक्त करते हैं।"@hi,
        "Os Modelos de Montagem cobrem sete famílias. Três são baseadas em folha: Folha Plana (uma folha, 2 faces — Frente/Verso), Folha Dobrada (uma folha dobrada, 2 faces — Exterior/Interior; treze variantes de dobra) e Multipágina (várias folhas encadernadas, 5+ faces). Quatro cobrem topologias não em folha: Estrutural (embalagem 3D com corte especial — caixas, cartuchos, sacolas), Rolo (etiquetas/adesivos contínuos em bobina), Multivias (vias autocopiativas/NCR empilhadas) e Sistema de Display (gráfico de grande formato com hardware reutilizável — roll-ups, estandes). Modelo de Montagem é topologia, não tecnologia: produtos de grande formato topologicamente planos (banners, placas rígidas, pôsteres, canvas) usam Folha Plana e expressam sua natureza de grande formato via Tecnologia/Substrato."@pt ;
    ptpge:group "configurations" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/embellishments> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/features> ;
    skos:definition "Forædlinger er mellemlaget i trykklagstakken — selektive additive behandlinger påført oven på farvelaget. Forædlinger tilføjer visuel eller taktil interesse (folieprægning, partiel UV-lak, prægning m.fl.)."@da,
        "Embellishments sind die mittlere Schicht des Druckschichten-Stacks — selektive additive Behandlungen, die auf die Color Layer aufgebracht werden."@de,
        "Embellishments are the middle layer of the Print Layer Stack — selective additive treatments applied on top of the Color Layer. Embellishments add visual or tactile interest (foil-stamping, spot UV varnish, embossing, debossing, relief treatments). They are typically applied to specific design elements, not full coverage. The Surface Finish layer (if any) sits on top of embellishments."@en,
        "Los Embellishments son efectos decorativos aplicados sobre el sustrato después de la capa de color — estampado con lámina, relieve, hundido, lámina caliente. Modifican la apariencia visual o táctil de una pieza impresa. Se distinguen del Surface Finish (que añade una capa superficial protectora o estética como barniz o laminado)."@es,
        "एम्बेलिशमेंट प्रिंट लेयर स्टैक की बीच की परत हैं — रंग परत के ऊपर चुनिंदा जगह लगाए गए योगात्मक उपचार। ये दृश्य या स्पर्श आकर्षण जोड़ते हैं (फ़ॉइल स्टैंपिंग, स्पॉट UV वार्निश, एम्बॉसिंग, डिबॉसिंग, उभार)। आमतौर पर विशिष्ट डिज़ाइन तत्वों पर, पूरी सतह पर नहीं। सतह फ़िनिश की परत (यदि हो) एम्बेलिशमेंट के ऊपर रहती है।"@hi,
        "Embellishmentsはカラー層の後に基材上に施される装飾的効果 — 箔押し、エンボス、デボス、ホットフォイル。印刷物の視覚的または触覚的外観を変える。Surface Finish（ニスやラミネーションなどの保護的または美的な表面層を加えるもの）とは区別される。"@ja,
        "Embellishments er det midterste laget i trykklags-stacken — selektive additive behandlinger lagt på toppen av Color Layer. Embellishments gir visuell eller taktil interesse (folie-trykk, spot UV-lakk, embossing, debossing, relief-behandlinger). De er typisk lagt på spesifikke design-elementer, ikke full-flate. Surface Finish (om den finnes) ligger over embellishments."@nb,
        "Veredelingen vormen de middelste laag van de druklaagstapel — selectieve additieve behandelingen bovenop de kleurlaag. Veredelingen voegen visuele of tactiele interesse toe (foliedruk, spot-UV-lak, preging e.a.)."@nl,
        "Uszlachetnienia to środkowa warstwa stosu warstw druku — wybiórcze zabiegi addytywne nanoszone na warstwę barwną. Dodają efektu wizualnego lub dotykowego (folia na gorąco, lakier UV wybiórczy, tłoczenie wypukłe, tłoczenie wklęsłe, efekty reliefowe). Zwykle stosowane do wybranych elementów projektu, nie na całej powierzchni. Warstwa wykończenia powierzchni (jeśli jest) leży na uszlachetnieniach."@pl,
        "Enobrecimentos são a camada intermediária da pilha de camadas de impressão — tratamentos aditivos seletivos aplicados sobre a camada de cor. Acrescentam interesse visual ou tátil (hot stamping, verniz UV localizado, relevo alto, relevo baixo, tratamentos em relevo). Normalmente aplicados a elementos específicos do design, não em cobertura total. A camada de acabamento de superfície (se houver) fica por cima dos enobrecimentos."@pt,
        "Dekor är mellanskiktet i tryckskiktstacken — selektiva additiva behandlingar applicerade ovanpå färgskiktet. Dekor tillför visuellt eller taktilt intresse (folieprägling, partiell UV-lack, prägling, försänkt prägling, reliefbehandlingar). De appliceras typiskt på specifika designelement, inte heltäckande. Ytbehandlingsskiktet (om något) ligger ovanpå dekoren."@sv,
        "Embellishments 是色彩层之后施加于承印物之上的装饰效果——烫箔、凸压、凹压、热烫箔。它们改变印刷品的视觉或触感外观。与 Surface Finish（添加保护性或美学表面层，如上光或覆膜）有所区别。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/features/embellishments/debossing>,
        <https://ptpge.org/v1/printing/features/embellishments/embossing>,
        <https://ptpge.org/v1/printing/features/embellishments/foil-stamping>,
        <https://ptpge.org/v1/printing/features/embellishments/full-uv-varnish>,
        <https://ptpge.org/v1/printing/features/embellishments/none>,
        <https://ptpge.org/v1/printing/features/embellishments/spot-aqueous-varnish>,
        <https://ptpge.org/v1/printing/features/embellishments/spot-uv-varnish> ;
    skos:notation "P:FT-EMB" ;
    skos:prefLabel "Forædlinger"@da,
        "Veredelung"@de,
        "Embellishments"@en,
        "Embellecimientos"@es,
        "सजावटी प्रभाव (एम्बेलिशमेंट)"@hi,
        "装飾加工"@ja,
        "Foredling"@nb,
        "Veredelingen"@nl,
        "Uszlachetnienia"@pl,
        "Enobrecimentos"@pt,
        "Dekor"@sv,
        "装饰加工"@zh-Hans ;
    ptpge:group "features" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/embellishments/foil-stamping/holographic> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Hologram Foil"@en,
        "रेनबो फ़ॉइल"@hi,
        "होलोग्राफ़िक स्टैंपिंग"@hi,
        "होलोग्राम फ़ॉइल"@hi,
        "Hologramfolie"@nb,
        "folia hologramowa"@pl,
        "hologram"@pl,
        "foil holograma"@pt,
        "holográfico"@pt,
        "hot stamping holográfico"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/embellishments/foil-stamping> ;
    skos:definition "Varmfolieprægning med holografisk folie — en regnbuespektret reflekterende folie, der skifter farve med synsvinklen. Bruges til eksklusiv emballage, certifikater og sikkerhedsanvendelser."@da,
        "Heißfolienprägung mit holographischer Folie — eine im Regenbogen-Spektrum reflektierende Folie, die ihre Farbe je nach Betrachtungswinkel ändert."@de,
        "Hot-foil stamping with holographic foil — a rainbow-spectrum reflective foil that shifts colour as the viewing angle changes. Used for premium packaging, certificates, and security applications."@en,
        "Estampación en caliente con foil holográfico — un foil reflectante de espectro arcoíris que cambia de color según el ángulo de visión. Usado en packaging premium, certificados y aplicaciones de seguridad."@es,
        "होलोग्राफ़िक फ़ॉइल से हॉट-फ़ॉइल स्टैंपिंग — इंद्रधनुषी परावर्तक फ़ॉइल जो देखने के कोण से रंग बदलती है। प्रीमियम पैकेजिंग, प्रमाणपत्रों और सुरक्षा अनुप्रयोगों में।"@hi,
        "ホログラム箔によるホットフォイル — 見る角度によって色が変わる虹スペクトルの反射箔。プレミアムパッケージ、証明書、セキュリティ用途に使われる。"@ja,
        "Varmfolie-preging med holografisk folie — en regnbue-spektrum reflekterende folie som skifter farge når betraktningsvinkelen endres. Brukes for premium-emballasje, sertifikater og sikkerhetsapplikasjoner."@nb,
        "Warmfoliedruk met holografische folie — een regenboogspectrum-reflecterende folie die van kleur verschuift met de kijkhoek. Gebruikt voor exclusieve verpakkingen, certificaten en beveiligingstoepassingen."@nl,
        "Folia na gorąco holograficzna — odbijająca folia o tęczowym widmie, zmieniająca kolor wraz z kątem patrzenia. Stosowana do opakowań premium, certyfikatów i zabezpieczeń."@pl,
        "Hot stamping com foil holográfico — um foil reflexivo de espectro arco-íris que muda de cor conforme o ângulo de visão. Usado em embalagens premium, certificados e aplicações de segurança."@pt,
        "Varmfoliering med holografisk folie — en reflekterande folie i regnbågsspektrum som skiftar kulör med betraktningsvinkeln. Används för exklusiva förpackningar, certifikat och säkerhetstillämpningar."@sv,
        "使用全息箔的烫印 — 随视角变换颜色的彩虹光谱反射箔。用于高端包装、证书与防伪应用。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§HOLOGRAPHIC" ;
    skos:prefLabel "Holografisk folie"@da,
        "Holografische Folie"@de,
        "Holographic Foil"@en,
        "Lámina holográfica"@es,
        "होलोग्राफ़िक फ़ॉइल"@hi,
        "ホログラム箔"@ja,
        "Holografisk folie"@nb,
        "Holografische folie"@nl,
        "Folia holograficzna"@pl,
        "Foil holográfico"@pt,
        "Holografisk folie"@sv,
        "全息箔"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.6 · p.74" ;
            ptpge:mappingRow "crosswalk row 25" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "EmbossingIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/substrates/roll-materials/vinyl> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:altLabel "Adhesive vinyl"@en,
        "PVC vinyl"@en,
        "Self-adhesive vinyl"@en,
        "PVC विनाइल"@hi,
        "चिपकने वाला विनाइल"@hi,
        "विनाइल रोल"@hi,
        "सेल्फ़-एडहेसिव विनाइल"@hi,
        "Vinyl"@nb,
        "folia samoprzylepna"@pl,
        "folia winylowa"@pl,
        "winyl PCV"@pl,
        "adesivo vinílico"@pt,
        "vinil PVC"@pt,
        "vinil adesivo"@pt,
        "vinil autoadesivo"@pt ;
    skos:broader <https://ptpge.org/v1/printing/substrates/roll-materials> ;
    skos:definition "Polyvinylchlorid-film (PVC) leveret på ruller — typisk selvklæbende. Bruges til skiltning, køretøjsindpakning, decals, gulvgrafik og udendørs bannere."@da,
        "Polyvinylchlorid-Folie (PVC) in Rollen — typischerweise selbstklebend. Verwendet für Beschilderung, Fahrzeugbeschriftung, Aufkleber, Bodengrafiken und Außenbanner."@de,
        "Polyvinyl chloride (PVC) film supplied on rolls — typically self-adhesive. Used for signage, vehicle wraps, decals, floor graphics, and outdoor banners."@en,
        "Vinilo adhesivo en bobina — sustrato dominante para señalética, rotulación de vehículos, vinilos decorativos y stickers."@es,
        "रोल में दी जाने वाली पॉलीविनाइल क्लोराइड (PVC) फ़िल्म — आमतौर पर स्वयं-चिपकने वाली। साइनेज, वाहन रैप, डीकल, फ़्लोर ग्राफ़िक्स और बाहरी बैनरों में।"@hi,
        "ロールで供給されるポリ塩化ビニル（PVC）フィルム — 通常自己粘着型。サイン、車両ラッピング、デカール、フロアグラフィック、屋外バナーに使用される。"@ja,
        "Polyvinylkloridfilm (PVC) levert på rull — typisk selvklebende. Brukt til skilting, kjøretøy-wraps, klistremerker, gulvgrafikk og utendørsbannere."@nb,
        "Polyvinylchloridefilm (pvc) op rollen — doorgaans zelfklevend. Gebruikt voor signalisatie, carwrapping, stickers, vloergraphics en buitenbanners."@nl,
        "Folia z polichlorku winylu (PCV) dostarczana w rolach — zwykle samoprzylepna. Używana do oznakowania, oklejania pojazdów, naklejek, grafik podłogowych i banerów zewnętrznych."@pl,
        "Filme de policloreto de vinila (PVC) fornecido em rolos — normalmente autoadesivo. Usado em sinalização, envelopamento de veículos, adesivos, gráficos de piso e banners externos."@pt,
        "Polyvinylkloridfilm (PVC) på rulle — typiskt självhäftande. Används för skyltar, fordonsfoliering, dekaler, golvgrafik och utomhusbanderoller."@sv,
        "卷筒粘性乙烯基 —— 标识、车辆贴膜、装饰贴膜和贴纸的主导承印物。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:SB§VINYL" ;
    skos:prefLabel "Vinyl"@da,
        "Vinyl"@de,
        "Vinyl"@en,
        "Vinilo"@es,
        "विनाइल"@hi,
        "ビニール"@ja,
        "Vinyl"@nb,
        "Vinyl"@nl,
        "Winyl"@pl,
        "Vinil"@pt,
        "Vinyl"@sv,
        "乙烯基"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "substrates" ;
    ptpge:level "element" ;
