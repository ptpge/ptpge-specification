<https://ptpge.org/v1/printing/configurations/formats/newspaper-formats> a skos:Concept ;
    dcterms:created "2026-08-12T11:00:47+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats> ;
    skos:definition "Avissideformater efter branchekonvention — fuldformat (broadsheet), berliner og tabloid. Nominelle mål; de præcise sidestørrelser varierer med pressens konfiguration."@da,
        "Zeitungsformate nach Branchenkonvention — Broadsheet, Berliner und Compact. Nominelle Maße; genaue Seitengrößen variieren je nach Rotationskonfiguration."@de,
        "Trade-convention newspaper page formats — broadsheet, Berliner and compact. Nominal dimensions; exact page sizes vary by press configuration."@en,
        "Formatos de página de periódico según convención del sector — sábana, berlinés y compacto. Dimensiones nominales; los tamaños exactos varían según la configuración de la rotativa."@es,
        "बिरादरी की परंपरा के अख़बार पृष्ठ फ़ॉर्मेट — ब्रॉडशीट, बर्लिनर और कॉम्पैक्ट। नाममात्र आयाम; सटीक पृष्ठ आकार प्रेस कॉन्फ़िगरेशन से बदलते हैं।"@hi,
        "業界慣行による新聞のページ判型 — ブロードシート、ベルリナー、コンパクト。公称寸法であり、実寸は輪転機の構成により異なる。"@ja,
        "Avisformater etter bransjekonvensjon — broadsheet, berliner og compact. Nominelle mål; eksakte sidestørrelser varierer med pressekonfigurasjonen."@nb,
        "Krantenpaginaformaten volgens brancheconventie — broadsheet, berliner en tabloid. Nominale maten; de exacte paginaformaten variëren met de configuratie van de pers."@nl,
        "Zwyczajowe branżowe formaty stron gazet — broadsheet, berliner i compact. Wymiary nominalne; dokładne rozmiary stron zależą od konfiguracji maszyny."@pl,
        "Formatos de página de jornal por convenção do ofício — broadsheet, Berliner e compacto. Dimensões nominais; os tamanhos exatos variam conforme a configuração da rotativa."@pt,
        "Tidningssidformat enligt branschkonvention — fullformat (broadsheet), berliner och tabloid. Nominella mått; exakta sidstorlekar varierar med pressens konfiguration."@sv,
        "按行业惯例的报纸版面幅面 — 对开、柏林式与紧凑型。名义尺寸；实际版面大小因轮转机配置而异。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/formats/newspaper-formats/berliner>,
        <https://ptpge.org/v1/printing/configurations/formats/newspaper-formats/broadsheet>,
        <https://ptpge.org/v1/printing/configurations/formats/newspaper-formats/compact> ;
    skos:notation "P:CF-NWS" ;
    skos:prefLabel "Tidningsformat"@da,
        "Zeitungsformate"@de,
        "Newspaper Formats"@en,
        "Formatos de periódico"@es,
        "अख़बार फ़ॉर्मेट"@hi,
        "新聞判型"@ja,
        "Avisformater"@nb,
        "Krantformaten"@nl,
        "Formaty gazetowe"@pl,
        "Formatos de jornal"@pt,
        "Tidningsformat"@sv,
        "报纸幅面"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-08-12" .

<https://ptpge.org/v1/printing/configurations/formats/ra-series> a skos:Concept ;
    dcterms:created "2026-08-12T11:00:47+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "RA Sizes"@en,
        "RA-formater"@nb,
        "formaty RA"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats> ;
    skos:definition "Ubeskårne trykarkformater efter ISO 217 (RA = Raw format A) — overdimensionerede ark, der renskæres ned til A-serien efter tryk, med mindre skæremargin end SRA-serien."@da,
        "Unbeschnittene Druckbogenformate nach ISO 217 (RA) — vergrößerte Bogen, die nach dem Druck auf die A-Reihe beschnitten werden, mit geringerer Zugabe als die SRA-Reihe."@de,
        "Untrimmed press-sheet formats of ISO 217 (RA = Raw format A) — oversized sheets trimmed down to the A series after printing, with a smaller allowance than the SRA series."@en,
        "Formatos de pliego sin recortar de ISO 217 (RA) — pliegos sobredimensionados que se refilan a la serie A tras la impresión, con menos demasía que la serie SRA."@es,
        "ISO 217 के बिना ट्रिम प्रेस-शीट फ़ॉर्मेट (RA = Raw format A) — छपाई के बाद A सीरीज़ में ट्रिम की जाने वाली बड़ी शीटें, SRA सीरीज़ से कम भत्ते के साथ।"@hi,
        "ISO 217 の断裁前印刷用紙判型（RA）。印刷後にA判へ断裁される大きめの用紙で、SRA系列より余白が小さい。"@ja,
        "Ubeskårne trykkarkformater i ISO 217 (RA) — overdimensjonerte ark som renskjæres til A-serien etter trykk, med mindre monn enn SRA-serien."@nb,
        "Onbesneden drukvelformaten volgens ISO 217 (RA = Raw format A) — ruimer bemeten vellen die na het drukken worden schoongesneden naar de A-reeks, met kleinere snijmarge dan de SRA-reeks."@nl,
        "Nieprzycięte formaty arkuszy drukowych normy ISO 217 (RA = Raw format A) — powiększone arkusze przycinane po druku do serii A, z mniejszym naddatkiem niż seria SRA."@pl,
        "Formatos de folha de impressão não refilada da ISO 217 (RA = Raw format A) — folhas superdimensionadas refiladas para a série A após a impressão, com margem menor que a série SRA."@pt,
        "Obeskurna tryckarksformat enligt ISO 217 (RA = Raw format A) — överdimensionerade ark som renskärs ned till A-serien efter tryck, med mindre skärmån än SRA-serien."@sv,
        "ISO 217 的未裁切印刷纸张幅面（RA）— 印后裁切为 A 系列的加大纸张，裁切余量小于 SRA 系列。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/formats/ra-series/ra0>,
        <https://ptpge.org/v1/printing/configurations/formats/ra-series/ra1>,
        <https://ptpge.org/v1/printing/configurations/formats/ra-series/ra2> ;
    skos:notation "P:CF-RA" ;
    skos:prefLabel "RA-serien (ISO 217)"@da,
        "RA-Reihe (ISO 217)"@de,
        "RA Series (ISO 217)"@en,
        "Serie RA (ISO 217)"@es,
        "RA सीरीज़ (ISO 217)"@hi,
        "RA判（ISO 217）"@ja,
        "RA-serie (ISO 217)"@nb,
        "RA-serie (ISO 217)"@nl,
        "Seria RA (ISO 217)"@pl,
        "Série RA (ISO 217)"@pt,
        "RA-serien (ISO 217)"@sv,
        "RA系列（ISO 217）"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
