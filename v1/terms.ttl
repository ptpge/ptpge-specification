<https://ptpge.org/v1/printing/configurations/formats/us/tabloid> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "11 x 17 in"@en,
        "11x17"@en,
        "11×17"@en,
        "ANSI B"@en,
        "Ledger"@en,
        "Tabloid size"@en,
        "format Tabloid"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/us> ;
    skos:definition "11 × 17 tommer (279.4 × 431.8 mm). Dobbelt areal af Letter — bruges til aviser, plakater og opslag. Samme dimensioner som Ledger, men i stående orientering."@da,
        "11 × 17 in (279,4 × 431,8 mm). Doppelte Fläche von Letter — verwendet für Zeitungen, Plakate und doppelseitige Spreads. Gleiche Maße wie Ledger, aber im Hochformat."@de,
        "11 × 17 in (279.4 × 431.8 mm). Twice the area of Letter — used for newspapers, posters, and double-page spreads. Same dimensions as Ledger but in portrait orientation."@en,
        "Tamaño Tabloide, 11 × 17 pulgadas (orientación vertical). Habitual para periódicos pequeños, boletines y carteles A3-equivalentes."@es,
        "11 × 17 in (279.4 × 431.8 mm). Letter का दोगुना क्षेत्रफल — अख़बारों, पोस्टरों और डबल-पेज स्प्रेड में। Ledger जैसे ही आयाम पर पोर्ट्रेट दिशा में।"@hi,
        "11×17インチ（279.4×431.8mm）。Letterの2倍の面積 — 新聞、ポスター、見開きに使用される。Ledgerと同一寸法だが縦向き。"@ja,
        "11 × 17 in (279,4 × 431,8 mm). Dobbelt areal av Letter — brukt til aviser, plakater og oppslagssider. Samme dimensjoner som Ledger, men i portrettorientering."@nb,
        "11 × 17 inch (279.4 × 431.8 mm). Dubbel het oppervlak van Letter — gebruikt voor kranten, posters en spreads. Dezelfde afmetingen als Ledger, maar in staande oriëntatie."@nl,
        "11 × 17 cali (279,4 × 431,8 mm). Dwukrotna powierzchnia Letter — używany do gazet, plakatów i rozkładówek. Te same wymiary co Ledger, lecz w orientacji pionowej."@pl,
        "11 × 17 in (279.4 × 431.8 mm). O dobro da área do Letter — usado em jornais, pôsteres e páginas duplas. Mesmas dimensões do Ledger, mas em orientação retrato."@pt,
        "11 × 17 tum (279.4 × 431.8 mm). Dubbla arean av Letter — används för tidningar, affischer och uppslag. Samma dimensioner som Ledger men i stående orientering."@sv,
        "Tabloid尺寸，11 × 17英寸（纵向）。常用于小报、通讯和A3等效海报。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§TABLOID" ;
    skos:prefLabel "Tabloid (11 x 17 tum)"@da,
        "Tabloid (11 x 17 in)"@de,
        "Tabloid (11 x 17 in)"@en,
        "Tabloid (279 × 432 mm / 11 × 17 in)"@es,
        "Tabloid (11 x 17 in)"@hi,
        "Tabloid (11 x 17 in)"@ja,
        "Tabloid (11 x 17 in)"@nb,
        "Tabloid (11 x 17 tum)"@nl,
        "Tabloid (11 x 17 in)"@pl,
        "Tabloid (11 x 17 in)"@pt,
        "Tabloid (11 x 17 tum)"@sv,
        "Tabloid (279 × 432 mm / 11 × 17 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 187.0 ;
            ptpge:aspectRatio 1.5455 ;
            ptpge:height 17.0 ;
            ptpge:standard "ANSI" ;
            ptpge:unit "in" ;
            ptpge:width 11.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/configurations/orientation/square> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:altLabel "1:1"@en,
        "Equal sides"@en,
        "Square orientation"@en,
        "1:1"@hi,
        "चौकोर"@hi,
        "बराबर भुजाएँ"@hi,
        "स्क्वेयर"@hi,
        "Kvadratisk"@nb,
        "1:1"@pl,
        "kwadrat"@pl,
        "orientacja kwadratowa"@pl,
        "1:1"@pt,
        "lados iguais"@pt,
        "orientação quadrada"@pt ;
    skos:broader <https://ptpge.org/v1/printing/configurations/orientation> ;
    skos:definition "Rektangulær orientering, hvor vandret og lodret mål er ens — bruges til kunsttryk, indhold til sociale medier og designdrevne udgivelser."@da,
        "Rechteckige Ausrichtung, bei der horizontale und vertikale Abmessungen gleich sind — verwendet für Kunstdrucke, Social-Media-Inhalte und designorientierte Publikationen."@de,
        "Rectangular orientation where horizontal and vertical dimensions are equal — used for art prints, social media content, and design-driven publications."@en,
        "Producto impreso con relación de aspecto 1:1. Habitual en catálogos de arte, libros fotográficos premium y packaging."@es,
        "आयताकार अभिविन्यास जिसमें क्षैतिज और ऊर्ध्वाधर आयाम बराबर हैं — आर्ट प्रिंट, सोशल मीडिया सामग्री और डिज़ाइन-प्रधान प्रकाशनों में।"@hi,
        "水平方向と垂直方向の寸法が等しい長方形の向き — アートプリント、ソーシャルメディアコンテンツ、デザイン主導の出版物に使用される。"@ja,
        "Rektangulær orientering der horisontale og vertikale dimensjoner er like — brukt for kunsttrykk, sosiale medier-innhold og designdrevne publikasjoner."@nb,
        "Rechthoekige oriëntatie waarbij horizontale en verticale maat gelijk zijn — gebruikt voor kunstdrukken, socialemedia-content en designgedreven publicaties."@nl,
        "Orientacja prostokątna, w której wymiary poziomy i pionowy są równe — używana do wydruków artystycznych, treści do mediów społecznościowych i publikacji o charakterze projektowym."@pl,
        "Orientação retangular em que as dimensões horizontal e vertical são iguais — usada em impressões de arte, conteúdo para redes sociais e publicações orientadas por design."@pt,
        "Rektangulär orientering där horisontellt och vertikalt mått är lika — används för konsttryck, sociala medier-innehåll och designdrivna publikationer."@sv,
        "宽高比为1:1的印刷品。常见于艺术画册、高级摄影书和包装。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§SQUARE" ;
    skos:prefLabel "Kvadratisk"@da,
        "Quadrat"@de,
        "Square"@en,
        "Cuadrado"@es,
        "वर्गाकार"@hi,
        "正方形"@ja,
        "Kvadrat"@nb,
        "Vierkant"@nl,
        "Kwadratowa"@pl,
        "Quadrado"@pt,
        "Kvadratisk"@sv,
        "方形"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78" ;
            ptpge:mappingRow "crosswalk row 21" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/features/embellishments/embossing> a skos:Concept ;
    dcterms:created "2026-05-19T20:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Raised Embossing"@en,
        "उभरी छपाई"@hi,
        "उभार"@hi,
        "एम्बॉस"@hi,
        "रेज़्ड एम्बॉसिंग"@hi,
        "Opphøyd preg"@nb,
        "Preging"@nb,
        "Relieffpreging"@nb,
        "emboss"@pl,
        "wytłoczenie wypukłe"@pl,
        "emboss"@pt,
        "relevo"@pt,
        "relevo alto"@pt,
        "relevo elevado"@pt ;
    skos:broader <https://ptpge.org/v1/printing/features/embellishments> ;
    skos:definition "Et reliefaftryk presset OP fra substratet, der skaber et hævet billede eller tekst. Udføres med han- og hunmatricer, der former substratet fra begge sider. Blindprægning bruger ingen farve/folie; folieprægning kombinerer med folie."@da,
        "Ein Reliefeindruck, der AUS dem Substrat hervorgepresst wird und ein erhabenes Bild oder Text erzeugt."@de,
        "A relief impression pressed UP from the substrate, creating a raised image or text. Done with male and female dies that shape the substrate from both sides. Blind embossing uses no ink/foil; foil embossing combines the relief with hot-foil application in one operation."@en,
        "El relieve es un embellecimiento estructural que eleva partes del sustrato por encima de la superficie circundante mediante un troquel, creando un elemento táctil tridimensional. A menudo se aplica a logotipos, monogramas o elementos de acento en portadas, tarjetas de visita y embalajes."@es,
        "सब्सट्रेट से ऊपर की ओर दबाकर बनाया उभार, जिससे उभरा हुआ चित्र या पाठ बनता है। पुरुष और स्त्री डाई से सब्सट्रेट को दोनों ओर से आकार दिया जाता है। ब्लाइंड एम्बॉसिंग में स्याही/फ़ॉइल नहीं; फ़ॉइल एम्बॉसिंग में उभार और हॉट-फ़ॉइल एक ही क्रिया में।"@hi,
        "エンボスは型を用いて基材の一部を周囲の表面より浮き上がらせる構造的な装飾加工で、立体的な触覚要素を生み出す。表紙、名刺、パッケージのロゴ、モノグラム、アクセント要素によく適用される。"@ja,
        "Et relief-inntrykk presset OPP fra substratet, som skaper et hevet bilde eller tekst. Utført med male og female dies som former substratet fra begge sider. Blind embossing bruker ingen blekk/folie; folie-embossing kombinerer relief med varmfolie-påføring i én operasjon."@nb,
        "Een reliëfafdruk OMHOOG uit het substraat geperst, die een verhoogd beeld of tekst vormt. Uitgevoerd met patrijs en matrijs die het substraat van beide zijden vormen. Blindpreging gebruikt geen inkt/folie; foliepreging combineert met folie."@nl,
        "Reliefowe wypchnięcie Z podłoża, tworzące wypukły obraz lub tekst. Wykonywane matrycą i patrycą kształtującymi podłoże z obu stron. Tłoczenie ślepe nie używa farby ani folii; tłoczenie z folią łączy relief z aplikacją folii na gorąco w jednej operacji."@pl,
        "Impressão em relevo prensada PARA CIMA a partir do substrato, criando imagem ou texto elevado. Feita com matrizes macho e fêmea que moldam o substrato dos dois lados. O relevo seco não usa tinta/foil; o relevo com foil combina o relevo com hot stamping em uma única operação."@pt,
        "Ett reliefavtryck pressat UPP ur substratet som skapar en upphöjd bild eller text. Görs med han- och honverktyg som formar substratet från båda sidor. Blindprägling använder varken bläck eller folie; folieprägling kombinerar reliefen med varmfolie i en och samma operation."@sv,
        "凸压（Embossing）是一种结构性装饰加工，使用模具将承印物的部分区域凸出于周围表面，形成立体触感元素。常应用于封面、名片和包装上的标识、字母组合或装饰元素。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/features/embellishments/embossing/blind>,
        <https://ptpge.org/v1/printing/features/embellishments/embossing/foil> ;
