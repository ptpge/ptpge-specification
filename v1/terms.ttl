        "亜鉛メッキ鋼"@ja,
        "Galvanisert stål"@nb,
        "Verzinkt staal"@nl,
        "Stal ocynkowana"@pl,
        "Aço galvanizado"@pt,
        "Galvaniserat stål"@sv,
        "镀锌钢"@zh-Hans ;
