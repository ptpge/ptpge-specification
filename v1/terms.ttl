<https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/efi-fiery-xf> a skos:Concept ;
    dcterms:created "2026-06-18T10:00:07+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:isReplacedBy <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
