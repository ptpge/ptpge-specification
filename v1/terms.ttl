        "Koenig & Bauer"@hi,
        "Koenig & Bauer"@ja,
        "Koenig & Bauer"@nb,
        "Koenig & Bauer"@nl,
        "Koenig & Bauer"@pl,
        "Koenig & Bauer"@pt,
        "Koenig & Bauer"@sv,
        "Koenig & Bauer"@zh-Hans ;
