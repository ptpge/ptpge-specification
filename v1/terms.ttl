    ptpge:version "2026-09-05" .

<https://ptpge.org/v1/variables/production> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/variables> ;
    skos:definition "Produktions-konfigurationsvariabler — de produktionsakser et trykt produkt kan konfigureres langs."@da,
        "Produktions-Konfigurationsvariablen — die Produktionsachsen, entlang derer ein Druckprodukt konfiguriert werden kann."@de,
        "Production configuration variables — the production axes a printed product can be configured along."@en,
        "Variables de configuración de producción — los ejes de producción a lo largo de los cuales puede configurarse un producto impreso."@es,
        "उत्पादन कॉन्फ़िगरेशन वेरिएबल — वे उत्पादन अक्ष जिनके साथ मुद्रित उत्पाद कॉन्फ़िगर किया जा सकता है।"@hi,
        "生産の構成変数 — 印刷物を構成できる生産の軸。"@ja,
        "Produksjon konfigurasjonsvariabler — produksjon-aksene et trykkprodukt kan konfigureres langs."@nb,
        "Productie-configuratievariabelen — de productieassen waarlangs een drukproduct kan worden geconfigureerd."@nl,
        "Zmienne konfiguracyjne produkcji — osie produkcyjne, wzdłuż których można skonfigurować produkt drukowany."@pl,
        "Variáveis de configuração de produção — os eixos de produção ao longo dos quais um impresso pode ser configurado."@pt,
        "Konfigurationsvariabler för produktion — de produktionsaxlar en trycksak kan konfigureras längs."@sv,
        "生产配置变量 — 印刷品可沿其配置的生产轴。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/variables/production/press-type>,
        <https://ptpge.org/v1/variables/production/technology> ;
    skos:notation "VAR:PD" ;
    skos:prefLabel "Produktion"@da,
        "Produktion"@de,
        "Production"@en,
        "Producción"@es,
        "उत्पादन"@hi,
        "生産"@ja,
        "Produksjon"@nb,
        "Productie"@nl,
        "Produkcja"@pl,
        "Produção"@pt,
        "Produktion"@sv,
        "生产"@zh-Hans ;
    ptpge:level "group" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/ordering/geography/asia> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:24+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T18:09:48+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/geography> ;
    skos:definition "Asien — geografisk facet på regionsniveau, der bruges til produktspecifikation, tilpasning til regionale standarder, leverandørlistning og afgrænsning af fragt og levering."@da,
        "Regionale Gruppierung Asien. Enthält länderspezifische Unterteilungen des asiatischen Kontinents zur Verwendung als geografische Facette in der Produktspezifikation, Lieferantenlisten und Versand-/Lieferzonen."@de,
        "Asian region grouping. Contains country-level subdivisions under the Asian continent for use as geographic facets in product specification, supplier listing, and shipping/delivery scoping."@en,
        "Agrupación regional de Asia. Contiene subdivisiones a nivel de país dentro del continente asiático, utilizadas como faceta geográfica en la especificación de productos, listados de proveedores y zonas de envío y entrega."@es,
        "क्षेत्रीय समूह: एशिया। उत्पाद विनिर्देश, आपूर्तिकर्ता सूची और शिपिंग/डिलीवरी के दायरे में भौगोलिक पहलू के रूप में उपयोग के लिए एशियाई महाद्वीप के अंतर्गत देश-स्तरीय उपविभाग।"@hi,
        "アジア地域のグループ。アジア大陸内の国レベルの細分を含み、製品仕様、供給者リスト、配送ゾーンの地理的ファセットとして使用される。"@ja,
        "Asia-regionen som gruppering. Inneholder land-nivå underinndelinger under det asiatiske kontinentet, brukt som geografisk fasett i produkt-spesifikasjon, leverandør-lister og frakt/leverings-avgrensning."@nb,
        "Azië — geografische facet op regioniveau, gebruikt voor productspecificatie, afstemming op regionale standaarden, leverancierslijsten en afbakening van verzending en levering."@nl,
        "Grupowanie regionalne dla Azji. Zawiera podziały na poziomie krajów kontynentu azjatyckiego, używane jako aspekty geograficzne w specyfikacji produktu, listach dostawców i zakresie wysyłki/dostawy."@pl,
        "Agrupamento regional: Ásia. Contém subdivisões de nível de país sob o continente asiático para uso como facetas geográficas em especificação de produto, listagem de fornecedores e delimitação de envio/entrega."@pt,
        "Asiatisk regiongruppering. Innehåller underindelningar på landsnivå under den asiatiska kontinenten, för användning som geografiska facetter i produktspecifikation, leverantörslistning och avgränsning av frakt och leverans."@sv,
        "亚洲区域分组。包含亚洲大陆下的国家级细分，作为产品规格、供应商列表和发货/配送范围的地理分面使用。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/ordering/geography/asia/china>,
        <https://ptpge.org/v1/ordering/geography/asia/india>,
        <https://ptpge.org/v1/ordering/geography/asia/japan> ;
    skos:notation "O:GY-ASI" ;
    skos:prefLabel "Asien"@da,
        "Asien"@de,
        "Asia"@en,
        "Asia"@es,
        "एशिया"@hi,
        "アジア"@ja,
        "Asia"@nb,
        "Azië"@nl,
        "Azja"@pl,
        "Ásia"@pt,
        "Asien"@sv,
        "亚洲"@zh-Hans ;
    ptpge:group "geography" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/ordering/geography/europe/benelux> a skos:Concept ;
    dcterms:created "2026-06-26T05:36:54+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T18:09:48+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/geography/europe> ;
    skos:definition "Subregional gruppering, der omfatter Belgien (BE), Nederlandene (NL) og Luxembourg (LU). Behandles ofte som ét marked i tryk- og leveringssammenhæng."@da,
        "Benelux-Untergruppierung, die Belgien (BE), die Niederlande (NL) und Luxemburg (LU) umfasst. In der europäischen Druckindustrie häufig als einheitliches Marktsegment behandelt aufgrund enger wirtschaftlicher Integration, gemeinsamer Handelskonventionen und abgestimmter Regulierungsrahmen."@de,
        "BeNeLux sub-region grouping covering Belgium (BE), the Netherlands (NL), and Luxembourg (LU). Frequently treated as a single market segment in the European printing industry due to close economic integration, shared trade conventions, and aligned regulatory frameworks."@en,
        "Subagrupación Benelux que cubre Bélgica (BE), los Países Bajos (NL) y Luxemburgo (LU). Frecuentemente tratada como un único segmento de mercado en la industria europea de impresión debido a la estrecha integración económica, convenciones comerciales compartidas y marcos regulatorios alineados."@es,
        "बेनेलक्स उप-क्षेत्रीय समूह: बेल्जियम (BE), नीदरलैंड (NL) और लक्ज़मबर्ग (LU)। घनिष्ठ आर्थिक एकीकरण, साझा व्यापार परंपराओं और संरेखित नियामक ढाँचों के कारण यूरोपीय मुद्रण उद्योग में अक्सर एक ही बाज़ार खंड माना जाता है।"@hi,
        "ベルギー（BE）、オランダ（NL）、ルクセンブルク（LU）を含むベネルクスサブ地域グループ。緊密な経済統合、共通の取引慣行、整合した規制枠組みにより、欧州印刷業界で単一の市場セグメントとして扱われることが多い。"@ja,
        "Benelux-undergruppe som dekker Belgia (BE), Nederland (NL) og Luxemburg (LU). Behandles ofte som ett markedssegment i den europeiske trykkindustrien på grunn av tett økonomisk integrasjon, felles handelskonvensjoner og forente regulatoriske rammer."@nb,
        "Subregionale groepering die België (BE), Nederland (NL) en Luxemburg (LU) omvat. Wordt in druk- en leveringscontext vaak als één markt behandeld."@nl,
        "Grupowanie subregionalne Benelux obejmujące Belgię (BE), Holandię (NL) i Luksemburg (LU). W europejskim przemyśle poligraficznym często traktowane jako jeden segment rynku ze względu na ścisłą integrację gospodarczą, wspólne zwyczaje handlowe i zbliżone ramy regulacyjne."@pl,
        "Agrupamento sub-regional Benelux: Bélgica (BE), Países Baixos (NL) e Luxemburgo (LU). Frequentemente tratado como um único segmento de mercado na indústria gráfica europeia, pela estreita integração econômica, convenções comerciais compartilhadas e quadros regulatórios alinhados."@pt,
        "Subregional gruppering som omfattar Belgien (BE), Nederländerna (NL) och Luxemburg (LU). Behandlas ofta som ett enda marknadssegment i den europeiska tryckindustrin på grund av tät ekonomisk integration, gemensamma handelskonventioner och samstämmiga regelverk."@sv,
        "比荷卢次区域分组，涵盖比利时（BE）、荷兰（NL）和卢森堡（LU）。由于紧密的经济一体化、共同的贸易惯例和一致的法规框架，在欧洲印刷行业中常被视为单一市场细分。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/ordering/geography/europe/benelux/belgium>,
        <https://ptpge.org/v1/ordering/geography/europe/benelux/luxembourg>,
        <https://ptpge.org/v1/ordering/geography/europe/benelux/netherlands> ;
    skos:notation "O:GY-EUR-BENELUX" ;
    skos:prefLabel "BeNeLux"@da,
        "Benelux"@de,
        "BeNeLux"@en,
        "Benelux"@es,
        "बेनेलक्स"@hi,
        "ベネルクス"@ja,
        "Benelux"@nb,
        "BeNeLux"@nl,
        "Benelux"@pl,
        "Benelux"@pt,
        "Benelux"@sv,
        "比荷卢"@zh-Hans ;
    ptpge:group "geography" ;
    ptpge:level "sub-category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-26" .

<https://ptpge.org/v1/ordering/geography/europe/dach> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:24+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T18:09:48+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/geography/europe> ;
    skos:definition "Subregional gruppering, der omfatter Tyskland (DE), Østrig (AT) og Schweiz (CH). Behandles ofte som ét tysksproget marked i tryk- og leveringssammenhæng."@da,
        "DACH-Untergruppierung, die Deutschland (DE), Österreich (AT) und die Schweiz (CH) umfasst. In der europäischen Druckindustrie häufig als einheitliches Marktsegment behandelt aufgrund gemeinsamer Sprache, ähnlicher Regulierungsrahmen und abgestimmter Handelskonventionen."@de,
        "DACH sub-region grouping covering Germany (DE), Austria (AT), and Switzerland (CH). Frequently treated as a single market segment in the European printing industry due to shared language, similar regulatory frameworks, and aligned trade conventions."@en,
        "Subagrupación DACH que cubre Alemania (DE), Austria (AT) y Suiza (CH). Frecuentemente tratada como un único segmento de mercado en la industria europea de impresión debido al idioma compartido, marcos regulatorios similares y convenciones comerciales alineadas."@es,
        "DACH उप-क्षेत्रीय समूह: जर्मनी (DE), ऑस्ट्रिया (AT) और स्विट्ज़रलैंड (CH)। साझा भाषा, समान नियामक ढाँचों और संरेखित व्यापार परंपराओं के कारण यूरोपीय मुद्रण उद्योग में अक्सर एक ही बाज़ार खंड माना जाता है।"@hi,
        "ドイツ（DE）、オーストリア（AT）、スイス（CH）を含むDACHサブ地域グループ。共通言語、類似の規制枠組み、整合した取引慣行により、欧州印刷業界で単一の市場セグメントとして扱われることが多い。"@ja,
        "DACH-undergruppe som dekker Tyskland (DE), Østerrike (AT) og Sveits (CH). Behandles ofte som ett markedssegment i den europeiske trykkindustrien på grunn av felles språk, lignende regulatoriske rammer og forente handelskonvensjoner."@nb,
        "Subregionale groepering die Duitsland (DE), Oostenrijk (AT) en Zwitserland (CH) omvat. Wordt in druk- en leveringscontext vaak als één Duitstalige markt behandeld."@nl,
        "Grupowanie subregionalne DACH obejmujące Niemcy (DE), Austrię (AT) i Szwajcarię (CH). W europejskim przemyśle poligraficznym często traktowane jako jeden segment rynku ze względu na wspólny język, podobne ramy regulacyjne i zbieżne zwyczaje handlowe."@pl,
        "Agrupamento sub-regional DACH: Alemanha (DE), Áustria (AT) e Suíça (CH). Frequentemente tratado como um único segmento de mercado na indústria gráfica europeia, pela língua comum, quadros regulatórios semelhantes e convenções comerciais alinhadas."@pt,
        "Subregional gruppering som omfattar Tyskland (DE), Österrike (AT) och Schweiz (CH). Behandlas ofta som ett enda marknadssegment i den europeiska tryckindustrin på grund av gemensamt språk, likartade regelverk och samstämmiga handelskonventioner."@sv,
        "DACH 次区域分组，涵盖德国（DE）、奥地利（AT）和瑞士（CH）。由于共同语言、相似的法规框架和一致的贸易惯例，在欧洲印刷行业中常被视为单一市场细分。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/ordering/geography/europe/dach/austria>,
        <https://ptpge.org/v1/ordering/geography/europe/dach/germany>,
        <https://ptpge.org/v1/ordering/geography/europe/dach/switzerland> ;
    skos:notation "O:GY-EUR-DACH" ;
    skos:prefLabel "DACH"@da,
        "DACH"@de,
        "DACH"@en,
        "DACH"@es,
        "DACH"@hi,
        "DACH（独・墺・瑞）"@ja,
        "DACH"@nb,
        "DACH"@nl,
        "DACH"@pl,
        "DACH"@pt,
        "DACH"@sv,
        "DACH（德奥瑞）"@zh-Hans ;
    ptpge:group "geography" ;
    ptpge:level "sub-category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/ordering/geography/north-america> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:24+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T18:09:48+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/geography> ;
    skos:definition "Nordamerika — geografisk facet på regionsniveau, der bruges til produktspecifikation, tilpasning til regionale standarder, leverandørlistning og afgrænsning af fragt og levering."@da,
        "Regionale Gruppierung Nordamerika. Enthält länderspezifische Unterteilungen für die Vereinigten Staaten (US), Kanada (CA) und Mexiko (MX). Verwendet als geografische Facette für Papierformatstandards (US Letter, Legal, Tabloid), Zertifizierungen, Lieferantenlisten und Versandzonen."@de,
        "North American region grouping. Contains country-level subdivisions for the United States (US), Canada (CA), and Mexico (MX). Used as geographic facet for paper size standards (US Letter, Legal, Tabloid), certifications, supplier listings, and shipping zones."@en,
        "Agrupación regional de Norteamérica. Contiene subdivisiones a nivel de país para Estados Unidos (US), Canadá (CA) y México (MX). Utilizada como faceta geográfica para normas de tamaño de papel (US Letter, Legal, Tabloid), certificaciones, listados de proveedores y zonas de envío."@es,
        "क्षेत्रीय समूह: उत्तर अमेरिका। संयुक्त राज्य (US), कनाडा (CA) और मेक्सिको (MX) के देश-स्तरीय उपविभाग। काग़ज़ आकार मानकों (US Letter, Legal, Tabloid), प्रमाणन, आपूर्तिकर्ता सूचियों और शिपिंग ज़ोन के लिए भौगोलिक पहलू के रूप में प्रयुक्त।"@hi,
        "北アメリカ地域のグループ。米国（US）、カナダ（CA）、メキシコ（MX）の国レベルの細分を含む。用紙サイズ規格（US Letter、Legal、Tabloid）、認証、供給者リスト、配送ゾーンの地理的ファセットとして使用される。"@ja,
        "Nord-Amerika-regionen som gruppering. Inneholder land-nivå underinndelinger for USA (US), Canada (CA) og Mexico (MX). Brukt som geografisk fasett for papirformat-standarder (US Letter, Legal, Tabloid), sertifiseringer, leverandør-lister og fraktsoner."@nb,
        "Noord-Amerika — geografische facet op regioniveau, gebruikt voor productspecificatie, afstemming op regionale standaarden, leverancierslijsten en afbakening van verzending en levering."@nl,
        "Grupowanie regionalne dla Ameryki Północnej. Zawiera podziały na poziomie krajów: Stany Zjednoczone (US), Kanada (CA) i Meksyk (MX). Używane jako aspekt geograficzny dla standardów formatów papieru (US Letter, Legal, Tabloid), certyfikatów, list dostawców i stref wysyłki."@pl,
        "Agrupamento regional: América do Norte. Contém subdivisões de nível de país para Estados Unidos (US), Canadá (CA) e México (MX). Usado como faceta geográfica para normas de tamanho de papel (US Letter, Legal, Tabloid), certificações, listagens de fornecedores e zonas de envio."@pt,
        "Nordamerikansk regiongruppering. Innehåller underindelningar på landsnivå för USA (US), Kanada (CA) och Mexiko (MX). Används som geografisk facett för pappersformatstandarder (US Letter, Legal, Tabloid), certifieringar, leverantörslistningar och fraktzoner."@sv,
        "北美洲区域分组。包含美国（US）、加拿大（CA）和墨西哥（MX）的国家级细分。作为纸张规格标准（US Letter、Legal、Tabloid）、认证、供应商列表和发货区域的地理分面使用。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/ordering/geography/north-america/canada>,
        <https://ptpge.org/v1/ordering/geography/north-america/mexico>,
        <https://ptpge.org/v1/ordering/geography/north-america/united-states> ;
    skos:notation "O:GY-NAM" ;
    skos:prefLabel "Nordamerika"@da,
        "Nordamerika"@de,
        "North America"@en,
        "Norteamérica"@es,
        "उत्तर अमेरिका"@hi,
        "北アメリカ"@ja,
        "Nord-Amerika"@nb,
        "Noord-Amerika"@nl,
        "Ameryka Północna"@pl,
        "América do Norte"@pt,
        "Nordamerika"@sv,
        "北美洲"@zh-Hans ;
    ptpge:group "geography" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/ordering/knowledge> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:24+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:33:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering> ;
    skos:definition "Ressourcer, der hjælper købere og producenter med at forstå og anvende PTPGE-begreberne i praksis. Organiseret i tre kategorier: Guider (forklarende dokumenter og best practice), Værktøjer (interaktive hjælpemidler — konfiguratorer, validatorer, omregnere) og Skabeloner (genbrugelige udgangspunkter for almindelige bestillings- og produktionsscenarier). Vidensressourcerne refererer til termer på tværs af begge topkoncepter."@da,
        "Ressourcen, die Käufern und Produzenten helfen, PTPGE-Konzepte in der Praxis zu verstehen und anzuwenden. Gegliedert in drei Kategorien: Guides (erklärende Dokumente und Best-Practice-Playbooks), Tools (interaktive Werkzeuge — Konfiguratoren, Validatoren, Konverter) und Templates (wiederverwendbare Ausgangspunkte für gängige Bestell- und Produktionsszenarien). Knowledge-Ressourcen referenzieren Begriffe aus beiden Top-Konzepten (Druckprozess und Bestellprozess) und bilden die Kontextschicht, die rohe Taxonomie in umsetzbare Arbeitsabläufe überführt. Abgegrenzt von Begriffsdefinitionen: Knowledge-Ressourcen sind How-to-Material, das sich unabhängig von der Taxonomie selbst weiterentwickeln kann."@de,
        "Resources that help buyers and producers understand and apply PTPGE concepts in practice. Organised into three categories: Guides (explanatory documents and best-practice playbooks), Tools (interactive utilities — configurators, validators, converters), and Templates (reusable starting points for common ordering and production scenarios). Knowledge resources reference terms across both top concepts (Printing Process and Ordering Process), providing the contextual layer that turns raw taxonomy into actionable workflows. Distinct from term-level definitions: knowledge resources are how-to material that may evolve independently of the taxonomy itself."@en,
        "Recursos que ayudan a compradores y productores a entender y aplicar los conceptos de PTPGE en la práctica. Organizados en tres categorías: Guides (documentos explicativos y manuales de buenas prácticas), Tools (utilidades interactivas — configuradores, validadores, conversores) y Templates (puntos de partida reutilizables para escenarios comunes de pedido y producción). Los recursos de conocimiento hacen referencia a términos en ambos conceptos principales (Proceso de Impresión y Proceso de Pedido), proporcionando la capa contextual que convierte la taxonomía pura en flujos de trabajo accionables. Se distinguen de las definiciones de términos: los recursos de conocimiento son material de cómo hacer, que puede evolucionar de forma independiente de la propia taxonomía."@es,
        "ऐसे संसाधन जो खरीदारों और उत्पादकों को PTPGE की संकल्पनाएँ व्यवहार में समझने और लागू करने में मदद करते हैं। तीन श्रेणियों में व्यवस्थित: गाइड (व्याख्यात्मक दस्तावेज़ और सर्वोत्तम-प्रथा पुस्तिकाएँ), टूल (इंटरैक्टिव उपयोगिताएँ — कॉन्फ़िगरेटर, वैलिडेटर, कन्वर्टर) और टेम्पलेट (सामान्य ऑर्डरिंग और उत्पादन परिदृश्यों के लिए पुन: प्रयोज्य प्रारंभ बिंदु)। ज्ञान संसाधन दोनों शीर्ष संकल्पनाओं (मुद्रण प्रक्रिया और ऑर्डरिंग प्रक्रिया) के पदों को संदर्भित करते हैं और वह प्रासंगिक परत देते हैं जो कच्चे वर्गीकरण को कार्रवाई योग्य कार्यप्रवाह में बदलती है। पद-स्तर की परिभाषाओं से अलग: ज्ञान संसाधन «कैसे करें» सामग्री हैं जो वर्गीकरण से स्वतंत्र विकसित हो सकती है।"@hi,
        "PTPGEの概念を実践で理解し適用するための、購入者と生産者向けリソース。3つのカテゴリで構成される：Guides（解説書とベストプラクティス・プレイブック）、Tools（インタラクティブなユーティリティ——コンフィギュレータ、バリデータ、コンバータ）、Templates（一般的な発注・生産シナリオ向けの再利用可能な開始点）。ナレッジ・リソースは両方のトップコンセプト（印刷プロセスと発注プロセス）の用語を参照し、生のタクソノミーを実行可能なワークフローへと変換する文脈レイヤーを提供する。用語レベルの定義とは区別され、ナレッジ・リソースはタクソノミー本体とは独立して進化しうる how-to コンテンツである。"@ja,
        "Ressurser som hjelper kjøpere og produsenter med å forstå og anvende PTPGE-konsepter i praksis. Organisert i tre kategorier: Guides (forklarende dokumenter og best-practice-playbooks), Tools (interaktive verktøy — konfiguratorer, validatorer, konverterere) og Templates (gjenbrukbare startpunkter for vanlige bestillings- og produksjonsscenarier). Kunnskapsressursene refererer termer på tvers av begge toppkonsepter (Trykkeprosess og Bestillingsprosess), og gir det kontekstuelle laget som gjør rå taksonomi om til handlingsorienterte arbeidsflyter. Skiller seg fra term-definisjoner: kunnskapsressurser er how-to-materiale som kan utvikles uavhengig av selve taksonomien."@nb,
        "Bronnen die kopers en producenten helpen de PTPGE-concepten in de praktijk te begrijpen en toe te passen. Georganiseerd in drie categorieën: Gidsen (verklarende documenten en best practices), Hulpmiddelen (interactieve tools — configuratoren, validators, omrekenaars) en Sjablonen (herbruikbare startpunten voor veelvoorkomende bestel- en productiescenario's)."@nl,
        "Zasoby pomagające nabywcom i producentom rozumieć i stosować pojęcia PTPGE w praktyce. Uporządkowane w trzy kategorie: Przewodniki (dokumenty objaśniające i zbiory dobrych praktyk), Narzędzia (interaktywne programy — konfiguratory, walidatory, konwertery) oraz Szablony (gotowe punkty wyjścia dla typowych scenariuszy zamawiania i produkcji). Zasoby wiedzy odwołują się do terminów z obu pojęć nadrzędnych (Proces drukowania i Proces zamawiania), tworząc warstwę kontekstu, która zamienia surową taksonomię w praktyczne procesy. W odróżnieniu od definicji terminów są to materiały instruktażowe, które mogą się rozwijać niezależnie od samej taksonomii."@pl,
        "Recursos que ajudam compradores e produtores a entender e aplicar os conceitos do PTPGE na prática. Organizados em três categorias: Guias (documentos explicativos e manuais de boas práticas), Ferramentas (utilitários interativos — configuradores, validadores, conversores) e Modelos (pontos de partida reutilizáveis para cenários comuns de compra e produção). Os recursos de conhecimento referenciam termos dos dois conceitos de topo (Processo de Impressão e Processo de Compra), fornecendo a camada contextual que transforma taxonomia bruta em fluxos de trabalho acionáveis. Distintos das definições de termo: recursos de conhecimento são material de «como fazer» que pode evoluir independentemente da taxonomia."@pt,
        "Resurser som hjälper köpare och producenter att förstå och tillämpa PTPGE-begreppen i praktiken. Organiserade i tre kategorier: Guider (förklarande dokument och best practice-handböcker), Verktyg (interaktiva hjälpmedel — konfiguratorer, validerare, konverterare) och Mallar (återanvändbara utgångspunkter för vanliga beställnings- och produktionsscenarier). Kunskapsresurser refererar termer under båda toppkoncepten (Tryckprocess och Beställningsprocess) och utgör kontextskiktet som förvandlar rå taxonomi till användbara arbetsflöden. Skiljer sig från termnivåns definitioner: kunskapsresurser är how-to-material som kan utvecklas oberoende av själva taxonomin."@sv,
        "帮助买方与生产方在实践中理解和应用 PTPGE 概念的资源。分为三类：Guides（说明性文档和最佳实践手册）、Tools（交互式工具——配置器、验证器、转换器）以及 Templates（用于常见订购和生产场景的可复用起点）。知识资源引用两个顶层概念（印刷过程和订购过程）中的术语，提供将原始分类法转化为可执行工作流的语境层。与术语级定义不同，知识资源属于使用指南类内容，可独立于分类法本身演进。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/ordering/knowledge/guides>,
        <https://ptpge.org/v1/ordering/knowledge/templates>,
        <https://ptpge.org/v1/ordering/knowledge/tools> ;
    skos:notation "O:KN" ;
    skos:prefLabel "Viden"@da,
        "Wissen"@de,
        "Knowledge"@en,
        "Conocimiento"@es,
        "ज्ञान"@hi,
        "知識"@ja,
        "Kunnskap"@nb,
        "Kennis"@nl,
        "Wiedza"@pl,
        "Conhecimento"@pt,
        "Kunskap"@sv,
        "知识"@zh-Hans ;
    ptpge:group "knowledge" ;
    ptpge:level "group" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/ordering/knowledge/templates> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:24+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:33:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/knowledge> ;
    skos:definition "Designfil-skabeloner til download, forudindstillet til almindelige trykspecifikationer. Organiseret efter designprogram (Adobe InDesign, Adobe Illustrator, Adobe PDF). Hver skabelon refererer via skos:related til de filformatstandarder, den producerer."@da,
        "Herunterladbare Design-Dateivorlagen, vorkonfiguriert für gängige Druckproduktspezifikationen. Gegliedert nach Designanwendung (Adobe InDesign, Adobe Illustrator, Adobe PDF). Jede Vorlage verweist über skos:related auf die Dateiformatstandards, die sie produziert."@de,
        "Downloadable design file templates pre-configured for common print product specifications. Organised by design application (Adobe InDesign, Adobe Illustrator, Adobe PDF). Each template references the file-format standards it produces via skos:related."@en,
        "Plantillas de archivos de diseño descargables, preconfiguradas para especificaciones comunes de productos impresos. Organizadas por aplicación de diseño (Adobe InDesign, Adobe Illustrator, Adobe PDF). Cada plantilla referencia mediante skos:related las normas de formato de archivo que produce."@es,
        "सामान्य मुद्रित-उत्पाद विनिर्देशों के लिए पहले से कॉन्फ़िगर किए गए, डाउनलोड योग्य डिज़ाइन फ़ाइल टेम्पलेट। डिज़ाइन एप्लिकेशन (Adobe InDesign, Adobe Illustrator, Adobe PDF) के अनुसार व्यवस्थित। हर टेम्पलेट skos:related के ज़रिए उन फ़ाइल-फ़ॉर्मेट मानकों को संदर्भित करता है जिन्हें वह उत्पन्न करता है।"@hi,
        "一般的な印刷物仕様に合わせて事前設定された、ダウンロード可能なデザインファイルテンプレート。デザインアプリケーション（Adobe InDesign、Adobe Illustrator、Adobe PDF）別に整理されている。各テンプレートは生成するファイル形式規格をskos:relatedで参照する。"@ja,
        "Nedlastbare design-fil-maler forhåndskonfigurert for vanlige trykkprodukt-spesifikasjoner. Organisert etter design-applikasjon (Adobe InDesign, Adobe Illustrator, Adobe PDF). Hver mal refererer filformat-standardene den produserer via skos:related."@nb,
        "Downloadbare ontwerpbestandssjablonen, vooraf ingesteld op veelvoorkomende drukspecificaties. Georganiseerd per ontwerpprogramma (Adobe InDesign, Adobe Illustrator, Adobe PDF). Elk sjabloon verwijst via skos:related naar de bestandsformaatstandaarden die het produceert."@nl,
        "Szablony plików projektowych do pobrania, wstępnie skonfigurowane dla typowych specyfikacji produktów drukowanych. Uporządkowane według aplikacji projektowej (Adobe InDesign, Adobe Illustrator, Adobe PDF). Każdy szablon odwołuje się poprzez skos:related do standardów formatów plików, które wytwarza."@pl,
        "Modelos de arquivo de design para download, pré-configurados para especificações comuns de impressos. Organizados por aplicativo de design (Adobe InDesign, Adobe Illustrator, Adobe PDF). Cada modelo referencia via skos:related as normas de formato de arquivo que produz."@pt,
        "Nedladdningsbara designfilsmallar förkonfigurerade för vanliga tryckproduktspecifikationer. Organiserade per designprogram (Adobe InDesign, Adobe Illustrator, Adobe PDF). Varje mall refererar de filformatstandarder den producerar via skos:related."@sv,
        "可下载的设计文件模板，已针对常见印刷品规格预先配置。按设计应用程序（Adobe InDesign、Adobe Illustrator、Adobe PDF）组织。每个模板通过 skos:related 引用其生成的文件格式标准。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/ordering/knowledge/templates/adobe-illustrator>,
        <https://ptpge.org/v1/ordering/knowledge/templates/adobe-indesign>,
        <https://ptpge.org/v1/ordering/knowledge/templates/adobe-pdf> ;
    skos:notation "O:KN-TPL" ;
    skos:prefLabel "Skabeloner"@da,
        "Vorlagen"@de,
        "Templates"@en,
        "Plantillas"@es,
        "टेम्पलेट"@hi,
        "テンプレート"@ja,
        "Maler"@nb,
        "Sjablonen"@nl,
        "Szablony"@pl,
        "Modelos de arquivo"@pt,
        "Mallar"@sv,
        "模板"@zh-Hans ;
    ptpge:group "knowledge" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

