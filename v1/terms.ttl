        "Enfocus PitStop Pro"@de,
        "Enfocus PitStop Pro"@en,
        "Enfocus PitStop Pro"@es,
        "Enfocus PitStop Pro"@hi,
        "Enfocus PitStop Pro"@ja,
        "Enfocus PitStop Pro"@nb,
        "Enfocus PitStop Pro"@nl,
        "Enfocus PitStop Pro"@pl,
        "Enfocus PitStop Pro"@pt,
        "Enfocus PitStop Pro"@sv,
        "Enfocus PitStop Pro"@zh-Hans ;
