    skos:altLabel "Limbundet"@da,
        "Klebebindung"@de,
        "Klebegebunden"@de,
        "Adhesive binding"@en,
        "Glue bound"@en,
        "Glued binding"@en,
        "Paperback binding"@en,
        "Perfect bound"@en,
        "Perfect-bound"@en,
        "एडहेसिव बाइंडिंग"@hi,
        "गोंद बाइंडिंग"@hi,
        "परफेक्ट बाउंड"@hi,
        "पेपरबैक बाइंडिंग"@hi,
        "सॉफ़्ट बाइंडिंग"@hi,
        "Limbinding"@nb,
        "Limbundet"@nb,
        "Limfres"@nb,
        "Limfrest"@nb,
        "Myk perm"@nb,
        "klejenie grzbietu"@pl,
        "oprawa bezszwowa"@pl,
        "oprawa miękka klejona"@pl,
        "colado"@pt,
        "encadernação colada"@pt,
        "hot melt"@pt,
        "lombada colada"@pt,
