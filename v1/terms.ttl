    ptpge:version "2026-10-12" ;
    ptpge:writtenBy "a printer, or its MIS" .

<https://ptpge.org/v1/variables/compliance/climate-documentation> a skos:Concept ;
    dcterms:created "2026-07-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/variables/compliance> ;
    skos:definition "Konfigurerbar kravsakse: den CO₂-regnskabsdokumentation køberen kræver, at tilbuddet bærer. Værdierne refererer til anerkendte regnskabsmetoder (ISO 14067, GHG Protocol Product Standard, ClimateCalc)."@da,
        "Konfigurierbare Anforderungsachse: die CO₂-Bilanzierungsdokumentation, die der Käufer vom Angebot verlangt. Werte referenzieren anerkannte Bilanzierungsmethoden (ISO 14067, GHG Protocol Product Standard, ClimateCalc); die deklarierten Fußabdruckswerte selbst stehen im Angebot und Vendor-Profil, nicht in der Konfiguration."@de,
        "Configurable requirement axis: the carbon-accounting documentation the buyer requires the offer to carry. Values reference recognized accounting methods (ISO 14067, GHG Protocol Product Standard, ClimateCalc); the declared footprint figures themselves live in the offer and vendor profile, not in the configuration."@en,
        "Eje de requisito configurable: la documentación de contabilidad de carbono que el comprador exige que lleve la oferta. Los valores referencian métodos reconocidos (ISO 14067, GHG Protocol, ClimateCalc); las cifras declaradas viven en la oferta y el perfil del proveedor, no en la configuración."@es,
        "कॉन्फ़िगर करने योग्य आवश्यकता अक्ष: कार्बन-लेखांकन का वह दस्तावेज़ जो खरीदार ऑफ़र में चाहता है। मान मान्यता-प्राप्त लेखांकन विधियों (ISO 14067, GHG Protocol Product Standard, ClimateCalc) को संदर्भित करते हैं; घोषित फ़ुटप्रिंट के आँकड़े ऑफ़र और विक्रेता प्रोफ़ाइल में रहते हैं, कॉन्फ़िगरेशन में नहीं।"@hi,
        "設定可能な要件軸：買い手がオファーに求めるカーボン会計文書。値は認知された会計手法（ISO 14067、GHGプロトコル製品基準、ClimateCalc）を参照する。宣言されたフットプリント数値自体はオファーとベンダープロファイルにあり、構成には含まれない。"@ja,
        "Konfigurerbar krav-akse: karbonregnskaps-dokumentasjonen kjøperen krever at tilbudet bærer. Verdier refererer anerkjente regnskapsmetoder (ISO 14067, GHG Protocol Product Standard, ClimateCalc); selve de deklarerte fotavtrykkstallene bor i tilbudet og vendor-profilen, ikke i konfigurasjonen."@nb,
        "Configureerbare eisen-as: de CO₂-boekhoudingsdocumentatie die de koper eist dat de aanbieding draagt. De waarden verwijzen naar erkende rekenmethoden (ISO 14067, GHG Protocol Product Standard, ClimateCalc)."@nl,
        "Konfigurowalna oś wymagań: dokumentacja rachunkowości węglowej, której nabywca wymaga od oferty. Wartości odwołują się do uznanych metod rachunkowości (ISO 14067, GHG Protocol Product Standard, ClimateCalc); same deklarowane wartości śladu żyją w ofercie i profilu dostawcy, nie w konfiguracji."@pl,
        "Eixo de requisito configurável: a documentação de contabilidade de carbono que o comprador exige que a oferta carregue. Os valores referenciam métodos de contabilização reconhecidos (ISO 14067, GHG Protocol Product Standard, ClimateCalc); os números de pegada declarados vivem na oferta e no perfil do fornecedor, não na configuração."@pt,
        "Konfigurerbar kravaxel: den koldioxidredovisning köparen kräver att erbjudandet bär. Värdena refererar erkända redovisningsmetoder (ISO 14067, GHG Protocol Product Standard, ClimateCalc); de deklarerade utsläppssiffrorna själva bor i erbjudandet och leverantörsprofilen, inte i konfigurationen."@sv,
        "可配置的要求轴：买方要求报价携带的碳核算文档。取值引用公认的核算方法（ISO 14067、GHG 核算体系产品标准、ClimateCalc）；声明的碳足迹数值本身位于报价和供应商档案中，而非配置中。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CM§CLIMATE-DOCUMENTATION" ;
    skos:prefLabel "Klimadokumentation"@da,
        "Klimadokumentation"@de,
        "Climate Documentation"@en,
        "Documentación climática"@es,
        "जलवायु दस्तावेज़ीकरण"@hi,
        "気候文書化"@ja,
        "Klimadokumentasjon"@nb,
        "Klimaatdocumentatie"@nl,
        "Dokumentacja klimatyczna"@pl,
        "Documentação climática"@pt,
        "Klimatdokumentation"@sv,
        "气候文档"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Nogen klimadokumentation?"@da,
        "Eine Klimadokumentation?"@de,
        "Any climate documentation?"@en,
        "¿Alguna documentación climática?"@es,
        "कोई जलवायु दस्तावेज़?"@hi,
        "気候関連の証明書はありますか？"@ja,
        "Noen klimadokumentasjon?"@nb,
        "Een klimaatdocumentatie?"@nl,
        "Jakaś dokumentacja klimatyczna?"@pl,
        "Alguma documentação climática?"@pt,
        "Någon klimatdokumentation?"@sv,
        "需要气候文件吗？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/standards/certifications/environmental/carbon> ;
    ptpge:version "2026-07-18" .

<https://ptpge.org/v1/variables/compliance/color-profile> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Colour Profile"@en,
        "ICC प्रोफ़ाइल"@hi,
        "रंग प्रोफ़ाइल"@hi,
        "profil ICC"@pl,
        "perfil ICC"@pt,
        "perfil de cores"@pt ;
    skos:broader <https://ptpge.org/v1/variables/compliance> ;
    skos:definition "Konfigurerbar akse: Farveprofil. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Farbprofil. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Color Profile. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Perfil de color. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: कलर प्रोफ़ाइल। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：カラープロファイル。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Fargeprofil. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Kleurprofiel. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Profil barw. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Perfil de Cor. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Färgprofil. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：色彩配置文件。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CM§COLOR-PROFILE" ;
    skos:prefLabel "Farveprofil"@da,
        "Farbprofil"@de,
        "Color Profile"@en,
        "Perfil de color"@es,
        "कलर प्रोफ़ाइल"@hi,
        "カラープロファイル"@ja,
        "Fargeprofil"@nb,
        "Kleurprofiel"@nl,
        "Profil barw"@pl,
        "Perfil de cor"@pt,
        "Färgprofil"@sv,
        "色彩配置文件"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvilken farveprofil?"@da,
        "Welches Farbprofil?"@de,
        "Which colour profile?"@en,
        "¿Qué perfil de color?"@es,
        "कौन-सा कलर प्रोफ़ाइल?"@hi,
        "カラープロファイルは？"@ja,
        "Hvilken fargeprofil?"@nb,
        "Welk kleurprofiel?"@nl,
        "Jaki profil kolorów?"@pl,
        "Que perfil de cor?"@pt,
        "Vilken färgprofil?"@sv,
        "什么色彩配置文件？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/standards/color-systems> ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/variables/configuration/custom-height> a skos:Concept ;
    dcterms:created "2026-08-21T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Bespoke height"@en,
        "Custom size height"@en,
        "कस्टम साइज़ ऊँचाई"@hi,
        "मनचाही ऊँचाई"@hi,
        "Egendefinert høyde"@nb,
        "wysokość formatu niestandardowego"@pl,
        "wysokość własna"@pl,
        "altura do tamanho personalizado"@pt,
        "altura sob medida"@pt ;
    skos:broader <https://ptpge.org/v1/variables/configuration> ;
    skos:definition "Konfigurerbar akse: Tilpasset højde. Færdig højde for et tilpasset produkt i millimeter (numerisk, enkeltvalg). Bindes sammen med Tilpasset bredde hvis og kun hvis Format = Tilpasset. Det kanoniske par normaliseres så bredde ≤ højde; brugsrotation udtrykkes via variablen Orientering (SD-0066)."@da,
        "Konfigurierbare Achse: Individuelle Höhe. Endhöhe eines individuell formatierten Produkts in Millimetern (numerisch, Einfachauswahl). Wird genau dann zusammen mit Individuelle Breite gebunden, wenn Format = Individuell. Das kanonische Paar wird so normalisiert, dass Breite ≤ Höhe; die Nutzungsrotation wird über die Variable Ausrichtung ausgedrückt (SD-0066)."@de,
        "Configurable axis: Custom Height. The finished height of a custom-sized product in millimetres (numeric, single selection). Bound together with Custom Width if and only if Format = Customized. The canonical pair is normalized so that width ≤ height; rotation of use is expressed via the Orientation variable (SD-0066)."@en,
        "Eje configurable: Alto personalizado. Alto final de un producto de tamaño personalizado en milímetros (numérico, selección única). Se vincula junto con Ancho personalizado si y solo si Formato = Personalizado. El par canónico se normaliza de modo que ancho ≤ alto; la rotación de uso se expresa mediante la variable Orientación (SD-0066)."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: कस्टम ऊँचाई। कस्टम आकार के उत्पाद की तैयार ऊँचाई मिलीमीटर में (संख्यात्मक, एकल चयन)। कस्टम चौड़ाई के साथ तभी बाँधी जाती है जब फ़ॉर्मेट = कस्टम हो। मानक जोड़ी को इस तरह सामान्य किया जाता है कि चौड़ाई ≤ ऊँचाई; उपयोग की दिशा ओरिएंटेशन वेरिएबल से व्यक्त होती है (SD-0066)।"@hi,
        "構成可能な軸：カスタム高さ。カスタムサイズ製品の仕上がり高さ（ミリメートル、数値、単一選択）。フォーマット＝カスタマイズの場合に限り、カスタム幅と共に束縛される。正規形は幅 ≤ 高さであり、使用時の回転は「向き」変数で表現される（SD-0066）。"@ja,
        "Konfigurerbar akse: Tilpasset høyde. Ferdig høyde for et tilpasset produkt i millimeter (numerisk, enkeltvalg). Bindes sammen med Tilpasset bredde hvis og bare hvis Format = Tilpasset. Kanonisk par normaliseres slik at bredde ≤ høyde; rotasjon uttrykkes via Orientering-variabelen (SD-0066)."@nb,
        "Configureerbare as: Hoogte op maat. Eindhoogte van een product op maat in millimeters (numeriek, enkelvoudig). Wordt samen met Breedte op maat gebonden dan en slechts dan als Formaat = Op maat. Het canonieke paar wordt genormaliseerd zodat breedte ≤ hoogte; gebruiksrotatie wordt uitgedrukt via de variabele Oriëntatie (SD-0066)."@nl,
        "Oś konfigurowalna: Wysokość niestandardowa. Wysokość gotowego produktu o niestandardowym formacie w milimetrach (numeryczna, wybór pojedynczy). Wiązana razem z Szerokością niestandardową wtedy i tylko wtedy, gdy Format = Niestandardowy. Kanoniczna para jest znormalizowana tak, że szerokość ≤ wysokość; obrót użycia wyraża zmienna Orientacja (SD-0066)."@pl,
        "Eixo configurável: Altura Personalizada. A altura final de um produto de tamanho personalizado, em milímetros (numérico, seleção única). Vinculada junto com a Largura Personalizada se e somente se Formato = Personalizado. O par canônico é normalizado de modo que largura ≤ altura; a rotação de uso é expressa pela variável Orientação (SD-0066)."@pt,
        "Konfigurerbar axel: Anpassad höjd. Färdig höjd för en anpassad produkt i millimeter (numerisk, enkelval). Binds tillsammans med Anpassad bredd om och endast om Format = Anpassat. Det kanoniska paret normaliseras så att bredd ≤ höjd; användningsrotation uttrycks via variabeln Orientering (SD-0066)."@sv,
        "可配置轴：自定义高度。定制尺寸产品的成品高度，以毫米计（数值，单选）。当且仅当格式＝定制时，与自定义宽度一同绑定。规范形式为宽度 ≤ 高度；使用方向的旋转通过方向变量表达（SD-0066）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CF§CUSTOM-HEIGHT" ;
    skos:prefLabel "Tilpasset højde"@da,
        "Individuelle Höhe"@de,
        "Custom Height"@en,
        "Alto personalizado"@es,
        "कस्टम ऊँचाई"@hi,
        "カスタム高さ"@ja,
        "Tilpasset høyde"@nb,
        "Hoogte op maat"@nl,
        "Wysokość niestandardowa"@pl,
        "Altura personalizada"@pt,
        "Anpassad höjd"@sv,
        "自定义高度"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "numeric" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvor høj?"@da,
        "Wie hoch?"@de,
        "How tall?"@en,
        "¿Qué altura?"@es,
        "कितना ऊँचा?"@hi,
        "高さは？"@ja,
        "Hvor høy?"@nb,
        "Hoe hoog?"@nl,
        "Jaka wysokość?"@pl,
        "Que altura?"@pt,
        "Hur hög?"@sv,
        "多高？"@zh-Hans ;
    ptpge:rangeMax 50000.0 ;
    ptpge:rangeMin 5.0 ;
    ptpge:scope "product" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78" ;
            ptpge:mappingRow "crosswalk row 23" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:unit "mm" ;
    ptpge:version "2026-08-21" .

<https://ptpge.org/v1/variables/configuration/custom-width> a skos:Concept ;
    dcterms:created "2026-08-21T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Bespoke width"@en,
        "Custom size width"@en,
        "कस्टम साइज़ चौड़ाई"@hi,
        "मनचाही चौड़ाई"@hi,
        "Egendefinert bredde"@nb,
        "szerokość formatu niestandardowego"@pl,
        "szerokość własna"@pl,
        "largura do tamanho personalizado"@pt,
        "largura sob medida"@pt ;
    skos:broader <https://ptpge.org/v1/variables/configuration> ;
    skos:definition "Konfigurerbar akse: Tilpasset bredde. Færdig bredde for et tilpasset produkt i millimeter (numerisk, enkeltvalg). Bindes sammen med Tilpasset højde hvis og kun hvis Format = Tilpasset. Det kanoniske par normaliseres så bredde ≤ højde; brugsrotation udtrykkes via variablen Orientering (SD-0066)."@da,
        "Konfigurierbare Achse: Individuelle Breite. Endbreite eines individuell formatierten Produkts in Millimetern (numerisch, Einfachauswahl). Wird genau dann zusammen mit Individuelle Höhe gebunden, wenn Format = Individuell. Das kanonische Paar wird so normalisiert, dass Breite ≤ Höhe; die Nutzungsrotation wird über die Variable Ausrichtung ausgedrückt (SD-0066)."@de,
        "Configurable axis: Custom Width. The finished width of a custom-sized product in millimetres (numeric, single selection). Bound together with Custom Height if and only if Format = Customized. The canonical pair is normalized so that width ≤ height; rotation of use is expressed via the Orientation variable (SD-0066)."@en,
        "Eje configurable: Ancho personalizado. Ancho final de un producto de tamaño personalizado en milímetros (numérico, selección única). Se vincula junto con Alto personalizado si y solo si Formato = Personalizado. El par canónico se normaliza de modo que ancho ≤ alto; la rotación de uso se expresa mediante la variable Orientación (SD-0066)."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: कस्टम चौड़ाई। कस्टम आकार के उत्पाद की तैयार चौड़ाई मिलीमीटर में (संख्यात्मक, एकल चयन)। कस्टम ऊँचाई के साथ तभी बाँधी जाती है जब फ़ॉर्मेट = कस्टम हो। मानक जोड़ी को इस तरह सामान्य किया जाता है कि चौड़ाई ≤ ऊँचाई; उपयोग की दिशा ओरिएंटेशन वेरिएबल से व्यक्त होती है (SD-0066)।"@hi,
        "構成可能な軸：カスタム幅。カスタムサイズ製品の仕上がり幅（ミリメートル、数値、単一選択）。フォーマット＝カスタマイズの場合に限り、カスタム高さと共に束縛される。正規形は幅 ≤ 高さであり、使用時の回転は「向き」変数で表現される（SD-0066）。"@ja,
        "Konfigurerbar akse: Tilpasset bredde. Ferdig bredde for et tilpasset produkt i millimeter (numerisk, enkeltvalg). Bindes sammen med Tilpasset høyde hvis og bare hvis Format = Tilpasset. Kanonisk par normaliseres slik at bredde ≤ høyde; rotasjon uttrykkes via Orientering-variabelen (SD-0066)."@nb,
        "Configureerbare as: Breedte op maat. Eindbreedte van een product op maat in millimeters (numeriek, enkelvoudig). Wordt samen met Hoogte op maat gebonden dan en slechts dan als Formaat = Op maat. Het canonieke paar wordt genormaliseerd zodat breedte ≤ hoogte; gebruiksrotatie wordt uitgedrukt via de variabele Oriëntatie (SD-0066)."@nl,
        "Oś konfigurowalna: Szerokość niestandardowa. Szerokość gotowego produktu o niestandardowym formacie w milimetrach (numeryczna, wybór pojedynczy). Wiązana razem z Wysokością niestandardową wtedy i tylko wtedy, gdy Format = Niestandardowy. Kanoniczna para jest znormalizowana tak, że szerokość ≤ wysokość; obrót użycia wyraża zmienna Orientacja (SD-0066)."@pl,
        "Eixo configurável: Largura Personalizada. A largura final de um produto de tamanho personalizado, em milímetros (numérico, seleção única). Vinculada junto com a Altura Personalizada se e somente se Formato = Personalizado. O par canônico é normalizado de modo que largura ≤ altura; a rotação de uso é expressa pela variável Orientação (SD-0066)."@pt,
        "Konfigurerbar axel: Anpassad bredd. Färdig bredd för en anpassad produkt i millimeter (numerisk, enkelval). Binds tillsammans med Anpassad höjd om och endast om Format = Anpassat. Det kanoniska paret normaliseras så att bredd ≤ höjd; användningsrotation uttrycks via variabeln Orientering (SD-0066)."@sv,
        "可配置轴：自定义宽度。定制尺寸产品的成品宽度，以毫米计（数值，单选）。当且仅当格式＝定制时，与自定义高度一同绑定。规范形式为宽度 ≤ 高度；使用方向的旋转通过方向变量表达（SD-0066）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CF§CUSTOM-WIDTH" ;
    skos:prefLabel "Tilpasset bredde"@da,
        "Individuelle Breite"@de,
        "Custom Width"@en,
        "Ancho personalizado"@es,
        "कस्टम चौड़ाई"@hi,
        "カスタム幅"@ja,
        "Tilpasset bredde"@nb,
        "Breedte op maat"@nl,
        "Szerokość niestandardowa"@pl,
        "Largura personalizada"@pt,
        "Anpassad bredd"@sv,
        "自定义宽度"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "numeric" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvor bred?"@da,
        "Wie breit?"@de,
        "How wide?"@en,
        "¿Qué anchura?"@es,
        "कितना चौड़ा?"@hi,
        "幅は？"@ja,
        "Hvor bred?"@nb,
        "Hoe breed?"@nl,
        "Jaka szerokość?"@pl,
        "Que largura?"@pt,
        "Hur bred?"@sv,
        "多宽？"@zh-Hans ;
    ptpge:rangeMax 50000.0 ;
    ptpge:rangeMin 5.0 ;
    ptpge:scope "product" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78" ;
            ptpge:mappingRow "crosswalk row 23" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:unit "mm" ;
    ptpge:version "2026-08-21" .

<https://ptpge.org/v1/variables/features/spot-ink> a skos:Concept ;
    dcterms:created "2026-10-12T15:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-12T15:00:00+00:00"^^xsd:dateTime ;
    skos:altLabel "PMS-farve"@da,
        "Pantone-nummer"@da,
        "HKS-Nummer"@de,
        "Pantone-Nummer"@de,
        "Schmuckfarbe"@de,
        "HKS number"@en,
        "Named ink"@en,
        "PMS colour"@en,
        "Pantone number"@en,
        "Spot colour reference"@en,
        "Número Pantone"@es,
        "Numéro Pantone"@fr,
        "PANTONE 指定"@ja,
        "パントン番号"@ja,
        "Navngitt spotfarge"@nb,
        "PMS-farge"@nb,
        "Pantone-nummer"@nb,
        "PMS-kleur"@nl,
        "Pantone-nummer"@nl,
        "Numer Pantone"@pl,
        "Número Pantone"@pt,
        "PMS-färg"@sv,
        "Pantone-nummer"@sv,
        "潘通色号"@zh-Hans ;
    skos:broader <https://ptpge.org/v1/variables/features> ;
    skos:definition "Konfigurerbar akse: den navngivne farve bag hvert staffagefarvelag, som en kode under et farvematchingsystem — Pantone 300 C, HKS 43 K, RAL 5015. Værdien er systemtermen efterfulgt af koden; koden kontrolleres på form, aldrig mod en liste. Én værdi pr. staffagefarvelag på samme flade (SD-0104)."@da,
        "Konfigurierbare Achse: die benannte Farbe hinter jeder Sonderfarbenebene, als Code unter einem Farbsystem — Pantone 300 C, HKS 43 K, RAL 5015. Der Wert ist der Systembegriff gefolgt vom Code; der Code wird auf Form geprüft, nie gegen eine Liste. Ein Wert je Sonderfarbenebene auf derselben Fläche (SD-0104)."@de,
        "Configurable axis: the named ink behind each spot-color layer, as a code under a colour matching system — Pantone 300 C, HKS 43 K, RAL 5015. The value is the matching-system term followed by the code (…/pantone-matching-system/300-c); the code is checked for form, never against a list, because the libraries are the systems' own. One value per spot-color layer on the same face (SD-0104)."@en,
        "Eje configurable: la tinta nombrada detrás de cada capa de tinta directa, como código bajo un sistema de referencia de color — Pantone 300 C, HKS 43 K, RAL 5015. El valor es el término del sistema seguido del código; el código se comprueba por su forma, nunca contra una lista. Un valor por capa de tinta directa en la misma cara (SD-0104)."@es,
        "Konfiguroitava akseli: nimetty väri kunkin spottiväritason takana, koodina värijärjestelmän alla — Pantone 300 C, HKS 43 K, RAL 5015. Arvo on järjestelmätermi ja koodi; koodi tarkistetaan muodoltaan, ei listaa vasten. Yksi arvo per spottiväritaso samalla pinnalla (SD-0104)."@fi,
        "Axe configurable : l’encre nommée derrière chaque couche de ton direct, comme code sous un système de référence couleur — Pantone 300 C, HKS 43 K, RAL 5015. La valeur est le terme du système suivi du code ; le code est vérifié sur sa forme, jamais contre une liste. Une valeur par couche de ton direct sur la même face (SD-0104)."@fr,
        "कॉन्फ़िगर करने योग्य अक्ष: प्रत्येक स्पॉट-रंग परत के पीछे नामित स्याही, रंग मिलान प्रणाली के अंतर्गत कोड के रूप में — Pantone 300 C, HKS 43 K, RAL 5015। मान प्रणाली शब्द और कोड है; कोड की केवल बनावट जाँची जाती है, सूची से नहीं। एक ही सतह पर प्रति स्पॉट-रंग परत एक मान (SD-0104)।"@hi,
        "Stillanlegur ás: nefndur litur á bak við hvert sérlitalag, sem kóði undir litakerfi — Pantone 300 C, HKS 43 K, RAL 5015. Gildið er kerfishugtakið og kóðinn; kóðinn er athugaður á formi, aldrei gegn lista. Eitt gildi á hvert sérlitalag á sama fleti (SD-0104)."@is,
        "設定可能な軸：各特色レイヤーの背後にある指定インキを、カラーマッチングシステム下のコードとして — Pantone 300 C、HKS 43 K、RAL 5015。値はシステム用語とコード；コードは形式のみ検証され、リストとは照合されない。同一面の特色レイヤーごとに1値（SD-0104）。"@ja,
        "Konfigurerbar akse: den navngitte blekkfargen bak hvert spotfargelag, som en kode under et fargematchingsystem — Pantone 300 C, HKS 43 K, RAL 5015. Verdien er systemtermen fulgt av koden (…/pantone-matching-system/300-c); koden sjekkes på form, aldri mot en liste, for bibliotekene er systemenes egne. Én verdi per spotfargelag på samme flate (SD-0104)."@nb,
        "Configureerbare as: de benoemde inkt achter elke steunkleurlaag, als code onder een kleurmatchingsysteem — Pantone 300 C, HKS 43 K, RAL 5015. De waarde is de systeemterm gevolgd door de code; de code wordt op vorm gecontroleerd, nooit tegen een lijst. Eén waarde per steunkleurlaag op hetzelfde vlak (SD-0104)."@nl,
        "Konfigurowalna oś: nazwana farba za każdą warstwą koloru dodatkowego, jako kod w systemie dopasowania kolorów — Pantone 300 C, HKS 43 K, RAL 5015. Wartość to termin systemu i kod; kod sprawdzany jest pod kątem formy, nigdy względem listy. Jedna wartość na warstwę koloru dodatkowego na tej samej powierzchni (SD-0104)."@pl,
        "Eixo configurável: a tinta nomeada por trás de cada camada de cor direta, como código sob um sistema de correspondência de cor — Pantone 300 C, HKS 43 K, RAL 5015. O valor é o termo do sistema seguido do código; o código é verificado na forma, nunca contra uma lista. Um valor por camada de cor direta na mesma face (SD-0104)."@pt,
        "Konfigurerbar axel: den namngivna färgen bakom varje dekorfärgslager, som en kod under ett färgmatchningssystem — Pantone 300 C, HKS 43 K, RAL 5015. Värdet är systemtermen följd av koden; koden kontrolleras på form, aldrig mot en lista. Ett värde per dekorfärgslager på samma yta (SD-0104)."@sv,
        "可配置轴：每个专色层背后的指定油墨，以配色系统下的色号表示 — Pantone 300 C、HKS 43 K、RAL 5015。值为系统术语加色号；色号只检查格式，不与列表比对。同一面上每个专色层一个值（SD-0104）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:FT§SPOT-INK" ;
    skos:prefLabel "Staffagefarve (navngivet)"@da,
        "Sonderfarbe (benannt)"@de,
        "Spot Ink"@en,
        "Tinta directa (nombrada)"@es,
        "Spottiväri (nimetty)"@fi,
        "Ton direct (nommé)"@fr,
        "स्पॉट स्याही (नामित)"@hi,
        "Sérlitur (nefndur)"@is,
        "特色（指定）"@ja,
        "Spotfarge (navngitt)"@nb,
        "Steunkleur (benoemd)"@nl,
        "Kolor dodatkowy (nazwany)"@pl,
        "Cor direta (nomeada)"@pt,
        "Dekorfärg (namngiven)"@sv,
        "专色（指定）"@zh-Hans ;
    skos:scopeNote "Written as <matching-system term>/<code>, the code lower-cased with spaces as hyphens: Pantone 300 C → …/pantone-matching-system/300-c; HKS 43 K → …/hks/43-k; RAL 5015 → …/ral/5015. The number of spot-ink values on a face must equal the number of spot-color layers bound there; the specification sets no upper limit — the press does (vendor-declaration/1 inkStations)."@en,
        "Skrives som <matchingsystem-term>/<kode>, koden i små bokstaver med mellomrom som bindestrek: Pantone 300 C → …/pantone-matching-system/300-c; HKS 43 K → …/hks/43-k; RAL 5015 → …/ral/5015. Antall spot-ink-verdier på en flate må være lik antall spotfargelag bundet der; spesifikasjonen setter ingen øvre grense — det gjør pressen (vendor-declaration/1 inkStations)."@nb ;
    ptpge:cardinality "multiple" ;
    ptpge:datatype "code" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvilken staffagefarve? (fx Pantone 300 C)"@da,
        "Welche Sonderfarbe? (z. B. Pantone 300 C)"@de,
        "Which spot ink? (e.g. Pantone 300 C)"@en,
        "¿Qué tinta directa? (p. ej. Pantone 300 C)"@es,
        "Mikä spottiväri? (esim. Pantone 300 C)"@fi,
        "Quel ton direct ? (p. ex. Pantone 300 C)"@fr,
        "कौन-सी स्पॉट स्याही? (जैसे Pantone 300 C)"@hi,
        "Hvaða sérlitur? (t.d. Pantone 300 C)"@is,
        "どの特色ですか？（例：Pantone 300 C）"@ja,
        "Hvilken spotfarge? (f.eks. Pantone 300 C)"@nb,
        "Welke steunkleur? (bv. Pantone 300 C)"@nl,
        "Który kolor dodatkowy? (np. Pantone 300 C)"@pl,
        "Que cor direta? (p. ex. Pantone 300 C)"@pt,
        "Vilken dekorfärg? (t.ex. Pantone 300 C)"@sv,
        "哪种专色？（例如 Pantone 300 C）"@zh-Hans ;
    ptpge:scope "surface" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems> ;
    ptpge:version "2026-10-12" .

<https://ptpge.org/v1/variables/finishing/folding> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Fold"@en,
        "तह"@hi,
        "फ़ोल्ड"@hi,
        "मोड़"@hi,
        "Brett"@nb,
        "Fals"@nb,
        "złam"@pl,
        "dobradura"@pt,
        "tipo de dobra"@pt ;
    skos:broader <https://ptpge.org/v1/variables/finishing> ;
    skos:definition "Konfigurerbar akse: Fals. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Falzung. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Fold. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Plegado. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: फ़ोल्ड। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：折り。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Bretting. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Vouw. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Składanie. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Dobra. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Fals. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：折页。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:FN§FOLDING" ;
    skos:prefLabel "Falsning"@da,
        "Falzung"@de,
        "Folding"@en,
        "Plegado"@es,
        "फ़ोल्डिंग"@hi,
        "折り"@ja,
        "Bretting"@nb,
        "Vouwen"@nl,
        "Składanie"@pl,
        "Dobra"@pt,
        "Falsning"@sv,
        "折页"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvordan er den falset?"@da,
        "Wie ist es gefalzt?"@de,
        "How is it folded?"@en,
        "¿Cómo está plegado?"@es,
        "फ़ोल्ड कैसे?"@hi,
        "折り方は？"@ja,
        "Hvordan er den brettet?"@nb,
        "Hoe is het gevouwen?"@nl,
        "Jak jest złożony?"@pl,
        "Como é dobrado?"@pt,
        "Hur är den falsad?"@sv,
        "如何折叠？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/completions/folding> ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/variables/order/delivery-method> a skos:Concept ;
    dcterms:created "2026-06-26T05:36:54+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Fulfilment method"@en,
        "Shipping method"@en,
        "फ़ुलफ़िलमेंट विधि"@hi,
        "भेजने का तरीका"@hi,
        "शिपिंग विधि"@hi,
        "Forsendelsesmetode"@nb,
        "metoda realizacji"@pl,
        "sposób dostawy"@pl,
        "sposób wysyłki"@pl,
        "forma de envio"@pt,
        "modalidade de entrega"@pt,
        "método de expedição"@pt ;
    skos:broader <https://ptpge.org/v1/variables/order> ;
    skos:definition "Konfigurerbar akse: Leveringsmetode. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Versandart (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
