<https://ptpge.org/v1/printing/features/colors/cmykogv> a skos:Concept ;
    dcterms:created "2026-05-19T23:30:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "CMYK+OGV"@da,
        "Syvfarvetryk"@da,
        "Udvidet farverum"@da,
        "7-Farben-Druck"@de,
        "CMYK+OGV"@de,
        "Erweiterter Farbraum"@de,
        "7-Color"@en,
        "7-color"@en,
        "7-colour"@en,
        "CMYK+OGV"@en,
        "Extended Gamut"@en,
        "Extended gamut"@en,
        "Heptachrome"@en,
        "Seven-Color"@en,
        "CMYK+OGV"@es,
        "Gama extendida"@es,
        "Heptacromía"@es,
        "7 रंग"@hi,
        "CMYK+OGV"@hi,
        "विस्तारित गैमट"@hi,
        "सेवन कलर"@hi,
        "हेप्टाक्रोम"@hi,
        "7色印刷"@ja,
        "CMYK+OGV"@ja,
        "拡張色域"@ja,
        "7-farge"@nb,
        "7-fargers trykk"@nb,
        "CMYK+OGV"@nb,
        "Utvidet fargeomfang"@nb,
        "Utvidet gamut"@nb,
        "CMYK+OGV"@nl,
        "Uitgebreid kleurbereik"@nl,
        "Zevenkleurendruk"@nl,
        "7 kolorów"@pl,
        "CMYK+OGV"@pl,
        "gamut rozszerzony"@pl,
        "7 cores"@pt,
        "CMYK+OGV"@pt,
        "gama estendida"@pt,
        "heptacromia"@pt,
        "sete cores"@pt,
        "CMYK+OGV"@sv,
        "Sjufärgstryck"@sv,
        "Utökad färgrymd"@sv,
        "CMYK+OGV"@zh-Hans,
        "七色印刷"@zh-Hans,
        "扩展色域"@zh-Hans ;
    skos:broader <https://ptpge.org/v1/printing/features/colors> ;
    skos:definition "Udvidet 7-farvetryk med CMYK plus orange, grøn og violet farve. Fanger op til ~95 % af Pantones staffagefarver med procesfarver alene — og fjerner behovet for staffagefarver for de fleste brandfarver."@da,
        "Erweiterter 7-Farbgamut-Druck mit CMYK plus Orange, Grün und Violett. Erfasst bis zu ~95% der Pantone-Vollfarben mit reinen Prozessfarben."@de,
        "Extended 7-color gamut printing using CMYK plus Orange, Green, and Violet inks. Captures up to ~95% of Pantone solid colors using process inks only — eliminating the need for spot inks for most brand colors. Used by Esko and Heidelberg systems for high-volume packaging and commercial work."@en,
        "Impresión de gama extendida de 7 colores con CMYK más tintas Naranja, Verde y Violeta. Captura hasta ~95% de los colores sólidos Pantone solo con tintas de proceso — eliminando la necesidad de tintas planas para la mayoría de los colores de marca. Usado por sistemas de Esko y Heidelberg para packaging de alto volumen y trabajo comercial."@es,
        "CMYK के साथ नारंगी, हरी और बैंगनी स्याही से 7-रंग विस्तारित गैमट छपाई। केवल प्रोसेस स्याहियों से ~95% पैंटोन सॉलिड रंग पकड़ती है — अधिकांश ब्रांड रंगों के लिए स्पॉट स्याही की ज़रूरत ख़त्म। उच्च-मात्रा पैकेजिंग और व्यावसायिक काम में Esko और Heidelberg प्रणालियों द्वारा प्रयुक्त।"@hi,
        "CMYK にオレンジ、グリーン、バイオレットを加えた7色の拡張ガモット印刷。プロセスインキのみで Pantone ソリッドカラーの約95%までを再現し、大半のブランドカラーで特色インキを不要にする。Esko や Heidelberg のシステムにより、大量パッケージや商業印刷で使われる。"@ja,
        "Utvidet 7-fargers gamut-trykk med CMYK pluss Oransje, Grønn og Fiolett blekk. Fanger opp til ~95% av Pantones solide farger med kun prosess-blekk. Brukes av Esko og Heidelberg-systemer for høyvolums emballasje og kommersielt arbeid."@nb,
        "Uitgebreide 7-kleurendruk met CMYK plus oranje, groene en violette inkt. Vangt tot ~95% van de Pantone-steunkleuren met procesinkten alleen — en maakt steunkleuren voor de meeste merkkleuren overbodig."@nl,
        "Druk o rozszerzonym gamucie w 7 kolorach: CMYK plus farby pomarańczowa, zielona i fioletowa. Oddaje do ~95% pełnych kolorów Pantone wyłącznie farbami procesowymi — eliminując potrzebę farb dodatkowych dla większości kolorów firmowych. Stosowany w systemach Esko i Heidelberg do wysokonakładowych opakowań i prac komercyjnych."@pl,
        "Impressão em gama estendida de 7 cores usando CMYK mais tintas Laranja, Verde e Violeta. Alcança até ~95% das cores sólidas Pantone só com tintas de escala — eliminando a necessidade de cores especiais para a maioria das cores de marca. Usada por sistemas Esko e Heidelberg em embalagem de alto volume e impressão comercial."@pt,
        "Utökat 7-färgstryck med CMYK plus orange, grönt och violett bläck. Fångar upp till ~95 % av Pantones dekorfärger med enbart processbläck — vilket eliminerar behovet av dekorbläck för de flesta varumärkesfärger. Används av Esko- och Heidelberg-system för högvolymförpackningar och civiltryck."@sv,
        "在 CMYK 基础上加入橙、绿、紫油墨的7色扩展色域印刷。仅用工艺油墨即可再现约95%的 Pantone 实色 — 使大多数品牌色无需专色油墨。Esko 与 Heidelberg 系统用于大批量包装与商业印刷。"@zh-Hans ;
    skos:exactMatch <https://ptpge.org/v1/printing/standards/color-systems/color-spaces/cmykogv> ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:FT§CMYKOGV" ;
    skos:prefLabel "CMYKOGV"@da,
        "CMYKOGV"@de,
        "CMYKOGV"@en,
        "CMYKOGV"@es,
        "CMYKOGV"@hi,
        "CMYKOGV"@ja,
        "CMYKOGV"@nb,
        "CMYKOGV"@nl,
        "CMYKOGV"@pl,
        "CMYKOGV"@pt,
        "CMYKOGV"@sv,
        "CMYKOGV"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "features" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.4 · p.72",
                "§6.15 · p.168" ;
            ptpge:mappingRow "crosswalk row 24" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "ColorIntent",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-08-27" ;
    ptpge:visual [ ] .

<https://ptpge.org/v1/printing/management/quality-assurance/color-management> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    dcterms:replaces <https://ptpge.org/v1/printing/management/quality-assurance/color-management/adobe-color-management> ;
    skos:altLabel "Colour Management"@en,
        "zarządzanie kolorem"@pl,
        "Gestão de cor"@pt ;
    skos:broader <https://ptpge.org/v1/printing/management/quality-assurance> ;
    skos:definition "Systemer og værktøjer, der sikrer konsekvent farvegengivelse på tværs af enheder, substrater og trykteknologier — med ICC-farveprofiler til at oversætte farveværdier mellem forskellige farveomfang."@da,
        "Systeme und Werkzeuge, die eine konsistente Farbreproduktion über Geräte, Bedruckstoffe und Drucktechnologien hinweg sicherstellen — mithilfe von ICC-Farbprofilen, die Farbwerte zwischen verschiedenen Farbräumen übersetzen."@de,
        "Systems and tools that ensure consistent color reproduction across devices, substrates, and printing technologies — using ICC color profiles to translate color values between different gamuts."@en,
        "Sistemas y herramientas que aseguran la reproducción consistente del color entre dispositivos, sustratos y tecnologías de impresión — utilizando perfiles ICC para traducir valores de color entre diferentes gamuts."@es,
        "प्रणालियाँ और औज़ार जो डिवाइसों, सब्सट्रेट और मुद्रण तकनीकों में एक-समान रंग पुनरुत्पादन सुनिश्चित करते हैं — विभिन्न गैमट के बीच रंग मान अनुवाद करने के लिए ICC रंग प्रोफ़ाइल का उपयोग।"@hi,
        "デバイス、基材、印刷技術を超えて一貫した色再現を保証するシステムとツール — 異なる色域間で色値を変換するためにICCカラープロファイルを使用する。"@ja,
        "Systemer og verktøy som sikrer konsistent fargegjengivelse på tvers av enheter, substrater og trykketeknologier — bruker ICC-fargeprofiler for å oversette fargeverdier mellom forskjellige gamut."@nb,
        "Systemen en tools die consistente kleurweergave waarborgen over apparaten, substraten en druktechnologieën heen — met ICC-kleurprofielen om kleurwaarden tussen verschillende gamma's te vertalen."@nl,
        "Systemy i narzędzia zapewniające spójną reprodukcję barw między urządzeniami, podłożami i technologiami druku — z użyciem profili ICC do przeliczania wartości barw między różnymi gamutami."@pl,
        "Sistemas e ferramentas que garantem reprodução consistente de cor entre dispositivos, substratos e tecnologias de impressão — usando perfis de cor ICC para traduzir valores de cor entre gamuts diferentes."@pt,
        "System och verktyg som säkerställer konsekvent färgåtergivning över enheter, substrat och trycktekniker — med ICC-färgprofiler som översätter färgvärden mellan olika färgrymder."@sv,
        "确保跨设备、承印物和印刷工艺一致再现色彩的系统和工具——使用ICC色彩配置文件在不同色域之间转换色值。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/management/quality-assurance/color-management/adobe-color-management> ;
    skos:notation "P:MG-QAS-CMNG" ;
    skos:prefLabel "Farvestyring"@da,
        "Farbmanagement"@de,
        "Color Management"@en,
        "Gestión de Color"@es,
        "रंग प्रबंधन"@hi,
        "カラーマネジメント"@ja,
        "Fargestyring"@nb,
        "Kleurbeheer"@nl,
        "Zarządzanie barwą"@pl,
        "Gerenciamento de cor"@pt,
        "Färghantering"@sv,
        "色彩管理"@zh-Hans ;
    skos:related <https://ptpge.org/v1/printing/standards/color-systems/color-profiles/icc-profiles> ;
    skos:scopeNote "Im Mittelpunkt steht das Management von ICC-Profilen (Erstellung, Einbettung, Konvertierung) sowie integrierte Farbsysteme (Adobe Color Management). Farbabgleichssysteme wie Pantone werden unter Standards › Color Systems geführt; die physische Farbkalibrierung ist hier ein verwandtes Element."@de,
        "Centered on ICC profile management (creation, embedding, conversion) and integrated color systems (Adobe Color Management). Color matching systems like Pantone are tracked under Standards › Color Systems; physical color calibration is a sibling element here."@en,
        "Centrado en la gestión de perfiles ICC (creación, incrustación, conversión) y sistemas integrados de color (Adobe Color Management). Sistemas de igualación de color como Pantone se rastrean en Normas › Sistemas de Color › Sistemas de Igualación."@es,
        "ICC प्रोफ़ाइल प्रबंधन (निर्माण, एम्बेडिंग, रूपांतरण) और एकीकृत रंग प्रणालियों (Adobe Color Management) पर केंद्रित। Pantone जैसी रंग मिलान प्रणालियाँ मानक › रंग प्रणालियों में; भौतिक रंग अंशांकन यहाँ सहोदर तत्व।"@hi,
        "ICCプロファイル管理（作成、埋め込み、変換）と統合カラーシステム（Adobe Color Management）を中心とする。Pantoneなどのカラーマッチングシステムは、Standards › Color Systemsに分類される。物理的な色キャリブレーションは、ここでの兄弟要素である。"@ja,
        "Sentrert rundt ICC-profilhåndtering (opprettelse, innebygging, konvertering) og integrerte fargesystemer (Adobe Color Management). Fargematchingssystemer som Pantone spores under Standards › Color Systems; fysisk fargekalibrering er et søsken-element her."@nb,
        "Centrado no gerenciamento de perfis ICC (criação, incorporação, conversão) e em sistemas de cor integrados (Adobe Color Management). Sistemas de correspondência de cor como Pantone ficam em Normas › Sistemas de cor; a calibração física de cor é um elemento irmão aqui."@pt,
        "围绕ICC配置文件管理（创建、嵌入、转换）和集成色彩系统（Adobe色彩管理）展开。Pantone等色彩匹配系统在标准 › 色彩系统 › 色彩匹配系统中跟踪。"@zh-Hans ;
    ptpge:group "management" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.4.2 · p.91",
                "§5.4.3 · p.91",
                "§6.68 · p.252" ;
            ptpge:mappingRow "crosswalk row 12" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "ColorCorrection",
                "ColorSpaceConversion",
                "PrintCondition" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/workflow/efficiency-tools> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/management/workflow> ;
    skos:definition "Softwareplatforme og integrationer, der reducerer manuelt arbejde i trykproduktionskæden — automatiseringsmotorer, samarbejdssystemer og middleware, der forbinder prepress, presse og færdiggørelse."@da,
        "Software-Plattformen und Integrationen, die manuelle Arbeit in der Druckproduktionspipeline reduzieren — Automatisierungs-Engines, Kollaborationssysteme und Middleware, die Druckvorstufe, Druck und Veredelung verbinden."@de,
        "Software platforms and integrations that reduce manual work in the print production pipeline — automation engines, collaboration systems, and middleware connecting prepress, press, and finishing."@en,
        "Plataformas de software e integraciones que reducen el trabajo manual en la cadena de producción de impresión — motores de automatización, sistemas de colaboración y middleware que conecta pre-prensa, prensa y acabado."@es,
        "सॉफ़्टवेयर प्लेटफ़ॉर्म और एकीकरण जो प्रिंट उत्पादन पाइपलाइन में हाथ का काम घटाते हैं — स्वचालन इंजन, सहयोग सिस्टम और प्रीप्रेस, प्रेस और फ़िनिशिंग को जोड़ने वाला मिडलवेयर।"@hi,
        "印刷生産パイプラインで手作業を削減するソフトウェアプラットフォームと統合 — 自動化エンジン、協業システム、製版・印刷・仕上げをつなぐミドルウェア。"@ja,
        "Programvareplattformer og integrasjoner som reduserer manuelt arbeid i trykkproduksjonsledningen — automasjonsmotorer, samarbeidssystemer og middelvare som kobler prepress, presse og etterbehandling."@nb,
        "Softwareplatformen en integraties die handwerk in de drukproductieketen verminderen — automatiseringsengines, samenwerkingssystemen en middleware die prepress, pers en afwerking verbinden."@nl,
        "Platformy programowe i integracje ograniczające pracę ręczną w potoku produkcji poligraficznej — silniki automatyzacji, systemy współpracy i oprogramowanie pośredniczące łączące prepress, maszynę i wykończenie."@pl,
        "Plataformas de software e integrações que reduzem o trabalho manual no pipeline de produção gráfica — motores de automação, sistemas de colaboração e middleware que conecta pré-impressão, impressão e acabamento."@pt,
        "Programvaruplattformar och integrationer som minskar manuellt arbete i tryckproduktionskedjan — automationsmotorer, samarbetssystem och mellanprogram som kopplar samman prepress, press och efterbehandling."@sv,
        "减少印刷生产管道中手工工作的软件平台和集成——自动化引擎、协作系统以及连接印前、印刷和印后的中间件。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/management/workflow/efficiency-tools/automation-integration>,
        <https://ptpge.org/v1/printing/management/workflow/efficiency-tools/collaboration-tools> ;
    skos:notation "P:MG-WFL-EFFT" ;
    skos:prefLabel "Effektivitetsværktøjer"@da,
        "Effizienzwerkzeuge"@de,
        "Efficiency Tools"@en,
        "Herramientas de Eficiencia"@es,
        "दक्षता औज़ार"@hi,
        "効率化ツール"@ja,
        "Effektivitetsverktøy"@nb,
        "Efficiencytools"@nl,
        "Narzędzia efektywności"@pl,
        "Ferramentas de eficiência"@pt,
        "Effektivitetsverktyg"@sv,
        "效率工具"@zh-Hans ;
    skos:scopeNote "Umfasst Automatisierungs- und Integrationsplattformen (Heidelberg Prinect, Kodak Prinergy, Agfa Apogee, EFI Fiery, Esko Automation Engine, Enfocus Switch, Xerox FreeFlow Core, Adobe PDF Workflow) sowie Kollaborationswerkzeuge, die Kunden, Designer und Produktion verbinden. Die Grenze zum Auftragsmanagement ist fließend — Automatisierungswerkzeuge enthalten oft auch Funktionen zur Auftragsverfolgung."@de,
        "Includes automation and integration platforms (Heidelberg Prinect, Kodak Prinergy, Agfa Apogee, EFI Fiery, Esko Automation Engine, Enfocus Switch, Xerox FreeFlow Core, Adobe PDF Workflow), and collaboration tools that connect customers, designers, and production. The boundary with Job Management is fluid — automation tools often include job-tracking features."@en,
        "Incluye plataformas de automatización e integración (Heidelberg Prinect, Kodak Prinergy, Agfa Apogee, EFI Fiery, Esko Automation Engine, Enfocus Switch, Xerox FreeFlow Core, Adobe PDF Workflow) y herramientas de colaboración para gestión de archivos y aprobaciones."@es,
        "स्वचालन और एकीकरण प्लेटफ़ॉर्म (Heidelberg Prinect, Kodak Prinergy, Agfa Apogee, EFI Fiery, Esko Automation Engine, Enfocus Switch, Xerox FreeFlow Core, Adobe PDF Workflow) और ग्राहकों, डिज़ाइनरों और उत्पादन को जोड़ने वाले सहयोग औज़ार शामिल। जॉब प्रबंधन से सीमा तरल — स्वचालन औज़ारों में प्रायः जॉब-ट्रैकिंग सुविधाएँ होती हैं।"@hi,
        "自動化および統合プラットフォーム（Heidelberg Prinect、Kodak Prinergy、Agfa Apogee、EFI Fiery、Esko Automation Engine、Enfocus Switch、Xerox FreeFlow Core、Adobe PDF Workflow）と、顧客、デザイナー、生産をつなぐ協業ツールを含む。Job Managementとの境界は流動的である — 自動化ツールはジョブ追跡機能を含むことが多い。"@ja,
        "Inkluderer automasjons- og integrasjonsplattformer (Heidelberg Prinect, Kodak Prinergy, Agfa Apogee, EFI Fiery, Esko Automation Engine, Enfocus Switch, Xerox FreeFlow Core, Adobe PDF Workflow) og samarbeidsverktøy som kobler kunder, designere og produksjon. Grensen mot Job Management er flytende — automasjonsverktøy inkluderer ofte funksjoner for jobbsporing."@nb,
        "Inclui plataformas de automação e integração (Heidelberg Prinect, Kodak Prinergy, Agfa Apogee, EFI Fiery, Esko Automation Engine, Enfocus Switch, Xerox FreeFlow Core, Adobe PDF Workflow) e ferramentas de colaboração que conectam clientes, designers e produção. A fronteira com Gestão de trabalhos é fluida — ferramentas de automação muitas vezes incluem recursos de acompanhamento de trabalhos."@pt,
        "包括自动化与集成平台（Heidelberg Prinect、Kodak Prinergy、Agfa Apogee、EFI Fiery、Esko Automation Engine、Enfocus Switch、Xerox FreeFlow Core、Adobe PDF Workflow）以及文件管理和批准的协作工具。"@zh-Hans ;
    ptpge:group "management" ;
    ptpge:level "sub-category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/management/workflow/file-preparation> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/management/workflow> ;
    skos:definition "Tekniske operationer, der forvandler trykklare designfiler til pressespecifikt output — udskydning (arrangering af sider på et ark), RIP-behandling (rastering til pressen) og trapping."@da,
        "Technische Operationen, die druckfertige Designdateien in maschinenspezifische Ausgaben umwandeln — Ausschießen (Anordnung der Seiten auf einem Bogen), RIP-Verarbeitung (Rasterung für die Druckmaschine) und Trapping."@de,
        "Technical operations that transform print-ready design files into press-specific output — imposition (arranging pages on a sheet), RIP processing (rasterizing for the press), and trapping."@en,
        "Operaciones técnicas que transforman archivos de diseño listos para imprenta en la salida específica de la prensa — imposición (disposición de páginas en una hoja), procesamiento RIP (rasterización para la prensa) y trapping."@es,
        "तकनीकी क्रियाएँ जो प्रिंट-रेडी डिज़ाइन फ़ाइलों को प्रेस-विशिष्ट आउटपुट में बदलती हैं — इम्पोज़िशन (शीट पर पेज व्यवस्थित करना), RIP प्रोसेसिंग (प्रेस के लिए रास्टराइज़ करना) और ट्रैपिंग।"@hi,
        "印刷可能なデザインファイルを印刷機固有の出力に変換する技術的工程 — 面付け（シート上のページ配置）、RIP処理（印刷機向けのラスタ化）、トラッピング。"@ja,
        "Tekniske operasjoner som transformerer trykkferdige designfiler til presse-spesifikt output — impositioning (arrangere sider på et ark), RIP-prosessering (rasterisering for pressen) og trapping."@nb,
        "Technische bewerkingen die drukklare ontwerpbestanden omzetten naar persspecifieke output — impositie (pagina's schikken op een vel), RIP-verwerking (rasteren voor de pers) en trapping."@nl,
        "Operacje techniczne przekształcające gotowe do druku pliki projektowe w wyjście właściwe dla maszyny — impozycja (rozmieszczenie stron na arkuszu), przetwarzanie RIP (rasteryzacja dla maszyny) i trapping."@pl,
        "Operações técnicas que transformam arquivos de design prontos para impressão em saída específica para a máquina — imposição (arranjo de páginas numa folha), processamento RIP (rasterização para a máquina) e trapping."@pt,
        "Tekniska operationer som omvandlar tryckfärdiga designfiler till presspecifik utdata — utskjutning (sidplacering på ark), RIP-bearbetning (rastrering för pressen) och trapping."@sv,
        "将印刷就绪的设计文件转换为印刷机专用输出的技术操作——拼版（将页面排布于纸张上）、RIP处理（光栅化以供印刷机）和补漏白。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/management/workflow/file-preparation/impositioning>,
        <https://ptpge.org/v1/printing/management/workflow/file-preparation/raster-image-processing> ;
    skos:notation "P:MG-WFL-FLPR" ;
    skos:prefLabel "Filklargøring"@da,
        "Dateivorbereitung"@de,
        "File Preparation"@en,
        "Preparación de Archivos"@es,
        "फ़ाइल तैयारी"@hi,
        "ファイル準備"@ja,
        "Fil-klargjøring"@nb,
        "Bestandsvoorbereiding"@nl,
        "Przygotowanie plików"@pl,
        "Preparação de arquivos"@pt,
        "Filförberedelse"@sv,
        "文件准备"@zh-Hans ;
    skos:scopeNote "Umfasst Ausschießen (Seitenanordnung, Bogenlayout, Greiferränder) und RIP (Raster Image Processing — Konvertierung vektorbasierter PDFs in das Bitmap-Format, das die Druckmaschine benötigt). Beide sind typischerweise in die übergeordnete Workflow-Automatisierungsplattform integriert, existieren aber als eigenständige technische Operationen."@de,
        "Includes impositioning (page arrangement, signature layout, gripper margins) and RIP (raster image processing — converting vector PDFs into the bitmap format the press needs). Both are typically integrated into the broader workflow automation platform but exist as distinct technical operations."@en,
        "Incluye imposición (disposición de páginas, maquetación de pliegos, márgenes de pinza) y RIP (Raster Image Processor — conversión de PDF vectoriales al formato bitmap que necesita la prensa). Ambos suelen estar integrados en motores de automatización."@es,
        "इम्पोज़िशनिंग (पेज व्यवस्था, सिग्नेचर लेआउट, ग्रिपर मार्जिन) और RIP (रास्टर इमेज प्रोसेसिंग — वेक्टर PDF को प्रेस के आवश्यक बिटमैप फ़ॉर्मेट में बदलना) शामिल। दोनों आमतौर पर व्यापक वर्कफ़्लो स्वचालन प्लेटफ़ॉर्म में एकीकृत, पर अलग तकनीकी क्रियाओं के रूप में विद्यमान।"@hi,
        "面付け（ページ配置、折り丁レイアウト、グリッパーマージン）とRIP（ラスター画像処理 — ベクターPDFを印刷機が必要とするビットマップ形式に変換）を含む。両者とも通常はより広範なワークフロー自動化プラットフォームに統合されているが、独立した技術的工程として存在する。"@ja,
        "Inkluderer impositioning (sidearrangering, signaturoppsett, griper-marger) og RIP (raster image processing — konverterer vektor-PDF-er til bitmap-formatet pressen trenger). Begge er typisk integrert i den bredere workflow-automasjonsplattformen, men eksisterer som distinkte tekniske operasjoner."@nb,
        "Inclui imposição (arranjo de páginas, layout de cadernos, margens de pinça) e RIP (processamento de imagem raster — conversão de PDFs vetoriais no formato bitmap que a máquina precisa). Ambos são normalmente integrados à plataforma mais ampla de automação de fluxo de trabalho, mas existem como operações técnicas distintas."@pt,
        "包括拼版（页面排布、印张布局、咬口边距）和RIP（光栅图像处理器——将矢量PDF转换为印刷机所需的位图格式）。两者通常集成在自动化引擎中。"@zh-Hans ;
    ptpge:group "management" ;
    ptpge:level "sub-category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/certifications/process> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards/certifications> ;
    skos:definition "Standarder, der definerer trykprocessers tekniske parametre — farvegengivelse, sikkerhedstryk, prepress-dataudveksling — og certificerer trykkeriers overholdelse af dem."@da,
        "Normen, die die technischen Parameter von Druckverfahren definieren — Farbreproduktion, Sicherheitsdruck, Druckvorstufen-Datenaustausch — und die Einhaltung durch Druckereien zertifizieren."@de,
        "Standards that define the technical parameters of printing processes — color reproduction, security printing, prepress data exchange — and certify printers' adherence to them."@en,
        "Normas que definen los parámetros técnicos de los procesos de impresión — reproducción de color, impresión de seguridad, intercambio de datos pre-prensa — y certifican el cumplimiento de las imprentas con ellos."@es,
        "मुद्रण प्रक्रियाओं के तकनीकी मापदंड — रंग पुनरुत्पादन, सुरक्षा मुद्रण, प्रीप्रेस डेटा विनिमय — परिभाषित करने वाले और प्रिंटरों के पालन को प्रमाणित करने वाले मानक।"@hi,
        "印刷工程の技術的パラメータ（色再現、セキュリティ印刷、製版データ交換）を定義し、印刷会社のそれらへの適合を認証する規格。"@ja,
        "Standarder som definerer tekniske parametre i trykkeprosesser — fargegjengivelse, sikkerhetstrykk, preprintdatautveksling — og sertifiserer trykkeriers etterlevelse av dem."@nb,
        "Standaarden die de technische parameters van drukprocessen definiëren — kleurweergave, beveiligd drukwerk, prepressdata-uitwisseling — en certificeren dat drukkerijen ze naleven."@nl,
        "Standardy definiujące parametry techniczne procesów drukowania — reprodukcję barw, druk zabezpieczony, wymianę danych prepress — i certyfikujące ich przestrzeganie przez drukarnie."@pl,
        "Normas que definem os parâmetros técnicos dos processos de impressão — reprodução de cor, impressão de segurança, troca de dados de pré-impressão — e certificam a aderência dos impressores a elas."@pt,
        "Standarder som definierar tryckprocessers tekniska parametrar — färgåtergivning, säkerhetstryck, prepressdatautbyte — och certifierar tryckeriers efterlevnad av dem."@sv,
        "定义印刷工艺技术参数——色彩再现、安全印刷、印前数据交换——并认证印刷厂遵守度的标准。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/certifications/process/intergraf-15374>,
        <https://ptpge.org/v1/printing/standards/certifications/process/iso-14298> ;
    skos:notation "P:ST-CER-PROC" ;
    skos:prefLabel "Proces"@da,
        "Prozess"@de,
        "Process"@en,
        "Proceso"@es,
        "प्रक्रिया"@hi,
        "プロセス"@ja,
        "Prosess"@nb,
        "Proces"@nl,
        "Procesowe"@pl,
        "Processo"@pt,
        "Process"@sv,
        "工艺"@zh-Hans ;
    skos:scopeNote "Umfasst Skalenfarben-Normen (Familie ISO 12647), Anforderungen an den Sicherheitsdruck (ISO 14298) und Druckvorstufen-Datenaustausch (Intergraf 15374). Qualitäts- und Umweltmanagementsysteme befinden sich in benachbarten Unterkategorien."@de,
        "Covers process-color standards (ISO 12647 family), security-printing requirements (ISO 14298), and prepress data interchange (Intergraf 15374). Quality and environmental management systems live in adjacent sub-categories."@en,
        "Cubre las normas de proceso de color (familia ISO 12647), los requisitos para impresión de seguridad (ISO 14298) y el intercambio de datos pre-prensa (Intergraf 15374). Los sistemas de gestión de calidad y ambientales se sitúan en sub-categorías adyacentes."@es,
        "प्रोसेस-कलर मानक (ISO 12647 परिवार), सुरक्षा-मुद्रण आवश्यकताएँ (ISO 14298) और प्रीप्रेस डेटा विनिमय (Intergraf 15374) शामिल। गुणवत्ता और पर्यावरण प्रबंधन प्रणालियाँ निकटवर्ती उप-श्रेणियों में।"@hi,
        "プロセスカラー規格（ISO 12647ファミリー）、セキュリティ印刷要件（ISO 14298）、製版データ交換（Intergraf 15374）を扱う。品質および環境マネジメントシステムは隣接サブカテゴリに属する。"@ja,
        "Dekker prosessfarge-standarder (ISO 12647-familien), sikkerhetstrykk-krav (ISO 14298), og preprintdatautveksling (Intergraf 15374). Kvalitets- og miljøledelsessystemer hører til tilstøtende underkategorier."@nb,
        "Cobre normas de cor de processo (família ISO 12647), requisitos de impressão de segurança (ISO 14298) e intercâmbio de dados de pré-impressão (Intergraf 15374). Sistemas de gestão de qualidade e ambiental ficam em subcategorias adjacentes."@pt,
        "涵盖过程色标准（ISO 12647系列）、安全印刷要求（ISO 14298）和印前数据交换（Intergraf 15374）。质量和环境管理系统位于相邻子分类。"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.7 · p.336" ;
            ptpge:mappingRow "crosswalk row 5" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Certification" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

<https://ptpge.org/v1/printing/standards/color-systems/color-profiles> a skos:Concept ;
    dcterms:created "2026-06-18T10:00:07+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel "Colour Profiles"@en,
        "profile kolorów"@pl,
        "Perfis de cores"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems> ;
    skos:definition "Farveprofiler og karakteriseringsdata brugt i farvestyret gengivelse."@da,
        "Farbprofile und Charakterisierungsdaten für die farbgemanagte Reproduktion."@de,
        "Colour profiles and characterisation data used in colour-managed reproduction."@en,
        "Perfiles de color y datos de caracterización usados en la reproducción con gestión de color."@es,
        "रंग-प्रबंधित पुनरुत्पादन में प्रयुक्त रंग प्रोफ़ाइल और लक्षण-वर्णन डेटा।"@hi,
        "カラーマネジメントされた複製に用いるカラープロファイルと特性化データ。"@ja,
        "Fargeprofiler og karakteriseringsdata brukt i fargestyrt reproduksjon."@nb,
        "Kleurprofielen en karakteriseringsdata gebruikt in kleurbeheerde reproductie."@nl,
        "Profile barw i dane charakteryzacji używane w reprodukcji z zarządzaniem barwą."@pl,
        "Perfis de cor e dados de caracterização usados na reprodução com gerenciamento de cor."@pt,
        "Färgprofiler och karakteriseringsdata som används i färghanterad återgivning."@sv,
        "用于色彩管理复制的色彩配置文件与特性化数据。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/color-systems/color-profiles/device-profiles>,
        <https://ptpge.org/v1/printing/standards/color-systems/color-profiles/icc-profiles> ;
    skos:notation "P:ST-CSY-CPRF" ;
    skos:prefLabel "Farveprofiler"@da,
        "Farbprofile"@de,
