{
  "openapi": "3.1.0",
  "info": {
    "title": "PTPGE API",
    "version": "2026-10-23",
    "summary": "The open, semantic vocabulary for print — 882 terms with permanent URIs.",
    "description": "REST surface of the PTPGE specification (Periodic Table of Print & Graphic Elements). Every term is a permanent, dereferenceable URI returning JSON-LD/SKOS; the same vocabulary backs the MCP server for AI agents (mcp.ptpge.org) and the ptpge-cfs/1 Configuration Fingerprint.\n\nContent negotiation: extensionless URLs return `application/ld+json` by default, `text/turtle` when the Accept header asks for it, and an HTML page in browsers. Append `?format=json` to receive the identical bytes with `Content-Type: application/json` (for clients that choke on ld+json). All endpoints are read-only (GET).",
    "license": {
      "name": "CC BY 4.0 (term data)",
      "identifier": "CC-BY-4.0"
    },
    "contact": {
      "name": "PTPGE",
      "url": "https://ptpge.org"
    }
  },
  "externalDocs": {
    "description": "Specification, documentation and permanent home",
    "url": "https://ptpge.org"
  },
  "servers": [
    {
      "url": "https://api.ptpge.org/v1",
      "description": "Production (Public Beta — open, no key). Term URIs themselves resolve on https://ptpge.org/v1/."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Catalog / discovery document",
        "description": "Top-level index of the vocabulary (groups, counts, entry points).",
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "index.jsonld",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/scheme": {
      "get": {
        "summary": "The SKOS concept scheme",
        "operationId": "getScheme",
        "responses": {
          "200": {
            "description": "ConceptScheme (JSON-LD)",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/context": {
      "get": {
        "summary": "The JSON-LD context",
        "operationId": "getContext",
        "responses": {
          "200": {
            "description": "JSON-LD @context used by every document",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Data release info",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "Release date, term counts, scheme URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dataVersion": {
                      "type": "string"
                    },
                    "termCount": {
                      "type": "integer"
                    },
                    "scheme_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/terms": {
      "get": {
        "summary": "Full bundle — the scheme and every term in one @graph",
        "description": "Large response; intended for bulk download / self-hosting. Also available as Turtle at /terms.ttl.",
        "operationId": "getFullBundle",
        "responses": {
          "200": {
            "description": "terms.jsonld",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/search-index": {
      "get": {
        "summary": "Client-side search index",
        "operationId": "getSearchIndex",
        "responses": {
          "200": {
            "description": "Compact index of labels/notations for client-side search",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/schemas": {
      "get": {
        "summary": "The five document schemas",
        "description": "request/1, quote/1, vendor-declaration/1, supplier-catalogue/1, ucp-manifest/1 — each a term under /schemas/{name}/{version}; a published JSON Schema sits next to it as /schemas/{name}/{version}.schema.json.",
        "operationId": "getSchemas",
        "responses": {
          "200": {
            "description": "schemas index (JSON-LD)",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/schemas/{name}/{version}.schema.json": {
      "get": {
        "summary": "JSON Schema (draft 2020-12) of a document form",
        "operationId": "getJsonSchema",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "request",
                "quote",
                "vendor-declaration",
                "supplier-catalogue",
                "ucp-manifest"
              ]
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The JSON Schema",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "No published JSON Schema for this form yet"
          }
        }
      }
    },
    "/suppliers": {
      "get": {
        "summary": "Suppliers register (makers of presses, substrates, inks)",
        "description": "Identity entries, not terms: URI, name, country, domain, claim status, where the company's own supplier-catalogue/1 lives. One entry per /suppliers/{slug}.",
        "operationId": "getSuppliers",
        "responses": {
          "200": {
            "description": "register index (JSON-LD)",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/vendors": {
      "get": {
        "summary": "Vendors register (print shops)",
        "description": "Identity entries, not terms: URI, name, country, domain, claim status, where the company's own vendor-declaration/1 lives (https://<domain>/.well-known/ptpge/declaration.json). One entry per /vendors/{slug}.",
        "operationId": "getVendors",
        "responses": {
          "200": {
            "description": "register index (JSON-LD)",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/mappings": {
      "get": {
        "summary": "Crosswalk discovery document",
        "description": "Mappings to adjacent industry vocabularies (e.g. CIP4/XJDF) — one file per target under /mappings/{slug}.",
        "operationId": "getMappings",
        "responses": {
          "200": {
            "description": "mappings/index.jsonld",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/{termPath}": {
      "get": {
        "summary": "Any term, sub-tree index or top concept by its URI path",
        "description": "The core of the API: `https://ptpge.org/v1/{termPath}` IS the term's permanent identifier. Examples: `/printing/standards/measurement-systems/metric`, `/ordering/products/brochures`, `/variables/configuration/format`. Internal nodes return an index of their children. NOTE: {termPath} contains slashes — OpenAPI path templating cannot express this formally, so treat it as a prefix pattern `[a-z0-9./-]+` rather than a single segment.",
        "operationId": "getTerm",
        "parameters": [
          {
            "name": "termPath",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9./-]+$"
            },
            "description": "Slash-separated term path (charset a-z 0-9 . / - — the ptpge-cfs/1 token charset)."
          }
        ],
        "responses": {
          "200": {
            "description": "The term document",
            "content": {
              "application/ld+json": {
                "schema": {
                  "type": "object",
                  "description": "One PTPGE term (house format, JSON-LD).",
                  "properties": {
                    "@context": {
                      "type": "string",
                      "description": "https://ptpge.org/v1/context.jsonld"
                    },
                    "id": {
                      "type": "string",
                      "format": "uri",
                      "description": "Permanent term URI (never changes; deprecated terms keep resolving)."
                    },
                    "type": {
                      "type": "string"
                    },
                    "notation": {
                      "type": "string",
                      "description": "Notation v3, axis-typed: P:CF§A4, O:PR§BROCHURE, VAR:CFG§FORMAT; registers SUP:/VEN:, schemas SCH:."
                    },
                    "elementType": {
                      "type": "string",
                      "enum": [
                        "group",
                        "category",
                        "sub-category",
                        "element",
                        "variable",
                        "value",
                        "concept",
                        "context",
                        "reference"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "proposed",
                        "approved",
                        "deprecated"
                      ],
                      "description": "Lifecycle. In the Public Beta every live term is 'proposed'; URIs are stable regardless, and deprecated terms keep resolving with a pointer to their successor."
                    },
                    "version": {
                      "type": "string",
                      "description": "ISO date of the content release that last touched this term."
                    },
                    "label": {
                      "type": "object",
                      "description": "Multilingual labels keyed by BCP-47 code (en, nb, de, ja, es, zh-Hans, sv, da, nl, pl, pt, hi)."
                    },
                    "definition": {
                      "type": "object",
                      "description": "Multilingual definitions."
                    },
                    "broader": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "narrower": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ordered": {
                      "type": "boolean",
                      "description": "On multi-value variables: true means value order is significant and serializes with '>' in ptpge-cfs/1."
                    }
                  },
                  "additionalProperties": true
                }
              },
              "text/turtle": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No such term"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Term": {
        "type": "object",
        "description": "One PTPGE term (house format, JSON-LD).",
        "properties": {
          "@context": {
            "type": "string",
            "description": "https://ptpge.org/v1/context.jsonld"
          },
          "id": {
            "type": "string",
            "format": "uri",
            "description": "Permanent term URI (never changes; deprecated terms keep resolving)."
          },
          "type": {
            "type": "string"
          },
          "notation": {
            "type": "string",
            "description": "Notation v3, axis-typed: P:CF§A4, O:PR§BROCHURE, VAR:CFG§FORMAT; registers SUP:/VEN:, schemas SCH:."
          },
          "elementType": {
            "type": "string",
            "enum": [
              "group",
              "category",
              "sub-category",
              "element",
              "variable",
              "value",
              "concept",
              "context",
              "reference"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "deprecated"
            ],
            "description": "Lifecycle. In the Public Beta every live term is 'proposed'; URIs are stable regardless, and deprecated terms keep resolving with a pointer to their successor."
          },
          "version": {
            "type": "string",
            "description": "ISO date of the content release that last touched this term."
          },
          "label": {
            "type": "object",
            "description": "Multilingual labels keyed by BCP-47 code (en, nb, de, ja, es, zh-Hans, sv, da, nl, pl, pt, hi)."
          },
          "definition": {
            "type": "object",
            "description": "Multilingual definitions."
          },
          "broader": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "narrower": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ordered": {
            "type": "boolean",
            "description": "On multi-value variables: true means value order is significant and serializes with '>' in ptpge-cfs/1."
          }
        },
        "additionalProperties": true
      }
    }
  }
}
