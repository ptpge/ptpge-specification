      "label": {
        "en": "Tagged Image File Format (.tif)",
        "es": "TIFF (.tif)",
        "zh-Hans": "TIFF (.tif)",
        "nb": "Tagged Image File Format (.tif)",
        "de": "Tagged Image File Format (.tif)",
        "ja": "Tagged Image File Format (.tif)",
        "sv": "TIFF (.tif)",
        "da": "TIFF (.tif)",
