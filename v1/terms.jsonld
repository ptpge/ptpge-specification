      "label": {
        "en": "C4 (229 x 324 mm)",
        "es": "C4 (229 × 324 mm)",
        "zh-Hans": "C4 (229 × 324 mm)",
        "nb": "C4 (229 x 324 mm)",
        "de": "C4 (229 x 324 mm)",
        "ja": "C4 (229 x 324 mm)",
