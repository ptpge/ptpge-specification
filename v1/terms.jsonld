    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "sub-category",
      "label": {
        "en": "Raster Graphics",
        "es": "Gráficos Raster",
        "zh-Hans": "位图图形",
        "nb": "Rastergrafikk",
        "de": "Rastergrafik",
        "ja": "ラスターグラフィック",
        "sv": "Rastergrafik",
        "da": "Rastergrafik",
        "nl": "Rastergraphics",
        "pl": "Grafika rastrowa",
        "pt": "Gráficos raster",
        "hi": "रास्टर ग्राफ़िक्स"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "standards",
      "broader": "https://ptpge.org/v1/printing/standards/graphic-file-formats",
      "narrower": [
        "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics/joint-picture-expert-group",
        "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics/portable-network-group",
        "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics/tagged-image-file-format",
        "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics/camera-raw"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:50:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Image file formats that store visual content as a grid of pixels, each with explicit color values — appropriate for photographs and continuous-tone artwork.",
        "nb": "Bildefilformater som lagrer visuelt innhold som et rutenett av piksler, hver med eksplisitte fargeverdier — passende for fotografier og kontinuerlig-tonet kunst.",
        "de": "Bilddateiformate, die visuelle Inhalte als Pixelraster mit expliziten Farbwerten je Pixel speichern — geeignet für Fotografien und Halbton-Bildmaterial.",
        "ja": "視覚コンテンツを、それぞれが明示的な色値を持つピクセルのグリッドとして保存する画像ファイル形式 — 写真および連続階調のアートワークに適する。",
        "es": "Formatos de archivo de imagen que almacenan el contenido visual como una rejilla de píxeles, cada uno con valores de color explícitos — apropiados para fotografías y obras de tono continuo.",
        "zh-Hans": "将视觉内容存储为像素网格的图像文件格式，每个像素具有明确的色值——适合照片和连续色调艺术作品。",
        "sv": "Bildfilformat som lagrar visuellt innehåll som ett rutnät av pixlar, var och en med explicita färgvärden — lämpligt för fotografier och halvtonsoriginal.",
        "da": "Billedfilformater, der lagrer visuelt indhold som et gitter af pixels, hver med eksplicitte farveværdier — velegnet til fotografier og halvtoneoriginaler.",
        "nl": "Beeldbestandsformaten die visuele inhoud opslaan als een raster van pixels, elk met expliciete kleurwaarden — geschikt voor foto's en fulltone-originelen.",
        "pl": "Formaty plików obrazów przechowujące treść wizualną jako siatkę pikseli, każdy z jawnymi wartościami barw — właściwe dla fotografii i grafiki wielotonalnej.",
        "pt": "Formatos de arquivo de imagem que armazenam o conteúdo visual como uma grade de pixels, cada um com valores de cor explícitos — adequados para fotografias e arte de tom contínuo.",
        "hi": "छवि फ़ाइल फ़ॉर्मेट जो दृश्य सामग्री को पिक्सेल की ग्रिड के रूप में संग्रहीत करते हैं, हर पिक्सेल के स्पष्ट रंग मान — फ़ोटोग्राफ़ और सतत-टोन आर्टवर्क के लिए उपयुक्त।"
      },
      "scopeNote": {
        "en": "Includes lossy compression (JPEG), lossless compression (PNG, TIFF), and uncompressed/minimally-processed sensor data (Camera RAW). Resolution and color depth determine fitness for print at a given size.",
        "nb": "Inkluderer tapsbehandlet komprimering (JPEG), tapsfri komprimering (PNG, TIFF) og ubehandlet/minimalt behandlede sensordata (Camera RAW). Oppløsning og fargedybde avgjør egnethet for trykk i en gitt størrelse.",
        "de": "Umfasst verlustbehaftete Kompression (JPEG), verlustfreie Kompression (PNG, TIFF) und unkomprimierte/minimal verarbeitete Sensordaten (Camera RAW). Auflösung und Farbtiefe bestimmen die Eignung für den Druck in einer bestimmten Größe.",
        "ja": "非可逆圧縮（JPEG）、可逆圧縮（PNG、TIFF）、無圧縮または最小限の処理を施したセンサーデータ（Camera RAW）を含む。解像度と色深度が、特定のサイズで印刷に適するかを決定する。",
        "es": "Incluye compresión con pérdida (JPEG), compresión sin pérdida (PNG, TIFF) y datos de sensor sin comprimir o mínimamente procesados (RAW de cámara). La resolución y la profundidad de color determinan la idoneidad para imprimir a un tamaño dado.",
        "zh-Hans": "包括有损压缩（JPEG）、无损压缩（PNG、TIFF）以及未压缩或最低限度处理的传感器数据（相机RAW）。分辨率和色深决定在特定尺寸下印刷的适用性。",
        "pt": "Inclui compressão com perdas (JPEG), sem perdas (PNG, TIFF) e dados de sensor não comprimidos/minimamente processados (Camera RAW). Resolução e profundidade de cor determinam a adequação para impressão num dado tamanho.",
        "hi": "हानिपूर्ण संपीड़न (JPEG), हानिरहित संपीड़न (PNG, TIFF) और असंपीड़ित/न्यूनतम-प्रसंस्कृत सेंसर डेटा (Camera RAW) शामिल। रिज़ॉल्यूशन और रंग गहराई किसी आकार पर प्रिंट की उपयुक्तता तय करते हैं।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "notation": "P:ST-GFF-RAST",
      "semanticSource": [
        {
          "standard": "XJDF",
          "version": "2.2",
          "elements": [
            "FileSpec"
          ],
          "refs": [
            "§8.19 · p.345"
          ],
          "match": "partial",
          "via": "crosswalk row 3"
        }
      ],
      "altLabels": {
        "pl": [
          "grafika bitmapowa"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics/camera-raw",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Camera RAW",
        "es": "Camera RAW",
        "zh-Hans": "相机RAW",
        "nb": "Camera RAW",
        "de": "Camera RAW",
        "ja": "Camera RAW",
        "sv": "Camera RAW",
        "da": "Camera RAW",
        "nl": "Camera RAW",
        "pl": "Camera RAW",
        "pt": "Camera RAW",
        "hi": "Camera RAW"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "standards",
      "notation": "P:ST§CAMERA-RAW",
      "elementType": "reference",
      "broader": "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:50:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Family of file formats storing minimally-processed image sensor data from digital cameras (e.g. .cr2, .nef, .arw), preserving maximum dynamic range and editing latitude.",
        "nb": "Familie av filformater som lagrer minimalt behandlede bildesensordata fra digitale kameraer (f.eks. .cr2, .nef, .arw), med bevart maksimalt dynamisk område og redigeringsfleksibilitet.",
        "de": "Familie von Dateiformaten zur Speicherung minimal verarbeiteter Bildsensordaten von Digitalkameras (z. B. .cr2, .nef, .arw), behält maximalen Dynamikumfang und Bearbeitungsspielraum bei.",
        "ja": "デジタルカメラから最小限の処理を施した画像センサーデータを保存するファイル形式ファミリー（例：.cr2、.nef、.arw）。最大のダイナミックレンジと編集の自由度を保持する。",
        "es": "Datos crudos del sensor de la cámara, mínimamente procesados. Formato propietario por fabricante (.cr2, .nef, .arw, .raf, etc.). Se procesa a JPEG o TIFF antes de entregarlo a imprenta.",
        "zh-Hans": "相机传感器的原始数据，经过最少处理。专有格式按制造商分（.cr2、.nef、.arw、.raf等）。交付印刷前处理为JPEG或TIFF。",
        "sv": "Familj av filformat som lagrar minimalt bearbetade bildsensordata från digitalkameror (t.ex. .cr2, .nef, .arw) och bevarar maximalt dynamiskt omfång och redigeringsutrymme.",
        "da": "Familie af filformater, der lagrer minimalt behandlede billedsensordata fra digitalkameraer (f.eks. .cr2, .nef, .arw) og bevarer maksimalt dynamisk omfang og redigeringsmuligheder.",
        "nl": "Familie van bestandsformaten die minimaal bewerkte beeldsensordata van digitale camera's opslaan (bijv. .cr2, .nef, .arw) en maximaal dynamisch bereik en bewerkingsruimte behouden.",
        "pl": "Rodzina formatów plików przechowujących minimalnie przetworzone dane z sensora aparatu cyfrowego (np. .cr2, .nef, .arw), zachowujących maksymalny zakres dynamiczny i swobodę edycji.",
        "pt": "Família de formatos de arquivo que armazenam dados de sensor de imagem minimamente processados de câmeras digitais (por exemplo, .cr2, .nef, .arw), preservando máxima faixa dinâmica e latitude de edição.",
        "hi": "डिजिटल कैमरों के न्यूनतम-प्रसंस्कृत छवि सेंसर डेटा संग्रहीत करने वाले फ़ाइल फ़ॉर्मेट का परिवार (जैसे .cr2, .nef, .arw), अधिकतम डायनामिक रेंज और संपादन गुंजाइश संरक्षित।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
