      "label": {
        "en": "DL (110 x 220 mm)",
        "es": "DL (110 × 220 mm)",
        "zh-Hans": "DL (110 × 220 mm)",
        "nb": "DL (110 x 220 mm)",
        "de": "DL (110 x 220 mm)",
        "ja": "DL (110 x 220 mm)",
        "nl": "DL (110 x 220 mm)",
        "sv": "DL (110 x 220 mm)",
