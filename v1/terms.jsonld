          "Fluted roll"
        ],
        "nb": [
          "Bølgepapp-rull"
        ],
        "pl": [
          "fala w roli"
        ],
        "pt": [
          "rolo de ondulado",
          "papelão ondulado em bobina"
        ],
        "hi": [
          "फ़्लूटेड रोल",
          "कोरुगेटेड रील"
        ]
      },
