          ],
          "match": "partial",
          "via": "SD-0076"
        }
      ],
      "altLabels": {
        "pl": [
          "szerokość grzbietu"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/variables/configuration/winding-direction",
      "type": "skos:Concept",
      "version": "2026-09-05",
      "status": "proposed",
      "notation": "VAR:CF§WINDING-DIRECTION",
      "level": "element",
      "elementType": "variable",
      "label": {
        "en": "Winding Direction",
        "nb": "Viklingsretning",
        "de": "Wickelrichtung",
        "es": "Sentido de bobinado",
        "ja": "巻き方向",
        "zh-Hans": "卷绕方向",
        "sv": "Rullriktning",
        "da": "Rulleretning",
        "nl": "Wikkelrichting",
        "pl": "Kierunek nawoju",
        "pt": "Sentido de enrolamento",
        "hi": "वाइंडिंग दिशा"
      },
      "definition": {
        "en": "Which of the eight FINAT winding positions the finished labels or stickers take on the roll — printed face out or in, and which edge leads (top, bottom, right, left). Bindable because a label applicator accepts exactly one direction. Adopted from XJDF Component/@WindingResult, which references the FINAT numbering. Applies to roll-supplied products only; unbound means unspecified.",
        "nb": "Hvilken av de åtte FINAT-viklingsposisjonene de ferdige etikettene eller stickerne har på rullen — trykkside ut eller inn, og hvilken kant som går først (topp, bunn, høyre, venstre). Bindbar fordi en etikettapplikator tar imot nøyaktig én retning. Adoptert fra XJDF Component/@WindingResult, som refererer FINAT-nummereringen. Gjelder bare produkter levert på rull; ubundet betyr uspesifisert.",
        "de": "Welche der acht FINAT-Wickelpositionen die fertigen Etiketten auf der Rolle einnehmen — Druckseite außen oder innen, und welche Kante vorausläuft (oben, unten, rechts, links). Bindbar, weil ein Etikettenspender genau eine Richtung akzeptiert. Übernommen aus XJDF Component/@WindingResult, das auf die FINAT-Nummerierung verweist. Nur für Rollenprodukte; ungebunden bedeutet nicht spezifiziert.",
        "es": "Cuál de las ocho posiciones de bobinado FINAT adoptan las etiquetas o adhesivos acabados en la bobina — cara impresa hacia fuera o hacia dentro, y qué borde va primero (superior, inferior, derecho, izquierdo). Vinculable porque una aplicadora acepta exactamente una dirección. Adoptado de XJDF Component/@WindingResult, que remite a la numeración FINAT. Solo para productos en bobina; sin vincular significa sin especificar.",
        "ja": "仕上がったラベル／ステッカーがロール上で取る 8 つの FINAT 巻き位置のいずれか——外巻きか内巻きか、どの辺が先行するか（上・下・右・左）。ラベラーは一方向しか受け付けないため束縛可能。FINAT 番号を参照する XJDF Component/@WindingResult から採用。ロール供給製品のみに適用。未束縛は未指定を意味する。",
        "zh-Hans": "成品标签或贴纸在卷上采用八个 FINAT 卷绕位置中的哪一个——印刷面朝外或朝内，以及哪一边先出（上、下、右、左）。可绑定，因为贴标机只接受一种方向。采用自引用 FINAT 编号的 XJDF Component/@WindingResult。仅适用于卷装产品；未绑定即未指定。",
        "sv": "Vilket av de åtta FINAT-rullägena de färdiga etiketterna har på rullen — tryck utåt eller inåt, och vilken kant som går först (topp, botten, höger, vänster). Bindbar eftersom en applikator tar exakt en riktning. Hämtad från XJDF Component/@WindingResult, som hänvisar till FINAT-numreringen. Endast rullprodukter; obunden betyder ospecificerad.",
        "da": "Hvilken af de otte FINAT-rullepositioner de færdige etiketter har på rullen — trykside ud eller ind, og hvilken kant der går først (top, bund, højre, venstre). Bindbar, fordi en applikator accepterer præcis én retning. Overtaget fra XJDF Component/@WindingResult, der henviser til FINAT-nummereringen. Kun rulleprodukter; ubundet betyder uspecificeret.",
        "nl": "Welke van de acht FINAT-wikkelposities de afgewerkte etiketten op de rol innemen — beeld buiten of binnen, en welke rand voorop gaat (boven, onder, rechts, links). Bindbaar omdat een applicator precies één richting accepteert. Overgenomen uit XJDF Component/@WindingResult, dat naar de FINAT-nummering verwijst. Alleen voor rolproducten; ongebonden betekent niet gespecificeerd.",
        "pl": "Która z ośmiu pozycji nawoju FINAT przyjmują gotowe etykiety lub naklejki na roli — stroną zadrukowaną na zewnątrz lub do wewnątrz i którą krawędzią do przodu (górą, dołem, prawą, lewą). Wiązalna, ponieważ aplikator etykiet przyjmuje dokładnie jeden kierunek. Przyjęta z XJDF Component/@WindingResult, która odwołuje się do numeracji FINAT. Dotyczy tylko produktów dostarczanych w roli; brak wartości oznacza nieokreślone.",
        "pt": "Qual das oito posições de enrolamento FINAT as etiquetas ou adesivos acabados assumem no rolo — face impressa para fora ou para dentro, e qual borda lidera (superior, inferior, direita, esquerda). Vinculável porque um aplicador de etiquetas aceita exatamente um sentido. Adotado de XJDF Component/@WindingResult, que referencia a numeração FINAT. Aplica-se apenas a produtos fornecidos em rolo; não vinculado significa não especificado.",
        "hi": "तैयार लेबल या स्टिकर रोल पर आठ FINAT वाइंडिंग स्थितियों में से कौन-सी लेते हैं — छपा हुआ चेहरा बाहर या अंदर, और कौन-सा किनारा आगे (ऊपर, नीचे, दाएँ, बाएँ)। बाँधने योग्य क्योंकि लेबल एप्लिकेटर ठीक एक ही दिशा स्वीकार करता है। XJDF Component/@WindingResult से लिया गया, जो FINAT क्रमांकन को संदर्भित करता है। केवल रोल में दिए जाने वाले उत्पादों पर लागू; अनबाउंड का अर्थ अनिर्दिष्ट।"
      },
      "question": {
        "en": "Which way is it wound?",
        "nb": "Hvilken vei er den rullet?",
        "de": "In welche Richtung ist es gewickelt?",
        "es": "¿En qué sentido está enrollado?",
        "ja": "巻き方向は？",
        "zh-Hans": "卷绕方向是？",
        "sv": "Åt vilket håll är den rullad?",
        "da": "Hvilken vej er den rullet?",
        "nl": "Welke kant op is het gewikkeld?",
        "pl": "W którą stronę jest nawinięty?",
        "pt": "Em que sentido está enrolado?",
        "hi": "किस दिशा में लपेटा गया है?"
      },
      "datatype": "enum",
      "cardinality": "single",
      "scope": "product",
      "valueDomain": "https://ptpge.org/v1/printing/configurations/winding-direction",
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/variables/configuration",
      "created": "2026-09-05T00:00:00Z",
      "modified": "2026-10-06T19:16:59Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "semanticSource": [
        {
          "standard": "XJDF",
          "version": "2.2",
          "elements": [
            "Component",
            "Component@WindingResult",
            "Winding"
          ],
          "refs": [
            "§6.18 · p.176",
            "§5.6.38 · p.113"
          ],
          "match": "exact",
          "via": "Component@WindingResult"
        }
      ],
      "altLabels": {
        "pl": [
          "pozycja nawoju FINAT"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/variables/features",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "group",
      "label": {
        "en": "Features",
        "nb": "Egenskaper",
        "de": "Merkmale",
        "es": "Características",
        "ja": "特性",
        "zh-Hans": "特性",
        "sv": "Egenskaper",
        "da": "Karakteristika",
        "nl": "Kenmerken",
        "pl": "Cechy",
        "pt": "Características",
        "hi": "फ़ीचर"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/variables",
      "created": "2026-06-17T10:05:27Z",
      "modified": "2026-10-12T15:00:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "notation": "VAR:FT",
      "creator": "https://ptpge.org/contributors/ptpge",
      "narrower": [
        "https://ptpge.org/v1/variables/features/color-mode",
        "https://ptpge.org/v1/variables/features/embellishment",
        "https://ptpge.org/v1/variables/features/surface-finish",
        "https://ptpge.org/v1/variables/features/spot-ink"
      ],
      "definition": {
        "en": "Feature configuration variables — the visual and tactile feature axes a printed product can be configured along: color mode, surface finish and embellishment.",
        "nb": "Egenskapsvariabler — aksene for visuelle og taktile egenskaper et trykkprodukt kan konfigureres langs: fargemodus, overflatebehandling og dekor.",
        "de": "Merkmal-Konfigurationsvariablen — die Achsen visueller und haptischer Merkmale, entlang derer ein Druckprodukt konfiguriert werden kann: Farbmodus, Oberflächenveredelung und Zusatzveredelung.",
        "es": "Variables de configuración de características — los ejes de características visuales y táctiles a lo largo de los cuales puede configurarse un producto impreso: modo de color, acabado superficial y ornamentación.",
        "ja": "特性の構成変数 — 印刷物を構成できる視覚的・触覚的特性の軸。カラーモード、表面加工、加飾など。",
        "zh-Hans": "特性配置变量 — 印刷品可沿其配置的视觉与触觉特性轴：色彩模式、表面处理与装饰工艺。",
        "sv": "Konfigurationsvariabler för egenskaper — de visuella och taktila egenskapsaxlar en trycksak kan konfigureras längs: färgläge, ytbehandling och dekor.",
        "da": "Karakteristik-konfigurationsvariabler — de visuelle og taktile akser et trykt produkt kan konfigureres langs: farvetilstand, overfladefinish og forædling.",
        "nl": "Kenmerk-configuratievariabelen — de visuele en tactiele assen waarlangs een drukproduct kan worden geconfigureerd: kleurmodus, oppervlakteafwerking en veredeling.",
        "pl": "Zmienne konfiguracyjne cech — osie cech wizualnych i dotykowych, wzdłuż których można skonfigurować produkt drukowany: tryb koloru, wykończenie powierzchni i uszlachetnienie.",
        "pt": "Variáveis de configuração de características — os eixos visuais e táteis ao longo dos quais um impresso pode ser configurado: modo de cor, acabamento de superfície e enobrecimento.",
        "hi": "फ़ीचर कॉन्फ़िगरेशन वेरिएबल — वे दृश्य और स्पर्श अक्ष जिनके साथ मुद्रित उत्पाद कॉन्फ़िगर किया जा सकता है: कलर मोड, सरफ़ेस फ़िनिश और एम्बेलिशमेंट।"
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/variables/features/color-mode",
      "type": "skos:Concept",
      "version": "2026-09-20",
      "status": "proposed",
      "notation": "VAR:FT§COLOR-MODE",
      "level": "element",
      "elementType": "variable",
      "label": {
        "en": "Color Mode",
        "nb": "Fargemodus",
        "de": "Farbmodus",
        "es": "Modo de color",
        "ja": "カラーモード",
        "zh-Hans": "色彩模式",
        "sv": "Färgläge",
        "da": "Farvetilstand",
        "nl": "Kleurmodus",
        "pl": "Tryb koloru",
        "pt": "Modo de cor",
        "hi": "कलर मोड"
      },
      "altLabels": {
        "en": [
          "Color Printing",
          "Ink Colors",
          "Colour Mode"
        ],
        "nb": [
          "Fargetrykk",
          "Farger"
        ],
        "pl": [
          "kolorystyka druku",
          "kolory farb",
          "tryb barw"
        ],
        "pt": [
          "cores de impressão",
          "cores de tinta",
          "modo de cores"
        ],
        "hi": [
          "रंग मोड",
          "प्रिंट कलर",
          "स्याही के रंग",
          "छपाई के रंग"
        ]
      },
      "definition": {
        "en": "Configurable axis: Color Mode. A surface is configured with one or more color layers from the referenced valueDomain, in print order — e.g. White + CMYK (white underprint on dark, clear or non-paper substrates), CMYK + Spot, or Black + White. A single layer remains the common case.",
        "nb": "Konfigurerbar akse: Fargemodus. En flate konfigureres med ett eller flere fargelag fra value-domain, i trykkrekkefølge — f.eks. White + CMYK (hvit undertrykk på mørke, klare eller ikke-papir-substrater), CMYK + Spot, eller Black + White. Ett lag er fortsatt normaltilfellet.",
        "de": "Konfigurierbare Achse: Farbmodus. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain.",
        "es": "Eje configurable: Modo de color. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado.",
        "ja": "構成可能な軸：カラーモード。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。",
        "zh-Hans": "可配置轴：色彩模式。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。",
        "sv": "Konfigurerbar axel: Färgläge. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain).",
        "da": "Konfigurerbar akse: Farvetilstand. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne.",
        "nl": "Configureerbare as: Kleurmodus. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein.",
        "pl": "Oś konfigurowalna: Tryb koloru. Powierzchnia jest konfigurowana jedną lub kilkoma warstwami barwnymi z przywołanej valueDomain, w kolejności druku — np. Biel + CMYK (podkład biały na ciemnych, przezroczystych lub niepapierowych podłożach), CMYK + kolor dodatkowy lub Czerń + Biel. Pojedyncza warstwa pozostaje typowym przypadkiem.",
        "pt": "Eixo configurável: Modo de Cor. Uma face é configurada com uma ou mais camadas de cor do valueDomain referenciado, em ordem de impressão — p. ex. Branco + CMYK (base branca sobre substratos escuros, transparentes ou não papel), CMYK + Cor especial, ou Preto + Branco. Uma única camada continua sendo o caso comum.",
        "hi": "कॉन्फ़िगर करने योग्य अक्ष: कलर मोड। किसी सतह को संदर्भित valueDomain से एक या अधिक रंग परतों के साथ, छपाई के क्रम में, कॉन्फ़िगर किया जाता है — जैसे सफ़ेद + CMYK (गहरे, पारदर्शी या ग़ैर-काग़ज़ सब्सट्रेट पर सफ़ेद अंडरप्रिंट), CMYK + स्पॉट, या काला + सफ़ेद। एक ही परत अब भी सामान्य मामला है।"
      },
      "question": {
        "en": "Printed in which colours?",
        "nb": "Trykt i hvilke farger?",
        "de": "In welchen Farben gedruckt?",
        "es": "¿Impreso en qué colores?",
        "ja": "何色で印刷しますか？",
        "zh-Hans": "用什么颜色印刷？",
        "sv": "Tryckt i vilka färger?",
        "da": "Trykt i hvilke farver?",
        "nl": "In welke kleuren gedrukt?",
        "pl": "W jakich kolorach drukowany?",
        "pt": "Impresso em que cores?",
        "hi": "किन रंगों में छपाई?"
      },
      "datatype": "enum",
      "cardinality": "multiple",
      "scope": "surface",
      "valueDomain": "https://ptpge.org/v1/printing/features/colors",
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/variables/features",
      "created": "2026-05-30T00:00:00Z",
      "modified": "2026-10-06T19:16:59Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
