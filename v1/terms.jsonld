      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Matte Lamination",
        "nb": "Matt laminering",
        "de": "Matt-Laminierung",
        "ja": "マットラミネート",
        "es": "Laminado mate",
        "zh-Hans": "哑膜覆膜",
