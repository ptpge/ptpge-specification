        "de": "Weiterverarbeitung",
        "es": "Acabado",
        "ja": "後加工",
        "zh-Hans": "印后加工",
        "sv": "Efterbehandling",
        "da": "Færdiggørelse",
        "nl": "Afwerking",
        "pl": "Wykończenie",
        "pt": "Acabamento",
        "hi": "फ़िनिशिंग"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/variables",
      "created": "2026-06-17T10:05:27Z",
