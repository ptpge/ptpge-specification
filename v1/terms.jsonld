        "nb": "Papiroverflater",
        "de": "Papieroberflächen",
        "ja": "用紙表面",
        "sv": "Pappersytor",
        "da": "Papiroverflader",
        "nl": "Papieroppervlakken",
        "pl": "Powierzchnie papieru",
        "pt": "Superfícies de papel",
