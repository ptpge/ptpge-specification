      "label": {
        "en": "Cardboard",
        "es": "Cartón (Bobina)",
        "zh-Hans": "纸板（卷材）",
        "nb": "Papp",
        "de": "Karton",
        "ja": "段ボール",
        "sv": "Kartong",
        "da": "Karton (rulle)",
        "nl": "Karton (rol)",
        "pl": "Karton",
        "pt": "Cartão em rolo",
        "hi": "गत्ता (रोल)"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "notation": "P:SB§CARDBOARD",
      "elementType": "value",
