      "created": "2026-06-18T10:00:07Z",
      "modified": "2026-10-06T19:29:35Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "notation": "P:ST§HP-INDICHROME",
      "creator": "https://ptpge.org/contributors/ptpge",
      "elementType": "reference",
      "definition": {
        "en": "HP Indigo IndiChrome extended-gamut ink system for digital offset.",
        "nb": "HP Indigo IndiChrome utvidet-gamut blekksystem for digital offset.",
        "de": "HP Indigo IndiChrome — Extended-Gamut-Farbsystem für Digital-Offset.",
        "es": "Sistema de tintas de gama extendida HP Indigo IndiChrome para ófset digital.",
        "ja": "デジタルオフセットのための HP Indigo IndiChrome 拡張ガモットインキシステム。",
        "zh-Hans": "用于数字胶印的 HP Indigo IndiChrome 扩展色域油墨系统。",
        "sv": "HP Indigo IndiChrome — bläcksystem för utökad färgomfattning inom digital offset.",
        "da": "HP Indigo IndiChrome — farvesystem for udvidet farveomfang inden for digital offset.",
        "nl": "HP Indigo IndiChrome — inktsysteem voor uitgebreid gamma binnen digitale offset.",
        "pl": "System farb o rozszerzonym gamucie HP Indigo IndiChrome dla cyfrowego offsetu.",
        "pt": "Sistema de tintas de gamut estendido HP Indigo IndiChrome para offset digital.",
        "hi": "डिजिटल ऑफसेट के लिए HP Indigo IndiChrome विस्तारित-गैमट स्याही प्रणाली।"
      },
