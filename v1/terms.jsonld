        "de": "Naturpapier (CIE 80–90, leicht warm)",
        "ja": "ナチュラル紙（CIE 80〜90、やや温かみ）",
        "sv": "Naturpapper (CIE 80–90, lätt varm)",
        "da": "Naturpapir (CIE 80–90, let varm)",
        "nl": "Naturelpapier (CIE 80–90, licht warm)",
        "pl": "Papier naturalny (CIE 80–90, lekko ciepły)",
