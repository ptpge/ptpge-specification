    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/quality-assurance",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "category",
      "label": {
        "en": "Quality Assurance",
        "es": "Aseguramiento de Calidad",
        "zh-Hans": "质量保证",
        "nb": "Kvalitetssikring",
        "de": "Qualitätssicherung",
        "ja": "品質保証",
        "sv": "Kvalitetssäkring",
        "da": "Kvalitetssikring",
        "nl": "Kwaliteitsborging",
        "pl": "Zapewnienie jakości",
        "pt": "Garantia de qualidade",
        "hi": "गुणवत्ता आश्वासन"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "management",
      "broader": "https://ptpge.org/v1/printing/management",
      "narrower": [
        "https://ptpge.org/v1/printing/management/quality-assurance/color-calibration",
        "https://ptpge.org/v1/printing/management/quality-assurance/color-management",
        "https://ptpge.org/v1/printing/management/quality-assurance/preflight-file-check",
        "https://ptpge.org/v1/printing/management/quality-assurance/proofing"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:54:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Processes and tools that verify a print job meets specifications and is suitable for production — applied before printing (preflight, proofing) and during/after (color management, calibration).",
        "nb": "Prosesser og verktøy som verifiserer at en trykkjobb oppfyller spesifikasjoner og er egnet for produksjon — anvendt før trykking (preflight, proofing) og under/etter (fargestyring, kalibrering).",
        "de": "Prozesse und Werkzeuge, die sicherstellen, dass ein Druckauftrag den Spezifikationen entspricht und produktionstauglich ist — eingesetzt vor dem Druck (Preflight, Proofing) und während/nach dem Druck (Farbmanagement, Kalibrierung).",
        "ja": "印刷ジョブが仕様を満たし生産に適していることを検証する工程とツール — 印刷前（プリフライト、校正）と印刷中・後（カラーマネジメント、キャリブレーション）に適用される。",
        "es": "Procesos y herramientas que verifican que un trabajo de impresión cumple con las especificaciones y es apto para producción — aplicados antes de imprimir (preflight, pruebas) y durante o después (gestión de color, calibración).",
        "zh-Hans": "验证印刷作业符合规格并适合生产的流程和工具——在印刷前应用（飞检、校样）以及在印刷期间和之后应用（色彩管理、校准）。",
        "sv": "Processer och verktyg som verifierar att ett tryckjobb uppfyller specifikationerna och är produktionsdugligt — tillämpade före tryck (preflight, provtryck) samt under/efter (färghantering, kalibrering).",
        "da": "Processer og værktøjer, der verificerer at en trykopgave opfylder specifikationerne og er produktionsklar — anvendt før tryk (preflight, prøvetryk) og under/efter (farvestyring, kalibrering).",
        "nl": "Processen en tools die verifiëren dat een drukopdracht aan de specificaties voldoet en productieklaar is — toegepast vóór het drukken (preflight, proeven) en tijdens/erna (kleurbeheer, kalibratie).",
        "pl": "Procesy i narzędzia weryfikujące, czy zlecenie drukarskie spełnia specyfikację i nadaje się do produkcji — stosowane przed drukiem (preflight, proofing) oraz w trakcie/po nim (zarządzanie barwą, kalibracja).",
        "pt": "Processos e ferramentas que verificam se um trabalho de impressão atende às especificações e é adequado para produção — aplicados antes da impressão (preflight, provas) e durante/depois (gerenciamento de cor, calibração).",
        "hi": "प्रक्रियाएँ और औज़ार जो सत्यापित करते हैं कि प्रिंट जॉब विनिर्देशों को पूरा करता है और उत्पादन के लिए उपयुक्त है — मुद्रण से पहले (प्रीफ़्लाइट, प्रूफ़िंग) और दौरान/बाद (रंग प्रबंधन, अंशांकन) लागू।"
      },
      "scopeNote": {
        "en": "Includes preflight file checking (Enfocus PitStop, Callas PDF Toolbox, Esko Automation Engine), proofing (prepress soft proofs, hard proofs, post-press proofreading), color management (ICC profiles, calibration), and color matching systems. Each step catches errors at successively later stages — preflight finds file problems before plates are made; proofing catches color/layout issues before printing; calibration ensures the press matches the specification.",
        "nb": "Inkluderer preflight filsjekk (Enfocus PitStop, Callas PDF Toolbox, Esko Automation Engine), proofing (prepress soft proofs, hard proofs, post-press korrekturlesing), fargestyring (ICC-profiler, kalibrering) og fargematchingssystemer. Hvert trinn fanger feil på stadig senere stadier — preflight finner filproblemer før plater lages; proofing fanger farge/layout-problemer før trykking; kalibrering sikrer at pressen matcher spesifikasjonen.",
        "de": "Umfasst Preflight-Dateiprüfung (Enfocus PitStop, Callas PDF Toolbox, Esko Automation Engine), Proofing (Soft Proofs in der Druckvorstufe, Hard Proofs, Korrekturlesen nach Druck), Farbmanagement (ICC-Profile, Kalibrierung) und Farbabgleichssysteme. Jeder Schritt fängt Fehler in einer späteren Phase ab — Preflight findet Dateiprobleme vor der Plattenherstellung; Proofing fängt Farb- und Layoutfehler vor dem Druck ab; Kalibrierung stellt sicher, dass die Druckmaschine der Spezifikation entspricht.",
        "ja": "プリフライト・ファイルチェック（Enfocus PitStop、Callas PDF Toolbox、Esko Automation Engine）、校正（製版ソフトプルーフ、ハードプルーフ、刷り上がり校正）、カラーマネジメント（ICCプロファイル、キャリブレーション）、カラーマッチングシステムを含む。各工程はそれぞれ後の段階で発生するエラーを捕捉する — プリフライトは刷版作成前にファイルの問題を発見し、校正は印刷前に色やレイアウトの問題を捕捉し、キャリブレーションは印刷機が仕様に一致することを保証する。",
        "es": "Incluye verificación preflight de archivos (Enfocus PitStop, Callas PDF Toolbox, Esko Automation Engine), pruebas (pruebas blandas pre-prensa, pruebas duras, corrección post-prensa), gestión de color (perfiles ICC, calibración) y control de impresión.",
        "zh-Hans": "包括飞检文件检查（Enfocus PitStop、Callas PDF Toolbox、EskoAutomation Engine）、校样（印前软校样、硬校样、印后校对）、色彩管理（ICC配置文件、校准）和印刷控制。",
        "pt": "Inclui verificação de arquivos em preflight (Enfocus PitStop, Callas PDF Toolbox, Esko Automation Engine), provas (provas de tela de pré-impressão, provas físicas, revisão pós-impressão), gerenciamento de cor (perfis ICC, calibração) e sistemas de correspondência de cor. Cada etapa captura erros em estágios sucessivamente posteriores — o preflight encontra problemas de arquivo antes das chapas; as provas capturam problemas de cor/layout antes da impressão; a calibração garante que a máquina corresponda à especificação.",
        "hi": "प्रीफ़्लाइट फ़ाइल जाँच (Enfocus PitStop, Callas PDF Toolbox, Esko Automation Engine), प्रूफ़िंग (प्रीप्रेस सॉफ़्ट प्रूफ़, हार्ड प्रूफ़, पोस्ट-प्रेस प्रूफ़रीडिंग), रंग प्रबंधन (ICC प्रोफ़ाइल, अंशांकन) और रंग मिलान प्रणालियाँ शामिल। हर चरण क्रमशः बाद के स्तर पर त्रुटियाँ पकड़ता है — प्रीफ़्लाइट प्लेट बनने से पहले फ़ाइल समस्याएँ; प्रूफ़िंग मुद्रण से पहले रंग/लेआउट समस्याएँ; अंशांकन सुनिश्चित करता है कि प्रेस विनिर्देश से मेल खाए।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "notation": "P:MG-QAS"
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/quality-assurance/color-calibration",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Color Calibration",
        "es": "Calibración de Color",
        "zh-Hans": "色彩校准",
        "nb": "Farge-kalibrering",
        "de": "Farbkalibrierung",
        "ja": "カラーキャリブレーション",
        "sv": "Färgkalibrering",
        "da": "Farvekalibrering",
        "nl": "Kleurkalibratie",
        "pl": "Kalibracja barw",
        "pt": "Calibração de cor",
        "hi": "रंग अंशांकन"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "management",
      "notation": "P:MG§COLOR-CALIBRATION",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/management/quality-assurance",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:54:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Process of measuring and adjusting a printing device or display so its actual color output matches a specified target — using spectrophotometers to read printed patches and software to build calibration curves.",
        "nb": "Prosess for å måle og justere en trykkenhet eller skjerm slik at faktisk fargeutgang matcher et spesifisert mål — bruker spektrofotometre til å avlese trykte patcher og programvare til å bygge kalibreringskurver.",
        "de": "Verfahren zur Messung und Anpassung eines Druckgeräts oder Displays, sodass dessen tatsächliche Farbausgabe mit einem festgelegten Sollwert übereinstimmt — mithilfe von Spektralfotometern werden Druckmuster gemessen und Software erzeugt Kalibrierkurven.",
        "ja": "印刷機またはディスプレイの実際の色出力が指定されたターゲットに一致するように測定および調整する工程 — 分光測色計で印刷パッチを読み取り、ソフトウェアでキャリブレーションカーブを作成する。",
        "es": "Proceso de ajustar dispositivos (monitores, escáneres, prensas) para que reproduzcan colores de forma consistente y conforme a un objetivo establecido.",
        "zh-Hans": "调整设备（显示器、扫描仪、印刷机）以一致且符合既定目标地再现颜色的过程。",
        "sv": "Processen att mäta och justera en tryckenhet eller bildskärm så att dess faktiska färgutmatning matchar ett angivet mål — med spektrofotometrar som läser tryckta fält och programvara som bygger kalibreringskurvor.",
        "da": "Proces til at måle og justere en trykenhed eller skærm, så dens faktiske farveoutput matcher et specificeret mål — med spektrofotometre til at aflæse trykte felter og software til at bygge korrektionskurver.",
        "nl": "Proces van meten en bijstellen van een drukapparaat of scherm zodat de werkelijke kleuruitvoer overeenkomt met een gespecificeerd doel — met spectrofotometers die gedrukte velden meten en software die correctiecurven opbouwt.",
        "pl": "Proces pomiaru i regulacji urządzenia drukującego lub wyświetlacza tak, aby jego rzeczywisty wynik barwny odpowiadał zadanemu celowi — z użyciem spektrofotometrów do odczytu zadrukowanych pól i oprogramowania do budowy krzywych kalibracyjnych.",
        "pt": "Processo de medir e ajustar um dispositivo de impressão ou monitor para que sua saída real de cor corresponda a um alvo especificado — usando espectrofotômetros para ler amostras impressas e software para construir curvas de calibração.",
        "hi": "मुद्रण उपकरण या डिस्प्ले को मापने और समायोजित करने की प्रक्रिया ताकि उसका वास्तविक रंग आउटपुट निर्दिष्ट लक्ष्य से मेल खाए — छपे पैच पढ़ने के लिए स्पेक्ट्रोफ़ोटोमीटर और अंशांकन वक्र बनाने के लिए सॉफ़्टवेयर।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "Colour Calibration"
        ],
        "pl": [
          "kalibracja kolorów"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/quality-assurance/color-management",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "sub-category",
      "label": {
        "en": "Color Management",
        "es": "Gestión de Color",
        "zh-Hans": "色彩管理",
        "nb": "Fargestyring",
        "de": "Farbmanagement",
        "ja": "カラーマネジメント",
        "sv": "Färghantering",
        "da": "Farvestyring",
        "nl": "Kleurbeheer",
        "pl": "Zarządzanie barwą",
        "pt": "Gerenciamento de cor",
        "hi": "रंग प्रबंधन"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "management",
      "broader": "https://ptpge.org/v1/printing/management/quality-assurance",
      "narrower": [
        "https://ptpge.org/v1/printing/management/quality-assurance/color-management/adobe-color-management"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:54:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Systems and tools that ensure consistent color reproduction across devices, substrates, and printing technologies — using ICC color profiles to translate color values between different gamuts.",
        "nb": "Systemer og verktøy som sikrer konsistent fargegjengivelse på tvers av enheter, substrater og trykketeknologier — bruker ICC-fargeprofiler for å oversette fargeverdier mellom forskjellige gamut.",
        "de": "Systeme und Werkzeuge, die eine konsistente Farbreproduktion über Geräte, Bedruckstoffe und Drucktechnologien hinweg sicherstellen — mithilfe von ICC-Farbprofilen, die Farbwerte zwischen verschiedenen Farbräumen übersetzen.",
        "ja": "デバイス、基材、印刷技術を超えて一貫した色再現を保証するシステムとツール — 異なる色域間で色値を変換するためにICCカラープロファイルを使用する。",
        "es": "Sistemas y herramientas que aseguran la reproducción consistente del color entre dispositivos, sustratos y tecnologías de impresión — utilizando perfiles ICC para traducir valores de color entre diferentes gamuts.",
        "zh-Hans": "确保跨设备、承印物和印刷工艺一致再现色彩的系统和工具——使用ICC色彩配置文件在不同色域之间转换色值。",
        "sv": "System och verktyg som säkerställer konsekvent färgåtergivning över enheter, substrat och trycktekniker — med ICC-färgprofiler som översätter färgvärden mellan olika färgrymder.",
        "da": "Systemer og værktøjer, der sikrer konsekvent farvegengivelse på tværs af enheder, substrater og trykteknologier — med ICC-farveprofiler til at oversætte farveværdier mellem forskellige farveomfang.",
        "nl": "Systemen en tools die consistente kleurweergave waarborgen over apparaten, substraten en druktechnologieën heen — met ICC-kleurprofielen om kleurwaarden tussen verschillende gamma's te vertalen.",
        "pl": "Systemy i narzędzia zapewniające spójną reprodukcję barw między urządzeniami, podłożami i technologiami druku — z użyciem profili ICC do przeliczania wartości barw między różnymi gamutami.",
        "pt": "Sistemas e ferramentas que garantem reprodução consistente de cor entre dispositivos, substratos e tecnologias de impressão — usando perfis de cor ICC para traduzir valores de cor entre gamuts diferentes.",
        "hi": "प्रणालियाँ और औज़ार जो डिवाइसों, सब्सट्रेट और मुद्रण तकनीकों में एक-समान रंग पुनरुत्पादन सुनिश्चित करते हैं — विभिन्न गैमट के बीच रंग मान अनुवाद करने के लिए ICC रंग प्रोफ़ाइल का उपयोग।"
      },
      "scopeNote": {
        "en": "Centered on ICC profile management (creation, embedding, conversion) and integrated color systems (Adobe Color Management). Color matching systems like Pantone are tracked under Standards › Color Systems; physical color calibration is a sibling element here.",
        "nb": "Sentrert rundt ICC-profilhåndtering (opprettelse, innebygging, konvertering) og integrerte fargesystemer (Adobe Color Management). Fargematchingssystemer som Pantone spores under Standards › Color Systems; fysisk fargekalibrering er et søsken-element her.",
        "de": "Im Mittelpunkt steht das Management von ICC-Profilen (Erstellung, Einbettung, Konvertierung) sowie integrierte Farbsysteme (Adobe Color Management). Farbabgleichssysteme wie Pantone werden unter Standards › Color Systems geführt; die physische Farbkalibrierung ist hier ein verwandtes Element.",
        "ja": "ICCプロファイル管理（作成、埋め込み、変換）と統合カラーシステム（Adobe Color Management）を中心とする。Pantoneなどのカラーマッチングシステムは、Standards › Color Systemsに分類される。物理的な色キャリブレーションは、ここでの兄弟要素である。",
        "es": "Centrado en la gestión de perfiles ICC (creación, incrustación, conversión) y sistemas integrados de color (Adobe Color Management). Sistemas de igualación de color como Pantone se rastrean en Normas › Sistemas de Color › Sistemas de Igualación.",
        "zh-Hans": "围绕ICC配置文件管理（创建、嵌入、转换）和集成色彩系统（Adobe色彩管理）展开。Pantone等色彩匹配系统在标准 › 色彩系统 › 色彩匹配系统中跟踪。",
        "pt": "Centrado no gerenciamento de perfis ICC (criação, incorporação, conversão) e em sistemas de cor integrados (Adobe Color Management). Sistemas de correspondência de cor como Pantone ficam em Normas › Sistemas de cor; a calibração física de cor é um elemento irmão aqui.",
        "hi": "ICC प्रोफ़ाइल प्रबंधन (निर्माण, एम्बेडिंग, रूपांतरण) और एकीकृत रंग प्रणालियों (Adobe Color Management) पर केंद्रित। Pantone जैसी रंग मिलान प्रणालियाँ मानक › रंग प्रणालियों में; भौतिक रंग अंशांकन यहाँ सहोदर तत्व।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "notation": "P:MG-QAS-CMNG",
      "altLabels": {
        "en": [
          "Colour Management"
        ],
        "pl": [
          "zarządzanie kolorem"
        ],
        "pt": [
          "Gestão de cor"
        ]
      },
      "related": [
        "https://ptpge.org/v1/printing/standards/color-systems/color-profiles/icc-profiles"
      ],
      "semanticSource": [
