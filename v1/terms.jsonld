      "status": "proposed",
      "level": "element",
      "notation": "P:CF§DISPLAY-SYSTEM",
      "elementType": "value",
      "label": {
        "en": "Display System Setup",
        "nb": "Display-system-oppsett",
        "de": "Display-System-Setup",
        "ja": "ディスプレイシステム構成",
        "es": "Configuración de sistema de display",
        "zh-Hans": "展示系统结构",
        "nl": "Displaysysteem-opzet",
        "sv": "Displaysystem",
        "da": "Displaysystem",
        "pl": "Konfiguracja systemu ekspozycyjnego",
        "pt": "Montagem em sistema de display",
        "hi": "डिस्प्ले सिस्टम सेटअप"
      },
      "altLabels": {
        "en": [
          "Display kit setup",
          "Print + hardware setup",
          "Roll-up/stand setup"
        ],
        "nb": [
          "Display-kit-oppsett",
          "Trykk + maskinvare-oppsett",
          "Rollup/stand-oppsett"
