      "label": {
        "en": "Letter (8.5 x 11 in)",
        "es": "Letter (216 × 279 mm / 8.5 × 11 in)",
        "zh-Hans": "Letter (216 × 279 mm / 8.5 × 11 in)",
        "nb": "Letter (8.5 x 11 in)",
        "de": "Letter (8.5 x 11 in)",
        "ja": "Letter (8.5 x 11 in)",
