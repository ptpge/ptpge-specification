      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "standards",
      "notation": "P:ST§RGB",
      "elementType": "reference",
      "broader": "https://ptpge.org/v1/printing/standards/color-systems/color-spaces",
      "created": "2026-05-18T12:24:03Z",
