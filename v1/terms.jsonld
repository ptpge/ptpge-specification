      "label": {
        "en": "Holographic Foil",
        "nb": "Holografisk folie",
        "de": "Holografische Folie",
        "ja": "ホログラム箔",
        "es": "Lámina holográfica",
        "zh-Hans": "全息箔",
        "nl": "Holografische folie",
        "sv": "Holografisk folie",
        "da": "Holografisk folie",
        "pl": "Folia holograficzna",
        "pt": "Foil holográfico",
        "hi": "होलोग्राफ़िक फ़ॉइल"
      },
      "altLabels": {
        "en": [
          "Hologram Foil"
