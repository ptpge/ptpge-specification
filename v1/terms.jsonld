    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/sheet-materials",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "category",
      "label": {
        "en": "Sheet Materials",
        "es": "Materiales en Hoja",
        "zh-Hans": "纸张材料",
        "nb": "Ark-materialer",
        "de": "Bogenmaterialien",
        "ja": "シート基材",
        "sv": "Arkmaterial",
        "da": "Arkmaterialer",
        "nl": "Velmaterialen",
        "pl": "Materiały arkuszowe",
        "pt": "Materiais em folha",
        "hi": "शीट सामग्री"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "broader": "https://ptpge.org/v1/printing/substrates",
      "narrower": [
        "https://ptpge.org/v1/printing/substrates/sheet-materials/paper",
        "https://ptpge.org/v1/printing/substrates/sheet-materials/corrugated",
        "https://ptpge.org/v1/printing/substrates/sheet-materials/cardstock",
        "https://ptpge.org/v1/printing/substrates/sheet-materials/magnetic-foil"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:24:41Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Pre-cut flat substrates supplied in sheet stacks — the traditional format for offset, digital, and most commercial printing.",
        "nb": "Forhåndsskårne flate substrater levert i arkstabler — det tradisjonelle formatet for offset, digital og det meste av kommersiell trykk.",
        "de": "Vorgeschnittene flache Bedruckstoffe in Bogenstapeln — das klassische Format für Offset-, Digital- und den meisten gewerblichen Druck.",
        "ja": "シートとして積み重ねて供給される事前裁断済みの平面基材 — オフセット、デジタル、大半の商業印刷の伝統的な形態。",
        "es": "Sustratos planos pre-cortados suministrados en pilas de hojas — el formato tradicional para offset, digital y la mayoría de la impresión comercial.",
        "zh-Hans": "以堆叠形式供应的预裁切平面承印物——胶印、数码印刷及大多数商业印刷的传统格式。",
        "sv": "Förskurna plana substrat levererade i arkbuntar — det traditionella formatet för offset, digitaltryck och det mesta av civiltrycket.",
        "da": "Forudskårne flade substrater leveret i arkstakke — det traditionelle format for offset, digital og det meste kommercielle tryk.",
        "nl": "Voorgesneden vlakke substraten geleverd in velstapels — het traditionele formaat voor offset, digitaal en het meeste commerciële drukwerk.",
        "pl": "Pocięte płaskie podłoża dostarczane w stosach arkuszy — tradycyjny format dla offsetu, druku cyfrowego i większości druku komercyjnego.",
        "pt": "Substratos planos pré-cortados fornecidos em pilhas de folhas — o formato tradicional para offset, digital e a maior parte da impressão comercial.",
        "hi": "शीट के ढेर में दिए जाने वाले पहले से कटे सपाट सब्सट्रेट — ऑफसेट, डिजिटल और अधिकांश व्यावसायिक छपाई का पारंपरिक रूप।"
      },
      "scopeNote": {
        "en": "Includes paper (the dominant substrate for commercial printing), cardstock for heavier work, and corrugated sheets for packaging. Paper is further subdivided by suppliers, weights, surfaces, and color shades.",
        "nb": "Inkluderer papir (det dominerende substratet for kommersiell trykk), kartong for tyngre arbeid og bølgepapp-ark for emballasje. Papir er videre inndelt etter leverandører, vekt, overflate og fargenyanser.",
        "de": "Umfasst Papier (der dominierende Bedruckstoff im gewerblichen Druck), Karton für schwerere Arbeiten und Wellpappebogen für Verpackungen. Papier wird weiter nach Lieferanten, Grammaturen, Oberflächen und Farbtönen unterteilt.",
        "ja": "紙（商業印刷の主要基材）、より重い用途のためのカード紙、パッケージ用の段ボールシートを含む。紙はさらにサプライヤー、坪量、表面、色合いで細分化される。",
        "es": "Incluye papel (el sustrato dominante para impresión comercial), cartulina para trabajos más pesados y hojas onduladas para embalaje. El papel se subdivide además por proveedores, gramajes, superficies y colores.",
        "zh-Hans": "包括纸（商业印刷的主导承印物）、用于较重作品的卡纸和用于包装的瓦楞张。纸又按供应商、克重、表面和颜色进一步细分。",
        "pt": "Inclui papel (o substrato dominante na impressão comercial), cartão para trabalhos mais pesados e folhas de ondulado para embalagem. O papel subdivide-se ainda por fornecedores, gramaturas, superfícies e tonalidades.",
        "hi": "काग़ज़ (व्यावसायिक छपाई का प्रमुख सब्सट्रेट), भारी काम के लिए कार्डस्टॉक और पैकेजिंग के लिए कोरुगेटेड शीट शामिल। काग़ज़ आगे आपूर्तिकर्ता, वज़न, सतह और रंगत के अनुसार बँटता है।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "notation": "P:SB-SHT",
      "altLabels": {
        "pl": [
          "arkusze"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/sheet-materials/cardstock",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Cardstock",
        "es": "Cartulina",
        "zh-Hans": "卡纸",
        "nb": "Kartong",
        "de": "Kartonpapier",
        "ja": "カードストック",
        "sv": "Kartong (cardstock)",
        "da": "Karton (cardstock)",
        "nl": "Karton (cardstock)",
        "pl": "Karton",
        "pt": "Cartão (cardstock)",
        "hi": "कार्डस्टॉक"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "notation": "P:SB§CARDSTOCK",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/substrates/sheet-materials",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:24:41Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Heavyweight, stiff paper between roughly 200 and 350 gsm, used for products that need rigidity but not the thickness of board: business cards, postcards, book covers, packaging inserts, invitations. The boundary between paper and cardstock is conventional rather than physical, but typically begins around 200 gsm.",
        "nb": "Tungt, stivt papir mellom omtrent 200 og 350 gsm, brukt for produkter som trenger stivhet uten tykkelsen til kartong: visittkort, postkort, bokomslag, pakke­innlegg, invitasjoner. Grensen mellom papir og kartong er konvensjonell snarere enn fysisk, men begynner typisk rundt 200 gsm.",
        "de": "Schweres, steifes Papier zwischen etwa 200 und 350 g/m², eingesetzt für Produkte, die Steifigkeit, aber nicht die Dicke einer Platte benötigen: Visitenkarten, Postkarten, Buchcover, Verpackungseinleger, Einladungen. Die Grenze zwischen Papier und Karton ist konventionell und nicht physikalisch festgelegt, beginnt aber typischerweise bei rund 200 g/m².",
        "ja": "おおよそ200〜350gsmの厚手で硬い紙。剛性が必要だがボードほどの厚みは不要な製品（名刺、ハガキ、書籍カバー、パッケージインサート、招待状）に使用される。紙とカード紙の境界は物理的というより慣例的だが、通常200gsm前後から始まる。",
        "es": "Papel grueso y rígido (típicamente 200+ gsm) — utilizado para tarjetas, portadas, embalaje ligero y postales.",
        "zh-Hans": "厚而硬的纸（通常200+克）—— 用于卡片、封面、轻量包装和明信片。",
        "sv": "Tungt, styvt papper mellan ungefär 200 och 350 g/m², används för produkter som behöver styvhet men inte skivmaterialets tjocklek: visitkort, vykort, bokomslag, förpackningsinlagor, inbjudningar. Gränsen mellan papper och kartong är konventionell snarare än fysisk, men börjar typiskt runt 200 g/m².",
        "da": "Kraftigt, stift papir mellem cirka 200 og 350 g/m², brugt til produkter der kræver stivhed men ikke pladetykkelse: visitkort, postkort, bogomslag, emballageindstik, invitationer. Grænsen mellem papir og karton er glidende.",
        "nl": "Zwaar, stijf papier tussen circa 200 en 350 g/m², gebruikt voor producten die stijfheid vragen maar geen plaatdikte: visitekaartjes, kaarten, boekomslagen, verpakkingsinlays, uitnodigingen. De grens tussen papier en karton is vloeiend.",
        "pl": "Ciężki, sztywny papier o gramaturze około 200–350 g/m², używany do produktów wymagających sztywności, lecz nie grubości tektury: wizytówek, pocztówek, okładek książek, wkładek opakowaniowych, zaproszeń. Granica między papierem a kartonem jest umowna, nie fizyczna, lecz zwykle zaczyna się około 200 g/m².",
        "pt": "Papel pesado e rígido, entre cerca de 200 e 350 g/m², usado em produtos que precisam de rigidez mas não da espessura de uma chapa: cartões de visita, postais, capas de livro, encartes de embalagem, convites. A fronteira entre papel e cartão é convencional, não física, mas normalmente começa em torno de 200 g/m².",
        "hi": "लगभग 200 से 350 GSM का भारी, कड़ा काग़ज़, ऐसे उत्पादों के लिए जिन्हें कड़ापन चाहिए पर बोर्ड जितनी मोटाई नहीं: विज़िटिंग कार्ड, पोस्टकार्ड, किताब के कवर, पैकेजिंग इन्सर्ट, निमंत्रण। काग़ज़ और कार्डस्टॉक की सीमा भौतिक नहीं, परंपरागत है, पर आमतौर पर 200 GSM के आसपास शुरू होती है।"
      },
      "altLabels": {
        "en": [
          "Card stock",
          "Heavy card"
        ],
        "nb": [
          "Kartong"
        ],
        "pl": [
          "karton ozdobny",
          "papier kartonowy",
          "brystol"
        ],
        "pt": [
          "cartão",
          "cartolina",
          "papel-cartão",
          "cartão pesado",
          "supremo"
        ],
        "hi": [
          "कार्ड स्टॉक",
          "मोटा काग़ज़",
          "कार्ड पेपर",
          "बोर्ड पेपर",
          "आर्ट कार्ड"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/sheet-materials/corrugated",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Corrugated",
        "nb": "Bølgepapp",
        "de": "Wellpappe",
        "ja": "段ボール",
        "es": "Cartón ondulado",
        "zh-Hans": "瓦楞纸板",
        "sv": "Wellpapp",
        "da": "Bølgepap",
        "nl": "Golfkarton",
        "pl": "Tektura falista",
        "pt": "Papelão ondulado",
        "hi": "कोरुगेटेड"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "notation": "P:SB§CORRUGATED-SHEET",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/substrates/sheet-materials",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:24:41Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "A multi-layer board made by gluing a fluted (corrugated) inner sheet between two flat liners, giving it strength and cushioning at low weight. The dominant substrate for shipping cartons and protective packaging. Available in single-wall, double-wall, and triple-wall constructions for increasing strength.",
        "nb": "En flerlags kartong laget ved å lime et bølget (korrugert) midtlag mellom to flate ytterark, som gir styrke og demping ved lav vekt. Det dominerende substratet for forsendelses­kartonger og beskyttende emballasje. Finnes i single-wall, double-wall og triple-wall for økende styrke.",
        "de": "Mehrlagige Pappe, hergestellt durch Verkleben einer gewellten (geriffelten) Innenlage zwischen zwei flachen Decklagen, die ihr bei geringem Gewicht Festigkeit und Polsterung verleiht. Der dominierende Bedruckstoff für Versandkartons und Schutzverpackungen. Erhältlich in einwelliger, doppelwelliger und dreiwelliger Ausführung mit zunehmender Festigkeit.",
        "ja": "波状（コルゲート）の中芯を2枚の平らなライナーの間に貼り合わせた多層板で、軽量ながら強度と緩衝性を備える。輸送用カートンと保護梱包の主要基材。強度を高めるシングルウォール、ダブルウォール、トリプルウォールの構成がある。",
        "es": "Cartón ondulado en hoja para producción de packaging cortado y trazado — cajas, expositores y embalaje protectivo.",
        "zh-Hans": "用于裁切和压痕包装生产的瓦楞纸板 —— 箱子、展示架和保护性包装。",
        "sv": "En flerskiktsskiva tillverkad genom att ett vågformat (korrugerat) mittskikt limmas mellan två plana ytskikt, vilket ger styrka och stötdämpning vid låg vikt. Det dominerande substratet för fraktkartonger och skyddsemballage. Finns i en-, två- och trevåggskonstruktioner för ökande styrka.",
        "da": "En flerlagsplade lavet ved at lime et bølget mellemark mellem to flade linere, hvilket giver styrke og stødabsorbering ved lav vægt. Det dominerende substrat til forsendelsesæsker og beskyttende emballage. Fås i single-, double- og triplewall.",
        "nl": "Een meerlaagse plaat, gemaakt door een gegolfd binnenvel tussen twee vlakke liners te lijmen — sterk en schokdempend bij laag gewicht. Het dominante substraat voor verzenddozen en beschermende verpakkingen. Verkrijgbaar in single-, double- en triplewall.",
        "pl": "Wielowarstwowa tektura powstała przez sklejenie pofalowanego arkusza wewnętrznego między dwiema płaskimi okleinami, co daje wytrzymałość i amortyzację przy niskiej masie. Dominujące podłoże pudeł wysyłkowych i opakowań ochronnych. Dostępna w konstrukcjach jedno-, dwu- i trójwarstwowych o rosnącej wytrzymałości.",
        "pt": "Chapa multicamada feita colando uma folha interna canelada (ondulada) entre dois liners planos, que lhe dá resistência e amortecimento com pouco peso. O substrato dominante para caixas de transporte e embalagens de proteção. Disponível em parede simples, dupla e tripla para resistência crescente.",
        "hi": "दो सपाट लाइनरों के बीच एक फ़्लूटेड (लहरदार) भीतरी शीट चिपकाकर बना बहु-परत बोर्ड, जो कम वज़न में मज़बूती और गद्दी देता है। शिपिंग कार्टन और सुरक्षात्मक पैकेजिंग का प्रमुख सब्सट्रेट। बढ़ती मज़बूती के लिए सिंगल-वॉल, डबल-वॉल और ट्रिपल-वॉल में उपलब्ध।"
      },
      "exactMatch": [
        "http://www.wikidata.org/entity/Q1080066"
      ],
      "altLabels": {
        "en": [
          "Corrugated sheet",
          "Corrugated board",
          "Fluted sheet"
        ],
        "pl": [
          "arkusz tektury falistej",
          "fala",
          "tektura pofalowana"
        ],
        "pt": [
          "ondulado",
          "papelão ondulado",
          "chapa ondulada",
          "corrugado",
          "papelão canelado"
        ],
        "hi": [
          "कोरुगेटेड शीट",
          "कोरुगेटेड बोर्ड",
          "लहरदार गत्ता",
          "फ़्लूटेड शीट",
          "कोरुगेटेड बॉक्स बोर्ड"
        ]
      },
      "creator": "https://ptpge.org/contributors/ptpge",
