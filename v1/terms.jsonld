    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/technologies/printing-technologies/analog/lithography",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Lithography",
        "es": "Litografía",
        "zh-Hans": "平版印刷",
        "nb": "Litografi",
        "de": "Lithografie",
        "ja": "リトグラフ",
        "sv": "Litografi",
        "da": "Litografi",
        "nl": "Lithografie",
        "pl": "Litografia",
        "pt": "Litografia",
        "hi": "लिथोग्राफ़ी"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "technologies",
      "notation": "P:TC§LITHOGRAPHY",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/technologies/printing-technologies/analog",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:42:30Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Planographic printing technology based on the principle that oil and water don't mix — the image area attracts ink while the non-image area attracts water, both lying on the same plane on a flat plate. Original invention from 1796; offset lithography is its modern industrial form.",
        "nb": "Planografisk trykketeknologi basert på prinsippet at olje og vann ikke blandes — bildeområdet tiltrekker blekk mens ikke-bildeområdet tiltrekker vann, begge på samme nivå på en flat plate. Opprinnelig oppfinnelse fra 1796; offsetlitografi er den moderne industrielle formen.",
        "de": "Flachdrucktechnologie, basierend auf dem Prinzip, dass sich Öl und Wasser nicht mischen — der Bildbereich nimmt Farbe an, während der bildfreie Bereich Wasser anzieht; beide liegen in derselben Ebene auf einer flachen Platte. Ursprüngliche Erfindung von 1796; der Offsetdruck ist die moderne industrielle Form.",
        "ja": "油と水が混ざらない原理に基づく平版印刷技術 — 画像領域がインキを引きつけ、非画像領域が水を引きつけ、両者は平版の同一平面上に存在する。1796年の元来の発明。オフセット平版印刷はその近代的工業形態。",
        "es": "Tecnología planográfica basada en la repulsión entre agua y tinta — base del offset moderno. La superficie de impresión es plana; las zonas de imagen aceptan tinta y rechazan agua, las zonas sin imagen al revés.",
        "zh-Hans": "基于水和油墨相互排斥的平版工艺 —— 现代胶印的基础。印刷表面平坦；图像区域接受油墨并排斥水，非图像区域反之。",
        "sv": "Plantrycksteknik baserad på principen att olja och vatten inte blandas — bildytan drar till sig bläck medan icke-bildytan drar till sig vatten, båda i samma plan på en plan plåt. Ursprunglig uppfinning från 1796; offsetlitografi är dess moderna industriella form.",
        "da": "Plantryksteknik baseret på princippet om, at olie og vand ikke blandes — billedfladen tiltrækker farve, mens ikke-billedfladen tiltrækker vand, begge i samme plan på en plan plade. Oprindelig opfindelse fra 1796; offsetlitografi er dens moderne industrielle form.",
        "nl": "Vlakdruktechnologie gebaseerd op het principe dat olie en water niet mengen — het beeldvlak trekt inkt aan terwijl het niet-beeldvlak water aantrekt, beide in hetzelfde vlak op een platte plaat. Oorspronkelijke uitvinding uit 1796; offsetlithografie is de moderne industriële vorm.",
        "pl": "Technologia druku płaskiego oparta na zasadzie, że olej i woda się nie mieszają — obszar obrazu przyjmuje farbę, a obszar bez obrazu wodę, oba leżąc na tej samej płaszczyźnie płaskiej formy. Pierwotny wynalazek z 1796 r.; offset jest jej nowoczesną formą przemysłową.",
        "pt": "Tecnologia de impressão planográfica baseada no princípio de que óleo e água não se misturam — a área de imagem atrai tinta enquanto a área sem imagem atrai água, ambas no mesmo plano de uma chapa lisa. Invenção original de 1796; a litografia offset é sua forma industrial moderna.",
        "hi": "इस सिद्धांत पर आधारित प्लैनोग्राफ़िक मुद्रण तकनीक कि तेल और पानी नहीं मिलते — छवि क्षेत्र स्याही खींचता है जबकि गैर-छवि क्षेत्र पानी, दोनों एक समतल प्लेट पर एक ही तल में। 1796 का मूल आविष्कार; ऑफसेट लिथोग्राफ़ी इसका आधुनिक औद्योगिक रूप है।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "Litho",
          "Stone lithography"
        ],
        "nb": [
          "Litografi"
        ],
        "pl": [
          "lito",
          "litografia kamienna"
        ],
        "pt": [
          "Lito",
          "Litografia em pedra"
        ],
        "hi": [
          "लिथो",
          "पत्थर लिथोग्राफ़ी"
        ]
      },
