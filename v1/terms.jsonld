    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/features/embellishments/foil-stamping/gold",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Gold Foil",
        "nb": "Gullfolie",
        "de": "Goldfolie",
        "ja": "金箔",
        "es": "Lámina de oro",
        "zh-Hans": "金箔",
        "nl": "Goudfolie",
        "sv": "Guldfolie",
