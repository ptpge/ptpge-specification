        ],
        "pl": [
          "kolory papieru",
          "białość papieru"
        ],
        "pt": [
          "cor do papel",
          "tonalidade do papel"
        ],
        "hi": [
          "काग़ज़ का रंग",
          "पेपर शेड"
        ]
      },
