    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/workflow/versioning-storage",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Versioning & Storage",
        "es": "Versionado y Almacenamiento",
        "zh-Hans": "版本控制与存储",
        "nb": "Versjonering & lagring",
        "de": "Versionierung & Speicherung",
        "ja": "バージョン管理とストレージ",
        "sv": "Versionering & lagring",
        "da": "Versionering & lagring",
        "nl": "Versiebeheer & opslag",
        "pl": "Wersjonowanie i przechowywanie",
        "pt": "Versionamento e armazenamento",
        "hi": "संस्करण और भंडारण"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "management",
      "notation": "P:MG§VERSIONING-STORAGE",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/management/workflow",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:54:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Maintaining an auditable history of file versions and providing long-term storage of approved production files — for reprints, archival compliance, and rollback if errors are discovered after delivery.",
        "nb": "Vedlikeholde en revisjonssporbar historikk av filversjoner og gi langsiktig lagring av godkjente produksjonsfiler — for opptrykk, arkivkrav og tilbakerulling hvis feil oppdages etter levering.",
        "de": "Pflege einer überprüfbaren Versionshistorie von Dateien sowie Langzeitarchivierung freigegebener Produktionsdateien — für Nachdrucke, Archivierungs-Compliance und Rollback bei nachträglich entdeckten Fehlern.",
        "ja": "ファイルバージョンの監査可能な履歴を維持し、承認済みの生産用ファイルを長期保存する — 増刷、アーカイブ準拠、納品後にエラーが発見された場合のロールバックのため。",
        "es": "Control de versiones de archivos del trabajo — qué versión es la aprobada, qué cambios se han hecho y dónde se almacena el histórico.",
        "zh-Hans": "作业文件的版本控制 —— 哪个版本已批准、做了什么更改、历史在哪里存储。",
        "sv": "Upprätthållande av en spårbar historik över filversioner och långtidslagring av godkända produktionsfiler — för nytryck, arkivkrav och återställning om fel upptäcks efter leverans.",
        "da": "Vedligeholdelse af en sporbar historik over filversioner og langtidslagring af godkendte produktionsfiler — til genoptryk, arkivkrav og tilbagerulning, hvis der opdages fejl efter produktion.",
        "nl": "Het bijhouden van een controleerbare historie van bestandsversies en langdurige opslag van goedgekeurde productiebestanden — voor herdrukken, archiefverplichtingen en terugdraaien als na productie fouten worden ontdekt.",
        "pl": "Utrzymywanie audytowalnej historii wersji plików i długoterminowe przechowywanie zatwierdzonych plików produkcyjnych — do dodruków, zgodności archiwalnej i wycofania zmian, jeśli błędy zostaną wykryte po dostawie.",
        "pt": "Manutenção de um histórico auditável de versões de arquivo e armazenamento de longo prazo dos arquivos de produção aprovados — para reimpressões, conformidade de arquivamento e reversão caso erros sejam descobertos após a entrega.",
        "hi": "फ़ाइल संस्करणों का ऑडिट-योग्य इतिहास बनाए रखना और अनुमोदित उत्पादन फ़ाइलों का दीर्घकालिक भंडारण — पुनर्मुद्रण, संग्रहण अनुपालन और डिलीवरी के बाद त्रुटि मिलने पर रोलबैक के लिए।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "versioning",
          "file storage",
          "version control"
        ],
        "nb": [
          "versjonering",
          "fillagring"
        ],
        "pl": [
          "wersjonowanie",
          "przechowywanie plików",
          "kontrola wersji"
        ],
        "pt": [
          "versionamento",
          "armazenamento de arquivos",
          "controle de versão"
        ],
        "hi": [
          "संस्करण",
          "फ़ाइल भंडारण",
          "संस्करण नियंत्रण"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/standards",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "group",
      "label": {
        "en": "Standards",
        "es": "Normas",
        "zh-Hans": "标准",
        "nb": "Standarder",
        "de": "Normen",
        "ja": "規格",
        "sv": "Standarder",
        "da": "Standarder",
        "nl": "Standaarden",
        "pl": "Standardy",
        "pt": "Normas",
        "hi": "मानक"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "standards",
      "notation": "P:ST",
      "broader": "https://ptpge.org/v1/printing",
      "narrower": [
        "https://ptpge.org/v1/printing/standards/measurement-systems",
        "https://ptpge.org/v1/printing/standards/paper-size-standards",
        "https://ptpge.org/v1/printing/standards/graphic-file-formats",
        "https://ptpge.org/v1/printing/standards/color-systems",
        "https://ptpge.org/v1/printing/standards/certifications",
        "https://ptpge.org/v1/printing/standards/print-standards",
        "https://ptpge.org/v1/printing/standards/regulations"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:50:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Cross-cutting reference frameworks that all manufacturing activity points back to: measurement systems, paper size standards, graphic file formats, color systems, and the certifications by which printers, products, and processes are independently verified. Standards is one of two cross-cutting Groups (alongside Management); these apply across every manufacturing facet rather than being a distinct step in production.",
        "nb": "Kryssgående referanserammeverk som all produksjonsaktivitet refererer tilbake til: målesystemer, papirformat-standarder, grafiske filformater, fargesystemer og sertifiseringene som trykkerier, produkter og prosesser kan verifiseres mot av uavhengige parter. Standards er en av to kryssgående grupper (sammen med Management); disse gjelder på tvers av alle produksjonsfasetter, ikke som et eget steg i produksjonen.",
        "de": "Übergreifende Referenzrahmen, auf die sich jede Fertigungsaktivität bezieht: Maßsysteme, Papierformat-Normen, Grafikdateiformate, Farbsysteme sowie die Zertifizierungen, anhand derer Druckereien, Produkte und Prozesse unabhängig verifiziert werden. Standards ist eine von zwei übergreifenden Gruppen (neben Management); diese gelten über alle Fertigungsfacetten hinweg und stellen keinen eigenständigen Produktionsschritt dar.",
        "ja": "全ての製造活動が拠り所とする横断的な参照基盤：計測単位、用紙寸法規格、グラフィックファイル形式、カラーシステム、および印刷会社・製品・工程を第三者が検証する認証制度。Standardsは、Managementと並ぶ二つの横断グループの一つであり、製造の各側面に共通して適用されるものであり、生産過程における独立した工程ではない。",
        "es": "Marcos de referencia transversales a los que toda la actividad de producción remite: sistemas de medida, normas de tamaños de papel, formatos de archivo gráfico, sistemas de color, y las certificaciones por las que imprentas, productos y procesos son verificados de forma independiente. Normas es uno de los dos grupos transversales — junto con Gestión — que aplican a toda actividad de fabricación.",
        "zh-Hans": "所有生产活动所参照的横向参考框架：测量系统、纸张尺寸标准、图形文件格式、色彩系统，以及对印刷厂、产品和工艺进行独立认证的认证体系。标准是两个横向分组之一——与管理一起——适用于所有制造活动。",
        "sv": "Tvärgående referensramverk som all tillverkning pekar tillbaka till: måttsystem, pappersformatstandarder, grafiska filformat, färgsystem och de certifieringar genom vilka tryckerier, produkter och processer verifieras oberoende. Standarder är en av två tvärgående grupper (jämte Administration); de gäller över alla tillverkningsfacetter snarare än att vara ett eget produktionssteg.",
        "da": "Tværgående referencerammer, som al fremstilling peger tilbage til: målesystemer, papirformatstandarder, grafiske filformater, farvesystemer og de certificeringer, hvormed trykkerier, produkter og processer verificeres uafhængigt. Standarder er én af to tværgående grupper (jævnfør Administration); de gælder på tværs af alle fremstillingsfacetter frem for at være et selvstændigt produktionstrin.",
        "nl": "Overkoepelende referentiekaders waar alle productie naar terugverwijst: meetsystemen, papierformaatstandaarden, grafische bestandsformaten, kleursystemen en de certificeringen waarmee drukkerijen, producten en processen onafhankelijk worden geverifieerd. Standaarden is één van twee overkoepelende groepen (naast Beheer); ze gelden over alle productiefacetten heen in plaats van een afzonderlijke productiestap te zijn.",
        "pl": "Przekrojowe ramy odniesienia, do których odwołuje się cała działalność produkcyjna: systemy miar, standardy formatów papieru, formaty plików graficznych, systemy barw oraz certyfikaty, którymi drukarnie, produkty i procesy są niezależnie weryfikowane. Standardy są jedną z dwóch grup przekrojowych (obok Zarządzania); dotyczą wszystkich aspektów produkcji, a nie stanowią osobnego etapu produkcji.",
        "pt": "Quadros de referência transversais aos quais toda a atividade de fabricação remete: sistemas de medição, normas de tamanho de papel, formatos de arquivo gráfico, sistemas de cor e as certificações pelas quais impressores, produtos e processos são verificados de forma independente. Normas é um dos dois Grupos transversais (junto com Gestão); aplicam-se a todas as facetas de fabricação em vez de ser uma etapa distinta da produção.",
        "hi": "वे व्यापक संदर्भ ढाँचे जिनकी ओर सारी निर्माण गतिविधि इशारा करती है: मापन प्रणालियाँ, काग़ज़ आकार मानक, ग्राफ़िक फ़ाइल फ़ॉर्मेट, रंग प्रणालियाँ और वे प्रमाणन जिनसे प्रिंटर, उत्पाद और प्रक्रियाएँ स्वतंत्र रूप से सत्यापित होती हैं। मानक दो व्यापक समूहों में से एक है (प्रबंधन के साथ); ये उत्पादन के अलग चरण के बजाय हर निर्माण पहलू पर लागू होते हैं।"
      },
      "scopeNote": {
        "en": "Per PTPGE's single-word naming convention, 'Standards' is an umbrella term covering five subcategories with different epistemic statuses: Measurement Systems (units and conventions), Paper Size Standards (normative formats), Graphic File Formats (file format specifications), Color Systems (color vocabularies including proprietary systems like Pantone), and Certifications (third-party-verified credentials such as FSC and ISO 12647-7). Anything that is a stable, reference-able convention or external normative document belongs here.",
        "nb": "Etter PTPGE sin ett-ords-konvensjon er 'Standards' en samlebetegnelse som dekker fem underkategorier med ulik epistemisk status: Measurement Systems (enheter og konvensjoner), Paper Size Standards (normative formater), Graphic File Formats (filformatspesifikasjoner), Color Systems (fargevokabularer inkludert proprietære systemer som Pantone), og Certifications (tredjepartverifiserte legitimasjoner som FSC og ISO 12647-7). Alt som er en stabil, refererbar konvensjon eller eksternt normativt dokument hører hjemme her.",
        "de": "Gemäß PTPGEs Ein-Wort-Namenskonvention ist 'Standards' ein Sammelbegriff, der fünf Unterkategorien mit unterschiedlichem epistemischem Status abdeckt: Measurement Systems (Einheiten und Konventionen), Paper Size Standards (normative Formate), Graphic File Formats (Dateiformatspezifikationen), Color Systems (Farbvokabulare einschließlich proprietärer Systeme wie Pantone) und Certifications (drittparteiverifizierte Nachweise wie FSC und ISO 12647-7). Alles, was eine stabile, referenzierbare Konvention oder ein externes normatives Dokument ist, gehört hierher.",
        "ja": "PTPGEのワンワード命名規則により、『Standards』は5つのサブカテゴリーを包括する傘的な用語である：Measurement Systems（単位と慣習）、Paper Size Standards（規範的フォーマット）、Graphic File Formats（ファイル形式仕様）、Color Systems（Pantoneなどの独自システムを含む色彩語彙）、Certifications（FSCやISO 12647-7などの第三者認証）。安定して参照可能な慣習や外部規範文書はここに属する。",
        "es": "Según la convención de nombres de una sola palabra de PTPGE, 'Standards' es un término paraguas que cubre cinco subcategorías con distinto estatus epistémico: Measurement Systems (unidades y convenciones), Paper Size Standards (formatos normativos), Graphic File Formats (especificaciones de formato de archivo), Color Systems (vocabularios de color incluyendo sistemas propietarios como Pantone) y Certifications (credenciales verificadas por terceros como FSC e ISO 12647-7). Todo lo que sea una convención estable y referenciable, o un documento normativo externo, pertenece aquí.",
        "zh-Hans": "依据 PTPGE 的单字命名惯例，『Standards』是一个涵盖五个子类别的伞形术语，它们具有不同的认识论地位：Measurement Systems（单位与惯例）、Paper Size Standards（规范性规格）、Graphic File Formats（文件格式规范）、Color Systems（包括 Pantone 等专有系统的颜色词汇）、Certifications（FSC、ISO 12647-7 等第三方验证凭证）。任何稳定的、可引用的惯例或外部规范文件都归属于此。",
        "pt": "Pela convenção de nome único do PTPGE, «Normas» é um termo guarda-chuva que cobre cinco subcategorias de status epistêmico diferente: Sistemas de medição (unidades e convenções), Normas de tamanho de papel (formatos normativos), Formatos de arquivo gráfico (especificações de formato), Sistemas de cor (vocabulários de cor, incluindo sistemas proprietários como Pantone) e Certificações (credenciais verificadas por terceiros, como FSC e ISO 12647-7). Tudo o que for uma convenção estável e referenciável ou um documento normativo externo pertence aqui.",
        "hi": "PTPGE की एक-शब्द नामकरण परंपरा के अनुसार «मानक» एक छाता-शब्द है जो अलग-अलग ज्ञानमीमांसीय स्थिति वाली पाँच उप-श्रेणियों को ढकता है: मापन प्रणालियाँ (इकाइयाँ और परंपराएँ), काग़ज़ आकार मानक (मानक फ़ॉर्मेट), ग्राफ़िक फ़ाइल फ़ॉर्मेट (फ़ाइल फ़ॉर्मेट विनिर्देश), रंग प्रणालियाँ (Pantone जैसी स्वामित्व प्रणालियों सहित रंग शब्दावली) और प्रमाणन (FSC और ISO 12647-7 जैसे तृतीय-पक्ष सत्यापित प्रमाण)। जो कुछ भी स्थिर, संदर्भ-योग्य परंपरा या बाहरी मानक दस्तावेज़ है, वह यहाँ है।"
      },
      "visual": {
        "color": "#939598",
        "colorName": "PTPGE Gray 1",
        "palette": [
          "#939598",
