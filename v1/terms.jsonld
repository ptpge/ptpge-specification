        "pl": [
          "wklęsłodruk zwojowy",
          "rotograwiura",
          "wklęsłodruk"
        ],
        "pt": [
          "Gravura de bobina",
          "Rotogravura"
        ],
        "hi": [
          "वेब ग्रेव्योर",
          "रोटोग्रेव्योर"
        ]
      },
