    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/configurations/setup-models/multi-part",
      "type": "skos:Concept",
      "version": "2026-06-22",
      "status": "proposed",
      "level": "element",
      "notation": "P:CF§MULTI-PART",
      "elementType": "value",
      "label": {
        "en": "Multi-part Setup",
        "nb": "Flerdelt oppsett",
        "de": "Mehrteiliges Setup",
        "ja": "複写構成",
        "es": "Configuración multicopia",
        "zh-Hans": "多联结构",
        "nl": "Meerdelige opzet",
        "sv": "Flerdelad (självkopierande)",
        "da": "Flerdelt (selvkopierende)",
        "pl": "Konfiguracja wieloczęściowa",
        "pt": "Montagem multivias",
        "hi": "मल्टी-पार्ट सेटअप"
      },
      "altLabels": {
        "en": [
          "Carbonless setup",
          "NCR setup",
          "Duplicate/triplicate setup"
        ],
        "nb": [
          "Gjenpart-oppsett",
          "Karbonfritt oppsett",
          "Blåkopi-oppsett"
        ],
        "pl": [
          "konfiguracja samokopiująca",
          "konfiguracja NCR",
          "konfiguracja dwu-/trzyegzemplarzowa"
        ],
        "pt": [
          "montagem autocopiativa",
          "montagem NCR",
          "montagem em duas/três vias"
        ],
        "hi": [
          "कार्बनलेस सेटअप",
          "NCR सेटअप",
          "डुप्लीकेट/ट्रिप्लीकेट सेटअप"
        ]
      },
      "definition": {
        "en": "A set of stacked sheets that transfer an impression from the top part to the parts beneath — carbonless (NCR) pads and forms in duplicate, triplicate, etc. Each Part is an addressable surface (Part 1, Part 2 …), usually printed on the front, collated in colour-coded sequence and padded or booked. The number of parts is variable and resolved by the Configurator. Maps to digital/offset business-forms production with collation and padding.",
        "nb": "Et sett av stablede ark som overfører et avtrykk fra den øverste delen til delene under — karbonfrie (NCR) blokker og skjemaer i to, tre eller flere eksemplarer. Hver Part er en adresserbar surface (Part 1, Part 2 …), vanligvis trykt på forsiden, samlet i fargekodet rekkefølge og limt eller heftet. Antall deler er variabelt og løses av Configurator.",
        "de": "Ein Satz gestapelter Bogen, die einen Abdruck vom obersten Teil auf die darunterliegenden Teile übertragen — selbstdurchschreibende (SD/NCR) Blöcke und Formulare in zweifacher, dreifacher Ausfertigung usw. Jeder Part ist eine adressierbare Surface (Part 1, Part 2 …).",
        "ja": "A set of stacked sheets that transfer an impression from the top part to the parts beneath — carbonless (NCR) pads and forms in duplicate, triplicate, etc. Each Part is an addressable surface, usually printed on the front.",
        "es": "A set of stacked sheets that transfer an impression from the top part to the parts beneath — carbonless (NCR) pads and forms in duplicate, triplicate, etc. Each Part is an addressable surface, usually printed on the front.",
        "zh-Hans": "A set of stacked sheets that transfer an impression from the top part to the parts beneath — carbonless (NCR) pads and forms in duplicate, triplicate, etc. Each Part is an addressable surface, usually printed on the front.",
        "sv": "En uppsättning staplade ark som överför ett avtryck från den översta delen till delarna under — självkopierande (NCR) block och blanketter i två, tre eller fler exemplar. Varje del är en adresserbar yta (Del 1, Del 2 …), vanligen tryckt på framsidan, kollationerad i färgkodad ordning och blockad eller bokad. Antalet delar är variabelt och avgörs av Konfiguratorn. Motsvarar digital-/offsetproduktion av affärsblanketter med kollationering och blockning.",
        "da": "Et sæt stablede ark, der overfører et aftryk fra den øverste del til delene nedenunder — selvkopierende (NCR) blokke og formularer i to, tre eller flere eksemplarer. Hver del er en adresserbar flade (Del 1, Del 2 …), som regel trykt på forsiden, kollationeret og limet.",
        "nl": "Een set gestapelde vellen die een afdruk van het bovenste deel doorschrijven naar de delen eronder — zelfkopiërende (NCR) blokken en formulieren in twee-, drie- of meervoud. Elk deel is een adresseerbaar vlak (Deel 1, Deel 2 …), doorgaans aan de voorzijde bedrukt, vergaard en gelijmd.",
        "pl": "Zestaw ułożonych arkuszy przenoszących zapis z górnej części na części poniżej — bloczki i formularze samokopiujące (NCR) w dwóch, trzech itd. egzemplarzach. Każda Część jest adresowalną powierzchnią (Część 1, Część 2 …), zwykle zadrukowaną z przodu, zbieraną w sekwencji oznaczonej kolorami i klejoną w bloczki lub zeszyty. Liczba części jest zmienna i ustalana przez Konfigurator. Odpowiada cyfrowej/offsetowej produkcji druków akcydensowych z zbieraniem i klejeniem bloczków.",
        "pt": "Conjunto de folhas empilhadas que transferem a impressão da via de cima para as vias abaixo — blocos e formulários autocopiativos (NCR) em duas, três vias etc. Cada Via é uma face endereçável (Via 1, Via 2 …), normalmente impressa na frente, intercalada em sequência com código de cores e colada em bloco ou talão. O número de vias é variável e resolvido pelo Configurador. Corresponde à produção digital/offset de formulários comerciais com intercalação e colagem.",
        "hi": "एक के ऊपर एक रखी शीटों का सेट जो ऊपरी प्रति की छाप नीचे की प्रतियों पर उतारता है — कार्बनलेस (NCR) पैड और फ़ॉर्म दो, तीन प्रतियों में। हर प्रति एक पता-योग्य सतह है (प्रति 1, प्रति 2 …), आमतौर पर सामने छपी, रंग-कोडित क्रम में लगाई और पैड या बुक में बँधी। प्रतियों की संख्या परिवर्तनशील है और कॉन्फ़िगरेटर तय करता है। कोलेशन और पैडिंग के साथ डिजिटल/ऑफसेट बिज़नेस-फ़ॉर्म उत्पादन से मेल खाता है।"
      },
      "langStatus": {
        "en": "production",
        "nb": "production",
        "de": "production",
        "ja": "draft",
        "es": "draft",
        "zh-Hans": "draft"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "configurations",
      "broader": "https://ptpge.org/v1/printing/configurations/setup-models",
      "surfaces": [
        {
          "id": "parts",
          "label": {
            "en": "Parts",
            "nb": "Deler",
            "de": "Teile"
          },
          "count": "variable"
        }
      ],
      "scopeNote": {
        "en": "The number of parts (duplicate, triplicate …) is variable and resolved by the Configurator; parts are usually printed on the front and collated in a colour-coded sequence, then padded or booked. Quantity is counted in sets.",
        "pt": "O número de vias (duas, três …) é variável e resolvido pelo Configurador; as vias são normalmente impressas na frente e intercaladas em sequência com código de cores, depois coladas em bloco ou talão. A quantidade é contada em jogos.",
        "hi": "प्रतियों की संख्या (दो, तीन …) परिवर्तनशील है और कॉन्फ़िगरेटर तय करता है; प्रतियाँ आमतौर पर सामने छपती हैं और रंग-कोडित क्रम में लगकर पैड या बुक में बँधती हैं। मात्रा सेट में गिनी जाती है।"
      },
      "created": "2026-06-22T00:00:00Z",
      "modified": "2026-09-23T06:34:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/configurations/setup-models/roll",
      "type": "skos:Concept",
      "version": "2026-06-22",
      "status": "proposed",
      "level": "element",
      "notation": "P:CF§ROLL",
      "elementType": "value",
      "label": {
        "en": "Roll Setup",
        "nb": "Rull-oppsett",
        "de": "Rollen-Setup",
        "ja": "ロール構成",
        "es": "Configuración en rollo",
        "zh-Hans": "卷筒结构",
        "nl": "Rol-opzet",
        "sv": "Rulle",
        "da": "Rulle",
        "pl": "Konfiguracja rolowa",
        "pt": "Montagem em rolo",
        "hi": "रोल सेटअप"
      },
      "altLabels": {
        "en": [
          "Reel setup",
          "Continuous setup",
          "Labels-on-roll setup"
        ],
        "nb": [
          "Kontinuerlig oppsett",
          "Etikett-på-rull-oppsett"
        ],
        "pl": [
          "konfiguracja na roli",
          "konfiguracja ciągła",
          "etykiety na roli"
        ],
        "pt": [
          "montagem em bobina",
          "montagem contínua",
          "rótulos em rolo"
        ],
        "hi": [
          "रील सेटअप",
          "सतत सेटअप",
          "रोल पर लेबल सेटअप"
        ]
      },
      "definition": {
        "en": "A continuous printed product supplied on a reel rather than as cut sheets — self-adhesive labels and stickers on roll. One printable Face carries a repeating design; the Back is the liner (usually unprinted). Quantity is a repeat count along the web rather than a sheet count, and roll parameters (core size, winding direction, gap/pitch) are resolved by the Configurator. Maps to flexo / digital roll-to-roll production. The orientation of the finished labels on the roll is a bindable axis, winding-direction (FINAT 1–8, XJDF Component/@WindingResult).",
        "nb": "Et kontinuerlig trykkprodukt levert på rull i stedet for som kuttede ark — selvklebende etiketter og klistremerker på rull. Én trykkbar Face bærer et repeterende design; Back er bæremateriale (vanligvis utrykt). Antall er et repetisjons-antall langs banen i stedet for et ark-antall, og rull-parametre (kjernestørrelse, vikleretning, gap/pitch) løses av Configurator. Mapper til flexo / digital rull-til-rull-produksjon. Orienteringen av de ferdige etikettene på rullen er en bindbar akse, winding-direction (FINAT 1–8, XJDF Component/@WindingResult).",
        "de": "Ein kontinuierliches Druckprodukt, das auf einer Rolle statt als geschnittene Bogen geliefert wird — selbstklebende Etiketten und Aufkleber auf Rolle. Eine bedruckbare Face trägt ein sich wiederholendes Design; die Back ist das Trägermaterial (meist unbedruckt). Die Menge ist eine Wiederholungsanzahl entlang der Bahn.",
        "ja": "A continuous printed product supplied on a reel rather than as cut sheets — self-adhesive labels and stickers on roll. One printable Face carries a repeating design; the Back is the liner (usually unprinted).",
        "es": "A continuous printed product supplied on a reel rather than as cut sheets — self-adhesive labels and stickers on roll. One printable Face carries a repeating design; the Back is the liner (usually unprinted).",
        "zh-Hans": "A continuous printed product supplied on a reel rather than as cut sheets — self-adhesive labels and stickers on roll. One printable Face carries a repeating design; the Back is the liner (usually unprinted).",
        "sv": "En kontinuerlig tryckt produkt levererad på rulle i stället för som skurna ark — självhäftande etiketter och klistermärken på rulle. En tryckbar yta bär en repeterande design; baksidan är linern (vanligen otryckt). Kvantiteten är ett repetitionsantal längs banan snarare än ett arkantal, och rullparametrar (kärnstorlek, lindningsriktning, mellanrum/pitch) avgörs av Konfiguratorn. Motsvarar flexo-/digital rulle-till-rulle-produktion.",
        "da": "Et kontinuerligt trykt produkt leveret på rulle i stedet for som skårne ark — selvklæbende etiketter og klistermærker på rulle. Én trykbar flade bærer et gentaget design; bagsiden er lineren (som regel utrykt). Mængden er et gentagelsesantal langs banen.",
        "nl": "Een doorlopend gedrukt product geleverd op rol in plaats van als gesneden vellen — zelfklevende etiketten en stickers op rol. Eén bedrukbaar vlak draagt een zich herhalend ontwerp; de achterzijde is de liner (doorgaans onbedrukt). De hoeveelheid is een herhalingsaantal langs de baan.",
        "pl": "Ciągły produkt drukowany dostarczany na roli zamiast ciętych arkuszy — etykiety i naklejki samoprzylepne na roli. Jedna zadrukowywana Strona niesie powtarzalny projekt; Tył to podkład (zwykle niezadrukowany). Nakład jest liczbą powtórzeń wzdłuż wstęgi, a nie liczbą arkuszy, a parametry roli (średnica gilzy, kierunek nawijania, odstęp/podziałka) ustala Konfigurator. Odpowiada produkcji flekso / cyfrowej z roli na rolę. Orientacja gotowych etykiet na roli jest wiązalną osią: kierunek nawijania (FINAT 1–8, XJDF Component/@WindingResult).",
        "pt": "Produto impresso contínuo fornecido em bobina em vez de folhas cortadas — rótulos e adesivos autoadesivos em rolo. Uma Face imprimível carrega um desenho repetido; o Verso é o liner (normalmente sem impressão). A quantidade é uma contagem de repetições ao longo da bobina, não de folhas, e os parâmetros do rolo (tamanho do tubete, sentido de enrolamento, espaçamento/passo) são resolvidos pelo Configurador. Corresponde à produção flexo/digital rolo a rolo. A orientação dos rótulos acabados no rolo é um eixo vinculável, sentido de enrolamento (FINAT 1–8, XJDF Component/@WindingResult).",
        "hi": "कटी शीटों के बजाय रील पर दिया जाने वाला सतत मुद्रित उत्पाद — रोल पर स्वयं-चिपकने वाले लेबल और स्टिकर। एक छपाई योग्य सतह पर दोहराया जाने वाला डिज़ाइन; पीछे लाइनर (आमतौर पर बिना छपा)। मात्रा शीट संख्या नहीं, वेब के साथ दोहराव की गिनती है, और रोल के पैरामीटर (कोर आकार, वाइंडिंग दिशा, गैप/पिच) कॉन्फ़िगरेटर तय करता है। फ़्लेक्सो/डिजिटल रोल-टू-रोल उत्पादन से मेल खाता है। रोल पर तैयार लेबलों की दिशा बाँधने योग्य अक्ष है, वाइंडिंग दिशा (FINAT 1–8, XJDF Component/@WindingResult)।"
      },
      "langStatus": {
        "en": "production",
        "nb": "production",
        "de": "production",
        "ja": "draft",
        "es": "draft",
        "zh-Hans": "draft"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "configurations",
      "broader": "https://ptpge.org/v1/printing/configurations/setup-models",
      "surfaces": [
        {
          "id": "face",
          "label": {
            "en": "Face",
            "nb": "Forside",
            "de": "Vorderseite"
          }
        },
        {
          "id": "back",
          "label": {
            "en": "Back (liner)",
            "nb": "Bakside (liner)",
            "de": "Rückseite (Träger)"
          }
        }
      ],
      "scopeNote": {
        "en": "Quantity is a repeat count along the web (not sheets); core size, winding direction and label gap/pitch are roll parameters resolved by the Configurator. Back is normally the unprinted liner.",
        "pt": "A quantidade é uma contagem de repetições ao longo da bobina (não de folhas); tamanho do tubete, sentido de enrolamento e espaçamento/passo dos rótulos são parâmetros do rolo resolvidos pelo Configurador. O verso é normalmente o liner sem impressão.",
        "hi": "मात्रा वेब के साथ दोहराव की गिनती है (शीटें नहीं); कोर आकार, वाइंडिंग दिशा और लेबल गैप/पिच कॉन्फ़िगरेटर द्वारा तय रोल पैरामीटर हैं। पीछे आमतौर पर बिना छपा लाइनर।"
      },
      "created": "2026-06-22T00:00:00Z",
      "modified": "2026-09-23T06:34:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/configurations/setup-models/structural",
      "type": "skos:Concept",
      "version": "2026-06-22",
      "status": "proposed",
      "level": "element",
      "notation": "P:CF§STRUCTURAL",
      "elementType": "value",
      "label": {
        "en": "Structural Setup",
        "nb": "Strukturelt oppsett",
        "de": "Struktur-Setup",
        "ja": "構造構成",
        "es": "Configuración estructural",
        "zh-Hans": "结构结构",
        "nl": "Structurele opzet",
        "sv": "Strukturell",
        "da": "Strukturel",
        "pl": "Konfiguracja konstrukcyjna",
        "pt": "Montagem estrutural",
        "hi": "संरचनात्मक सेटअप"
      },
      "altLabels": {
        "en": [
          "Die-cut 3D setup",
          "Carton setup",
          "Box setup"
        ],
        "nb": [
          "Stanset 3D-oppsett",
          "Eske-oppsett",
          "Kartong-oppsett"
        ],
        "pl": [
          "konfiguracja 3D wykrawana",
          "konfiguracja kartonik",
          "konfiguracja pudełko"
        ],
        "pt": [
          "montagem 3D com corte especial",
          "montagem de cartucho",
          "montagem de caixa"
        ],
        "hi": [
          "डाई-कट 3D सेटअप",
          "कार्टन सेटअप",
          "बॉक्स सेटअप"
        ]
      },
      "definition": {
        "en": "A three-dimensional printed product cut and creased from a flat blank (a die-cut net) and folded/glued into shape — folding cartons, custom and mailer boxes, paper bags, and rigid/luxury packaging. Two surfaces are addressable: Outside and Inside, each spanning the variable number of panels defined by the dieline. The exact panel layout comes from the structural design (dieline) and is resolved by the Configurator; maps to XJDF die-cutting/structural intents.",
        "nb": "Et tredimensjonalt trykkprodukt skåret og rillet fra et flatt utlegg (et stanset utbrett) og brettet/limt til form — foldekartonger, esker og mailer-bokser, papirposer og rigid/luksus-emballasje. To surfaces er adresserbare: Outside og Inside, hver med det variable antallet paneler definert av stanseformen. Det eksakte panel-oppsettet kommer fra den strukturelle designen (dieline) og løses av Configurator; mapper til XJDF stanse-/strukturelle intents.",
        "de": "Ein dreidimensionales Druckprodukt, aus einem flachen Zuschnitt (gestanztes Netz) geschnitten und gerillt und in Form gefaltet/geklebt — Faltschachteln, individuelle und Versandkartons, Papiertüten sowie Rigid-/Luxusverpackung. Zwei Surfaces sind adressierbar: Außen und Innen, jeweils über die variable Anzahl der vom Stanzwerkzeug definierten Paneele.",
        "ja": "A three-dimensional printed product cut and creased from a flat blank (a die-cut net) and folded/glued into shape — folding cartons, custom and mailer boxes, paper bags, and rigid/luxury packaging. Two surfaces are addressable: Outside and Inside, each spanning the variable number of panels defined by the dieline.",
        "es": "A three-dimensional printed product cut and creased from a flat blank (a die-cut net) and folded/glued into shape — folding cartons, custom and mailer boxes, paper bags, and rigid/luxury packaging. Two surfaces are addressable: Outside and Inside, each spanning the variable number of panels defined by the dieline.",
        "zh-Hans": "A three-dimensional printed product cut and creased from a flat blank (a die-cut net) and folded/glued into shape — folding cartons, custom and mailer boxes, paper bags, and rigid/luxury packaging. Two surfaces are addressable: Outside and Inside, each spanning the variable number of panels defined by the dieline.",
        "sv": "En tredimensionell tryckt produkt skuren och bigad ur ett plant ämne (ett stansschema) och falsad/limmad till form — vikkartonger, special- och mailerboxar, papperspåsar samt styva/exklusiva förpackningar. Två adresserbara ytor: utsida och insida, var och en spännande över det variabla antal paneler som stanslayouten definierar. Den exakta panellayouten kommer från strukturdesignen (stansschemat) och avgörs av Konfiguratorn; motsvarar XJDF:s stansnings-/strukturintents.",
        "da": "Et tredimensionelt trykt produkt skåret og rillet ud af et fladt emne (en stanseform) og falset/limet i form — foldeæsker, special- og forsendelsesæsker, papirsposer samt stive/eksklusive emballager. To adresserbare flader: yderside og inderside.",
        "nl": "Een driedimensionaal gedrukt product, gesneden en gerild uit een vlak blank (een stansvorm) en gevouwen/gelijmd tot vorm — vouwdozen, maatwerk- en verzenddozen, papieren tassen en stevige/luxe verpakkingen. Twee adresseerbare vlakken: buiten- en binnenzijde.",
        "pl": "Trójwymiarowy produkt drukowany wycięty i bigowany z płaskiego wykroju (siatki wykrojnika) oraz złożony/sklejony do kształtu — kartoniki składane, pudełka na zamówienie i wysyłkowe, torby papierowe oraz opakowania sztywne/luksusowe. Adresowalne są dwie powierzchnie: Zewnętrzna i Wewnętrzna, każda obejmująca zmienną liczbę paneli określoną przez wykrojnik. Dokładny układ paneli wynika z projektu konstrukcyjnego (wykrojnika) i jest ustalany przez Konfigurator; odpowiada intencjom XJDF dla wykrawania/konstrukcji.",
        "pt": "Produto impresso tridimensional cortado e vincado a partir de uma planificação (uma faca de corte) e dobrado/colado até tomar forma — cartuchos, caixas personalizadas e de envio, sacolas de papel e embalagens rígidas/de luxo. Duas faces são endereçáveis: Exterior e Interior, cada uma abrangendo o número variável de painéis definido pela faca. O layout exato dos painéis vem do projeto estrutural (faca) e é resolvido pelo Configurador; corresponde às intenções XJDF de corte especial/estrutura.",
        "hi": "सपाट ब्लैंक (डाई-कट नेट) से काटकर और क्रीज़ करके, मोड़कर/चिपकाकर आकार में लाया गया त्रि-आयामी मुद्रित उत्पाद — फ़ोल्डिंग कार्टन, कस्टम और मेलर बॉक्स, पेपर बैग और कठोर/लक्ज़री पैकेजिंग। दो पता-योग्य सतहें: बाहरी और भीतरी, हर एक डाईलाइन से परिभाषित परिवर्तनशील पैनल संख्या पर फैली। सटीक पैनल लेआउट संरचनात्मक डिज़ाइन (डाईलाइन) से आता है और कॉन्फ़िगरेटर तय करता है; XJDF डाई-कटिंग/संरचनात्मक इंटेंट से मेल खाता है।"
      },
      "langStatus": {
        "en": "production",
        "nb": "production",
        "de": "production",
        "ja": "draft",
        "es": "draft",
        "zh-Hans": "draft"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "configurations",
      "broader": "https://ptpge.org/v1/printing/configurations/setup-models",
      "surfaces": [
        {
          "id": "outside",
          "label": {
            "en": "Outside",
            "nb": "Utside",
            "de": "Außen"
          },
          "count": "variable"
        },
        {
          "id": "inside",
          "label": {
            "en": "Inside",
            "nb": "Innside",
            "de": "Innen"
          },
          "count": "variable"
        }
      ],
      "scopeNote": {
        "en": "Panel count and geometry are defined by the structural dieline, not by a fixed list; the Configurator instantiates the Surface/panel structure from the chosen box/carton/bag style. Production maps to XJDF CuttingParams / die-cutting and folding-gluing.",
        "pt": "O número e a geometria dos painéis são definidos pela faca estrutural, não por uma lista fixa; o Configurador instancia a estrutura de faces/painéis a partir do estilo de caixa/cartucho/sacola escolhido. A produção corresponde a XJDF CuttingParams / corte especial e dobra-cola.",
        "hi": "पैनल संख्या और ज्यामिति संरचनात्मक डाईलाइन से परिभाषित हैं, किसी निश्चित सूची से नहीं; कॉन्फ़िगरेटर चुने गए बॉक्स/कार्टन/बैग शैली से सतह/पैनल संरचना बनाता है। उत्पादन XJDF CuttingParams / डाई-कटिंग और फ़ोल्डिंग-ग्लूइंग से मेल खाता है।"
      },
      "created": "2026-06-22T00:00:00Z",
      "modified": "2026-09-23T06:34:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
