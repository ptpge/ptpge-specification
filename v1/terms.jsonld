      "level": "element",
      "label": {
        "en": "Gloss Lamination",
        "nb": "Glansig laminering",
        "de": "Glanz-Laminierung",
        "ja": "光沢ラミネート",
        "es": "Laminado brillante",
        "zh-Hans": "光膜覆膜",
