      "label": {
        "en": "Magnetic Foil",
        "nb": "Magnetfolie",
        "de": "Magnetfolie",
        "es": "Lámina magnética",
        "ja": "マグネットシート",
        "zh-Hans": "磁性贴片",
        "sv": "Magnetfolie",
        "da": "Magnetfolie",
        "nl": "Magneetfolie",
        "pl": "Folia magnetyczna",
        "pt": "Manta magnética",
        "hi": "चुंबकीय शीट"
