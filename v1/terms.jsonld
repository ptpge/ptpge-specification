      "label": {
        "en": "Heatset Web Offset",
        "nb": "Rulleoffset (heatset)",
        "de": "Rollenoffset (Heatset)",
        "es": "Ófset de bobina heatset",
        "ja": "ヒートセット輪転オフセット",
        "zh-Hans": "热固轮转胶印",
        "sv": "Heatset-rulloffset",
        "da": "Heatset-rotationsoffset",
        "nl": "Heatset-rotatieoffset",
        "pl": "Offset zwojowy heatset",
        "pt": "Offset de bobina heatset",
        "hi": "हीटसेट वेब ऑफसेट"
