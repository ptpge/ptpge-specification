      "broader": "https://ptpge.org/v1/printing/technologies/printing-technologies/analog",
      "narrower": [
        "https://ptpge.org/v1/printing/technologies/printing-technologies/analog/gravure/sheet-fed-rotogravure",
        "https://ptpge.org/v1/printing/technologies/printing-technologies/analog/gravure/web-rotogravure"
