      "label": {
        "en": "Wide Format Printers",
        "es": "Impresoras de Gran Formato",
        "zh-Hans": "大幅面打印机",
        "nb": "Storformat-printere",
        "de": "Großformatdrucker",
        "ja": "大判プリンター",
        "sv": "Storformatsskrivare",
        "da": "Storformatprintere",
