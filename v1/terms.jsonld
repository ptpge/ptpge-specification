      "created": "2026-05-30T00:00:00Z",
      "modified": "2026-10-06T19:16:59Z",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/variables/substrate/substrate-weight",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "notation": "VAR:SB§SUBSTRATE-WEIGHT",
      "level": "element",
      "elementType": "variable",
      "label": {
        "en": "Substrate Weight",
        "nb": "Substratvekt",
        "de": "Grammatur",
        "es": "Gramaje",
        "ja": "坪量",
        "zh-Hans": "克重",
        "sv": "Substratvikt",
        "da": "Substratvægt",
        "nl": "Substraatgewicht",
        "pl": "Gramatura podłoża",
        "pt": "Gramatura do substrato",
        "hi": "सब्सट्रेट का वज़न"
      },
      "altLabels": {
        "en": [
          "Paper Weight",
          "Grammage",
          "GSM"
        ],
        "nb": [
          "Papirvekt",
          "Gramvekt"
        ],
        "pl": [
          "gramatura papieru",
          "gramatura",
          "g/m²"
        ],
        "pt": [
          "gramatura",
          "gramatura do papel",
          "g/m²",
          "peso do papel"
        ],
        "hi": [
          "काग़ज़ का वज़न",
          "ग्रामेज",
          "GSM",
          "पेपर वेट"
        ]
      },
      "definition": {
        "en": "Configurable axis: Substrate Weight. A printed product is configured along this variable (numeric, single selection, in gsm). Allowed values are drawn from the referenced valueDomain.",
        "nb": "Konfigurerbar akse: Substratvekt. Et trykkprodukt konfigureres langs denne variabelen (numeric, single valg, i gsm). Verdier hentes fra value-domain.",
        "de": "Konfigurierbare Achse: Grammatur. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (numerisch, Einfachauswahl, in g/m²). Zulässige Werte stammen aus der referenzierten valueDomain.",
        "es": "Eje configurable: Gramaje. Un producto impreso se configura a lo largo de esta variable (numérico, selección única, en g/m²). Los valores permitidos provienen del valueDomain referenciado.",
        "ja": "構成可能な軸：坪量。印刷物はこの変数に沿って構成される（数値、単一選択、g/m²単位）。許容値は参照先の valueDomain から取得される。",
        "zh-Hans": "可配置轴：克重。印刷品沿此变量进行配置（数值，单选，以 g/m² 计）。允许的取值来自所引用的 valueDomain。",
        "sv": "Konfigurerbar axel: Substratvikt. En trycksak konfigureras längs denna variabel (numerisk, enkelval, i g/m²). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain).",
        "da": "Konfigurerbar akse: Substratvægt. Et trykt produkt konfigureres langs denne variabel (numerisk, enkeltvalg, i g/m²). Tilladte værdier hentes fra det refererede værdidomæne.",
        "nl": "Configureerbare as: Substraatgewicht. Een drukproduct wordt langs deze variabele geconfigureerd (numeriek, enkelvoudig, in g/m²). Toegestane waarden komen uit het gerefereerde waardedomein.",
        "pl": "Oś konfigurowalna: Gramatura podłoża. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (numeryczna, wybór pojedynczy, w g/m²). Dozwolone wartości pochodzą z przywołanej valueDomain.",
        "pt": "Eixo configurável: Gramatura do Substrato. Um impresso é configurado ao longo desta variável (numérico, seleção única, em g/m²). Os valores permitidos vêm do valueDomain referenciado.",
        "hi": "कॉन्फ़िगर करने योग्य अक्ष: सब्सट्रेट का वज़न (ग्रामेज)। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (संख्यात्मक, एकल चयन, GSM में)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"
      },
      "question": {
        "en": "How heavy a paper?",
        "nb": "Hvor tykt papir?",
        "de": "Welches Papiergewicht?",
        "es": "¿Qué gramaje?",
        "ja": "紙の厚さ（坪量）は？",
        "zh-Hans": "纸张多重？",
        "sv": "Vilken pappersvikt?",
        "da": "Hvilken papirvægt?",
        "nl": "Welk papiergewicht?",
        "pl": "Jaka gramatura?",
        "pt": "Que gramagem?",
        "hi": "कागज़ कितना भारी?"
      },
      "datatype": "numeric",
      "cardinality": "single",
      "scope": "product",
      "unit": "gsm",
      "valueDomain": "https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-weights",
      "rangeMin": 40,
      "rangeMax": 600,
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/variables/substrate",
      "created": "2026-05-30T00:00:00Z",
      "modified": "2026-10-06T19:16:59Z",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/schemas",
      "type": "skos:Concept",
      "version": "2026-10-09",
      "status": "proposed",
      "notation": "SCH",
      "level": "top-concept",
      "label": {
        "en": "Schemas",
        "nb": "Dokumentskjemaer",
        "de": "Schemata",
        "sv": "Scheman",
        "da": "Skemaer",
        "nl": "Schema's"
      },
      "definition": {
        "en": "The five document forms the vocabulary is used in: vendor declaration and supplier catalogue (what a company is and offers, published on its own domain), request and quote (one deal between a buyer and a printer), UCP manifest (the identity on a checkout line). Each has a schema with a permanent URI and a version; a document carries its owner, the schema carries none. Status: draft. All five have published JSON Schemas (2026-10-10), with a reference validator that checks shape, identity or fingerprint, and every term URI against the vocabulary. The rule every schema sets: what a document says about products and options, it says with term URIs, not labels.",
        "nb": "De fem dokumentformene vokabularet brukes i: leverandørdeklarasjon og produsentkatalog (hva en virksomhet er og tilbyr, publisert på eget domene), forespørsel og tilbud (én handel mellom kjøper og trykkeri), UCP-manifest (identiteten på en kasselinje). Hvert har et skjema med permanent URI og versjon; et dokument bærer sin eier, skjemaet bærer ingen. Status: utkast. Alle fem har publisert JSON Schema (2026-10-10), med en referansevalidator som sjekker form, identitet eller fingeravtrykk, og hver term-URI mot vokabularet. Regelen hvert skjema setter: det et dokument sier om produkter og valg, sier det med term-URI-er, ikke etiketter."
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "topConceptOf": "https://ptpge.org/v1/scheme",
      "created": "2026-10-06T19:16:59Z",
      "modified": "2026-10-10T19:20:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "narrower": [
        "https://ptpge.org/v1/schemas/vendor-declaration/1",
        "https://ptpge.org/v1/schemas/supplier-catalogue/1",
        "https://ptpge.org/v1/schemas/request/1",
        "https://ptpge.org/v1/schemas/quote/1",
        "https://ptpge.org/v1/schemas/ucp-manifest/1"
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/schemas/quote/1",
      "type": "ptpge:Schema",
      "version": "2026-10-12",
      "status": "proposed",
      "notation": "SCH:QUOTE",
      "level": "element",
      "label": {
        "en": "Quote",
        "nb": "Tilbud"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/schemas",
      "schemaVersion": 1,
      "stage": "published",
      "writtenBy": "a printer, in answer to a request",
      "holds": "price · quantity · delivery · validity, for one configuration",
      "jsonSchema": "https://ptpge.org/v1/schemas/quote/1.schema.json",
      "definition": {
        "en": "A printer's answer to one request: the same configuration (the ptpge-cfs/1 fingerprint it was asked for), a quantity, a price in one currency, delivery terms and a validity period, addressed to the buyer who asked. Together with the request it is one deal; its acceptance is the event an implementation acts on. Not published at a known path — it has a recipient.",
        "nb": "Et trykkeris svar på én forespørsel: samme konfigurasjon (ptpge-cfs/1-fingeravtrykket det ble spurt om), et antall, en pris i én valuta, leveringsvilkår og en gyldighetsperiode, adressert til kjøperen som spurte. Sammen med forespørselen utgjør det én handel; aksepten er hendelsen en implementasjon handler på. Publiseres ikke på kjent sti – det har en mottaker."
      },
      "note": {
        "en": "Pairs with request/1: a quote answers exactly one request and repeats its fingerprint, so the two can be matched without a system in between. JSON Schema published 2026-10-10 (draft 2020-12): the printer's register identity, inReplyTo (the request's id and spec fingerprint — must equal the quote's own), the configuration and fingerprint repeated, quantity, price in one currency (total, unit, setup, VAT), alternatives at other run lengths, lead time, delivery, conditions, validUntil. The schema says nothing about how the price was made. Reference validator: tools/validate_declaration.py.",
        "nb": "Hører sammen med request/1: et tilbud svarer på nøyaktig én forespørsel og gjentar dens fingeravtrykk, så de to kan kobles uten et system imellom. JSON Schema publisert 2026-10-10 (draft 2020-12): trykkeriets registeridentitet, inReplyTo (forespørselens id og spec-fingeravtrykk — må være lik tilbudets eget), konfigurasjon og fingeravtrykk gjentatt, antall, pris i én valuta (total, enhet, oppsett, mva), alternativer for andre opplag, leveringstid, levering, betingelser, validUntil. Skjemaet sier ingenting om hvordan prisen ble til."
      },
      "created": "2026-10-09T17:30:00Z",
      "modified": "2026-10-10T22:10:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/"
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/schemas/request/1",
      "type": "ptpge:Schema",
      "version": "2026-10-12",
      "status": "proposed",
      "notation": "SCH:REQUEST",
      "level": "element",
      "label": {
        "en": "Request",
        "nb": "Forespørsel"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/schemas",
      "schemaVersion": 1,
      "stage": "published",
      "writtenBy": "a buyer or an agent",
      "holds": "a configuration + quantity, asked of one or many vendors",
      "jsonSchema": "https://ptpge.org/v1/schemas/request/1.schema.json",
      "definition": {
        "en": "A buyer's or agent's ask: one validated configuration (bindings on vocabulary URIs, resolving to a ptpge-cfs/1 fingerprint) plus quantity and delivery terms, addressed to one or many vendors. The document a receiving system acts on without a human in between.",
        "nb": "A buyer's or agent's ask: one validated configuration (bindings on vocabulary URIs, resolving to a ptpge-cfs/1 fingerprint) plus quantity and delivery terms, addressed to one or many vendors. The document a receiving system acts on without a human in between."
      },
      "created": "2026-10-06T19:16:59Z",
      "modified": "2026-10-10T22:10:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "note": {
        "en": "JSON Schema published 2026-10-10 (draft 2020-12): buyer, recipients (register identities), one configuration (product template + bindings on variable URIs → term URIs or numbers, surface-scoped where the variable is), the ptpge-cfs/1 fingerprint (spec, optionally offer), quantity and alternatives, delivery, artwork hash-first. Any recipient recomputes the fingerprint; a document whose identity and statement disagree is refused. Reference validator: tools/validate_declaration.py.",
        "nb": "JSON Schema publisert 2026-10-10 (draft 2020-12): kjøper, mottakere (registeridentiteter), én konfigurasjon (produktmal + bindinger på variabel-URI-er → term-URI-er eller tall, flatebundet der variabelen er det), ptpge-cfs/1-fingeravtrykket (spec, eventuelt offer), antall og alternativer, levering, trykkfil hash først. Mottakeren regner fingeravtrykket på nytt; et dokument der identitet og utsagn ikke stemmer, avvises."
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/schemas/supplier-catalogue/1",
      "type": "ptpge:Schema",
      "version": "2026-10-12",
      "status": "proposed",
      "notation": "SCH:SUPPLIER-CATALOGUE",
      "level": "element",
      "label": {
        "en": "Supplier catalogue",
        "nb": "Produsentkatalog"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/schemas",
      "schemaVersion": 1,
      "stage": "published",
      "writtenBy": "a paper or equipment maker",
      "holds": "the maker's series, grades and models, mapped to generic terms",
      "jsonSchema": "https://ptpge.org/v1/schemas/supplier-catalogue/1.schema.json",
      "definition": {
        "en": "A maker's own series, grades and models, each mapped to the generic terms it embodies (substrate, weight, technology). Written and kept current by the maker; carries the maker's identity (/v1/suppliers/…). The vocabulary stays free of company names because this document exists.",
        "nb": "Produsentens egne serier, kvaliteter og modeller, hver knyttet til de generiske termene den representerer (substrat, vekt, teknologi). Skrives og holdes à jour av produsenten; bærer produsentens identitet (/v1/suppliers/…). Vokabularet holdes fritt for firmanavn fordi dette dokumentet finnes."
      },
      "created": "2026-10-06T19:16:59Z",
      "modified": "2026-10-10T21:40:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "location": "https://<domain>/.well-known/ptpge/catalogue.json",
      "carries": [
        "identity — the maker's register URI (/v1/suppliers/<slug>)",
        "logo — optional, URL or data URI; shown on the register entry",
        "schemaVersion — the version of this schema the document follows"
      ],
      "note": {
        "en": "Published by the maker on its own domain at the known path (SD-0101). The register at ptpge.org points at the domain and validates the document; it never stores a copy. JSON Schema published 2026-10-10 (draft 2020-12): a flat list of items with stable ids and parent links — series, grades, shades, models — each with the vocabulary class it embodies and, per variable, the terms the maker states; product names live only here; a vendor declaration refers to an item as {supplier, item}. Reference validator: tools/validate_declaration.py.",
        "nb": "Publiseres av produsenten på eget domene på den kjente stien (SD-0101). Registeret på ptpge.org peker på domenet og validerer dokumentet; det lagrer aldri en kopi. JSON Schema publisert 2026-10-10 (draft 2020-12): en flat liste av oppføringer med stabile id-er og foreldrelenker — serier, kvaliteter, nyanser, modeller — hver med vokabularklassen den representerer og, per variabel, termene produsenten oppgir; produktnavn finnes bare her; en leverandørdeklarasjon viser til en oppføring som {supplier, item}."
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/schemas/ucp-manifest/1",
      "type": "ptpge:Schema",
      "version": "2026-10-12",
      "status": "proposed",
      "notation": "SCH:UCP-MANIFEST",
      "level": "element",
      "label": {
        "en": "UCP manifest",
        "nb": "UCP-manifest"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/schemas",
      "schemaVersion": 1,
      "stage": "published",
      "writtenBy": "a storefront",
      "holds": "the PTPGE identity on a checkout line",
      "jsonSchema": "https://ptpge.org/v1/schemas/ucp-manifest/1.schema.json",
      "definition": {
        "en": "How a storefront carries the PTPGE identity in a Universal Commerce Protocol manifest: the fingerprint on the line item, the configuration behind it resolvable at ptpge.org/f. The bridge from the specification to agentic checkout.",
        "nb": "How a storefront carries the PTPGE identity in a Universal Commerce Protocol manifest: the fingerprint on the line item, the configuration behind it resolvable at ptpge.org/f. The bridge from the specification to agentic checkout."
      },
      "created": "2026-10-06T19:16:59Z",
      "modified": "2026-10-10T22:50:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "location": "https://<domain>/.well-known/ucp",
      "carries": [
        "ucp.capabilities[\"org.ptpge.print.identity\"] — the published extension (spec ptpge.org/ucp/identity, schema ptpge.org/ucp/schemas/identity.json), extending dev.ucp.shopping.checkout",
        "ptpge.identity — the printer's register URI (/v1/vendors/<slug>)",
        "ptpge.declaration — the vendor declaration at its known path on the same domain",
        "ptpge.vocabulary · ptpge.fingerprint — https://ptpge.org/v1/ and ptpge-cfs/1 with resolver ptpge.org/f/",
        "item.ptpge.fingerprint on every checkout line item — the identity of what is bought"
      ],
      "note": {
        "en": "The manifest is UCP's document at UCP's known path; this schema validates only the PTPGE parts of it and leaves the rest open. Capability and offerings do not belong in the manifest — they live in the vendor declaration the manifest points to (SD-0101). JSON Schema published 2026-10-10 (draft 2020-12). Reference validator: tools/validate_declaration.py (detects a manifest by its ucp + ptpge blocks; checks same domain, known path, the capability entry, the ptpge block).",
        "nb": "Manifestet er UCPs dokument på UCPs kjente sti; dette skjemaet validerer bare PTPGE-delene og lar resten stå åpent. Kapasitet og tilbud hører ikke hjemme i manifestet — de ligger i leverandørdeklarasjonen manifestet peker på (SD-0101). JSON Schema publisert 2026-10-10 (draft 2020-12)."
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/schemas/vendor-declaration/1",
      "type": "ptpge:Schema",
      "version": "2026-10-12",
      "status": "proposed",
      "notation": "SCH:VENDOR-DECLARATION",
      "level": "element",
      "label": {
        "en": "Vendor declaration",
        "nb": "Leverandørdeklarasjon"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/schemas",
      "schemaVersion": 1,
      "stage": "published",
      "writtenBy": "a printer, or its MIS",
      "holds": "identity · capability · offerings",
      "jsonSchema": "https://ptpge.org/v1/schemas/vendor-declaration/1.schema.json",
      "definition": {
        "en": "What a printer is and can make, in the vocabulary: identity, production capability, the products it offers. Written by the printer or its MIS; carries the printer's identity (/v1/vendors/…).",
        "nb": "Hva et trykkeri er og kan lage, i vokabularet: identitet, produksjonskapasitet, produktene det tilbyr. Skrives av trykkeriet eller dets MIS; bærer trykkeriets identitet (/v1/vendors/…)."
      },
      "created": "2026-10-06T19:16:59Z",
      "modified": "2026-10-12T11:40:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "location": "https://<domain>/.well-known/ptpge/declaration.json",
      "carries": [
        "identity — the printer's register URI (/v1/vendors/<slug>)",
        "logo — optional, URL or data URI; shown on the register entry",
        "schemaVersion — the version of this schema the document follows"
      ],
      "note": {
        "en": "Published by the printer on its own domain at the known path (SD-0101). The register at ptpge.org points at the domain and validates the document; it never stores a copy. Prices and price rules are not part of this document — they belong to the printer's agreement with whatever implementation quotes for it. JSON Schema published 2026-10-10 (draft 2020-12): every vocabulary value is a term URI, never a label; a press is a supplier URI plus the maker's model designation; an offering is a product template plus, per variable, the values accepted. Reference validator: tools/validate_declaration.py in the PTPGE repository. Since 2026-10-12 (SD-0102) a key in supports may carry a part scope, <variable>@<part>, for the substrate variables — substrate-weight@cover and substrate-weight@inside for a booklet whose cover and inside are different sheets; the part must be one the product's setup model declares.",
        "nb": "Publiseres av trykkeriet på eget domene på den kjente stien (SD-0101). Registeret på ptpge.org peker på domenet og validerer dokumentet; det lagrer aldri en kopi. Priser og prisregler er ikke del av dokumentet — de hører til trykkeriets avtale med den implementasjonen som gir tilbud. JSON Schema publisert 2026-10-10 (draft 2020-12): alle vokabularverdier er term-URI-er, aldri etiketter; en presse er leverandør-URI pluss produsentens modellbetegnelse; et tilbud er en produktmal pluss, per variabel, de verdiene som aksepteres. Fra 2026-10-12 (SD-0102) kan en nøkkel i supports bære et del-scope, <variabel>@<del>, for substratvariablene — substrate-weight@cover og substrate-weight@inside for et hefte der omslag og innmat er forskjellige ark; delen må være en som produktets setup-modell erklærer."
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/suppliers",
      "type": "skos:Concept",
      "version": "2026-10-06",
      "status": "proposed",
      "notation": "SUP",
      "level": "top-concept",
      "label": {
        "en": "Suppliers",
        "nb": "Produsenter",
        "de": "Hersteller",
        "sv": "Leverantörer",
        "da": "Leverandører",
        "nl": "Fabrikanten"
      },
      "definition": {
        "en": "The register of makers — press, printer, finishing-equipment and paper manufacturers — each with one permanent PTPGE identity. A supplier's series, grades and models live in its own supplier catalogue, not in the vocabulary. A register, not the specification: the vocabulary itself carries no company names.",
        "nb": "Registeret over produsenter – presse-, skriver-, etterbehandlings- og papirprodusenter – hver med én permanent PTPGE-identitet. En produsents serier, kvaliteter og modeller lever i dens egen produsentkatalog, ikke i vokabularet. Et register, ikke spesifikasjonen: selve vokabularet bærer ingen firmanavn."
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "topConceptOf": "https://ptpge.org/v1/scheme",
      "created": "2026-10-06T19:16:59Z",
      "modified": "2026-10-09T10:30:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "narrower": [
        "https://ptpge.org/v1/suppliers/antalis",
        "https://ptpge.org/v1/suppliers/canon",
        "https://ptpge.org/v1/suppliers/harry-rochat",
        "https://ptpge.org/v1/suppliers/heidelberg",
        "https://ptpge.org/v1/suppliers/komori",
        "https://ptpge.org/v1/suppliers/lessebo",
        "https://ptpge.org/v1/suppliers/manroland",
