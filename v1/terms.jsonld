        "https://ptpge.org/contributors/patrik-knutsson"
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/sheet-materials/magnetic-foil",
      "type": "skos:Concept",
      "version": "2026-08-22",
