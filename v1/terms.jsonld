      "label": {
        "en": "Express Delivery",
        "nb": "Ekspresslevering",
        "de": "Expressversand",
        "es": "Entrega exprés",
        "ja": "速達配送",
        "zh-Hans": "加急配送",
        "sv": "Expressleverans",
        "da": "Ekspreslevering",
        "nl": "Expreslevering",
