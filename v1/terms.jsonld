        "sv": "Leveranssätt",
        "da": "Leveringsmetoder",
        "nl": "Leveringsmethoden",
        "pl": "Sposoby dostawy",
        "pt": "Métodos de entrega",
        "hi": "डिलीवरी विधियाँ"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "distribution",
      "broader": "https://ptpge.org/v1/ordering/distribution",
      "created": "2026-06-26T05:36:54Z",
