      "label": {
        "en": "Roll Fold",
        "es": "Pliegue Enrollado",
        "zh-Hans": "卷折",
        "nb": "Rull-fold",
        "de": "Wickelfalz",
        "ja": "巻き折り",
        "sv": "Rullfals",
        "da": "Rullefals",
        "nl": "Rolvouw (wikkelvouw)",
        "pl": "Złam zwijany",
        "pt": "Dobra envolvente",
        "hi": "रोल फ़ोल्ड"
