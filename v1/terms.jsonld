          "Nanography",
          "Nanographic printing"
        ],
        "nb": [
          "Nanografi"
        ],
        "pl": [
          "nanografia",
          "druk nanograficzny"
        ],
        "pt": [
          "Nanografia",
          "Impressão nanográfica"
        ],
        "hi": [
          "नैनोग्राफ़ी",
          "नैनोग्राफ़िक प्रिंटिंग"
        ]
      },
