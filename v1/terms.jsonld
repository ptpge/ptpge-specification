        "es": "Tarjeta de Visita ISO 216 (74 × 52 mm)",
        "zh-Hans": "ISO 216名片 (74 × 52 mm)",
        "nb": "Business Card ISO 216 (74 x 52 mm)",
        "de": "Business Card ISO 216 (74 x 52 mm)",
        "ja": "Business Card ISO 216 (74 x 52 mm)",
