      "label": {
        "en": "Business Card Japan (91 x 55 mm)",
        "es": "Tarjeta de Visita Japonesa (91 × 55 mm)",
        "zh-Hans": "日本名片 (91 × 55 mm)",
        "nb": "Business Card Japan 91 x 55 mm)",
        "de": "Business Card Japan 91 x 55 mm)",
        "ja": "Business Card Japan 91 x 55 mm)",
        "nl": "Visitekaartje Japan (91 x 55 mm)",
        "sv": "Visitkort Japan (91 x 55 mm)",
        "da": "Visitkort Japan (91 x 55 mm)",
        "pl": "Wizytówka Japonia (91 x 55 mm)",
        "pt": "Cartão de visita Japão (91 x 55 mm)",
