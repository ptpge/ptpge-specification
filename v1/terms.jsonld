      "scope": "product",
      "valueDomain": "https://ptpge.org/v1/printing/configurations/shape",
      "inScheme": "https://ptpge.org/v1/scheme",
      "broader": "https://ptpge.org/v1/variables/configuration",
      "created": "2026-05-30T00:00:00Z",
