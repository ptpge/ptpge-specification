          "Top edge",
          "Top-edge binding",
          "Top fold",
          "Top-bound",
          "Calendar binding"
        ],
        "nb": [
          "Topp kant",
          "Toppbundet",
          "Topp fals"
        ],
        "pl": [
          "krawędź górna",
          "oprawa górna",
          "złam górny",
          "oprawa kalendarzowa"
        ],
        "pt": [
