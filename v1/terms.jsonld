        "ja": {
          "status": "llm-draft",
          "generated": "2026-05-08",
          "method": "LLM-generated initial translation using established Japanese print-industry terminology (印刷, 製版, 規格, 色空間, 色域, 認証制度, 用紙寸法, 製本, 仕上げ, 折り, 校正). Loanwords used where they are the established industry term (デジタル, インクジェット, ラミネート).",
          "review": "Not yet reviewed by professional Japanese print-domain translator. Targeted for v1.1 (Q3 2026) — Japan is the centre of gravity for the global digital production-press industry (Komori, Konica Minolta, Canon, Ricoh, Fujifilm, Mimaki, Mutoh, Roland DG, Brother, Mitsubishi, Horizon, Duplo) — so professional verification is the highest-priority language milestone."
        },
        "es": {
          "status": "llm-draft",
          "generated": "2026-05-18",
          "method": "LLM-generated initial translation; terminology choices documented in tools/_translate_es_*.py.",
          "review": "Not yet reviewed by professional translator. Targeted for v1.2 (Q4 2026). Use with the understanding that terminology may need refinement (e.g., regional variants for huecograbado/rotograbado, sustrato/soporte, encuadernación rústica/perfecta)."
        },
        "zh-Hans": {
          "status": "llm-draft",
          "generated": "2026-05-18",
          "method": "LLM-generated initial translation using mainland China print-industry terminology (承印物, 印后加工, 装订, 折页, 模切, etc.). Terminology choices documented in tools/_translate_zh_*.py.",
          "review": "Not yet reviewed by professional translator. Targeted for v1.3 (Q1 2027). Use with the understanding that terminology may need refinement for regional variants (mainland vs. Taiwan/HK conventions) or vendor-specific preferences."
        },
        "sv": {
          "status": "llm-draft",
          "generated": "2026-08-15",
          "method": "LLM-generated initial translation using established Swedish print-trade terminology (arkoffset, rulloffset, djuptryck, bigning via 'bigning/big', limbindning, klammerhäftning, foliering, bestruket/obestruket papper, färgrymd, dekorfärg, efterbehandling). Conservative altLabels added only where a second trade synonym is well established (serigrafi, högtryck, flexografi, tampotryck, limhäftning, sublimering).",
          "review": "Not yet reviewed by professional Swedish print-domain translator. Review and enrichment by a Swedish print-trade partner is planned ahead of the wider language-sponsorship programme."
        },
        "da": {
          "status": "llm-draft",
          "generated": "2026-08-16",
          "method": "LLM-generated initial translation using established Danish print-trade terminology (arkoffset, rotationsoffset, dybtryk, limbinding, hæftning med klammer via 'klammerhæftning', falsning, foliering, bestrøget/ubestrøget papir, farverum, staffagefarve, færdiggørelse). Conservative altLabels added only where a second trade synonym is well established.",
          "review": "Not yet reviewed by professional Danish print-domain translator."
        },
        "nl": {
          "status": "llm-draft",
          "generated": "2026-08-16",
          "method": "LLM-generated initial translation using established Dutch/Flemish print-trade terminology (vellenoffset, rotatieoffset, diepdruk, garenloos binden, nieten (hechten), rillen, stansen, gestreken/ongestreken papier, steunkleur, afwerking). 139 pre-existing Dutch labels (from external field-mapping work) were preserved unchanged. Conservative altLabels added only where a second trade synonym is well established.",
          "review": "Not yet reviewed by professional Dutch print-domain translator. VIGC (Flanders) is the natural review channel via the ongoing field-mapping collaboration."
        },
        "pl": {
          "status": "llm-draft",
          "generated": "2026-09-08",
          "method": "LLM-generated initial translation using established Polish print-trade terminology (offset arkuszowy, offset zwojowy, wklęsłodruk, fleksografia, sitodruk, typografia, oprawa klejona, oprawa zeszytowa, bigowanie, wykrawanie, papier powlekany/niepowlekany, kolor dodatkowy, uszlachetnienie, wykończenie, podłoże, gramatura). Inch-based North American format labels (ANSI, Arch, US Letter family) keep their English label form, as in the other languages. altLabels.pl follow the English altLabel set plus Polish trade synonyms; cross-term collisions were pruned before publication (SD-0071).",
          "review": "Not yet reviewed by professional Polish print-domain translator. Reviewer channel to be confirmed."
        },
        "pt": {
          "status": "llm-draft",
          "generated": "2026-09-22",
          "method": "LLM-generated initial translation in Portuguese with Acordo Ortográfico spelling readable in Brazil and Portugal, using established Portuguese-language print-trade terminology (offset plano/rotativo, rotogravura, flexografia, serigrafia, tipografia, encadernação colada/canoa/espiral, vinco, corte e vinco, papel couché/offset, gramatura, cor especial/Pantone, acabamento, laminação, verniz, substrato). Brand names, format codes and ISO references pass through unchanged, as in the other languages. Translations are kept as reviewable data files in tools/i18n/.",
          "review": "Not yet reviewed by a professional Portuguese-language print-domain translator. Brazil is the natural review channel (largest Portuguese-language print market); a Portuguese (PT) reviewer for European usage is welcome. Candidate for the first language-sponsorship (SD-0017 §3)."
        },
        "hi": {
          "status": "llm-draft",
          "generated": "2026-09-22",
          "method": "LLM-generated initial translation in Hindi (Devanagari script). Follows Indian print-trade practice: established English trade terms are transliterated into Devanagari where that is what the trade says (ऑफसेट, लैमिनेशन, फ्लेक्सो, डाई-कट, कोटेड पेपर, पैंटोन), native Hindi is used where it is current (कागज़, छपाई, बाइंडिंग/जिल्दसाज़ी, मोड़, रंग, आकार). Brand names, format codes and ISO references pass through unchanged. Translations are kept as reviewable data files in tools/i18n/.",
          "review": "Not yet reviewed by a professional Hindi print-domain translator. Reviewer channel to be confirmed (North Indian print associations; Delhi/Mumbai printers). English remains the working language of much of the Indian trade, so Hindi labels serve buyers first."
        }
