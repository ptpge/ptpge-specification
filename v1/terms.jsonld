        ],
        "pl": [
          "papier w roli",
          "rola papieru",
          "papier zwojowy"
        ],
        "pt": [
          "bobina de papel",
          "rolo de papel",
          "papel em bobina"
        ],
        "hi": [
          "काग़ज़ का रोल",
          "पेपर रील",
          "रोल पेपर"
        ]
