          "na rolce",
          "pakowanie rolkowe"
        ],
        "pt": [
          "enrolado",
          "em rolo",
          "embalagem em rolo"
        ],
        "hi": [
          "लपेटा हुआ",
          "रोल पैकेजिंग",
          "रोल करके"
        ]
      },
