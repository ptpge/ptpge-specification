    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/quality-assurance/proofing/proof-approval/changes-requested",
      "type": "skos:Concept",
      "version": "2026-07-18",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Changes Requested",
        "nb": "Endringer ønsket",
        "de": "Änderungen angefordert",
        "ja": "修正依頼",
        "es": "Cambios solicitados",
        "zh-Hans": "要求修改",
        "sv": "Ändringar begärda",
        "da": "Ændringer ønsket",
        "nl": "Wijzigingen gevraagd",
        "pl": "Zgłoszono poprawki",
        "pt": "Alterações solicitadas",
        "hi": "बदलाव अनुरोधित"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "management",
      "notation": "P:MG§CHANGES-REQUESTED",
      "broader": "https://ptpge.org/v1/printing/management/quality-assurance/proofing/proof-approval",
      "created": "2026-07-18T00:00:00Z",
