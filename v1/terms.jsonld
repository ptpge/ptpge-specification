      "label": {
        "en": "FINAT 8",
        "nb": "FINAT 8",
        "de": "FINAT 8",
        "es": "FINAT 8",
        "ja": "FINAT 8",
        "zh-Hans": "FINAT 8",
        "sv": "FINAT 8",
