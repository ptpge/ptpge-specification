      "notation": "P:CF§HEAD-TO-HEAD",
      "label": {
        "en": "Head-to-head",
        "nb": "Topp-mot-topp",
        "de": "Kopf-an-Kopf",
        "es": "Cabeza con cabeza",
        "ja": "天地同方向",
        "zh-Hans": "天对天",
        "sv": "Huvud-mot-huvud",
        "da": "Top-mod-top",
        "nl": "Kop-aan-kop",
