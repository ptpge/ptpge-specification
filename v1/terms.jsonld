        "zh-Hans": "纸张尺寸标准",
        "nb": "Papirformat-standarder",
        "de": "Papierformatstandards",
        "ja": "用紙サイズ規格",
        "sv": "Pappersformatstandarder",
        "da": "Papirformatstandarder",
        "nl": "Papierformaatstandaarden",
        "pl": "Standardy formatów papieru",
        "pt": "Normas de tamanho de papel",
