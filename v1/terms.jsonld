        "zh-Hans": "PNG (.png)",
        "nb": "Portable Network Group (.png)",
        "de": "Portable Network Group (.png)",
        "ja": "Portable Network Group (.png)",
        "sv": "PNG (.png)",
        "da": "PNG (.png)",
        "nl": "PNG (.png)",
