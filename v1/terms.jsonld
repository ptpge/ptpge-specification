    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics/joint-picture-expert-group",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Joint Picture Expert Group (.jpg)",
        "es": "JPEG (.jpg)",
        "zh-Hans": "JPEG (.jpg)",
        "nb": "Joint Picture Expert Group (.jpg)",
        "de": "Joint Picture Expert Group (.jpg)",
        "ja": "Joint Picture Expert Group (.jpg)",
        "sv": "JPEG (.jpg)",
        "da": "JPEG (.jpg)",
        "nl": "JPEG (.jpg)",
