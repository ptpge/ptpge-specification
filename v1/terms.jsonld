        ],
        "pt": [
          "tratamento de dados"
        ],
        "hi": [
          "डेटा हैंडलिंग"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/workflow/efficiency-tools",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "sub-category",
      "label": {
        "en": "Efficiency Tools",
        "es": "Herramientas de Eficiencia",
        "zh-Hans": "效率工具",
        "nb": "Effektivitetsverktøy",
        "de": "Effizienzwerkzeuge",
        "ja": "効率化ツール",
        "sv": "Effektivitetsverktyg",
        "da": "Effektivitetsværktøjer",
        "nl": "Efficiencytools",
        "pl": "Narzędzia efektywności",
        "pt": "Ferramentas de eficiência",
        "hi": "दक्षता औज़ार"
