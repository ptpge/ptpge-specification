        ],
        "pl": [
          "TIN",
          "Wydrukowano w Norwegii"
        ],
        "pt": [
          "TIN",
          "Impresso na Noruega"
        ],
        "hi": [
          "TIN",
          "नॉर्वे में मुद्रित"
        ]
      },
