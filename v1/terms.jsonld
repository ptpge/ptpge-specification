        "sv": "Hybridgrafik",
        "da": "Hybridgrafik",
        "nl": "Hybride graphics",
        "pl": "Grafika hybrydowa",
        "pt": "Gráficos híbridos",
        "hi": "हाइब्रिड ग्राफ़िक्स"
