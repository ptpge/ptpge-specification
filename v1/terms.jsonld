    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/ordering/knowledge/guides",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "category",
      "notation": "O:KN-GUI",
      "label": {
        "en": "Guides",
        "nb": "Veiledninger",
        "de": "Anleitungen",
        "ja": "ガイド",
        "es": "Guías",
        "zh-Hans": "指南",
        "sv": "Guider",
        "da": "Guider",
        "nl": "Gidsen",
        "pl": "Przewodniki",
        "pt": "Guias",
        "hi": "गाइड"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "knowledge",
      "broader": "https://ptpge.org/v1/ordering/knowledge",
      "narrower": [
        "https://ptpge.org/v1/ordering/knowledge/guides/standard-paper-sizes",
        "https://ptpge.org/v1/ordering/knowledge/guides/printing-formats-page-sizes",
        "https://ptpge.org/v1/ordering/knowledge/guides/folding-types-creasing",
        "https://ptpge.org/v1/ordering/knowledge/guides/binding-types-finishing",
        "https://ptpge.org/v1/ordering/knowledge/guides/colours-icc-profiles",
        "https://ptpge.org/v1/ordering/knowledge/guides/resolutions-file-sizes",
        "https://ptpge.org/v1/ordering/knowledge/guides/paper-material-qualities",
        "https://ptpge.org/v1/ordering/knowledge/guides/bleed-safety-margins",
        "https://ptpge.org/v1/ordering/knowledge/guides/fonts-paths",
        "https://ptpge.org/v1/ordering/knowledge/guides/file-formats-print-ready-pdfs",
        "https://ptpge.org/v1/ordering/knowledge/guides/digital-vs-offset-printing",
        "https://ptpge.org/v1/ordering/knowledge/guides/environment-sustainability"
      ],
      "created": "2026-05-18T12:24:24Z",
      "modified": "2026-09-22T16:33:00Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Educational guides that explain print-domain concepts to buyers in plain language. Each guide cross-references the vocabulary terms it covers via skos:related, providing a bridge between buyer-facing documentation and the production-side vocabulary.",
        "nb": "Pedagogiske veiledninger som forklarer print-domene-konsepter for kjøpere på enkelt språk. Hver veiledning cross-refererer vokabulartermene den dekker via skos:related, og skaper en bro mellom kjøper-vendt dokumentasjon og produsentsidens vokabular.",
        "de": "Pädagogische Anleitungen, die Druckdomänenkonzepte in einfacher Sprache für Käufer erläutern. Jede Anleitung verweist über skos:related auf die abgedeckten Layer-1-Begriffe und bildet eine Brücke zwischen käuferorientierter Dokumentation und produzentenseitigem Vokabular.",
        "ja": "印刷分野の概念を購入者向けに平易な言葉で説明する教育ガイド。各ガイドは説明対象の語彙用語をskos:relatedで相互参照し、購入者向けドキュメントと生産者側の語彙との橋渡しを行う。",
        "es": "Guías educativas que explican los conceptos del ámbito de la impresión a los compradores en lenguaje sencillo. Cada guía referencia mediante skos:related los términos de la Capa 1 que cubre, proporcionando un puente entre la documentación orientada al comprador y el vocabulario del lado de producción.",
        "zh-Hans": "以通俗语言向买方解释印刷领域概念的教学指南。每篇指南通过 skos:related 交叉引用其涵盖的 词汇术语，在面向买方的文档与生产方词汇之间架起桥梁。",
        "sv": "Utbildande guider som förklarar tryckdomänens begrepp för köpare på ett enkelt språk. Varje guide korsrefererar de vokabulärtermer den täcker via skos:related och slår en bro mellan köparvänd dokumentation och produktionssidans vokabulär.",
        "da": "Pædagogiske guider, der forklarer trykfaglige begreber for købere i et klart sprog. Hver guide krydshenviser via skos:related til de lag 1-termer, den dækker — en bro mellem køberrettet dokumentation og produktionsvokabularet.",
        "nl": "Educatieve gidsen die drukbegrippen in heldere taal aan kopers uitleggen. Elke gids verwijst via skos:related naar de laag 1-termen die hij behandelt — een brug tussen kopersgerichte documentatie en het productievocabulaire.",
        "pl": "Przewodniki edukacyjne objaśniające nabywcom pojęcia z dziedziny druku prostym językiem. Każdy przewodnik odwołuje się poprzez skos:related do terminów warstwy 1, które omawia, łącząc dokumentację dla nabywców ze słownictwem produkcyjnym.",
        "pt": "Guias educativos que explicam conceitos do domínio gráfico aos compradores em linguagem simples. Cada guia referencia via skos:related os termos da Camada 1 que cobre, fazendo a ponte entre a documentação voltada ao comprador e o vocabulário do lado da produção.",
        "hi": "शैक्षिक गाइड जो मुद्रण क्षेत्र की संकल्पनाएँ खरीदारों को सरल भाषा में समझाते हैं। हर गाइड skos:related के ज़रिए उन लेयर 1 पदों को संदर्भित करता है जिन्हें वह कवर करता है — खरीदार-उन्मुख दस्तावेज़ीकरण और उत्पादन-पक्ष की शब्दावली के बीच सेतु।"
      }
    },
