      "label": {
        "en": "RGB",
        "es": "RGB",
        "zh-Hans": "RGB",
        "nb": "RGB",
        "de": "RGB",
        "ja": "RGB",
        "sv": "RGB",
        "da": "RGB",
        "nl": "RGB",
        "pl": "RGB",
