      "label": {
        "en": "C Series (ISO 269)",
        "es": "Serie C (ISO 269)",
        "zh-Hans": "C系列（ISO 269）",
        "nb": "C-serie (ISO 269)",
        "de": "C-Reihe (ISO 269)",
        "ja": "C判（ISO 269）",
        "sv": "C-serien (ISO 269)",
        "da": "C-serien (ISO 269)",
        "nl": "C-reeks (ISO 269)",
        "pl": "Seria C (ISO 269)",
        "pt": "Série C (ISO 269)",
        "hi": "C सीरीज़ (ISO 269)"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
