        ],
        "pl": [
          "współpraca",
          "narzędzia do przeglądu"
        ],
        "pt": [
          "colaboração",
          "ferramentas de revisão"
        ],
        "hi": [
          "सहयोग",
          "समीक्षा औज़ार"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/workflow/file-preparation",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "sub-category",
      "label": {
        "en": "File Preparation",
        "es": "Preparación de Archivos",
        "zh-Hans": "文件准备",
        "nb": "Fil-klargjøring",
        "de": "Dateivorbereitung",
        "ja": "ファイル準備",
        "sv": "Filförberedelse",
        "da": "Filklargøring",
        "nl": "Bestandsvoorbereiding",
        "pl": "Przygotowanie plików",
        "pt": "Preparação de arquivos",
        "hi": "फ़ाइल तैयारी"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "management",
      "broader": "https://ptpge.org/v1/printing/management/workflow",
      "narrower": [
        "https://ptpge.org/v1/printing/management/workflow/file-preparation/impositioning",
        "https://ptpge.org/v1/printing/management/workflow/file-preparation/raster-image-processing"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:54:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Technical operations that transform print-ready design files into press-specific output — imposition (arranging pages on a sheet), RIP processing (rasterizing for the press), and trapping.",
        "nb": "Tekniske operasjoner som transformerer trykkferdige designfiler til presse-spesifikt output — impositioning (arrangere sider på et ark), RIP-prosessering (rasterisering for pressen) og trapping.",
        "de": "Technische Operationen, die druckfertige Designdateien in maschinenspezifische Ausgaben umwandeln — Ausschießen (Anordnung der Seiten auf einem Bogen), RIP-Verarbeitung (Rasterung für die Druckmaschine) und Trapping.",
        "ja": "印刷可能なデザインファイルを印刷機固有の出力に変換する技術的工程 — 面付け（シート上のページ配置）、RIP処理（印刷機向けのラスタ化）、トラッピング。",
        "es": "Operaciones técnicas que transforman archivos de diseño listos para imprenta en la salida específica de la prensa — imposición (disposición de páginas en una hoja), procesamiento RIP (rasterización para la prensa) y trapping.",
        "zh-Hans": "将印刷就绪的设计文件转换为印刷机专用输出的技术操作——拼版（将页面排布于纸张上）、RIP处理（光栅化以供印刷机）和补漏白。",
        "sv": "Tekniska operationer som omvandlar tryckfärdiga designfiler till presspecifik utdata — utskjutning (sidplacering på ark), RIP-bearbetning (rastrering för pressen) och trapping.",
        "da": "Tekniske operationer, der forvandler trykklare designfiler til pressespecifikt output — udskydning (arrangering af sider på et ark), RIP-behandling (rastering til pressen) og trapping.",
        "nl": "Technische bewerkingen die drukklare ontwerpbestanden omzetten naar persspecifieke output — impositie (pagina's schikken op een vel), RIP-verwerking (rasteren voor de pers) en trapping.",
        "pl": "Operacje techniczne przekształcające gotowe do druku pliki projektowe w wyjście właściwe dla maszyny — impozycja (rozmieszczenie stron na arkuszu), przetwarzanie RIP (rasteryzacja dla maszyny) i trapping.",
        "pt": "Operações técnicas que transformam arquivos de design prontos para impressão em saída específica para a máquina — imposição (arranjo de páginas numa folha), processamento RIP (rasterização para a máquina) e trapping.",
        "hi": "तकनीकी क्रियाएँ जो प्रिंट-रेडी डिज़ाइन फ़ाइलों को प्रेस-विशिष्ट आउटपुट में बदलती हैं — इम्पोज़िशन (शीट पर पेज व्यवस्थित करना), RIP प्रोसेसिंग (प्रेस के लिए रास्टराइज़ करना) और ट्रैपिंग।"
      },
      "scopeNote": {
        "en": "Includes impositioning (page arrangement, signature layout, gripper margins) and RIP (raster image processing — converting vector PDFs into the bitmap format the press needs). Both are typically integrated into the broader workflow automation platform but exist as distinct technical operations.",
        "nb": "Inkluderer impositioning (sidearrangering, signaturoppsett, griper-marger) og RIP (raster image processing — konverterer vektor-PDF-er til bitmap-formatet pressen trenger). Begge er typisk integrert i den bredere workflow-automasjonsplattformen, men eksisterer som distinkte tekniske operasjoner.",
        "de": "Umfasst Ausschießen (Seitenanordnung, Bogenlayout, Greiferränder) und RIP (Raster Image Processing — Konvertierung vektorbasierter PDFs in das Bitmap-Format, das die Druckmaschine benötigt). Beide sind typischerweise in die übergeordnete Workflow-Automatisierungsplattform integriert, existieren aber als eigenständige technische Operationen.",
        "ja": "面付け（ページ配置、折り丁レイアウト、グリッパーマージン）とRIP（ラスター画像処理 — ベクターPDFを印刷機が必要とするビットマップ形式に変換）を含む。両者とも通常はより広範なワークフロー自動化プラットフォームに統合されているが、独立した技術的工程として存在する。",
        "es": "Incluye imposición (disposición de páginas, maquetación de pliegos, márgenes de pinza) y RIP (Raster Image Processor — conversión de PDF vectoriales al formato bitmap que necesita la prensa). Ambos suelen estar integrados en motores de automatización.",
        "zh-Hans": "包括拼版（页面排布、印张布局、咬口边距）和RIP（光栅图像处理器——将矢量PDF转换为印刷机所需的位图格式）。两者通常集成在自动化引擎中。",
        "pt": "Inclui imposição (arranjo de páginas, layout de cadernos, margens de pinça) e RIP (processamento de imagem raster — conversão de PDFs vetoriais no formato bitmap que a máquina precisa). Ambos são normalmente integrados à plataforma mais ampla de automação de fluxo de trabalho, mas existem como operações técnicas distintas.",
        "hi": "इम्पोज़िशनिंग (पेज व्यवस्था, सिग्नेचर लेआउट, ग्रिपर मार्जिन) और RIP (रास्टर इमेज प्रोसेसिंग — वेक्टर PDF को प्रेस के आवश्यक बिटमैप फ़ॉर्मेट में बदलना) शामिल। दोनों आमतौर पर व्यापक वर्कफ़्लो स्वचालन प्लेटफ़ॉर्म में एकीकृत, पर अलग तकनीकी क्रियाओं के रूप में विद्यमान।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "notation": "P:MG-WFL-FLPR"
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/management/workflow/file-preparation/impositioning",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Impositioning",
        "es": "Imposición",
        "zh-Hans": "拼版",
        "nb": "Påtegning / imposition",
        "de": "Ausschießen",
        "ja": "面付け",
        "sv": "Utskjutning",
        "da": "Udskydning",
        "nl": "Impositie (uitschieten)",
        "pl": "Impozycja",
        "pt": "Imposição",
        "hi": "इम्पोज़िशनिंग"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "management",
      "notation": "P:MG§IMPOSITIONING",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/management/workflow/file-preparation",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:54:01Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Arrangement of multiple pages on a single press sheet so that, after printing, folding, and cutting, the pages appear in correct sequence in the finished product. Critical for books, brochures, and any signature-based bindery.",
        "nb": "Arrangering av flere sider på et enkelt presseark slik at sidene etter trykk, folding og kutting fremstår i riktig rekkefølge i det ferdige produktet. Kritisk for bøker, brosjyrer og enhver signaturbasert innbinding.",
        "de": "Anordnung mehrerer Seiten auf einem einzelnen Druckbogen, sodass die Seiten nach Druck, Falzen und Schneiden in der korrekten Reihenfolge im fertigen Produkt erscheinen. Unverzichtbar für Bücher, Broschüren und alle bogenbasierten Bindungsarten.",
        "ja": "印刷、折り、断裁の後、完成品でページが正しい順序で表示されるように、複数のページを1枚の印刷シートに配置する作業。書籍、ブローシュア、折り丁ベースの製本に不可欠。",
        "es": "Disposición de páginas individuales sobre un pliego de impresión para que, tras imprimir, plegar y cortar, queden en el orden correcto en el producto final.",
        "zh-Hans": "将单个页面在印刷纸张上的排布，使得在印刷、折页和裁切后页面在最终产品中按正确顺序排列。",
        "sv": "Placering av flera sidor på ett och samma tryckark så att sidorna efter tryck, falsning och skärning hamnar i rätt ordning i den färdiga produkten. Avgörande för böcker, broschyrer och all arkbaserad bokbindning.",
        "da": "Arrangering af flere sider på ét trykark, så siderne efter tryk, falsning og skæring står i korrekt rækkefølge i det færdige produkt. Kritisk for bøger, brochurer og alt flersidet.",
        "nl": "Het schikken van meerdere pagina's op één drukvel zodat de pagina's na drukken, vouwen en snijden in de juiste volgorde in het eindproduct staan. Cruciaal voor boeken, brochures en alles wat meerpagina is.",
        "pl": "Rozmieszczenie wielu stron na jednym arkuszu drukowym tak, aby po zadrukowaniu, złożeniu i przycięciu strony pojawiły się we właściwej kolejności w gotowym produkcie. Kluczowe dla książek, broszur i każdej introligatorni pracującej na składkach.",
        "pt": "Arranjo de várias páginas numa única folha de máquina de modo que, após impressão, dobra e corte, as páginas apareçam na sequência correta no produto acabado. Crítico para livros, folhetos e qualquer encadernação baseada em cadernos.",
        "hi": "एक ही प्रेस शीट पर कई पेजों की व्यवस्था ताकि छपाई, फ़ोल्डिंग और कटिंग के बाद पेज तैयार उत्पाद में सही क्रम में आएँ। पुस्तकों, ब्रोशर और किसी भी सिग्नेचर-आधारित बाइंडरी के लिए महत्वपूर्ण।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "imposition",
          "page imposition"
        ],
        "nb": [
          "montasje",
          "utskyting"
        ],
        "pl": [
          "montaż elektroniczny",
          "impozycja stron",
          "rozmieszczenie użytków"
        ],
        "pt": [
          "imposição de páginas",
          "montagem"
        ],
        "hi": [
          "इम्पोज़िशन",
          "पेज इम्पोज़िशन"
        ]
      },
      "semanticSource": [
