    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/object-materials/3d",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "3D",
        "es": "Objetos 3D",
        "zh-Hans": "3D物体",
        "nb": "3D",
        "de": "3D",
        "ja": "3D",
        "sv": "3D",
        "da": "3D",
        "nl": "3D",
        "pl": "3D",
        "pt": "3D",
        "hi": "3D"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "notation": "P:SB§3D",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/substrates/object-materials",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:24:41Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Three-dimensional objects printed directly via additive manufacturing or specialized object-printing equipment — used for prototypes, custom parts, and decorative items.",
        "nb": "Tredimensjonale objekter trykt direkte via additiv produksjon eller spesialisert objekttrykkutstyr — brukt til prototyper, tilpassede deler og dekorative gjenstander.",
        "de": "Dreidimensionale Objekte, die direkt mittels additiver Fertigung oder spezialisierter Objektdruck-Anlagen bedruckt werden — verwendet für Prototypen, Sonderteile und dekorative Objekte.",
        "ja": "付加製造または専用の立体物印刷機で直接印刷される三次元物体 — プロトタイプ、カスタム部品、装飾品に使用される。",
        "es": "Objetos tridimensionales impresos directamente — productos como bolígrafos, mecheros, electrónica de consumo.",
        "zh-Hans": "直接印刷的三维物体 —— 圆珠笔、打火机、消费电子等产品。",
        "sv": "Tredimensionella objekt tryckta direkt via additiv tillverkning eller specialiserad objekttryckutrustning — används för prototyper, specialdelar och dekorativa föremål.",
        "da": "Tredimensionelle objekter trykt direkte via additiv fremstilling eller specialiseret objekttryk-udstyr — bruges til prototyper, specialdele og dekorative genstande.",
        "nl": "Driedimensionale objecten, direct geprint via additieve productie of gespecialiseerde objectdrukapparatuur — gebruikt voor prototypes, maatwerkonderdelen en decoratieve objecten.",
        "pl": "Obiekty trójwymiarowe drukowane bezpośrednio metodami przyrostowymi lub na specjalistycznych urządzeniach do zadruku obiektów — używane do prototypów, części na zamówienie i przedmiotów dekoracyjnych.",
        "pt": "Objetos tridimensionais impressos diretamente por manufatura aditiva ou equipamento especializado de impressão em objetos — usados em protótipos, peças personalizadas e itens decorativos.",
        "hi": "एडिटिव मैन्युफ़ैक्चरिंग या विशेष ऑब्जेक्ट-प्रिंटिंग उपकरण से सीधे छपी त्रि-आयामी वस्तुएँ — प्रोटोटाइप, कस्टम पुर्ज़ों और सजावटी वस्तुओं में।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "3D object",
          "Three-dimensional object"
        ],
        "nb": [
          "3D-objekt"
        ],
        "pl": [
          "obiekt 3D",
          "obiekt trójwymiarowy"
        ],
        "pt": [
          "objeto 3D",
          "objeto tridimensional",
          "impressão 3D"
        ],
        "hi": [
          "3D वस्तु",
          "त्रि-आयामी वस्तु",
          "3D प्रिंट"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/object-materials",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "category",
      "label": {
        "en": "Object Materials",
        "es": "Materiales-Objeto",
        "zh-Hans": "物体材料",
        "nb": "Objekt-materialer",
        "de": "Objektmaterialien",
        "ja": "オブジェクト基材",
        "sv": "Objektmaterial",
        "da": "Objektmaterialer",
        "nl": "Objectmaterialen",
        "pl": "Materiały obiektowe",
        "pt": "Materiais-objeto",
        "hi": "वस्तु सामग्री"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "broader": "https://ptpge.org/v1/printing/substrates",
      "narrower": [
        "https://ptpge.org/v1/printing/substrates/object-materials/3d",
        "https://ptpge.org/v1/printing/substrates/object-materials/bootle",
        "https://ptpge.org/v1/printing/substrates/object-materials/box"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:24:41Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Three-dimensional or curved objects printed directly using specialized printing equipment — bypassing the traditional flat-substrate model.",
        "nb": "Tredimensjonale eller buede objekter trykt direkte ved hjelp av spesialisert utstyr — utenom den tradisjonelle flat-substrat-modellen.",
        "de": "Dreidimensionale oder gewölbte Objekte, die direkt mit spezialisierten Druckanlagen bedruckt werden — abseits des klassischen Modells eines flachen Bedruckstoffs.",
        "ja": "従来の平面基材モデルを迂回して、専用の印刷機で直接印刷される三次元または曲面の物体。",
        "es": "Objetos tridimensionales o curvos impresos directamente con equipo de impresión especializado — superando el modelo tradicional de sustrato plano.",
        "zh-Hans": "使用专用印刷设备直接印刷的三维或曲面物体——超越传统的平面承印物模式。",
        "sv": "Tredimensionella eller böjda objekt som trycks direkt med specialiserad tryckutrustning — förbi den traditionella modellen med plana substrat.",
        "da": "Tredimensionelle eller buede objekter trykt direkte med specialiseret trykudstyr — uden om den traditionelle fladsubstratmodel.",
        "nl": "Driedimensionale of gebogen objecten, direct bedrukt met gespecialiseerde drukapparatuur — buiten het traditionele vlaksubstraatmodel om.",
        "pl": "Obiekty trójwymiarowe lub zakrzywione zadrukowywane bezpośrednio na specjalistycznych urządzeniach — z pominięciem tradycyjnego modelu płaskiego podłoża.",
        "pt": "Objetos tridimensionais ou curvos impressos diretamente com equipamento de impressão especializado — fora do modelo tradicional de substrato plano.",
        "hi": "विशेष छपाई उपकरण से सीधे छपी त्रि-आयामी या घुमावदार वस्तुएँ — पारंपरिक सपाट-सब्सट्रेट मॉडल से हटकर।"
      },
      "scopeNote": {
        "en": "Includes 3D-printed objects, bottles (printed via inkjet or screen printing on the curved surface), and pre-assembled boxes (printed after construction). Custom industrial substrates and conformal printing technologies belong here.",
        "nb": "Inkluderer 3D-trykte objekter, flasker (trykt via inkjet eller silketrykk på den buede overflaten), og ferdigmonterte bokser (trykt etter sammenstilling). Tilpassede industrielle substrater og konforme trykketeknologier hører hjemme her.",
        "de": "Umfasst 3D-gedruckte Objekte, Flaschen (mit Tintenstrahl- oder Siebdruck auf der gewölbten Oberfläche bedruckt) und vorgefertigte Schachteln (nach der Konstruktion bedruckt). Spezielle Industriebedruckstoffe und konturierte Drucktechnologien gehören hierher.",
        "ja": "3D印刷物体、ボトル（曲面にインクジェットまたはシルクスクリーン印刷）、組立済みボックス（組立後に印刷）を含む。カスタム工業用基材および曲面追従印刷技術もここに属する。",
        "es": "Incluye objetos impresos en 3D, botellas (impresas mediante inyección de tinta o serigrafía sobre la superficie curva) y cajas preensambladas (impresas tras el montaje). Los sustratos industriales personalizados y la impresión conformal se rastrean aquí cuando corresponde.",
        "zh-Hans": "包括3D打印物体、瓶子（通过UV喷墨或丝印在曲面上印刷）和预组装盒子（组装后印刷）。定制工业承印物和异形印刷酌情在此处跟踪。",
        "pt": "Inclui objetos impressos em 3D, garrafas (impressas por jato de tinta ou serigrafia na superfície curva) e caixas pré-montadas (impressas depois de montadas). Substratos industriais personalizados e tecnologias de impressão conformal pertencem aqui.",
        "hi": "3D-प्रिंटेड वस्तुएँ, बोतलें (घुमावदार सतह पर इंकजेट या स्क्रीन प्रिंटिंग से) और पहले से जुड़े डिब्बे (बनने के बाद छपे) शामिल। कस्टम औद्योगिक सब्सट्रेट और कन्फ़ॉर्मल प्रिंटिंग तकनीकें यहीं आती हैं।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "notation": "P:SB-OBJ",
      "altLabels": {
        "pl": [
          "obiekty"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/object-materials/bootle",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Bottle",
        "es": "Botellas",
        "zh-Hans": "瓶子",
        "nb": "Flaske",
        "de": "Flasche",
        "ja": "ボトル",
        "sv": "Flaska",
        "da": "Flaske",
        "nl": "Fles",
        "pl": "Butelka",
        "pt": "Garrafa",
        "hi": "बोतल"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "notation": "P:SB§BOOTLE",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/substrates/object-materials",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:24:41Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Bottles (glass, plastic, aluminium) printed directly on their curved surface — typically via screen printing, pad printing, or specialized 360-degree inkjet equipment. Common in beverage and cosmetics packaging.",
        "nb": "Flasker (glass, plast, aluminium) trykt direkte på den buede overflaten — vanligvis via silketrykk, padtrykk eller spesialisert 360-graders inkjet-utstyr. Vanlig i drikke- og kosmetikkemballasje.",
        "de": "Flaschen (Glas, Kunststoff, Aluminium), die direkt auf ihrer gewölbten Oberfläche bedruckt werden — typischerweise mit Siebdruck, Tampondruck oder spezieller 360-Grad-Tintenstrahltechnik. Häufig bei Getränke- und Kosmetikverpackungen.",
        "ja": "曲面に直接印刷されるボトル（ガラス、プラスチック、アルミニウム）— 通常シルクスクリーン印刷、タンポ印刷、または専用の360度インクジェット機で印刷される。飲料および化粧品のパッケージで一般的。",
        "es": "Botellas impresas en su superficie curva mediante inyección de tinta UV o serigrafía rotatoria — habitual en cosmética, bebidas y farmacéutica.",
        "zh-Hans": "通过UV喷墨或丝印旋转印刷在曲面上的瓶子 —— 常见于化妆品、饮料和制药。",
        "sv": "Flaskor (glas, plast, aluminium) tryckta direkt på sin böjda yta — typiskt via screentryck, tampongtryck eller specialiserad 360-graders inkjetutrustning. Vanligt inom dryckes- och kosmetikförpackningar.",
        "da": "Flasker (glas, plast, aluminium) trykt direkte på den buede overflade — typisk via serigrafi, tampontryk eller specialiseret 360-graders inkjetudstyr. Almindeligt i drikkevare- og kosmetikemballage.",
        "nl": "Flessen (glas, kunststof, aluminium), direct bedrukt op het gebogen oppervlak — doorgaans via zeefdruk, tampondruk of gespecialiseerde 360-graden-inkjetapparatuur. Gebruikelijk in dranken- en cosmeticaverpakkingen.",
        "pl": "Butelki (szklane, plastikowe, aluminiowe) zadrukowywane bezpośrednio na zakrzywionej powierzchni — zwykle sitodrukiem, tampodrukiem lub specjalistycznymi urządzeniami atramentowymi 360°. Typowe w opakowaniach napojów i kosmetyków.",
        "pt": "Garrafas (vidro, plástico, alumínio) impressas diretamente na superfície curva — normalmente por serigrafia, tampografia ou equipamento especializado de jato de tinta 360°. Comum em embalagens de bebidas e cosméticos.",
        "hi": "घुमावदार सतह पर सीधे छपी बोतलें (काँच, प्लास्टिक, एल्युमिनियम) — आमतौर पर स्क्रीन प्रिंटिंग, पैड प्रिंटिंग या विशेष 360-डिग्री इंकजेट उपकरण से। पेय और सौंदर्य-प्रसाधन पैकेजिंग में आम।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "Bottle"
        ],
        "nb": [
          "Flaske"
        ],
        "pl": [
          "butelki"
        ],
        "pt": [
          "garrafa",
          "frasco"
        ],
        "hi": [
          "बोतल",
          "शीशी",
          "बॉटल"
        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/substrates/object-materials/box",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Box",
        "es": "Cajas",
        "zh-Hans": "盒子",
        "nb": "Eske",
        "de": "Box / Schachtel",
        "ja": "ボックス",
        "sv": "Låda",
        "da": "Æske",
        "nl": "Doos",
        "pl": "Pudełko",
        "pt": "Caixa",
        "hi": "डिब्बा"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "substrates",
      "notation": "P:SB§BOX",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/substrates/object-materials",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:24:41Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Pre-assembled boxes printed directly on their finished surface — bypassing the traditional flat-then-fold workflow. Used for bespoke packaging where the box already exists before printing.",
        "nb": "Ferdigmonterte bokser trykt direkte på den ferdige overflaten — utenom den tradisjonelle flat-så-brett-arbeidsflyten. Brukt til skreddersydd emballasje der esken allerede finnes før trykking.",
        "de": "Vorgefertigte Schachteln, die direkt auf ihrer fertigen Oberfläche bedruckt werden — abseits des klassischen Workflows „erst flach drucken, dann falzen“. Eingesetzt für individuelle Verpackungen, bei denen die Schachtel bereits vor dem Druck existiert.",
        "ja": "完成した表面に直接印刷される組立済みボックス — 従来の平面印刷後に折り立てるワークフローを迂回する。印刷前にボックスがすでに存在するオーダーメイドのパッケージで使用される。",
        "es": "Cajas pre-ensambladas impresas tras el montaje, con tecnologías capaces de manejar formas tridimensionales.",
        "zh-Hans": "组装后印刷的预组装盒子，使用能处理三维形状的技术。",
        "sv": "Färdigmonterade lådor tryckta direkt på sin färdiga yta — förbi det traditionella arbetsflödet platt-sedan-vikt. Används för skräddarsydda förpackningar där lådan redan finns före trycket.",
        "da": "Færdigsamlede æsker trykt direkte på den færdige overflade — uden om det traditionelle flad-derefter-fals-arbejdsflow. Bruges til specialemballage, hvor æsken allerede findes før tryk.",
        "nl": "Voorgemonteerde dozen, direct bedrukt op het afgewerkte oppervlak — buiten de traditionele vlak-dan-vouwen-workflow om. Gebruikt voor maatwerkverpakkingen waarbij de doos al bestaat vóór het drukken.",
        "pl": "Gotowe, złożone pudełka zadrukowywane bezpośrednio na ich powierzchni — z pominięciem tradycyjnego przepływu płaski-arkusz-potem-składanie. Używane do opakowań na zamówienie, gdy pudełko istnieje już przed drukiem.",
        "pt": "Caixas pré-montadas impressas diretamente na superfície acabada — fora do fluxo tradicional de imprimir plano e depois dobrar. Usadas em embalagens sob medida em que a caixa já existe antes da impressão.",
        "hi": "पहले से जुड़े डिब्बे जिन पर तैयार सतह पर सीधे छपाई होती है — पारंपरिक पहले-सपाट-फिर-मोड़ो प्रवाह से हटकर। ऐसी कस्टम पैकेजिंग में जहाँ डिब्बा छपाई से पहले ही मौजूद है।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "Carton"
        ],
        "nb": [
          "Eske",
          "Boks"
        ],
        "pl": [
          "pudło"
        ],
        "pt": [
          "caixa montada",
          "cartucho"
        ],
        "hi": [
          "बॉक्स",
          "कार्टन",
          "बना हुआ डिब्बा"
        ]
      }
    },
    {
