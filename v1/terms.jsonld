    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/completions/fold-binding-edge",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "category",
      "label": {
        "en": "Fold & Binding Edge",
        "nb": "Fals- og innbindingskant",
        "de": "Falz- und Bindekante",
        "ja": "折り・製本エッジ",
        "es": "Borde de Pliegue y Encuadernación",
        "zh-Hans": "折页与装订边缘",
        "sv": "Fals- och bindningskant",
        "da": "Fals- og indbindingskant",
        "nl": "Vouw- en bindzijde",
        "pl": "Krawędź złamu i oprawy",
        "pt": "Borda de dobra e encadernação",
        "hi": "फ़ोल्ड और बाइंडिंग किनारा"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "completions",
      "broader": "https://ptpge.org/v1/printing/completions",
      "narrower": [
        "https://ptpge.org/v1/printing/completions/fold-binding-edge/left",
        "https://ptpge.org/v1/printing/completions/fold-binding-edge/top",
        "https://ptpge.org/v1/printing/completions/fold-binding-edge/right",
        "https://ptpge.org/v1/printing/completions/fold-binding-edge/bottom"
      ],
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:12:20Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "The edge of the product where the binding or fold sits — left, right, top or bottom. A shared edge axis, independent of binding/fold type; selected via the Edge variable.",
        "nb": "Kanten på produktet der innbindingen eller folden sitter — venstre, høyre, topp eller bunn. En delt kant-akse, uavhengig av innbindings-/foldetype; velges via Edge-variabelen.",
        "de": "Die Kante des Produkts, an der Bindung oder Falz sitzt — links, rechts, oben oder unten. Eine gemeinsame Kantenachse, unabhängig von Binde-/Falzart; gewählt über die Variable Edge.",
        "es": "El borde del producto donde asienta la encuadernación o el plegado — izquierdo, derecho, superior o inferior. Un eje de borde compartido, independiente del tipo de encuadernación o plegado; se selecciona mediante la variable Edge.",
        "ja": "製本または折りが位置する製品の辺 — 左・右・上・下。製本・折りの種類に依存しない共通の辺軸で、Edge 変数で選択される。",
        "zh-Hans": "装订或折页所在的产品边 — 左、右、上或下。与装订/折页类型无关的共用边轴，通过 Edge 变量选择。",
        "sv": "Den kant av produkten där bindningen eller falsen sitter — vänster, höger, ovan- eller nederkant. En gemensam kantaxel, oberoende av bindnings-/falstyp; väljs via variabeln Kant.",
        "da": "Den kant af produktet, hvor indbindingen eller falsen sidder — venstre, højre, top eller bund. En fælles kantakse, uafhængig af indbindings-/falstype; vælges via variablen Kant.",
        "nl": "De zijde van het product waar de binding of vouw zit — links, rechts, boven of onder. Een gedeelde zijde-as, onafhankelijk van bind-/vouwtype; gekozen via de variabele Zijde.",
        "pl": "Krawędź produktu, na której znajduje się oprawa lub złam — lewa, prawa, górna lub dolna. Wspólna oś krawędzi, niezależna od typu oprawy/złamu; wybierana przez zmienną Krawędź.",
        "pt": "A borda do produto onde fica a encadernação ou a dobra — esquerda, direita, topo ou base. Um eixo de borda compartilhado, independente do tipo de encadernação/dobra; selecionado pela variável Borda.",
        "hi": "उत्पाद का वह किनारा जहाँ बाइंडिंग या फ़ोल्ड होता है — बायाँ, दायाँ, ऊपर या नीचे। बाइंडिंग/फ़ोल्ड के प्रकार से स्वतंत्र एक साझा किनारा-अक्ष; किनारा वेरिएबल से चुना जाता है।"
      },
      "scopeNote": {
        "en": "Determines reading direction and binding type compatibility. Left-edge binding is the default for Western-language books and reports. Top-edge binding is used for notepads, calendars, and presentations. Right-edge binding is used for right-to-left languages (Arabic, Hebrew).",
        "nb": "Bestemmer leseretning og kompatibilitet med innbindingstype. Venstrekant-binding er standard for vestlig-språklige bøker og rapporter. Toppkant-binding brukes til notatblokker, kalendere og presentasjoner. Høyrekant-binding brukes til høyre-til-venstre-språk (arabisk, hebraisk).",
        "de": "Bestimmt Leserichtung und Bindungstyp-Kompatibilität. Linksrandbindung ist Standard für Bücher und Berichte in westlichen Sprachen. Oberkantenbindung wird für Notizblöcke, Kalender und Präsentationen verwendet. Rechtsrandbindung wird für Sprachen verwendet, die von rechts nach links gelesen werden (Arabisch, Hebräisch).",
        "ja": "読み方向と綴じ方法の互換性を決定する。左綴じが西欧語の書籍と報告書の標準。上綴じはノート、カレンダー、プレゼンテーションに使用される。右綴じは右から左への言語（アラビア語、ヘブライ語）に使用される。",
        "es": "Determina la dirección de lectura y la compatibilidad del tipo de encuadernación. La encuadernación por el lado izquierdo es la predeterminada para libros e informes en lenguas occidentales. La encuadernación superior se utiliza para blocs, calendarios y carpetas de presentación.",
        "zh-Hans": "决定阅读方向和装订类型兼容性。左侧装订是西方语言书籍和报告的默认方向。顶部装订用于便签、日历和演示文件夹。",
        "pt": "Determina o sentido de leitura e a compatibilidade com o tipo de encadernação. Encadernação à esquerda é o padrão para livros e relatórios em línguas ocidentais. Encadernação no topo é usada em blocos, calendários e apresentações. Encadernação à direita é usada em línguas escritas da direita para a esquerda (árabe, hebraico).",
        "hi": "पढ़ने की दिशा और बाइंडिंग प्रकार की अनुकूलता तय करता है। पश्चिमी भाषाओं की किताबों और रिपोर्टों में बाईं ओर बाइंडिंग डिफ़ॉल्ट है। ऊपर की बाइंडिंग नोटपैड, कैलेंडर और प्रस्तुतियों में। दाईं ओर बाइंडिंग दाएँ-से-बाएँ लिखी भाषाओं (अरबी, हिब्रू; भारत में उर्दू) में।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "notation": "P:CP-FBE",
      "semanticSource": [
        {
          "standard": "XJDF",
          "version": "2.2",
          "elements": [
            "BindingIntent"
          ],
          "refs": [
            "§4.3 · p.64"
          ],
          "match": "exact",
          "via": "crosswalk row 47"
        }
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/completions/fold-binding-edge/bottom",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Bottom",
        "nb": "Bunn",
        "de": "Unten",
        "ja": "下",
        "es": "Inferior",
        "zh-Hans": "底部",
        "sv": "Nederkant",
        "da": "Bund",
        "nl": "Onder",
        "pl": "Dół",
        "pt": "Base",
        "hi": "नीचे"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "completions",
      "broader": "https://ptpge.org/v1/printing/completions/fold-binding-edge",
      "created": "2026-06-19T09:56:13Z",
      "modified": "2026-09-23T06:12:20Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "notation": "P:CP§BOTTOM",
      "creator": "https://ptpge.org/contributors/ptpge",
      "elementType": "value",
      "definition": {
        "en": "Fold or binding edge placed along the bottom of the product — an uncommon placement used for certain flip pads, specialty calendars, and some technical or landscape layouts. Reader flips pages downward.",
        "nb": "Folde- eller bindingskant plassert langs bunnen av produktet — en uvanlig plassering brukt til enkelte vippeblokker, spesialkalendere og noen tekniske eller landskaps-orienterte oppsett. Leseren blar sidene nedover.",
        "de": "Falz- oder Bindungskante an der Unterkante des Produkts — eine seltene Platzierung für bestimmte Flip-Blöcke, Spezialkalender und einige technische oder Querformat-Layouts. Der Leser blättert die Seiten nach unten.",
        "ja": "折りまたは綴じの辺が印刷物の下部に配置される — 特定のフリップパッド、特殊なカレンダー、一部の技術的または横長レイアウトに使われる珍しい配置。読者はページを下方向にめくる。",
        "es": "Pliegue o encuadernación por la parte inferior — colocación poco común para ciertos blocs, calendarios especiales y algunos diseños técnicos.",
        "zh-Hans": "底部折页或装订 —— 用于某些翻页便签和专用日历的少见方向。",
        "sv": "Fals eller bindningskant placerad längs produktens nederkant — en ovanlig placering som används för vissa vändblock, specialkalendrar och en del tekniska eller liggande layouter. Läsaren bläddrar sidorna nedåt.",
        "da": "Fals- eller indbindingskant placeret langs produktets bund — en ualmindelig placering brugt til visse vendeblokke, specialkalendere og nogle tekniske eller liggende layouts. Læseren vender siderne nedad.",
        "nl": "Vouw- of bindzijde langs de onderkant van het product — een ongebruikelijke plaatsing voor bepaalde omslagblokken, speciale kalenders en sommige technische of liggende lay-outs. De lezer slaat de pagina's naar beneden om.",
        "pl": "Krawędź złamu lub oprawy umieszczona wzdłuż dolnej krawędzi produktu — rzadkie umiejscowienie stosowane w niektórych bloczkach przerzucanych, kalendarzach specjalnych oraz niektórych układach technicznych lub poziomych. Czytelnik przerzuca strony w dół.",
        "pt": "Dobra ou encadernação ao longo da base do produto — posicionamento incomum, usado em certos blocos de virar, calendários especiais e alguns layouts técnicos ou paisagem. O leitor vira as páginas para baixo.",
        "hi": "उत्पाद के निचले किनारे पर फ़ोल्ड या बाइंडिंग — असामान्य स्थिति, कुछ फ़्लिप पैड, विशेष कैलेंडर और कुछ तकनीकी या लैंडस्केप लेआउट में। पाठक पृष्ठ नीचे की ओर पलटता है।"
      },
      "altLabels": {
        "en": [
          "Bottom edge",
          "Bottom-edge binding",
          "Bottom fold",
          "Bottom-bound"
        ],
        "nb": [
          "Bunn kant",
          "Bunnbundet",
          "Bunn fals"
        ],
        "pl": [
          "krawędź dolna",
          "oprawa dolna",
          "złam dolny"
        ],
        "pt": [
          "borda inferior",
          "encadernação na base",
          "dobra na base",
          "encadernado embaixo"
        ],
        "hi": [
          "निचला किनारा",
          "नीचे की बाइंडिंग",
          "नीचे का फ़ोल्ड"
        ]
      },
      "semanticSource": [
        {
