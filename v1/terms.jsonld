      "license": "https://creativecommons.org/licenses/by/4.0/",
      "closeMatch": [
        "https://schema.org/EducateAction"
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/ordering/use-cases/event-promotion",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "notation": "O:UC§EVENT-PROMOTION",
      "elementType": "context",
      "label": {
        "en": "Event Promotion",
        "nb": "Arrangementspromotering",
        "de": "Eventpromotion",
        "ja": "イベントプロモーション",
        "es": "Promoción de eventos",
        "zh-Hans": "活动推广",
        "sv": "Evenemangspromotion",
        "da": "Eventpromovering",
        "nl": "Evenementpromotie",
        "pl": "Promocja wydarzeń",
        "pt": "Divulgação de eventos",
        "hi": "आयोजन प्रचार"
      },
      "definition": {
        "en": "Products used to promote, announce, or document events such as concerts, festivals, conferences, exhibitions, and launches. Includes posters, flyers, programmes, and event brochures.",
        "nb": "Produkter brukt for å promotere, annonsere eller dokumentere arrangementer som konserter, festivaler, konferanser, utstillinger og lanseringer. Inkluderer plakater, flyere, programmer og arrangementsbrosjyrer.",
        "de": "Produkte zur Bewerbung, Ankündigung oder Dokumentation von Veranstaltungen wie Konzerten, Festivals, Konferenzen und Ausstellungen.",
        "ja": "コンサート、フェスティバル、会議、展示会、ローンチなどのイベントを告知・宣伝・記録するための製品。ポスター、チラシ、プログラム、イベントパンフレットを含む。",
        "es": "Productos usados para promocionar, anunciar o documentar eventos como conciertos, festivales, conferencias, exposiciones y lanzamientos. Incluye pósteres, flyers, programas y folletos de evento.",
        "zh-Hans": "用于宣传、发布或记录活动（音乐会、节庆、会议、展览、发布会）的产品。包括海报、传单、节目单与活动手册。",
        "sv": "Produkter som marknadsför, tillkännager eller dokumenterar evenemang som konserter, festivaler, konferenser, utställningar och lanseringar. Omfattar affischer, flygblad, program och evenemangsbroschyrer.",
        "da": "Produkter brugt til at promovere, annoncere eller dokumentere arrangementer som koncerter, festivaler, konferencer, udstillinger og lanceringer. Omfatter plakater, flyers, programmer og eventbrochurer.",
        "nl": "Producten om evenementen te promoten, aan te kondigen of te documenteren — concerten, festivals, congressen, tentoonstellingen en lanceringen. Omvat posters, flyers, programma's en evenementbrochures.",
        "pl": "Produkty służące promowaniu, zapowiadaniu lub dokumentowaniu wydarzeń, takich jak koncerty, festiwale, konferencje, wystawy i premiery. Obejmuje plakaty, ulotki, programy i broszury eventowe.",
        "pt": "Produtos usados para divulgar, anunciar ou documentar eventos como shows, festivais, congressos, exposições e lançamentos. Inclui pôsteres, flyers, programas e folhetos de evento.",
        "hi": "संगीत कार्यक्रम, उत्सव, सम्मेलन, प्रदर्शनी और लॉन्च जैसे आयोजनों के प्रचार, घोषणा या दस्तावेज़ीकरण के लिए उत्पाद। पोस्टर, फ़्लायर, कार्यक्रम पुस्तिका और इवेंट ब्रोशर शामिल।"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "use-cases",
      "broader": "https://ptpge.org/v1/ordering/use-cases",
      "created": "2026-05-20T10:00:00Z",
      "modified": "2026-09-22T16:31:34Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "closeMatch": [
        "https://schema.org/PromoteAction"
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/ordering/use-cases/informational",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "notation": "O:UC§INFORMATIONAL",
      "elementType": "context",
      "label": {
        "en": "Informational",
        "nb": "Informativ",
        "de": "Informativ",
        "ja": "情報提供",
        "es": "Informativo",
        "zh-Hans": "信息类",
        "sv": "Information",
        "da": "Information",
        "nl": "Informatie",
        "pl": "Informacyjne",
        "pt": "Informativo",
        "hi": "सूचनात्मक"
      },
      "definition": {
        "en": "Products used to inform, explain, or convey factual content to an audience. Includes leaflets, fact sheets, prospectuses, datasheets, and general reference documents.",
        "nb": "Produkter brukt til å informere, forklare eller formidle faktisk innhold til en målgruppe. Inkluderer leaflets, faktaark, prospekter, datablad og generelle referansedokumenter.",
        "de": "Produkte zur Information, Erklärung oder Vermittlung faktischer Inhalte an ein Publikum. Umfasst Faltblätter, Datenblätter, Prospekte und allgemeine Referenzdokumente.",
        "ja": "読者に事実情報を伝え、説明するための製品。リーフレット、ファクトシート、案内書、データシート、一般参照資料を含む。",
        "es": "Productos usados para informar, explicar o transmitir contenido factual a una audiencia. Incluye folletos, hojas informativas, prospectos, fichas técnicas y documentos de referencia general.",
        "zh-Hans": "用于向受众告知、解释或传达事实内容的产品。包括宣传页、资料页、说明书、数据表与一般参考文件。",
        "sv": "Produkter som informerar, förklarar eller förmedlar faktainnehåll till en publik. Omfattar foldrar, faktablad, prospekt, datablad och allmänna referensdokument.",
        "da": "Produkter brugt til at informere, forklare eller formidle faktuelt indhold til en målgruppe. Omfatter foldere, faktaark, prospekter, datablade og generelle referencedokumenter.",
        "nl": "Producten om een publiek te informeren, uit te leggen of feitelijke inhoud over te brengen. Omvat folders, factsheets, prospectussen, datasheets en algemene referentiedocumenten.",
        "pl": "Produkty służące informowaniu, objaśnianiu lub przekazywaniu treści faktograficznych odbiorcom. Obejmuje ulotki, karty informacyjne, prospekty, karty katalogowe i ogólne dokumenty referencyjne.",
        "pt": "Produtos usados para informar, explicar ou transmitir conteúdo factual a um público. Inclui folhetos, fichas técnicas, prospectos, datasheets e documentos de referência geral.",
        "hi": "किसी वर्ग को सूचित करने, समझाने या तथ्यात्मक सामग्री देने के लिए उत्पाद। लीफ़लेट, फ़ैक्ट शीट, प्रॉस्पेक्टस, डेटाशीट और सामान्य संदर्भ दस्तावेज़ शामिल।"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "use-cases",
      "broader": "https://ptpge.org/v1/ordering/use-cases",
      "created": "2026-05-20T10:00:00Z",
      "modified": "2026-09-22T16:31:34Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "closeMatch": [
        "https://schema.org/InformAction"
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/ordering/use-cases/instructional",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "notation": "O:UC§INSTRUCTIONAL",
      "elementType": "context",
      "label": {
        "en": "Instructional",
        "nb": "Instruktiv",
        "de": "Instruktiv",
        "ja": "教材・指導用",
        "es": "Instructivo",
        "zh-Hans": "教学指引",
        "sv": "Instruktion",
        "da": "Instruktion",
        "nl": "Instructie",
        "pl": "Instruktażowe",
        "pt": "Instrucional",
        "hi": "निर्देशात्मक"
      },
      "definition": {
        "en": "Products used to instruct or guide the reader through a process, procedure, or skill. Includes user manuals, installation guides, training materials, and step-by-step booklets.",
        "nb": "Produkter brukt til å instruere eller veilede leseren gjennom en prosess, prosedyre eller ferdighet. Inkluderer brukerveiledninger, installasjonsguider, opplæringsmateriell, og steg-for-steg-hefter.",
        "de": "Produkte zur Anleitung oder Führung des Lesers durch einen Prozess, ein Verfahren oder eine Fertigkeit. Umfasst Benutzerhandbücher, Installationsanleitungen und Schulungsmaterialien.",
        "ja": "プロセス、手順、技能について読者を導き、指導するための製品。取扱説明書、設置ガイド、研修教材、ステップ式の小冊子を含む。",
        "es": "Productos usados para instruir o guiar al lector a través de un proceso, procedimiento o habilidad. Incluye manuales de usuario, guías de instalación, materiales de formación y cuadernillos paso a paso.",
        "zh-Hans": "用于指导读者完成流程、程序或技能的产品。包括用户手册、安装指南、培训材料与分步小册子。",
        "sv": "Produkter som instruerar eller vägleder läsaren genom en process, procedur eller färdighet. Omfattar bruksanvisningar, installationsguider, utbildningsmaterial och steg-för-steg-häften.",
        "da": "Produkter brugt til at instruere eller guide læseren gennem en proces, procedure eller færdighed. Omfatter brugermanualer, installationsvejledninger, kursusmateriale og trin-for-trin-hæfter.",
        "nl": "Producten die de lezer door een proces, procedure of vaardigheid leiden. Omvat gebruikershandleidingen, installatiegidsen, cursusmateriaal en stap-voor-stapboekjes.",
        "pl": "Produkty służące instruowaniu lub prowadzeniu czytelnika przez proces, procedurę lub umiejętność. Obejmuje instrukcje obsługi, przewodniki instalacji, materiały szkoleniowe i broszury krok po kroku.",
        "pt": "Produtos usados para instruir ou guiar o leitor por um processo, procedimento ou habilidade. Inclui manuais do usuário, guias de instalação, materiais de treinamento e folhetos passo a passo.",
        "hi": "पाठक को किसी प्रक्रिया, विधि या कौशल में निर्देश या मार्गदर्शन देने वाले उत्पाद। यूज़र मैनुअल, इंस्टॉलेशन गाइड, प्रशिक्षण सामग्री और चरण-दर-चरण पुस्तिकाएँ शामिल।"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "use-cases",
      "broader": "https://ptpge.org/v1/ordering/use-cases",
      "created": "2026-05-20T10:00:00Z",
      "modified": "2026-09-22T16:31:34Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "closeMatch": [
        "https://schema.org/TeachAction"
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/ordering/use-cases/marketing",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "notation": "O:UC§MARKETING",
      "elementType": "context",
      "label": {
        "en": "Marketing",
        "nb": "Markedsføring",
        "de": "Marketing",
        "ja": "マーケティング",
        "es": "Marketing",
        "zh-Hans": "营销",
        "sv": "Marknadsföring",
        "da": "Markedsføring",
        "nl": "Marketing",
        "pl": "Marketing",
        "pt": "Marketing",
        "hi": "मार्केटिंग"
      },
      "definition": {
        "en": "Products used to promote, advertise, or market a business, product, service, or brand to potential customers. Includes brochures, flyers, posters, sales sheets, and promotional mailers used in marketing campaigns.",
        "nb": "Produkter brukt til å promotere, annonsere eller markedsføre en virksomhet, et produkt, en tjeneste eller et merke til potensielle kunder. Inkluderer brosjyrer, flyere, plakater, salgsark og markedsføringsmaterialer brukt i markedskampanjer.",
        "de": "Produkte, die zur Bewerbung, Werbung oder Vermarktung eines Unternehmens, Produkts, einer Dienstleistung oder Marke an potenzielle Kunden verwendet werden.",
        "ja": "見込み客に向けて事業・製品・サービス・ブランドを宣伝・広告・マーケティングするための製品。マーケティングキャンペーンで使うパンフレット、チラシ、ポスター、セールスシート、販促DMを含む。",
        "es": "Productos usados para promocionar, publicitar o comercializar un negocio, producto, servicio o marca ante clientes potenciales. Incluye folletos, flyers, pósteres, hojas de venta y mailings promocionales usados en campañas de marketing.",
        "zh-Hans": "用于向潜在客户推广、宣传企业、产品、服务或品牌的产品。包括营销活动中使用的手册、传单、海报、销售单页与促销邮件。",
        "sv": "Produkter som marknadsför eller annonserar ett företag, en produkt, tjänst eller ett varumärke mot potentiella kunder. Omfattar broschyrer, flygblad, affischer, säljblad och kampanjutskick.",
        "da": "Produkter brugt til at promovere, annoncere eller markedsføre en virksomhed, et produkt, en tjeneste eller et brand over for potentielle kunder. Omfatter brochurer, flyers, plakater, salgsark og kampagneforsendelser.",
        "nl": "Producten om een bedrijf, product, dienst of merk te promoten bij potentiële klanten. Omvat brochures, flyers, posters, verkoopbladen en promotionele mailings.",
        "pl": "Produkty służące promowaniu, reklamowaniu lub sprzedaży firmy, produktu, usługi lub marki potencjalnym klientom. Obejmuje foldery, ulotki, plakaty, karty sprzedażowe i mailingi promocyjne używane w kampaniach marketingowych.",
        "pt": "Produtos usados para promover, anunciar ou comercializar uma empresa, produto, serviço ou marca junto a clientes potenciais. Inclui folhetos, flyers, pôsteres, folhas de vendas e malas diretas promocionais usados em campanhas de marketing.",
        "hi": "किसी व्यवसाय, उत्पाद, सेवा या ब्रांड को संभावित ग्राहकों के बीच प्रचारित, विज्ञापित या विपणित करने वाले उत्पाद। मार्केटिंग अभियानों में प्रयुक्त ब्रोशर, फ़्लायर, पोस्टर, सेल्स शीट और प्रचार मेलर शामिल।"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "use-cases",
      "broader": "https://ptpge.org/v1/ordering/use-cases",
      "created": "2026-05-20T10:00:00Z",
      "modified": "2026-09-22T16:31:34Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "closeMatch": [
        "https://schema.org/PromoteAction"
      ]
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/ordering/use-cases/networking",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "notation": "O:UC§NETWORKING",
      "elementType": "context",
      "label": {
        "en": "Networking",
        "nb": "Nettverksbygging",
        "de": "Networking",
        "ja": "ネットワーキング",
        "es": "Networking",
        "zh-Hans": "人脉建立",
        "sv": "Nätverkande",
        "da": "Netværk",
        "nl": "Netwerken",
        "pl": "Networking",
        "pt": "Networking",
        "hi": "नेटवर्किंग"
      },
      "definition": {
        "en": "Products used in networking contexts such as conferences, trade shows, and professional meetups. Includes business cards, name badges, lanyards, and conference materials.",
        "nb": "Produkter brukt i nettverkssammenhenger som konferanser, messer og profesjonelle treff. Inkluderer visittkort, navneskilt, snorer og konferansemateriell.",
        "de": "Produkte für Networking-Kontexte wie Konferenzen, Messen und professionelle Treffen.",
        "ja": "会議、展示会、ビジネス交流会などのネットワーキングの場で使われる製品。名刺、ネームバッジ、ストラップ、会議資料を含む。",
        "es": "Productos usados en contextos de networking como conferencias, ferias y encuentros profesionales. Incluye tarjetas de visita, credenciales, lanyards y materiales de conferencia.",
        "zh-Hans": "用于会议、展会与专业聚会等社交场合的产品。包括名片、姓名徽章、挂绳与会议材料。",
        "sv": "Produkter som används i nätverkssammanhang som konferenser, mässor och professionella träffar. Omfattar visitkort, namnbrickor, nyckelband och konferensmaterial.",
        "da": "Produkter brugt i netværkssammenhænge som konferencer, messer og faglige møder. Omfatter visitkort, navnebadges, lanyards og konferencemateriale.",
        "nl": "Producten gebruikt in netwerkcontexten zoals congressen, vakbeurzen en professionele bijeenkomsten. Omvat visitekaartjes, naambadges, keycords en congresmateriaal.",
        "pl": "Produkty używane w kontekstach networkingowych, takich jak konferencje, targi i spotkania branżowe. Obejmuje wizytówki, identyfikatory imienne, smycze i materiały konferencyjne.",
        "pt": "Produtos usados em contextos de networking, como congressos, feiras e encontros profissionais. Inclui cartões de visita, crachás, cordões e materiais de congresso.",
        "hi": "सम्मेलन, व्यापार मेलों और पेशेवर मिलनों जैसे नेटवर्किंग संदर्भों में प्रयुक्त उत्पाद। विज़िटिंग कार्ड, नाम-बैज, लैनयार्ड और सम्मेलन सामग्री शामिल।"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
