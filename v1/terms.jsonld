          "encadernação no topo",
          "dobra no topo",
          "encadernação de calendário"
        ],
        "hi": [
          "ऊपरी किनारा",
          "ऊपर की बाइंडिंग",
          "ऊपर का फ़ोल्ड",
          "टॉप बाइंडिंग",
          "कैलेंडर बाइंडिंग"
        ]
      },
      "semanticSource": [
