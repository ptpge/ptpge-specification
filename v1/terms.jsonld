      "label": {
        "en": "Trykt i Norge (TIN)",
        "es": "Trykt i Norge (TIN)",
        "zh-Hans": "Trykt i Norge (TIN)",
        "nb": "Trykt i Norge (TIN)",
        "de": "Trykt i Norge (TIN)",
        "ja": "Trykt i Norge (TIN)",
        "sv": "Trykt i Norge (TIN)",
        "da": "Trykt i Norge (TIN)",
        "nl": "Trykt i Norge (TIN)",
