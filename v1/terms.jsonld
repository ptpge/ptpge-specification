        "nb": "Sidestifting",
        "de": "Seitenheftung",
        "ja": "Side Stapling",
        "es": "Side Stapling",
        "zh-Hans": "Side Stapling",
        "sv": "Sidohäftning",
        "da": "Sidehæftning",
        "nl": "Zijdelings nieten",
