    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/completions/binding/layflat-binding",
      "type": "skos:Concept",
      "version": "2026-08-12",
      "status": "proposed",
      "notation": "P:CP§LAYFLAT-BINDING",
      "level": "element",
      "elementType": "value",
      "pageCountMultiple": 2,
      "label": {
        "en": "Layflat Binding",
        "nb": "Layflat-innbinding",
        "de": "Layflat-Bindung",
        "ja": "レイフラット製本",
        "es": "Encuadernación layflat",
        "zh-Hans": "蝴蝶装",
        "sv": "Layflat-bindning",
        "da": "Layflat-indbinding",
        "nl": "Layflat-binding",
        "pl": "Oprawa layflat",
        "pt": "Encadernação layflat",
        "hi": "लेफ़्लैट बाइंडिंग"
      },
      "definition": {
        "en": "Spreads open completely flat with no gutter loss — leaves are mounted back-to-back so a single image can run across both pages; the premium construction for photo books and albums.",
        "nb": "Oppslag som åpner helt flatt uten tap i midten — arkene monteres rygg mot rygg slik at ett bilde kan løpe over begge sider; premiumkonstruksjonen for fotobøker og album.",
        "de": "Aufschläge öffnen völlig flach ohne Verlust im Bund — die Blätter werden Rücken an Rücken montiert, sodass ein Bild über beide Seiten laufen kann; die Premium-Konstruktion für Fotobücher und Alben.",
        "ja": "ノド落ちなく完全にフラットに開く — 用紙を背中合わせに貼り合わせるため、1枚の画像を見開き全体に渡せる。フォトブックやアルバムのプレミアム仕様。",
        "es": "Se abre completamente plano sin pérdida en el lomo — las hojas van montadas dorso con dorso de modo que una sola imagen puede extenderse por ambas páginas; la construcción premium para álbumes y libros de fotos.",
        "zh-Hans": "完全平摊打开、无订口损失 — 页张背对背裱合，单幅图像可横贯双页；照片书与相册的高端工艺。",
        "sv": "Uppslag som öppnas helt plant utan förlust i bindningen — bladen monteras rygg mot rygg så att en enda bild kan löpa över båda sidorna; premiumkonstruktionen för fotoböcker och album.",
        "da": "Åbner helt fladt uden tab i ryggen — bladene monteres ryg mod ryg, så et enkelt billede kan løbe hen over begge sider; den eksklusive konstruktion til fotobøger og album.",
        "nl": "Opent volledig vlak zonder verlies in de rug — de bladen worden rug-aan-rug gemonteerd zodat één beeld over beide pagina's kan doorlopen; de premium constructie voor fotoboeken en albums.",
        "pl": "Rozkładówki otwierają się całkowicie płasko, bez straty w grzbiecie — karty są łączone grzbiet w grzbiet, więc jeden obraz może biec przez obie strony; konstrukcja premium dla fotoksiążek i albumów.",
        "pt": "As páginas duplas abrem totalmente planas sem perda no meio — as folhas são montadas costas com costas para que uma única imagem atravesse as duas páginas; a construção premium para fotolivros e álbuns.",
        "hi": "स्प्रेड पूरी तरह सपाट खुलते हैं, बीच (गटर) में कुछ छिपता नहीं — पत्ते पीठ-से-पीठ चिपके होते हैं ताकि एक ही चित्र दोनों पृष्ठों पर फैल सके; फ़ोटो बुक और एल्बम के लिए प्रीमियम निर्माण।"
      },
