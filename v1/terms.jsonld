          "Foil emboss",
          "Combination embossing",
          "Foil and emboss"
        ],
        "nb": [
          "Foliepreg"
        ],
        "pl": [
          "tłoczenie kombinowane",
          "folia z tłoczeniem"
        ],
        "pt": [
          "relevo com hot stamping",
          "relevo metalizado",
          "hot stamping em relevo",
          "relevo e foil"
        ],
        "hi": [
          "फ़ॉइल एम्बॉस",
          "कॉम्बिनेशन एम्बॉसिंग",
          "फ़ॉइल और एम्बॉस",
          "फ़ॉइल उभार"
        ]
      },
