    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/standards/certifications/environmental/carbon/climatecalc",
      "type": "skos:Concept",
      "version": "2026-07-18",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "ClimateCalc",
        "nb": "ClimateCalc",
        "de": "ClimateCalc",
        "ja": "ClimateCalc",
        "es": "ClimateCalc",
        "zh-Hans": "ClimateCalc",
        "sv": "ClimateCalc",
        "da": "ClimateCalc",
        "nl": "ClimateCalc",
        "pl": "ClimateCalc",
        "pt": "ClimateCalc",
