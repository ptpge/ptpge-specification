        ]
      }
    },
    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/technologies/printing-technologies/analog/intaglio/aquatint",
      "type": "skos:Concept",
      "version": "2026-06-05",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Aquatint",
        "es": "Aguatinta",
        "zh-Hans": "飞尘蚀刻",
        "nb": "Akvatint",
        "de": "Aquatinta",
        "ja": "アクアチント",
        "sv": "Akvatint",
        "da": "Akvatinte",
        "nl": "Aquatint",
        "pl": "Akwatinta",
        "pt": "Água-tinta",
        "hi": "एक्वाटिंट"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "technologies",
      "notation": "P:TC§AQUATINT",
      "elementType": "value",
      "broader": "https://ptpge.org/v1/printing/technologies/printing-technologies/analog/intaglio",
      "created": "2026-05-18T12:24:03Z",
      "modified": "2026-09-23T06:42:30Z",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "definition": {
        "en": "Intaglio printmaking technique that produces broad tonal areas by dusting a copper plate with rosin powder, fusing it with heat, and selectively biting the unprotected metal with acid. Each rosin grain leaves a small dot, creating tonal gradations.",
        "nb": "Intaglio-grafikkteknikk som produserer brede tonale områder ved å støve en kobberplate med harpikspulver, smelte det med varme, og selektivt bite ubeskyttet metall med syre. Hvert harpikskorn etterlater en liten prikk og skaper tonale graderinger.",
        "de": "Stichtiefdruck-Technik, die durch Aufstäuben von Kolophoniumstaub auf eine Kupferplatte, Anschmelzen mit Hitze und selektives Ätzen des unbedeckten Metalls mit Säure breite Tonflächen erzeugt. Jedes Harzkorn hinterlässt einen kleinen Punkt und schafft so tonale Abstufungen.",
        "ja": "銅板にロジン粉末をまぶし、加熱で溶着し、保護されていない金属を選択的に酸で腐食させて広い階調領域を生み出す凹版版画技法。各ロジン粒が小さなドットを残し、階調グラデーションを作る。",
        "es": "Técnica de grabado en intaglio que utiliza resina y ácido para crear zonas tonales — la resina protege partes de la plancha mientras el ácido muerde otras, generando texturas continuas.",
        "zh-Hans": "凹版蚀刻技术，使用树脂和酸创造色调区域——树脂保护版的部分区域，酸蚀其他区域，产生连续纹理。",
        "sv": "Koppartrycksteknik som skapar breda tonytor genom att pudra en kopparplåt med harts, smälta fast det med värme och selektivt etsa den oskyddade metallen med syra. Varje hartskorn lämnar en liten punkt, vilket skapar tongraderingar.",
        "da": "Kobbertryksteknik, der skaber brede toneflader ved at pudre en kobberplade med harpiks, smelte den fast med varme og selektivt ætse det ubeskyttede metal med syre. Hvert harpikskorn efterlader en lille prik, hvilket skaber tonegraderinger.",
        "nl": "Koperdiepdruktechniek die brede toonvlakken oplevert door een koperplaat met harspoeder te bestuiven, dit met warmte te fixeren en het onbeschermde metaal selectief met zuur te etsen. Elke harskorrel laat een puntje achter, wat toongradaties oplevert.",
        "pl": "Technika druku wklęsłego dająca szerokie płaszczyzny tonalne przez opylenie płyty miedzianej sproszkowaną kalafonią, stopienie jej ciepłem i wybiórcze trawienie odsłoniętego metalu kwasem. Każde ziarno kalafonii zostawia drobny punkt, tworząc gradacje tonalne.",
        "pt": "Técnica de gravura calcográfica que produz amplas áreas tonais polvilhando uma chapa de cobre com pó de resina, fundindo-o com calor e corroendo seletivamente com ácido o metal desprotegido. Cada grão de resina deixa um pequeno ponto, criando gradações tonais.",
        "hi": "इंटैग्लियो प्रिंटमेकिंग तकनीक जो ताँबे की प्लेट पर रोज़िन पाउडर छिड़ककर, गर्मी से पिघलाकर और असुरक्षित धातु को चुनिंदा रूप से अम्ल से खाकर विस्तृत टोनल क्षेत्र बनाती है। हर रोज़िन कण एक छोटा बिंदु छोड़ता है, जिससे टोनल क्रम बनते हैं।"
      },
      "creator": "https://ptpge.org/contributors/ptpge",
      "contributor": [
        "https://ptpge.org/contributors/patrik-knutsson"
      ],
      "altLabels": {
        "en": [
          "Aquatint"
        ],
        "nb": [
          "Akvatint"
        ],
        "pt": [
          "Aquatinta"
        ]
      },
      "semanticSource": [
        {
