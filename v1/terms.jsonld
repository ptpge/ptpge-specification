      "label": {
        "en": "Blue Angel",
        "es": "Blue Angel (Der Blaue Engel)",
        "zh-Hans": "Blue Angel（蓝天使）",
        "nb": "Blue Angel",
        "de": "Blue Angel",
        "ja": "Blue Angel",
        "sv": "Blue Angel (Der Blaue Engel)",
        "da": "Blue Angel (Der Blaue Engel)",
        "nl": "Blue Angel (Der Blaue Engel)",
        "pl": "Błękitny Anioł",
        "pt": "Anjo Azul",
        "hi": "Blue Angel"
      },
      "inScheme": "https://ptpge.org/v1/scheme",
      "group": "standards",
      "notation": "P:ST§BLUE-ANGEL",
      "elementType": "reference",
      "broader": "https://ptpge.org/v1/printing/standards/certifications/environmental",
      "created": "2026-05-18T12:24:03Z",
