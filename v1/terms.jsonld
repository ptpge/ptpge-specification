    {
      "@context": "https://ptpge.org/v1/context.jsonld",
      "id": "https://ptpge.org/v1/printing/standards/color-systems/color-matching-systems/pantone-matching-system/pantone-metallic",
      "type": "skos:Concept",
      "version": "2026-08-27",
      "status": "proposed",
      "level": "element",
      "label": {
        "en": "Pantone Metallic",
        "nb": "Pantone Metallic",
        "de": "Pantone Metallic",
        "ja": "Pantone Metallic",
        "es": "Pantone Metallic",
        "zh-Hans": "Pantone Metallic",
        "sv": "Pantone Metallic",
        "da": "Pantone Metallic",
        "nl": "Pantone Metallic",
        "pl": "Pantone Metallic",
        "pt": "Pantone Metallic",
        "hi": "Pantone Metallic"
      },
      "definition": {
        "en": "Pantone's metallic color library — pre-mixed metallic inks (gold, silver, bronze, copper, and various other metallic effects). Provides reflective sheen and premium appearance. Pantone 871 (gold), 877 (silver), and the 800-series include metallic variants.",
        "nb": "Pantones metallisk-fargebibliotek — forhåndsblandede metalliske blekk (gull, sølv, bronse, kobber og diverse andre metalliske effekter). Gir reflekterende glans og premium-utseende.",
        "de": "Pantones Metallic-Farbbibliothek — vorgemischte Metallic-Druckfarben (Gold, Silber, Bronze, Kupfer und verschiedene andere Metallic-Effekte).",
        "ja": "Pantone のメタリックカラーライブラリ — 調合済みメタリックインキ（金、銀、ブロンズ、銅、その他のメタリック効果）。反射光沢とプレミアムな外観をもたらす。Pantone 871（金）、877（銀）、800番台にメタリックのバリエーションがある。",
        "es": "La biblioteca de colores metálicos de Pantone — tintas metálicas premezcladas (oro, plata, bronce, cobre y otros efectos metálicos). Aporta brillo reflectante y aspecto premium. Pantone 871 (oro), 877 (plata) y la serie 800 incluyen variantes metálicas.",
        "zh-Hans": "Pantone 金属色库 — 预混金属油墨（金、银、青铜、铜及其他金属效果）。提供反射光泽与高级观感。Pantone 871（金）、877（银）及800系列包含金属色变体。",
        "sv": "Pantones metalliska färgbibliotek — förblandade metalliska bläck (guld, silver, brons, koppar och andra metalliska effekter). Ger reflekterande lyster och premiumkänsla. Pantone 871 (guld), 877 (silver) och 800-serien innehåller metalliska varianter.",
        "da": "Pantones metalliske farvebibliotek — færdigblandede metalliske farver (guld, sølv, bronze, kobber og andre metaleffekter). Giver reflekterende glans og eksklusivt udtryk. Pantone 871 (guld), 877 (sølv) og 800-serien omfatter metalliske varianter.",
        "nl": "Pantones metallic kleurbibliotheek — voorgemengde metallic inkten (goud, zilver, brons, koper en andere metaaleffecten). Geeft reflecterende glans en een premium uitstraling. Pantone 871 (goud), 877 (zilver) en de 800-serie bevatten metallic varianten.",
        "pl": "Biblioteka barw metalicznych Pantone — wstępnie zmieszane farby metaliczne (złoto, srebro, brąz, miedź i inne efekty metaliczne). Daje odbijający połysk i wygląd premium. Pantone 871 (złoto), 877 (srebro) i seria 800 obejmują warianty metaliczne.",
        "pt": "Biblioteca de cores metálicas da Pantone — tintas metálicas pré-misturadas (ouro, prata, bronze, cobre e vários outros efeitos metálicos). Confere brilho reflexivo e aparência premium. Pantone 871 (ouro), 877 (prata) e a série 800 incluem variantes metálicas.",
        "hi": "Pantone का मेटैलिक रंग पुस्तकालय — पूर्व-मिश्रित मेटैलिक स्याही (सोना, चाँदी, काँसा, ताँबा और विभिन्न अन्य मेटैलिक प्रभाव)। परावर्तक चमक और प्रीमियम रूप देता है। Pantone 871 (सोना), 877 (चाँदी) और 800-श्रृंखला में मेटैलिक वेरिएंट।"
      },
