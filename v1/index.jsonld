{
  "@context": "https://ptpge.org/v1/context.jsonld",
  "id": "https://api.ptpge.org/v1/",
  "type": "ApiCatalog",
  "title": "PTPGE API — v1",
  "description": "Public, read-only API for the PTPGE specification — the open reference for print, built as a structured vocabulary covering the Periodic Table of Print & Graphic Elements. Every endpoint returns JSON-LD with SKOS vocabulary. Free to use under CC BY 4.0 with attribution.",
  "apiVersion": "1",
  "dataVersion": "2026-10-12",
  "termCount": 726,
  "deprecatedCount": 81,
  "variableCount": 36,
  "schemaCount": 5,
  "supplierCount": 14,
  "vendorCount": 1,
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "documentation": "https://api.ptpge.org/integration.html",
  "endpoints": [
    {
      "url": "https://api.ptpge.org/v1/scheme",
      "description": "The PTPGE concept scheme — name, version, top concepts."
    },
    {
      "url": "https://api.ptpge.org/v1/version",
      "description": "API version, data version, term counts by Group and level."
    },
    {
      "url": "https://api.ptpge.org/v1/printing",
      "description": "The Printing Process top concept (industry view) and its seven Groups."
    },
    {
      "url": "https://api.ptpge.org/v1/printing/{group}",
      "description": "A Printing Process Group: standards, management, technologies, configurations, features, substrates, completions."
    },
    {
      "url": "https://api.ptpge.org/v1/ordering",
      "description": "The Ordering Process top concept (end-user view) and its three Groups."
    },
    {
      "url": "https://api.ptpge.org/v1/ordering/{group}",
      "description": "An Ordering Process Group: knowledge, geography, products."
    },
    {
      "url": "https://api.ptpge.org/v1/{top}/{path}",
      "description": "Any term by its hierarchical path under either top concept. Permanent URI — never changes."
    },
    {
      "url": "https://api.ptpge.org/v1/terms",
      "description": "Full bundle of all terms in a single document (~390 KB)."
    },
    {
      "url": "https://api.ptpge.org/v1/search-index",
      "description": "Pre-computed search index for client-side full-text search."
    },
    {
      "url": "https://api.ptpge.org/v1/context",
      "description": "JSON-LD context — maps PTPGE field names to SKOS / Dublin Core."
    }
  ],
