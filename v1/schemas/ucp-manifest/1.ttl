<https://ptpge.org/v1/schemas/ucp-manifest/1> a ptpge:Schema ;
    dcterms:created "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/schemas> ;
    skos:definition "How a storefront carries the PTPGE identity in a Universal Commerce Protocol manifest: the fingerprint on the line item, the configuration behind it resolvable at ptpge.org/f. The bridge from the specification to agentic checkout."@en,
        "How a storefront carries the PTPGE identity in a Universal Commerce Protocol manifest: the fingerprint on the line item, the configuration behind it resolvable at ptpge.org/f. The bridge from the specification to agentic checkout."@nb ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "SCH:UCP-MANIFEST" ;
    skos:prefLabel "UCP manifest"@en,
        "UCP-manifest"@nb ;
    ptpge:holds "the PTPGE identity on a checkout line" ;
    ptpge:level "element" ;
    ptpge:schemaVersion 1 ;
    ptpge:stage "draft" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-10-06" ;
    ptpge:writtenBy "a storefront" .

