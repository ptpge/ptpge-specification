    skos:definition "What a printer is and can make, in the vocabulary: identity, production capability, the products it offers. Written by the printer or its MIS; carries the printer's identity (/v1/vendors/…)."@en,
        "Hva et trykkeri er og kan lage, i vokabularet: identitet, produksjonskapasitet, produktene det tilbyr. Skrives av trykkeriet eller dets MIS; bærer trykkeriets identitet (/v1/vendors/…)."@nb ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "SCH:VENDOR-DECLARATION" ;
    skos:prefLabel "Vendor declaration"@en,
        "Leverandørdeklarasjon"@nb ;
    ptpge:holds "identity · capability · offerings" ;
    ptpge:jsonSchema <https://ptpge.org/v1/schemas/vendor-declaration/1.schema.json> ;
    ptpge:level "element" ;
    ptpge:schemaVersion 1 ;
    ptpge:stage "draft" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-10-10" ;
    ptpge:writtenBy "a printer, or its MIS" .

