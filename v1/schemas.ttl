@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/schemas> a skos:Concept ;
    dcterms:created "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-10T19:20:00+00:00"^^xsd:dateTime ;
    skos:definition "The five document forms the vocabulary is used in: vendor declaration and supplier catalogue (what a company is and offers, published on its own domain), request and quote (one deal between a buyer and a printer), UCP manifest (the identity on a checkout line). Each has a schema with a permanent URI and a version; a document carries its owner, the schema carries none. Status: draft. All five have published JSON Schemas (2026-10-10), with a reference validator that checks shape, identity or fingerprint, and every term URI against the vocabulary. The rule every schema sets: what a document says about products and options, it says with term URIs, not labels."@en,
        "De fem dokumentformene vokabularet brukes i: leverandørdeklarasjon og produsentkatalog (hva en virksomhet er og tilbyr, publisert på eget domene), forespørsel og tilbud (én handel mellom kjøper og trykkeri), UCP-manifest (identiteten på en kasselinje). Hvert har et skjema med permanent URI og versjon; et dokument bærer sin eier, skjemaet bærer ingen. Status: utkast. Alle fem har publisert JSON Schema (2026-10-10), med en referansevalidator som sjekker form, identitet eller fingeravtrykk, og hver term-URI mot vokabularet. Regelen hvert skjema setter: det et dokument sier om produkter og valg, sier det med term-URI-er, ikke etiketter."@nb ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/schemas/quote/1>,
        <https://ptpge.org/v1/schemas/request/1>,
        <https://ptpge.org/v1/schemas/supplier-catalogue/1>,
        <https://ptpge.org/v1/schemas/ucp-manifest/1>,
        <https://ptpge.org/v1/schemas/vendor-declaration/1> ;
    skos:notation "SCH" ;
    skos:prefLabel "Skemaer"@da,
        "Schemata"@de,
        "Schemas"@en,
        "Dokumentskjemaer"@nb,
        "Schema's"@nl,
        "Scheman"@sv ;
    skos:topConceptOf <https://ptpge.org/v1/scheme> ;
    ptpge:level "top-concept" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-10-09" .

