    "en": "Vinyl Graphics",
    "nb": "Vinyldekor",
    "de": "Vinylgrafiken",
    "es": "Vinilos impresos",
    "ja": "ビニールグラフィックス",
    "zh-Hans": "乙烯基贴膜",
    "sv": "Vinyldekor",
    "da": "Vinylgrafik",
