        "Standard levering"@nb,
        "Standaardlevering"@nl,
        "Dostawa standardowa"@pl,
        "Entrega padrão"@pt,
        "Standardleverans"@sv,
        "标准配送"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "distribution" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-26" .

