        "Expreslevering"@nl,
        "Dostawa ekspresowa"@pl,
        "Entrega expressa"@pt,
        "Expressleverans"@sv,
        "加急配送"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "distribution" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-26" .

