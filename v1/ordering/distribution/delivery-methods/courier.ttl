<https://ptpge.org/v1/ordering/distribution/delivery-methods/courier> a skos:Concept ;
    dcterms:created "2026-06-26T05:36:54+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:33:00+00:00"^^xsd:dateTime ;
    skos:altLabel "Bike courier"@en,
        "Same-day courier"@en,
        "कूरियर सेवा"@hi,
        "बाइक कूरियर"@hi,
        "सेम-डे कूरियर"@hi,
        "kurier rowerowy"@pl,
        "kurier tego samego dnia"@pl,
        "courier no mesmo dia"@pt,
        "entrega por courier"@pt,
        "motoboy"@pt ;
    skos:broader <https://ptpge.org/v1/ordering/distribution/delivery-methods> ;
    skos:definition "Kurér — en distributionsmetode i det åbne checkout-vokabular. Selve transportøren, prisen og adressen er kommercielle data (lag 2/3/4)."@da,
        "Kurier — eine Versandart im offenen Checkout-Vokabular. Tatsächlicher Frachtführer, Tarif und Adresse sind kommerzielle Daten (Layer 2/3/4)."@de,
        "Courier — a distribution method in the open checkout vocabulary. The actual carrier, rate and address are commercial (Layer 2/3/4) data."@en,
        "Mensajería — un método de distribución del vocabulario abierto de checkout. El transportista, la tarifa y la dirección reales son datos comerciales (Layer 2/3/4)."@es,
        "कूरियर — खुले चेकआउट शब्दकोश में एक वितरण विधि। वास्तविक वाहक, दर और पता व्यावसायिक (लेयर 2/3/4) डेटा हैं।"@hi,
        "宅配便 — オープンなチェックアウト語彙における配送方法。実際の運送業者・料金・住所は商用データ（Layer 2/3/4）。"@ja,
        "Courier — en distribusjonsmetode i det åpne checkout-vokabularet. Faktisk transportør, rate og adresse er kommersiell (Layer 2/3/4) data."@nb,
        "Koerier — een leveringsmethode in het open checkout-vocabulaire. De feitelijke vervoerder, het tarief en het adres zijn commerciële gegevens (laag 2/3/4)."@nl,
        "Kurier — metoda dystrybucji w otwartym słownictwie kasy (checkout). Rzeczywisty przewoźnik, stawka i adres to dane handlowe (warstwa 2/3/4)."@pl,
        "Courier — método de distribuição no vocabulário aberto de checkout. A transportadora, a tarifa e o endereço reais são dados comerciais (Camadas 2/3/4)."@pt,
        "Bud — ett leveranssätt i den öppna kassavokabulären. Faktisk transportör, pris och adress är kommersiella data (Layer 2/3/4)."@sv,
        "快递——开放结算词汇中的一种配送方式。实际承运商、费率与地址属于商业数据（Layer 2/3/4）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:DS§COURIER" ;
    skos:prefLabel "Kurér"@da,
        "Kurier"@de,
        "Courier"@en,
