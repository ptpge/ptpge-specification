        <https://ptpge.org/v1/ordering/distribution/incoterms/exw>,
        <https://ptpge.org/v1/ordering/distribution/incoterms/fas>,
        <https://ptpge.org/v1/ordering/distribution/incoterms/fca>,
        <https://ptpge.org/v1/ordering/distribution/incoterms/fob> ;
    skos:notation "O:DS-INCOTERMS" ;
    skos:prefLabel "Incoterms 2020"@da,
        "Incoterms 2020"@de,
        "Incoterms 2020"@en,
        "Incoterms 2020"@es,
        "Incoterms 2020"@hi,
        "インコタームズ2020"@ja,
        "Incoterms 2020"@nb,
        "Incoterms 2020"@nl,
        "Incoterms 2020"@pl,
        "Incoterms 2020"@pt,
        "Incoterms 2020"@sv,
        "国际贸易术语2020"@zh-Hans ;
    skos:scopeNote "Incoterms® is a registered trademark of the International Chamber of Commerce (ICC). These terms are referenced, not redefined; the ICC publication is authoritative."@en,
        "Incoterms® अंतरराष्ट्रीय वाणिज्य मंडल (ICC) का पंजीकृत ट्रेडमार्क है। ये पद संदर्भित हैं, पुनर्परिभाषित नहीं; ICC का प्रकाशन प्रामाणिक है।"@hi,
        "Incoterms® er et registrert varemerke tilhørende International Chamber of Commerce (ICC). Disse vilkårene refereres, ikke omdefineres; ICC-publikasjonen er autoritativ."@nb,
        "Incoterms® é marca registrada da Câmara de Comércio Internacional (ICC). Estes termos são referenciados, não redefinidos; a publicação da ICC é a fonte autoritativa."@pt ;
    ptpge:group "distribution" ;
    ptpge:level "category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-26" .

