        "CFR — Cost and Freight"@nl,
        "CFR — Koszt i fracht"@pl,
        "CFR — Custo e Frete"@pt,
        "CFR — Cost and Freight"@sv,
        "CFR — 成本加运费"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "distribution" ;
    ptpge:hasProperty [ ] ;
