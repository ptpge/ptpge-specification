        "EXW — Ex Works"@nb,
        "EXW — Ex Works"@nl,
        "EXW — Z zakładu"@pl,
        "EXW — Na Fábrica"@pt,
        "EXW — Ex Works"@sv,
        "EXW — 工厂交货"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "distribution" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-26" .

