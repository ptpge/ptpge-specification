        "CIP — Carriage and Insurance Paid To"@nb,
        "CIP — Carriage and Insurance Paid To"@nl,
        "CIP — Przewóz i ubezpieczenie opłacone do"@pl,
        "CIP — Transporte e Seguro Pagos Até"@pt,
        "CIP — Carriage and Insurance Paid To"@sv,
        "CIP — 运费及保险费付至"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "distribution" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
