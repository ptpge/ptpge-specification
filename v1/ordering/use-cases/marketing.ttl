@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/ordering/use-cases/marketing> a skos:Concept ;
    dcterms:created "2026-05-20T10:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:31:34+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/use-cases> ;
    skos:closeMatch schema:PromoteAction ;
    skos:definition "Produkter brugt til at promovere, annoncere eller markedsføre en virksomhed, et produkt, en tjeneste eller et brand over for potentielle kunder. Omfatter brochurer, flyers, plakater, salgsark og kampagneforsendelser."@da,
        "Produkte, die zur Bewerbung, Werbung oder Vermarktung eines Unternehmens, Produkts, einer Dienstleistung oder Marke an potenzielle Kunden verwendet werden."@de,
        "Products used to promote, advertise, or market a business, product, service, or brand to potential customers. Includes brochures, flyers, posters, sales sheets, and promotional mailers used in marketing campaigns."@en,
        "Productos usados para promocionar, publicitar o comercializar un negocio, producto, servicio o marca ante clientes potenciales. Incluye folletos, flyers, pósteres, hojas de venta y mailings promocionales usados en campañas de marketing."@es,
        "किसी व्यवसाय, उत्पाद, सेवा या ब्रांड को संभावित ग्राहकों के बीच प्रचारित, विज्ञापित या विपणित करने वाले उत्पाद। मार्केटिंग अभियानों में प्रयुक्त ब्रोशर, फ़्लायर, पोस्टर, सेल्स शीट और प्रचार मेलर शामिल।"@hi,
        "見込み客に向けて事業・製品・サービス・ブランドを宣伝・広告・マーケティングするための製品。マーケティングキャンペーンで使うパンフレット、チラシ、ポスター、セールスシート、販促DMを含む。"@ja,
        "Produkter brukt til å promotere, annonsere eller markedsføre en virksomhet, et produkt, en tjeneste eller et merke til potensielle kunder. Inkluderer brosjyrer, flyere, plakater, salgsark og markedsføringsmaterialer brukt i markedskampanjer."@nb,
        "Producten om een bedrijf, product, dienst of merk te promoten bij potentiële klanten. Omvat brochures, flyers, posters, verkoopbladen en promotionele mailings."@nl,
        "Produkty służące promowaniu, reklamowaniu lub sprzedaży firmy, produktu, usługi lub marki potencjalnym klientom. Obejmuje foldery, ulotki, plakaty, karty sprzedażowe i mailingi promocyjne używane w kampaniach marketingowych."@pl,
        "Produtos usados para promover, anunciar ou comercializar uma empresa, produto, serviço ou marca junto a clientes potenciais. Inclui folhetos, flyers, pôsteres, folhas de vendas e malas diretas promocionais usados em campanhas de marketing."@pt,
        "Produkter som marknadsför eller annonserar ett företag, en produkt, tjänst eller ett varumärke mot potentiella kunder. Omfattar broschyrer, flygblad, affischer, säljblad och kampanjutskick."@sv,
        "用于向潜在客户推广、宣传企业、产品、服务或品牌的产品。包括营销活动中使用的手册、传单、海报、销售单页与促销邮件。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:UC§MARKETING" ;
    skos:prefLabel "Markedsføring"@da,
        "Marketing"@de,
        "Marketing"@en,
        "Marketing"@es,
        "मार्केटिंग"@hi,
        "マーケティング"@ja,
        "Markedsføring"@nb,
        "Marketing"@nl,
        "Marketing"@pl,
        "Marketing"@pt,
        "Marknadsföring"@sv,
        "营销"@zh-Hans ;
    ptpge:elementType "context" ;
    ptpge:group "use-cases" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

