@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/ordering/use-cases/instructional> a skos:Concept ;
    dcterms:created "2026-05-20T10:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:31:34+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/use-cases> ;
    skos:closeMatch schema:TeachAction ;
    skos:definition "Produkter brugt til at instruere eller guide læseren gennem en proces, procedure eller færdighed. Omfatter brugermanualer, installationsvejledninger, kursusmateriale og trin-for-trin-hæfter."@da,
        "Produkte zur Anleitung oder Führung des Lesers durch einen Prozess, ein Verfahren oder eine Fertigkeit. Umfasst Benutzerhandbücher, Installationsanleitungen und Schulungsmaterialien."@de,
        "Products used to instruct or guide the reader through a process, procedure, or skill. Includes user manuals, installation guides, training materials, and step-by-step booklets."@en,
        "Productos usados para instruir o guiar al lector a través de un proceso, procedimiento o habilidad. Incluye manuales de usuario, guías de instalación, materiales de formación y cuadernillos paso a paso."@es,
        "पाठक को किसी प्रक्रिया, विधि या कौशल में निर्देश या मार्गदर्शन देने वाले उत्पाद। यूज़र मैनुअल, इंस्टॉलेशन गाइड, प्रशिक्षण सामग्री और चरण-दर-चरण पुस्तिकाएँ शामिल।"@hi,
        "プロセス、手順、技能について読者を導き、指導するための製品。取扱説明書、設置ガイド、研修教材、ステップ式の小冊子を含む。"@ja,
        "Produkter brukt til å instruere eller veilede leseren gjennom en prosess, prosedyre eller ferdighet. Inkluderer brukerveiledninger, installasjonsguider, opplæringsmateriell, og steg-for-steg-hefter."@nb,
        "Producten die de lezer door een proces, procedure of vaardigheid leiden. Omvat gebruikershandleidingen, installatiegidsen, cursusmateriaal en stap-voor-stapboekjes."@nl,
        "Produkty służące instruowaniu lub prowadzeniu czytelnika przez proces, procedurę lub umiejętność. Obejmuje instrukcje obsługi, przewodniki instalacji, materiały szkoleniowe i broszury krok po kroku."@pl,
        "Produtos usados para instruir ou guiar o leitor por um processo, procedimento ou habilidade. Inclui manuais do usuário, guias de instalação, materiais de treinamento e folhetos passo a passo."@pt,
        "Produkter som instruerar eller vägleder läsaren genom en process, procedur eller färdighet. Omfattar bruksanvisningar, installationsguider, utbildningsmaterial och steg-för-steg-häften."@sv,
        "用于指导读者完成流程、程序或技能的产品。包括用户手册、安装指南、培训材料与分步小册子。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:UC§INSTRUCTIONAL" ;
    skos:prefLabel "Instruktion"@da,
        "Instruktiv"@de,
        "Instructional"@en,
        "Instructivo"@es,
        "निर्देशात्मक"@hi,
        "教材・指導用"@ja,
        "Instruktiv"@nb,
        "Instructie"@nl,
        "Instruktażowe"@pl,
        "Instrucional"@pt,
        "Instruktion"@sv,
        "教学指引"@zh-Hans ;
    ptpge:elementType "context" ;
    ptpge:group "use-cases" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

