<https://ptpge.org/v1/ordering/audiences/b2b> a skos:Concept ;
    dcterms:created "2026-05-20T10:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:31:34+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/audiences> ;
    skos:closeMatch schema:BusinessAudience ;
    skos:definition "Produkter rettet mod erhvervskøbere — virksomheder, fagfolk og organisationer, der køber til egen drift eller videresalg."@da,
        "Produkte für Geschäftskunden — Unternehmen, Fachleute und Organisationen, die für den eigenen Geschäftsbetrieb oder Wiederverkauf kaufen."@de,
        "Products targeted at business buyers — companies, professionals, and organisations purchasing for their own business operations or for resale."@en,
        "Productos dirigidos a compradores empresariales — empresas, profesionales y organizaciones que compran para sus propias operaciones o para reventa."@es,
        "व्यावसायिक खरीदारों के लिए उत्पाद — कंपनियाँ, पेशेवर और संस्थाएँ जो अपने व्यवसाय के संचालन या पुनर्विक्रय के लिए खरीदती हैं।"@hi,
        "ビジネスの買い手 — 自社の事業運営のため、または再販のために購入する企業・専門職・組織 — に向けた製品。"@ja,
        "Produkter rettet mot forretningskjøpere — selskaper, profesjonelle og organisasjoner som kjøper for egen drift eller videresalg."@nb,
        "Producten gericht op zakelijke kopers — bedrijven, professionals en organisaties die inkopen voor eigen bedrijfsvoering of doorverkoop."@nl,
        "Produkty skierowane do nabywców biznesowych — firm, profesjonalistów i organizacji kupujących na potrzeby własnej działalności lub do odsprzedaży."@pl,
        "Produtos voltados a compradores empresariais — empresas, profissionais e organizações que compram para a própria operação ou para revenda."@pt,
        "Produkter riktade till företagsköpare — företag, yrkesverksamma och organisationer som köper för egen verksamhet eller för återförsäljning."@sv,
        "面向企业买家的产品 — 为自身经营或转售而采购的公司、专业人士与组织。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:AU§B2B" ;
    skos:prefLabel "B2B (business-to-business)"@da,
        "B2B (Geschäftskunden)"@de,
        "B2B (Business-to-Business)"@en,
        "B2B (Business-to-Business)"@es,
        "B2B (व्यवसाय-से-व्यवसाय)"@hi,
        "B2B (Business-to-Business)"@ja,
        "B2B (Bedrift-til-bedrift)"@nb,
        "B2B (business-to-business)"@nl,
        "B2B (business-to-business)"@pl,
        "B2B (empresa para empresa)"@pt,
        "B2B (företag till företag)"@sv,
        "B2B (Business-to-Business)"@zh-Hans ;
    ptpge:elementType "context" ;
    ptpge:group "audiences" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

