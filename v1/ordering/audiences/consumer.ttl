@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/ordering/audiences/consumer> a skos:Concept ;
    dcterms:created "2026-05-20T10:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:31:34+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/audiences> ;
    skos:closeMatch schema:PeopleAudience ;
    skos:definition "Produkter rettet mod almindelige forbrugere på tværs af alle segmenter — bredere og mindre erhvervssegmenteret end B2C, herunder hobbyister, værter for arrangementer og købere til personlig brug."@da,
        "Produkte für allgemeine Verbraucher über alle Segmente hinweg — breiter als B2C, einschließlich Hobbyisten und Veranstalter."@de,
        "Products targeted at general consumers across all segments — broader and less business-segmented than B2C, including hobbyists, event hosts, and personal-use buyers."@en,
        "Productos dirigidos a consumidores en general de todos los segmentos — más amplio y menos segmentado por negocio que B2C, incluyendo aficionados, anfitriones de eventos y compradores de uso personal."@es,
        "सभी खंडों के सामान्य उपभोक्ताओं के लिए उत्पाद — B2C से व्यापक और कम व्यवसाय-खंडित, जिसमें शौक़ीन, आयोजन के मेज़बान और निजी उपयोग के खरीदार शामिल हैं।"@hi,
        "あらゆるセグメントの一般消費者向け製品 — B2C より広く、ビジネス区分の薄い層。趣味人、イベント主催者、個人利用の買い手を含む。"@ja,
        "Produkter rettet mot generelle forbrukere på tvers av alle segmenter — bredere og mindre B2C-segmentert, inkludert hobbyister, arrangører og personlige kjøpere."@nb,
        "Producten gericht op algemene consumenten in alle segmenten — breder en minder zakelijk gesegmenteerd dan B2C, inclusief hobbyisten, organisatoren van evenementen en particuliere kopers."@nl,
        "Produkty skierowane do ogółu konsumentów we wszystkich segmentach — szerzej i mniej biznesowo niż B2C; obejmuje hobbystów, organizatorów wydarzeń i nabywców na użytek osobisty."@pl,
        "Produtos voltados ao consumidor em geral, em todos os segmentos — mais amplo e menos segmentado por negócio que B2C, incluindo hobbistas, anfitriões de eventos e compradores para uso pessoal."@pt,
        "Produkter riktade till konsumenter i alla segment — bredare och mindre affärssegmenterat än B2C, inklusive hobbyister, evenemangsvärdar och privatköpare."@sv,
        "面向各细分层面普通消费者的产品 — 比 B2C 更广、商业细分更弱，包括爱好者、活动主办者与个人用途买家。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:AU§CONSUMER" ;
    skos:prefLabel "Forbruger"@da,
        "Verbraucher"@de,
        "Consumer"@en,
        "Consumidor"@es,
        "उपभोक्ता"@hi,
        "消費者"@ja,
        "Forbruker"@nb,
        "Consument"@nl,
        "Konsument"@pl,
        "Consumidor"@pt,
        "Konsument"@sv,
        "消费者"@zh-Hans ;
    ptpge:elementType "context" ;
    ptpge:group "audiences" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

