<https://ptpge.org/v1/ordering/audiences/educational> a skos:Concept ;
    dcterms:created "2026-05-20T10:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T16:31:34+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/ordering/audiences> ;
    skos:closeMatch schema:EducationalAudience ;
    skos:definition "Produkter rettet mod uddannelsesinstitutioner og lærende — skoler, universiteter, kursusudbydere, studerende og undervisere. Omfatter kursusmateriale, lærebøger, læringsressourcer og promovering af uddannelsesarrangementer."@da,
        "Produkte für Bildungseinrichtungen und Lernende — Schulen, Universitäten, Schulungsorganisationen, Studenten, Lehrer."@de,
        "Products targeted at educational institutions and learners — schools, universities, training organisations, students, teachers. Includes course materials, textbooks, learning resources, and educational events promotion."@en,
        "Productos dirigidos a instituciones educativas y estudiantes — escuelas, universidades, organizaciones de formación, alumnos, docentes. Incluye materiales de curso, libros de texto, recursos de aprendizaje y promoción de eventos educativos."@es,
        "शैक्षणिक संस्थानों और शिक्षार्थियों के लिए उत्पाद — स्कूल, विश्वविद्यालय, प्रशिक्षण संस्थाएँ, छात्र, शिक्षक। पाठ्य सामग्री, पाठ्यपुस्तकें, अधिगम संसाधन और शैक्षिक आयोजनों का प्रचार शामिल।"@hi,
        "教育機関と学習者 — 学校、大学、研修機関、学生、教員 — に向けた製品。コース教材、教科書、学習リソース、教育イベントの告知物を含む。"@ja,
        "Produkter rettet mot utdanningsinstitusjoner og lærende — skoler, universiteter, opplæringsorganisasjoner, studenter, lærere. Inkluderer kursmateriell, lærebøker, læringsressurser og promotering av utdanningshendelser."@nb,
        "Producten gericht op onderwijsinstellingen en lerenden — scholen, universiteiten, opleiders, studenten en docenten. Omvat cursusmateriaal, leerboeken, leermiddelen en promotie van onderwijsevenementen."@nl,
        "Produkty skierowane do instytucji edukacyjnych i osób uczących się — szkół, uczelni, organizacji szkoleniowych, uczniów, nauczycieli. Obejmuje materiały kursowe, podręczniki, pomoce dydaktyczne i promocję wydarzeń edukacyjnych."@pl,
        "Produtos voltados a instituições de ensino e estudantes — escolas, universidades, organizações de treinamento, alunos, professores. Inclui materiais de curso, livros didáticos, recursos de aprendizagem e divulgação de eventos educacionais."@pt,
        "Produkter riktade till utbildningsinstitutioner och lärande — skolor, universitet, utbildningsorganisationer, studenter, lärare. Omfattar kursmaterial, läroböcker, läranderesurser och marknadsföring av utbildningsevenemang."@sv,
        "面向教育机构与学习者的产品 — 学校、大学、培训机构、学生、教师。包括课程材料、教科书、学习资源与教育活动宣传品。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:AU§EDUCATIONAL" ;
    skos:prefLabel "Uddannelse"@da,
        "Pädagogisch"@de,
        "Educational"@en,
        "Educación"@es,
        "शैक्षिक"@hi,
        "教育"@ja,
        "Pedagogisk"@nb,
        "Onderwijs"@nl,
        "Edukacja"@pl,
        "Educacional"@pt,
        "Utbildning"@sv,
        "教育"@zh-Hans ;
    ptpge:elementType "context" ;
    ptpge:group "audiences" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

