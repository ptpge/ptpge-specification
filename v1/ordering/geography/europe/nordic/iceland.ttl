@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/ordering/geography/europe/nordic/iceland> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:24+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T18:09:48+00:00"^^xsd:dateTime ;
    skos:altLabel "IS"@en,
        "ISL"@en,
        "IS"@pl,
        "ISL"@pl ;
    skos:broader <https://ptpge.org/v1/ordering/geography/europe/nordic> ;
    skos:definition "Island — geografisk facet på landeniveau, der bruges til produktspecifikation, tilpasning til regionale standarder, leverandørlistning og afgrænsning af fragt og levering."@da,
        "Iceland — länderspezifische geografische Facette zur Verwendung in der Produktspezifikation, regionalen Standardausrichtung, Lieferantenliste und Versand-/Lieferzonen."@de,
        "Iceland — country-level geographic facet used for product specification, regional standards alignment, supplier listing, and shipping/delivery scoping."@en,
        "Iceland — faceta geográfica a nivel de país utilizada para especificación de producto, alineación con normas regionales, listados de proveedores y zonas de envío y entrega."@es,
        "आइसलैंड — देश-स्तरीय भौगोलिक पहलू, जो उत्पाद विनिर्देश, क्षेत्रीय मानकों के संरेखण, आपूर्तिकर्ता सूची और शिपिंग/डिलीवरी के दायरे के लिए प्रयुक्त होता है।"@hi,
        "Iceland — 製品仕様、地域標準への適合、供給者リスト、配送ゾーンに使用される国レベルの地理的ファセット。"@ja,
        "Iceland — land-nivå geografisk fasett brukt til produkt-spesifikasjon, regional standard-tilpasning, leverandør-lister og frakt/leverings-avgrensning."@nb,
        "IJsland — geografische facet op landniveau, gebruikt voor productspecificatie, afstemming op regionale standaarden, leverancierslijsten en afbakening van verzending en levering."@nl,
        "Islandia — aspekt geograficzny na poziomie kraju używany do specyfikacji produktu, dopasowania standardów regionalnych, listowania dostawców i zakresu wysyłki/dostawy."@pl,
        "Islândia — faceta geográfica de nível de país usada para especificação de produto, alinhamento a normas regionais, listagem de fornecedores e delimitação de envio/entrega."@pt,
        "Island — geografisk facett på landsnivå som används för produktspecifikation, anpassning till regionala standarder, leverantörslistning och avgränsning av frakt och leverans."@sv,
        "Iceland——用于产品规格、地区标准对接、供应商列表和发货/配送范围的国家级地理分面。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:GY§ICELAND" ;
    skos:prefLabel "Island"@da,
        "Island"@de,
        "Iceland"@en,
        "Islandia"@es,
        "आइसलैंड"@hi,
        "アイスランド"@ja,
        "Island"@nb,
        "IJsland"@nl,
        "Islandia"@pl,
        "Islândia"@pt,
        "Island"@sv,
        "冰岛"@zh-Hans ;
    ptpge:elementType "place" ;
    ptpge:group "geography" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

