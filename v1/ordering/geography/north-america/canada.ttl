@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/ordering/geography/north-america/canada> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:24+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-22T18:09:48+00:00"^^xsd:dateTime ;
    skos:altLabel "CA"@en,
        "CAN"@en,
        "CA"@pl,
        "CAN"@pl ;
    skos:broader <https://ptpge.org/v1/ordering/geography/north-america> ;
    skos:definition "Canada — geografisk facet på landeniveau, der bruges til produktspecifikation, tilpasning til regionale standarder, leverandørlistning og afgrænsning af fragt og levering."@da,
        "Canada — länderspezifische geografische Facette zur Verwendung in der Produktspezifikation, regionalen Standardausrichtung, Lieferantenliste und Versand-/Lieferzonen."@de,
        "Canada — country-level geographic facet used for product specification, regional standards alignment, supplier listing, and shipping/delivery scoping."@en,
        "Canada — faceta geográfica a nivel de país utilizada para especificación de producto, alineación con normas regionales, listados de proveedores y zonas de envío y entrega."@es,
        "कनाडा — देश-स्तरीय भौगोलिक पहलू, जो उत्पाद विनिर्देश, क्षेत्रीय मानकों के संरेखण, आपूर्तिकर्ता सूची और शिपिंग/डिलीवरी के दायरे के लिए प्रयुक्त होता है।"@hi,
        "Canada — 製品仕様、地域標準への適合、供給者リスト、配送ゾーンに使用される国レベルの地理的ファセット。"@ja,
        "Canada — land-nivå geografisk fasett brukt til produkt-spesifikasjon, regional standard-tilpasning, leverandør-lister og frakt/leverings-avgrensning."@nb,
        "Canada — geografische facet op landniveau, gebruikt voor productspecificatie, afstemming op regionale standaarden, leverancierslijsten en afbakening van verzending en levering."@nl,
        "Kanada — aspekt geograficzny na poziomie kraju używany do specyfikacji produktu, dopasowania standardów regionalnych, listowania dostawców i zakresu wysyłki/dostawy."@pl,
        "Canadá — faceta geográfica de nível de país usada para especificação de produto, alinhamento a normas regionais, listagem de fornecedores e delimitação de envio/entrega."@pt,
        "Kanada — geografisk facett på landsnivå som används för produktspecifikation, anpassning till regionala standarder, leverantörslistning och avgränsning av frakt och leverans."@sv,
        "Canada——用于产品规格、地区标准对接、供应商列表和发货/配送范围的国家级地理分面。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "O:GY§CANADA" ;
    skos:prefLabel "Canada"@da,
        "Kanada"@de,
        "Canada"@en,
        "Canadá"@es,
        "कनाडा"@hi,
        "カナダ"@ja,
        "Canada"@nb,
        "Canada"@nl,
        "Kanada"@pl,
        "Canadá"@pt,
        "Kanada"@sv,
        "加拿大"@zh-Hans ;
    ptpge:elementType "place" ;
    ptpge:group "geography" ;
    ptpge:hasProperty [ ] ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

