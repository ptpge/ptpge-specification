<https://ptpge.org/v1/suppliers> a skos:Concept ;
    dcterms:created "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-09T10:30:00+00:00"^^xsd:dateTime ;
    skos:definition "The register of makers — press, printer, finishing-equipment and paper manufacturers — each with one permanent PTPGE identity. A supplier's series, grades and models live in its own supplier catalogue, not in the vocabulary. A register, not the specification: the vocabulary itself carries no company names."@en,
        "Registeret over produsenter – presse-, skriver-, etterbehandlings- og papirprodusenter – hver med én permanent PTPGE-identitet. En produsents serier, kvaliteter og modeller lever i dens egen produsentkatalog, ikke i vokabularet. Et register, ikke spesifikasjonen: selve vokabularet bærer ingen firmanavn."@nb ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/suppliers/antalis>,
        <https://ptpge.org/v1/suppliers/canon>,
        <https://ptpge.org/v1/suppliers/harry-rochat>,
        <https://ptpge.org/v1/suppliers/heidelberg>,
        <https://ptpge.org/v1/suppliers/komori>,
        <https://ptpge.org/v1/suppliers/lessebo>,
        <https://ptpge.org/v1/suppliers/manroland>,
        <https://ptpge.org/v1/suppliers/mgi>,
        <https://ptpge.org/v1/suppliers/polar>,
        <https://ptpge.org/v1/suppliers/ricoh>,
        <https://ptpge.org/v1/suppliers/riso>,
        <https://ptpge.org/v1/suppliers/scodix>,
        <https://ptpge.org/v1/suppliers/swissqprint>,
        <https://ptpge.org/v1/suppliers/xerox> ;
    skos:notation "SUP" ;
    skos:prefLabel "Leverandører"@da,
        "Hersteller"@de,
        "Suppliers"@en,
        "Produsenter"@nb,
        "Fabrikanten"@nl,
        "Leverantörer"@sv ;
    skos:topConceptOf <https://ptpge.org/v1/scheme> ;
    ptpge:level "top-concept" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-10-06" .

