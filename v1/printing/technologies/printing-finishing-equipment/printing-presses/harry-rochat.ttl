<https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/printing-presses/harry-rochat> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:isReplacedBy <https://ptpge.org/v1/suppliers/harry-rochat> ;
