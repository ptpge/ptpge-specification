    skos:broader <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/printing-presses> ;
    skos:definition "Eastman Kodak — amerikansk producent af digitale produktionspresser (Nexpress, Prosper inkjet), trykplader og prepress-workflowsystemer."@da,
        "Eastman Kodak — US-amerikanischer Hersteller digitaler Produktionsdruckmaschinen (Nexpress, Prosper Inkjet), Druckplatten und Druckvorstufen-Workflow-Systemen."@de,
        "Eastman Kodak — American manufacturer of digital production presses (Nexpress, Prosper inkjet), printing plates, and prepress workflow systems."@en,
        "Eastman Kodak — fabricante estadounidense de prensas de inyección de tinta digital (serie Prosper), planchas CTP y soluciones de pre-prensa."@es,
        "Eastman Kodak — डिजिटल प्रोडक्शन प्रेस (Nexpress, Prosper इंकजेट), प्रिंटिंग प्लेट और प्रीप्रेस वर्कफ़्लो सिस्टम का अमेरिकी निर्माता।"@hi,
        "イーストマン・コダック — デジタル生産印刷機（Nexpress、Prosperインクジェット）、刷版、製版ワークフローシステムの米国のメーカー。"@ja,
        "Eastman Kodak — amerikansk produsent av digitale produksjonspresser (Nexpress, Prosper inkjet), trykkplater og prepress-arbeidsflyt-systemer."@nb,
        "Eastman Kodak — Amerikaanse fabrikant van digitale productiepersen (Nexpress, Prosper inkjet), drukplaten en prepressworkflowsystemen."@nl,
        "Eastman Kodak — amerykański producent cyfrowych maszyn produkcyjnych (Nexpress, atramentowe Prosper), płyt drukowych i systemów workflow prepress."@pl,
        "Eastman Kodak — fabricante americano de impressoras digitais de produção (Nexpress, jato de tinta Prosper), chapas de impressão e sistemas de fluxo de trabalho de pré-impressão."@pt,
        "Eastman Kodak — amerikansk tillverkare av digitala produktionspressar (Nexpress, Prosper inkjet), tryckplåtar och prepressarbetsflödessystem."@sv,
        "Eastman Kodak —— 美国数码喷墨印刷机制造商（Prosper系列）、CTP印版和印前解决方案。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC-PFE-PRES-KODA" ;
    skos:prefLabel "Kodak"@da,
        "Kodak"@de,
