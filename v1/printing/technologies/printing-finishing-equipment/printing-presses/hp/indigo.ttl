@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/printing-presses/hp/indigo> a skos:Concept ;
    dcterms:created "2026-08-25T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-09T10:30:00+00:00"^^xsd:dateTime ;
    skos:altLabel "Indigo"@en,
        "Indigo"@hi,
        "Indigo"@pl,
        "Indigo"@pt ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/printing-presses/hp> ;
    skos:definition "HP's Indigo sub-brand — liquid-electroink (liquid electrophotography) digital presses. A sub-brand with independent trade currency («printed on an Indigo»), hence its own identity term; individual models (Indigo 7K, 100K, …) are Layer-2 catalog content in HP's Supplier Profile."@en,
        "HP का Indigo उप-ब्रांड — लिक्विड-इलेक्ट्रोइंक (लिक्विड इलेक्ट्रोफ़ोटोग्राफ़ी) डिजिटल प्रेस। बिरादरी में अपनी अलग पहचान वाला उप-ब्रांड («Indigo पर छपा»), इसलिए अपना पहचान-पद; अलग-अलग मॉडल (Indigo 7K, 100K, …) HP की आपूर्तिकर्ता प्रोफ़ाइल में लेयर-2 कैटलॉग सामग्री हैं।"@hi,
        "HPs Indigo-undermerke — digitale presser med flytende elektroblekk (liquid electrophotography). Et undermerke med selvstendig valuta i bransjespråket («trykket på en Indigo»), derfor egen identitetsterm; enkeltmodellene (Indigo 7K, 100K, …) er Layer 2-kataloginnhold i HPs Supplier Profile."@nb,
        "Submarka Indigo firmy HP — cyfrowe maszyny z ciekłą farbą elektrostatyczną (ciekła elektrofotografia). Submarka o samodzielnej wartości w branży («drukowane na Indigo»), stąd własny termin tożsamości; poszczególne modele (Indigo 7K, 100K, …) to treść katalogowa warstwy 2 w profilu dostawcy HP."@pl,
        "Submarca Indigo da HP — impressoras digitais de tinta eletrônica líquida (eletrofotografia líquida). Submarca com moeda própria no ofício («impresso numa Indigo»), daí seu próprio termo de identidade; modelos individuais (Indigo 7K, 100K, …) são conteúdo de catálogo da Camada 2 no perfil de fornecedor da HP."@pt ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC-PFE-PRES-HP-INDG" ;
    skos:prefLabel "HP Indigo"@da,
        "HP Indigo"@de,
        "HP Indigo"@en,
        "HP Indigo"@es,
        "HP Indigo"@hi,
        "HP Indigo"@ja,
        "HP Indigo"@nb,
        "HP Indigo"@nl,
        "HP Indigo"@pl,
        "HP Indigo"@pt,
        "HP Indigo"@sv,
        "HP Indigo"@zh-Hans ;
    ptpge:deprecatedOn "2026-10-06"^^xsd:date ;
    ptpge:deprecationReason "Company names leave the vocabulary (SD-0097, 2026-10-06; SD-0101, 2026-10-09): a maker's identity is a register entry under /v1/suppliers/, created when the company claims it at ptpge.org/adopt, and its series and models live in its own catalogue. No register entry exists yet for this maker. This URI keeps resolving."@en,
        "Firmanavn går ut av vokabularet (SD-0097, 2026-10-06; SD-0101, 2026-10-09): en produsents identitet er en registeroppføring under /v1/suppliers/, opprettet når selskapet gjør identiteten gjeldende på ptpge.org/adopt, og serier og modeller lever i dens egen katalog. Ingen registeroppføring finnes ennå for denne produsenten. Denne URI-en fortsetter å svare."@nb ;
    ptpge:group "technologies" ;
    ptpge:level "sub-category" ;
    ptpge:status "deprecated" ;
    ptpge:version "2026-10-06" .

