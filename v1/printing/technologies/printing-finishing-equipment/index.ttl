@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/technologies/printing-finishing-equipment> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:39:22+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/technologies> ;
    skos:definition "Producenter og produktlinjer af fysisk udstyr til tryk og efterbehandling — maskinparken på produktionsgulvet."@da,
        "Hersteller und Produktlinien physischer Geräte, die in Druck und Druckweiterverarbeitung eingesetzt werden — die Maschinen auf der Produktionsfläche."@de,
        "Manufacturers and product lines of physical equipment used in printing and post-press finishing — the machinery on the production floor."@en,
        "Fabricantes y líneas de producto del equipo físico utilizado en impresión y acabado post-prensa — la maquinaria que se encuentra en la planta de producción."@es,
        "मुद्रण और पोस्ट-प्रेस फ़िनिशिंग में प्रयुक्त भौतिक उपकरणों के निर्माता और उत्पाद श्रृंखलाएँ — उत्पादन फ़्लोर की मशीनरी।"@hi,
        "印刷および後加工に使用される物理的機器のメーカーと製品ライン — 生産現場の機械類。"@ja,
        "Produsenter og produktlinjer av fysisk utstyr brukt i trykk og post-press etterbehandling — maskineriet på produksjonsgolvet."@nb,
        "Fabrikanten en productlijnen van fysieke apparatuur voor druk en afwerking — het machinepark op de productievloer."@nl,
        "Producenci i linie produktów fizycznych urządzeń używanych w druku i wykończeniu po druku — maszyny na hali produkcyjnej."@pl,
        "Fabricantes e linhas de produto de equipamentos físicos usados na impressão e no acabamento pós-impressão — as máquinas do chão de fábrica."@pt,
        "Tillverkare och produktlinjer av fysisk utrustning för tryck och efterbehandling — maskinparken på produktionsgolvet."@sv,
        "用于印刷和印后加工的物理设备制造商和产品线——生产车间内的机械设备。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/finishing-equipment>,
        <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/printing-presses>,
        <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/wide-format-printers> ;
    skos:notation "P:TC-PFE" ;
    skos:prefLabel "Tryk- & efterbehandlingsudstyr"@da,
        "Druck- und Weiterverarbeitungsausrüstung"@de,
        "Printing & Finishing Equipment"@en,
        "Equipo de Impresión y Acabado"@es,
        "मुद्रण और फ़िनिशिंग उपकरण"@hi,
        "印刷・後加工機器"@ja,
        "Trykk- og etterbehandlings-utstyr"@nb,
        "Druk- & afwerkingsapparatuur"@nl,
        "Urządzenia drukujące i wykończeniowe"@pl,
        "Equipamentos de impressão e acabamento"@pt,
        "Tryck- & efterbehandlingsutrustning"@sv,
        "印刷与印后设备"@zh-Hans ;
    skos:scopeNote "Umfasst Druckmaschinen (Offset, Digital, Flexo), Großformatdrucker (UV-Flachbett, Sublimation, Eco-Solvent) und Weiterverarbeitungsgeräte (Falzmaschinen, Buchbindemaschinen, Schneidemaschinen, Laminiergeräte, Stanzen). Die eigentlichen Drucktechnologien dieser Maschinen werden unter Drucktechnologien geführt."@de,
        "Includes printing presses (offset, digital, flexographic), wide-format printers (UV flatbed, dye-sublimation, eco-solvent), and finishing equipment (folders, binders, cutters, laminators, die-cutters). The actual printing technologies these machines use are tracked under Printing Technologies."@en,
        "Incluye prensas de impresión (offset, digital, flexográficas), impresoras de gran formato (UV plana, sublimación, eco-solvente) y equipo de acabado (plegadoras, encuadernadoras, guillotinas, plastificadoras, troqueladoras)."@es,
        "प्रिंटिंग प्रेस (ऑफसेट, डिजिटल, फ़्लेक्सोग्राफ़िक), वाइड-फॉर्मेट प्रिंटर (UV फ़्लैटबेड, डाई-सब्लिमेशन, इको-सॉल्वेंट) और फ़िनिशिंग उपकरण (फ़ोल्डर, बाइंडर, कटर, लैमिनेटर, डाई-कटर) शामिल। इन मशीनों की वास्तविक मुद्रण तकनीकें मुद्रण तकनीकों के अंतर्गत हैं।"@hi,
        "印刷機（オフセット、デジタル、フレキソ）、大判プリンター（UVフラットベッド、昇華転写、エコソルベント）、後加工機器（折り機、製本機、断裁機、ラミネーター、抜き機）を含む。これらの機器が使用する実際の印刷技術はPrinting Technologiesで扱う。"@ja,
        "Inkluderer trykkpresser (offset, digital, fleksografi), storformat-skrivere (UV flatbed, fargesublimering, øko-solvent) og etterbehandlingsutstyr (foldere, innbindere, kuttere, laminatorer, stansere). Selve trykketeknologiene maskinene bruker spores under Printing Technologies."@nb,
        "Inclui impressoras (offset, digital, flexográfica), impressoras de grande formato (UV flatbed, sublimação, eco-solvente) e equipamentos de acabamento (dobradeiras, encadernadoras, guilhotinas, laminadoras, cortadoras). As tecnologias de impressão que essas máquinas usam ficam em Tecnologias de impressão."@pt,
        "包括印刷机（胶印、数码、柔印）、大幅面打印机（UV平板、热升华、环保溶剂）和印后设备（折页机、装订机、裁切机、覆膜机、模切机）。"@zh-Hans ;
    ptpge:group "technologies" ;
    ptpge:level "category" ;
