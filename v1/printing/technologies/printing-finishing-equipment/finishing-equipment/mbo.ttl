<https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/finishing-equipment/mbo> a skos:Concept ;
    dcterms:created "2026-08-12T11:02:25+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
