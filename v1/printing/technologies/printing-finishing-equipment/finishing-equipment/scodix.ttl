<https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/finishing-equipment/scodix> a skos:Concept ;
    dcterms:created "2026-09-10T08:40:26+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
