<https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/finishing-equipment/graphic-whizard> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-09T10:30:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/finishing-equipment> ;
    skos:definition "Graphic Whizard — canadisk producent af kompakt efterbehandlingsudstyr til digitaltryk i korte serier, herunder rille-, perforerings- og nummererings-/ritsemaskiner."@da,
        "Graphic Whizard — kanadischer Hersteller kompakter Weiterverarbeitungsgeräte für den Kleinauflagen-Digitaldruck, einschließlich Rillgeräten, Perforiergeräten und Nummerier-/Rillmaschinen."@de,
        "Graphic Whizard — Canadian manufacturer of compact finishing equipment for short-run digital print, including creasers, perforators, and number/score machines."@en,
        "Graphic Whizard — fabricante canadiense de equipo compacto de acabado: numeradoras, hendidoras, perforadoras y plegadoras para producción de tirada corta."@es,
        "Graphic Whizard — शॉर्ट-रन डिजिटल प्रिंट के लिए कॉम्पैक्ट फ़िनिशिंग उपकरणों का कनाडाई निर्माता, जिसमें क्रीज़र, परफ़ोरेटर और नंबरिंग/स्कोरिंग मशीनें शामिल।"@hi,
        "Graphic Whizard — 短納期デジタル印刷向けのコンパクトな仕上げ機器を製造するカナダのメーカー。クリーザー、パーフォレーター、ナンバリング機・スコアリング機を扱う。"@ja,
        "Graphic Whizard — kanadisk produsent av kompakt etterbehandlingsutstyr for korttopplag digital trykk, inkludert creasers, perforerere og nummer-/score-maskiner."@nb,
        "Graphic Whizard — Canadese fabrikant van compacte afwerkingsapparatuur voor digitaal drukwerk in kleine oplagen, waaronder ril-, perforatie- en nummer-/scoremachines."@nl,
        "Graphic Whizard — kanadyjski producent kompaktowych urządzeń wykończeniowych do krótkoseryjnego druku cyfrowego, w tym bigówek, perforówek i numeratorów."@pl,
        "Graphic Whizard — fabricante canadense de equipamentos compactos de acabamento para impressão digital de tiragem curta, incluindo vincadoras, picotadoras e numeradoras/vincadoras."@pt,
        "Graphic Whizard — kanadensisk tillverkare av kompakt efterbehandlingsutrustning för digitaltryck i korta serier, inklusive bigmaskiner, perforeringsmaskiner och numrerings-/ritsmaskiner."@sv,
        "Graphic Whizard —— 加拿大紧凑型印后设备制造商：编号机、压痕机、打孔机和折页机，用于短印次生产。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC-PFE-FNEQ-GRAP" ;
    skos:prefLabel "Graphic Whizard"@da,
        "Graphic Whizard"@de,
        "Graphic Whizard"@en,
        "Graphic Whizard"@es,
        "Graphic Whizard"@hi,
        "Graphic Whizard"@ja,
        "Graphic Whizard"@nb,
        "Graphic Whizard"@nl,
        "Graphic Whizard"@pl,
        "Graphic Whizard"@pt,
        "Graphic Whizard"@sv,
        "Graphic Whizard"@zh-Hans ;
    ptpge:deprecatedOn "2026-10-06"^^xsd:date ;
    ptpge:deprecationReason "Company names leave the vocabulary (SD-0097, 2026-10-06; SD-0101, 2026-10-09): a maker's identity is a register entry under /v1/suppliers/, created when the company claims it at ptpge.org/adopt, and its series and models live in its own catalogue. No register entry exists yet for this maker. This URI keeps resolving."@en,
        "Firmanavn går ut av vokabularet (SD-0097, 2026-10-06; SD-0101, 2026-10-09): en produsents identitet er en registeroppføring under /v1/suppliers/, opprettet når selskapet gjør identiteten gjeldende på ptpge.org/adopt, og serier og modeller lever i dens egen katalog. Ingen registeroppføring finnes ennå for denne produsenten. Denne URI-en fortsetter å svare."@nb ;
    ptpge:group "technologies" ;
    ptpge:level "sub-category" ;
    ptpge:status "deprecated" ;
    ptpge:version "2026-10-06" .

