    skos:broader <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/finishing-equipment> ;
    skos:definition "MB Bäuerle — tysk producent af false- og kuverteringsudstyr, især til direct mail og transaktionstryk."@da,
        "MB Bäuerle — deutscher Hersteller von Falz- und Kuvertiermaschinen, insbesondere für Direktwerbung und Transaktionsdruck."@de,
        "MB Bäuerle — German manufacturer of folding and inserting equipment, particularly for direct mail and transactional printing."@en,
        "MB Bäuerle — fabricante alemán de plegadoras de alta precisión para producción comercial."@es,
        "MB Bäuerle — फ़ोल्डिंग और इन्सर्टिंग उपकरणों का जर्मन निर्माता, विशेषकर डायरेक्ट मेल और ट्रांज़ैक्शनल प्रिंटिंग के लिए।"@hi,
        "MB Bäuerle — ドイツの折り機・封入機メーカー。特にダイレクトメールおよびトランザクション印刷向け。"@ja,
        "MB Bäuerle — tysk produsent av brett- og innleggingsutstyr, særlig for direktreklame og transaksjons-trykk."@nb,
        "MB Bäuerle — Duitse fabrikant van vouw- en couverteerapparatuur, met name voor direct mail en transactiedruk."@nl,
        "MB Bäuerle — niemiecki producent urządzeń do składania i kopertowania, zwłaszcza dla direct mail i druku transakcyjnego."@pl,
        "MB Bäuerle — fabricante alemão de equipamentos de dobra e envelopamento, especialmente para mala direta e impressão transacional."@pt,
        "MB Bäuerle — tysk tillverkare av fals- och kuverteringsutrustning, särskilt för direktreklam och transaktionstryck."@sv,
        "MB Bäuerle —— 德国商业生产用高精度折页机制造商。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:TC-PFE-FNEQ-MBBA" ;
    skos:prefLabel "MB Bäuerle"@da,
        "MB Bäuerle"@de,
        "MB Bäuerle"@en,
        "MB Bäuerle"@es,
        "MB Bäuerle"@hi,
        "MB Bäuerle"@ja,
        "MB Bäuerle"@nb,
        "MB Bäuerle"@nl,
