    skos:broader <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/finishing-equipment> ;
    skos:definition "Baumfolder Corporation — amerikansk producent af falsemaskiner, bredt anvendt i efterbehandling til brochurer, foldere og direct mail."@da,
        "Baumfolder Corporation — US-amerikanischer Hersteller von Falzmaschinen, weit verbreitet in der Druckweiterverarbeitung für Broschüren, Flyer und Direktwerbung."@de,
        "Baumfolder Corporation — American manufacturer of paper-folding equipment, widely used in print finishing for brochures, leaflets, and direct mail."@en,
        "Baumfolder Corporation — fabricante estadounidense de plegadoras industriales para producción de impresión comercial."@es,
        "Baumfolder Corporation — काग़ज़ फ़ोल्डिंग उपकरणों का अमेरिकी निर्माता, ब्रोशर, लीफ़लेट और डायरेक्ट मेल की फ़िनिशिंग में व्यापक रूप से प्रयुक्त।"@hi,
        "Baumfolder Corporation — 米国の紙折り機メーカー。ブローシュア、リーフレット、ダイレクトメールの印刷後加工で広く使用されている。"@ja,
        "Baumfolder Corporation — amerikansk produsent av papirfolde-utstyr, mye brukt i trykk-etterbehandling for brosjyrer, flyers og direktreklame."@nb,
        "Baumfolder Corporation — Amerikaanse fabrikant van vouwmachines, breed gebruikt in afwerking voor brochures, folders en direct mail."@nl,
        "Baumfolder Corporation — amerykański producent urządzeń do składania papieru, szeroko używanych w wykończeniu druku broszur, ulotek i direct mail."@pl,
        "Baumfolder Corporation — fabricante americano de dobradeiras de papel, muito usadas no acabamento de folhetos, panfletos e mala direta."@pt,
        "Baumfolder Corporation — amerikansk tillverkare av falsmaskiner, brett använd i efterbehandling för broschyrer, foldrar och direktreklam."@sv,
        "Baumfolder Corporation —— 美国商业印刷生产用工业折页机制造商。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
