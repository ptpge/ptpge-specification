<https://ptpge.org/v1/printing/technologies/printing-technologies/digital/inkjet/dye-sublimation> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
