@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/standards/regulations> a skos:Concept ;
    dcterms:created "2026-07-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-23T00:00:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards> ;
    skos:definition "Regulatoriske instrumenter, der former trykhandel og produktdatakrav. Dette er referencer — ankre for maskinlæsbare compliancedata — ikke certificeringer, et trykkeri tilmelder sig."@da,
        "Regulatorische Instrumente, die den Druckhandel und Produktdatenanforderungen prägen. Es sind Referenzen — Anker für maschinenlesbare Compliance-Daten — keine Zertifizierungen, für die sich eine Druckerei entscheidet."@de,
        "Regulatory instruments that shape print commerce and product-data requirements. These are references — anchors for machine-readable compliance data — not certifications a printer opts into."@en,
        "Instrumentos regulatorios que dan forma al comercio de impresión y a los requisitos de datos de producto. Son referencias —anclas para datos de cumplimiento legibles por máquina— no certificaciones que una imprenta elige."@es,
        "प्रिंट वाणिज्य और उत्पाद-डेटा आवश्यकताओं को आकार देने वाले नियामक साधन। ये संदर्भ हैं — मशीन-पठनीय अनुपालन डेटा के लंगर — प्रमाणन नहीं जिन्हें प्रिंटर अपनी मर्ज़ी से चुने।"@hi,
        "印刷取引と製品データ要件を形作る規制手段。これらは参照であり——機械可読なコンプライアンスデータのアンカー——印刷会社が選択する認証ではない。"@ja,
        "Regulatoriske instrumenter som former trykkhandel og krav til produktdata. Dette er referanser — ankre for maskinlesbare samsvarsdata — ikke sertifiseringer et trykkeri velger."@nb,
        "Regulatoire instrumenten die drukhandel en productdatavereisten vormgeven. Dit zijn referenties — ankers voor machineleesbare compliancedata — geen certificeringen waarvoor een drukkerij zich aanmeldt."@nl,
        "Instrumenty regulacyjne kształtujące handel drukiem i wymagania dotyczące danych o produkcie. Są to odniesienia — kotwice dla maszynowo czytelnych danych o zgodności — a nie certyfikaty, do których drukarnia przystępuje dobrowolnie."@pl,
        "Instrumentos regulatórios que moldam o comércio de impressão e os requisitos de dados de produto. São referências — âncoras para dados de conformidade legíveis por máquina — e não certificações que um impressor escolhe obter."@pt,
        "Regulatoriska instrument som formar tryckhandel och produktdatakrav. Detta är referenser — ankare för maskinläsbara efterlevnadsdata — inte certifieringar ett tryckeri väljer att ansluta sig till."@sv,
        "塑造印刷贸易和产品数据要求的监管工具。它们是参照——机器可读合规数据的锚点——而非印刷企业自行选择的认证。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/regulations/digital-product-passport>,
        <https://ptpge.org/v1/printing/standards/regulations/packaging-and-packaging-waste-regulation> ;
    skos:notation "P:ST-REG" ;
    skos:prefLabel "Regulering"@da,
        "Regulierungen"@de,
        "Regulations"@en,
        "Regulaciones"@es,
        "विनियम"@hi,
        "規制"@ja,
        "Reguleringer"@nb,
        "Regelgeving"@nl,
        "Regulacje"@pl,
        "Regulamentos"@pt,
        "Regelverk"@sv,
        "法规"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-07-18" .

