    skos:prefLabel "Trykstandarder"@da,
        "Druckstandards"@de,
        "Print Standards"@en,
        "Estándares de impresión"@es,
        "मुद्रण मानक"@hi,
        "印刷標準"@ja,
        "Trykkstandarder"@nb,
