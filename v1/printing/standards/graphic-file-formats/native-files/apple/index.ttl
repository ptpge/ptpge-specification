@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/apple> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files> ;
    skos:definition "Programegne filformater for Apples produktivitetspakke iWork."@da,
        "Anwendungseigene Dateiformate für Apples iWork-Bürosoftware-Suite."@de,
        "Native file formats for Apple's iWork productivity suite."@en,
        "Formatos de archivo nativos para la suite de productividad iWork de Apple."@es,
        "Apple की iWork उत्पादकता सूट के नेटिव फ़ाइल फ़ॉर्मेट।"@hi,
        "AppleのiWork生産性スイート用のネイティブファイル形式。"@ja,
        "Programspesifikke filformater for Apples iWork-produktivitetspakke."@nb,
        "Programma-eigen bestandsformaten voor Apples productiviteitssuite iWork."@nl,
        "Natywne formaty plików pakietu biurowego Apple iWork."@pl,
        "Formatos de arquivo nativos da suíte de produtividade iWork da Apple."@pt,
        "Programegna filformat för Apples produktivitetssvit iWork."@sv,
        "Apple iWork办公套件的原生文件格式。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/apple/apple-keynotes>,
        <https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/apple/numbers>,
        <https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/apple/pages> ;
    skos:notation "P:ST-GFF-NATV-APPL" ;
    skos:prefLabel "Apple"@da,
        "Apple"@de,
        "Apple"@en,
        "Apple"@es,
        "Apple"@hi,
        "Apple"@ja,
        "Apple"@nb,
        "Apple"@nl,
        "Apple"@pl,
        "Apple"@pt,
        "Apple"@sv,
        "Apple"@zh-Hans ;
    skos:scopeNote "Umfasst Pages (.pages) für Textverarbeitung und Layout, Keynote (.key) für Präsentationen und Numbers (.numbers) für Tabellenkalkulation. Diese Formate sind in Druckproduktions-Workflows ungewöhnlich; PDF-Export ist die Standardübergabeform."@de,
        "Includes Pages (.pages) for word processing and layout, Keynote (.key) for presentations, and Numbers (.numbers) for spreadsheets. These formats are uncommon in print production workflows; PDF export is the standard handoff."@en,
        "Incluye Pages (.pages) para procesamiento de texto y maquetación, Keynote (.key) para presentaciones y Numbers (.numbers) para hojas de cálculo. Estos formatos son poco comunes en los flujos de producción impresa; la exportación a PDF es la entrega práctica para imprenta."@es,
        "वर्ड प्रोसेसिंग और लेआउट के लिए Pages (.pages), प्रस्तुतियों के लिए Keynote (.key) और स्प्रेडशीट के लिए Numbers (.numbers) शामिल। ये फ़ॉर्मेट प्रिंट उत्पादन वर्कफ़्लो में असामान्य; PDF निर्यात मानक हैंडऑफ़।"@hi,
        "ワードプロセッシングおよびレイアウト用のPages（.pages）、プレゼンテーション用のKeynote（.key）、表計算用のNumbers（.numbers）を含む。これらの形式は印刷生産ワークフローでは一般的ではなく、PDFエクスポートが標準的な受け渡し形式となる。"@ja,
        "Inkluderer Pages (.pages) for tekstbehandling og oppsett, Keynote (.key) for presentasjoner, og Numbers (.numbers) for regneark. Disse formatene er uvanlige i trykkproduksjon; PDF-eksport er standard overlevering."@nb,
        "Inclui Pages (.pages) para processamento de texto e layout, Keynote (.key) para apresentações e Numbers (.numbers) para planilhas. Esses formatos são incomuns em fluxos de produção gráfica; a exportação em PDF é a entrega padrão."@pt,
        "包括用于文字处理和版面的Pages（.pages）、用于演示的Keynote（.key）和用于电子表格的Numbers（.numbers）。这些格式在印刷生产工作流程中不常见；导出为PDF是切实可行的印刷交付。"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.19 · p.345" ;
            ptpge:mappingRow "crosswalk row 3" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "FileSpec" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

