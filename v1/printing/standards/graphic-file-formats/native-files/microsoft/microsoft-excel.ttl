<https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/microsoft/microsoft-excel> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel ".xlsx"@en,
        "Excel"@en,
        ".xlsx"@hi,
        "Excel"@hi,
        ".xlsx"@pl,
        "Excel"@pl,
        ".xlsx"@pt,
        "Excel"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/microsoft> ;
    skos:definition "Programeget regnearksformat (.xlsx) for Microsoft Excel, det dominerende regnearksprogram — baseret på Office Open XML (ECMA-376 / ISO 29500)."@da,
        "Anwendungseigenes Tabellenkalkulationsformat (.xlsx) von Microsoft Excel, der dominierenden Tabellenkalkulationsanwendung im Geschäftsumfeld — basierend auf Office Open XML (ECMA-376 / ISO 29500)."@de,
        "Native spreadsheet file format (.xlsx) for Microsoft Excel, the dominant business spreadsheet application — based on Office Open XML (ECMA-376 / ISO 29500)."@en,
        "Formato Office Open XML para hojas de cálculo. La exportación a PDF es el estándar de entrega a imprenta."@es,
        "Microsoft Excel का नेटिव स्प्रेडशीट फ़ाइल फ़ॉर्मेट (.xlsx), प्रमुख व्यावसायिक स्प्रेडशीट एप्लिकेशन — Office Open XML (ECMA-376 / ISO 29500) पर आधारित।"@hi,
        "Microsoft Excelのネイティブ表計算ファイル形式（.xlsx）。ビジネス向け表計算アプリケーションの代表 — Office Open XML（ECMA-376 / ISO 29500）に基づく。"@ja,
        "Programspesifikt regnearkformat (.xlsx) for Microsoft Excel, den dominerende regnearksapplikasjonen i næringslivet — basert på Office Open XML (ECMA-376 / ISO 29500)."@nb,
        "Programma-eigen spreadsheetformaat (.xlsx) voor Microsoft Excel, het dominante spreadsheetprogramma — gebaseerd op Office Open XML (ECMA-376 / ISO 29500)."@nl,
        "Natywny format arkusza kalkulacyjnego (.xlsx) programu Microsoft Excel, dominującej biznesowej aplikacji arkuszowej — oparty na Office Open XML (ECMA-376 / ISO 29500)."@pl,
        "Formato de arquivo nativo de planilha (.xlsx) do Microsoft Excel, o aplicativo de planilhas empresarial dominante — baseado no Office Open XML (ECMA-376 / ISO 29500)."@pt,
        "Programeget kalkylbladsformat (.xlsx) för Microsoft Excel, det dominerande kalkylprogrammet — baserat på Office Open XML (ECMA-376 / ISO 29500)."@sv,
        "用于电子表格的Office Open XML格式。导出为PDF是印刷交付标准。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§MICROSOFT-EXCEL" ;
    skos:prefLabel "Microsoft Excel (.xlsx)"@da,
        "Microsoft Excel (.xlsx)"@de,
        "Microsoft Excel (.xlsx)"@en,
