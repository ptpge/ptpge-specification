<https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/microsoft/microsoft-powerpoint> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel ".pptx"@en,
        "PowerPoint"@en,
        ".pptx"@hi,
        "PowerPoint"@hi,
        ".pptx"@pl,
        "PowerPoint"@pl,
        ".pptx"@pt,
        "PowerPoint"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/graphic-file-formats/native-files/microsoft> ;
    skos:definition "Programeget præsentationsformat (.pptx) for Microsoft PowerPoint, det dominerende præsentationsprogram — baseret på Office Open XML (ECMA-376 / ISO 29500)."@da,
        "Anwendungseigenes Präsentationsformat (.pptx) von Microsoft PowerPoint, der dominierenden Präsentationsanwendung im Geschäftsumfeld — basierend auf Office Open XML (ECMA-376 / ISO 29500)."@de,
        "Native presentation file format (.pptx) for Microsoft PowerPoint, the dominant business presentation application — based on Office Open XML (ECMA-376 / ISO 29500)."@en,
        "Formato Office Open XML para presentaciones. La exportación a PDF es la entrega práctica para imprenta."@es,
        "Microsoft PowerPoint का नेटिव प्रस्तुति फ़ाइल फ़ॉर्मेट (.pptx), प्रमुख व्यावसायिक प्रस्तुति एप्लिकेशन — Office Open XML (ECMA-376 / ISO 29500) पर आधारित।"@hi,
        "Microsoft PowerPointのネイティブプレゼンテーションファイル形式（.pptx）。ビジネス向けプレゼンテーションアプリケーションの代表 — Office Open XML（ECMA-376 / ISO 29500）に基づく。"@ja,
        "Programspesifikt presentasjonsformat (.pptx) for Microsoft PowerPoint, den dominerende presentasjonsapplikasjonen i næringslivet — basert på Office Open XML (ECMA-376 / ISO 29500)."@nb,
        "Programma-eigen presentatieformaat (.pptx) voor Microsoft PowerPoint, het dominante presentatieprogramma — gebaseerd op Office Open XML (ECMA-376 / ISO 29500)."@nl,
        "Natywny format prezentacji (.pptx) programu Microsoft PowerPoint, dominującej biznesowej aplikacji prezentacyjnej — oparty na Office Open XML (ECMA-376 / ISO 29500)."@pl,
        "Formato de arquivo nativo de apresentação (.pptx) do Microsoft PowerPoint, o aplicativo de apresentações empresarial dominante — baseado no Office Open XML (ECMA-376 / ISO 29500)."@pt,
        "Programeget presentationsformat (.pptx) för Microsoft PowerPoint, det dominerande presentationsprogrammet — baserat på Office Open XML (ECMA-376 / ISO 29500)."@sv,
        "用于演示的Office Open XML格式。导出为PDF是印刷的实际交付方式。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§MICROSOFT-POWERPOINT" ;
    skos:prefLabel "Microsoft PowerPoint (.pptx)"@da,
        "Microsoft Powerpoint (.pptx)"@de,
