@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/standards/graphic-file-formats/hybrid-graphics/encapsulated-postscript> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel ".eps"@en,
        "EPS"@en,
        ".eps"@hi,
        "EPS"@hi,
        ".eps"@pl,
        "EPS"@pl,
        ".eps"@pt,
        "EPS"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/graphic-file-formats/hybrid-graphics> ;
    skos:definition "Adobe-udviklet filformat (.eps) til selvstændig PostScript-grafik, historisk brugt som trykbranchens udvekslingsformat, før det i vidt omfang blev afløst af PDF."@da,
        "Von Adobe entwickeltes Dateiformat (.eps) für eigenständige PostScript-Grafiken, historisch als Austauschformat in der Druckbranche eingesetzt, mittlerweile weitgehend durch PDF abgelöst."@de,
        "Adobe-developed file format (.eps) for self-contained PostScript graphics, used historically as the print-industry interchange format before being largely superseded by PDF."@en,
        "Formato de archivo gráfico basado en PostScript (.eps), antiguo estándar para intercambio de gráficos vectoriales y mixtos antes de la adopción universal del PDF. Aún en uso en algunos flujos heredados."@es,
        "स्व-निहित PostScript ग्राफ़िक्स के लिए Adobe द्वारा विकसित फ़ाइल फ़ॉर्मेट (.eps), PDF द्वारा बड़े पैमाने पर प्रतिस्थापित होने से पहले ऐतिहासिक रूप से प्रिंट-उद्योग विनिमय फ़ॉर्मेट।"@hi,
        "Adobeが開発した自己完結型PostScriptグラフィックスのファイル形式（.eps）。PDFに大幅に置き換えられる以前は、印刷業界の交換形式として歴史的に使用されていた。"@ja,
        "Adobe-utviklet filformat (.eps) for selvstendige PostScript-grafikk, historisk brukt som utvekslingsformat i trykkbransjen før det i stor grad ble erstattet av PDF."@nb,
        "Door Adobe ontwikkeld bestandsformaat (.eps) voor zelfstandige PostScript-graphics, historisch het uitwisselformaat van de grafische industrie voordat het grotendeels werd vervangen door PDF."@nl,
        "Opracowany przez Adobe format pliku (.eps) dla samodzielnej grafiki PostScript, historycznie używany jako format wymiany w poligrafii, zanim został w dużej mierze zastąpiony przez PDF."@pl,
        "Formato de arquivo desenvolvido pela Adobe (.eps) para gráficos PostScript autocontidos, usado historicamente como formato de intercâmbio da indústria gráfica antes de ser amplamente substituído pelo PDF."@pt,
        "Adobe-utvecklat filformat (.eps) för självständig PostScript-grafik, historiskt använt som tryckbranschens utbytesformat innan det i stort ersattes av PDF."@sv,
        "基于PostScript的图形文件格式（.eps），在PDF普及之前是矢量和混合图形交换的旧标准。在某些遗留工作流程中仍在使用。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§ENCAPSULATED-POSTSCRIPT" ;
    skos:prefLabel "Encapsulated PostScript (.eps)"@da,
        "Encapsulated PostScript (.eps)"@de,
        "Encapsulated PostScript (.eps)"@en,
        "Encapsulated PostScript (.eps)"@es,
        "Encapsulated PostScript (.eps)"@hi,
        "Encapsulated PostScript (.eps)"@ja,
        "Encapsulated PostScript (.eps)"@nb,
        "Encapsulated PostScript (.eps)"@nl,
        "Encapsulated PostScript (.eps)"@pl,
        "Encapsulated PostScript (.eps)"@pt,
        "Encapsulated PostScript (.eps)"@sv,
        "Encapsulated PostScript (.eps)"@zh-Hans ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.19 · p.345" ;
            ptpge:mappingRow "crosswalk row 3" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "FileSpec" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

