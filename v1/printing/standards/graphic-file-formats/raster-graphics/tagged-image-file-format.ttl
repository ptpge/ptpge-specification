    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel ".tif"@en,
        ".tiff"@en,
        "TIFF"@en,
        ".tif"@hi,
        ".tiff"@hi,
        "TIFF"@hi,
        ".tif"@pl,
        ".tiff"@pl,
        "TIFF"@pl,
        ".tif"@pt,
        ".tiff"@pt,
        "TIFF"@pt ;
    skos:broader <https://ptpge.org/v1/printing/standards/graphic-file-formats/raster-graphics> ;
    skos:definition "TIFF (.tif) — fleksibelt rasterbilledformat med understøttelse af flere komprimeringsmetoder, farverum og metadata; bredt brugt i tryk-, scannings- og arkivarbejdsgange."@da,
        "TIFF (.tif) — flexibles Rasterbildformat, das mehrere Kompressionsmethoden, Farbräume und Metadaten unterstützt; weit verbreitet im Druck, beim Scannen und in Archivierungs-Workflows."@de,
        "TIFF (.tif) — flexible raster image format supporting multiple compression methods, color spaces, and metadata; widely used in print, scanning, and archival workflows."@en,
        "Tagged Image File Format — formato raster sin pérdida (o con LZW), histórico estándar pre-prensa para imágenes de alta resolución. Soporta CMYK, capas, transparencia y perfiles ICC."@es,
        "TIFF (.tif) — कई संपीड़न विधियों, रंग स्पेस और मेटाडेटा का समर्थन करने वाला लचीला रास्टर छवि फ़ॉर्मेट; प्रिंट, स्कैनिंग और संग्रहण वर्कफ़्लो में व्यापक रूप से प्रयुक्त।"@hi,
        "TIFF（.tif）— 複数の圧縮方式、色空間、メタデータをサポートする柔軟なラスター画像形式。印刷、スキャン、アーカイブのワークフローで広く使用される。"@ja,
        "TIFF (.tif) — fleksibelt rasterbildeformat med støtte for flere komprimeringsmetoder, fargerom og metadata; mye brukt i trykk-, skannings- og arkivarbeidsflyter."@nb,
        "TIFF (.tif) — flexibel rasterbeeldformaat met ondersteuning voor meerdere compressiemethoden, kleurruimten en metadata; breed gebruikt in druk-, scan- en archiefworkflows."@nl,
        "TIFF (.tif) — elastyczny format obrazu rastrowego obsługujący wiele metod kompresji, przestrzeni barw i metadanych; szeroko używany w druku, skanowaniu i archiwizacji."@pl,
        "TIFF (.tif) — formato flexível de imagem raster com suporte a vários métodos de compressão, espaços de cor e metadados; amplamente usado em fluxos de impressão, digitalização e arquivamento."@pt,
        "TIFF (.tif) — flexibelt rasterbildformat med stöd för flera komprimeringsmetoder, färgrymder och metadata; brett använt i tryck-, skannings- och arkivflöden."@sv,
        "Tagged Image File Format —— 无损（或LZW）位图格式，是高分辨率图像的历史印前标准。支持CMYK、图层、透明度和ICC配置文件。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§TAGGED-IMAGE-FILE-FORMAT" ;
    skos:prefLabel "TIFF (.tif)"@da,
        "Tagged Image File Format (.tif)"@de,
        "Tagged Image File Format (.tif)"@en,
        "TIFF (.tif)"@es,
        "Tagged Image File Format (.tif)"@hi,
        "Tagged Image File Format (.tif)"@ja,
        "Tagged Image File Format (.tif)"@nb,
