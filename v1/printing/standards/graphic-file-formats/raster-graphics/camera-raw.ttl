    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:altLabel ".raw"@en,
        "RAW"@en,
        "camera raw"@en,
        ".raw"@hi,
        "RAW"@hi,
        "camera raw"@hi,
        ".raw"@pl,
