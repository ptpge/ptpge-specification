    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems> ;
    skos:definition "HP Indigo IndiChrome — farvesystem for udvidet farveomfang inden for digital offset."@da,
        "HP Indigo IndiChrome — Extended-Gamut-Farbsystem für Digital-Offset."@de,
        "HP Indigo IndiChrome extended-gamut ink system for digital offset."@en,
        "Sistema de tintas de gama extendida HP Indigo IndiChrome para ófset digital."@es,
        "डिजिटल ऑफसेट के लिए HP Indigo IndiChrome विस्तारित-गैमट स्याही प्रणाली।"@hi,
        "デジタルオフセットのための HP Indigo IndiChrome 拡張ガモットインキシステム。"@ja,
        "HP Indigo IndiChrome utvidet-gamut blekksystem for digital offset."@nb,
        "HP Indigo IndiChrome — inktsysteem voor uitgebreid gamma binnen digitale offset."@nl,
        "System farb o rozszerzonym gamucie HP Indigo IndiChrome dla cyfrowego offsetu."@pl,
        "Sistema de tintas de gamut estendido HP Indigo IndiChrome para offset digital."@pt,
        "HP Indigo IndiChrome — bläcksystem för utökad färgomfattning inom digital offset."@sv,
        "用于数字胶印的 HP Indigo IndiChrome 扩展色域油墨系统。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§HP-INDICHROME" ;
    skos:prefLabel "HP IndiChrome"@da,
        "HP IndiChrome"@en,
        "HP IndiChrome"@hi,
        "HP IndiChrome"@nl,
        "HP IndiChrome"@pl,
        "HP IndiChrome"@pt,
        "HP IndiChrome"@sv ;
    ptpge:deprecatedOn "2026-10-06"^^xsd:date ;
    ptpge:deprecationReason "A brand is a term only when the trade uses it as a standard, never when it is a product one buys (SD-0097). This is a product: it belongs in the maker's supplier catalogue and in a printer's vendor declaration as capability. Use the generic parent in the vocabulary; this URI keeps resolving."@en,
        "Et merke er en term bare når bransjen bruker det som en standard, aldri når det er et produkt man kjøper (SD-0097). Dette er et produkt: det hører hjemme i produsentens katalog og i trykkeriets leverandørdeklarasjon som kapasitet. Bruk den generiske forelderen i vokabularet; denne URI-en fortsetter å svare."@nb ;
    ptpge:elementType "reference" ;
