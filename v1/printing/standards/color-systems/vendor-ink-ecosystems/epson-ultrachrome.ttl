<https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems/epson-ultrachrome> a skos:Concept ;
    dcterms:created "2026-06-18T10:00:07+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:isReplacedBy <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:29:35+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards/color-systems/vendor-ink-ecosystems> ;
    skos:definition "Epson UltraChrome — pigmentblæk-økosystem til inkjet med bredt farveomfang og prøvetryk."@da,
        "Epson UltraChrome — Pigmenttinten-Ökosystem für Inkjet mit großem Gamut und Proofing."@de,
        "Epson UltraChrome pigment-ink ecosystem for wide-gamut inkjet and proofing."@en,
        "Ecosistema de tintas pigmentadas Epson UltraChrome para inyección de amplia gama y pruebas."@es,
        "व्यापक-गैमट इंकजेट और प्रूफ़िंग के लिए Epson UltraChrome पिगमेंट-स्याही पारितंत्र।"@hi,
        "広色域インクジェットとプルーフィングのためのエプソン UltraChrome 顔料インキ・エコシステム。"@ja,
        "Epson UltraChrome pigmentblekk-økosystem for bredt-gamut blekkskriver og prøvetrykk."@nb,
        "Epson UltraChrome — pigmentinktecosysteem voor inkjet met breed gamma en proefdruk."@nl,
        "Ekosystem atramentów pigmentowych Epson UltraChrome dla szerokogamutowego druku atramentowego i proofingu."@pl,
        "Ecossistema de tintas pigmentadas Epson UltraChrome para jato de tinta de gamut amplo e provas."@pt,
        "Epson UltraChrome — pigmentbläcksekosystem för inkjet med bred färgomfattning och provtryck."@sv,
        "用于宽色域喷墨与打样的爱普生 UltraChrome 颜料墨水生态系统。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:ST§EPSON-ULTRACHROME" ;
    skos:prefLabel "Epson UltraChrome"@da,
        "Epson UltraChrome"@en,
        "Epson UltraChrome"@hi,
        "Epson UltraChrome"@nl,
        "Epson UltraChrome"@pl,
        "Epson UltraChrome"@pt,
        "Epson UltraChrome"@sv ;
    ptpge:deprecatedOn "2026-10-06"^^xsd:date ;
    ptpge:deprecationReason "A brand is a term only when the trade uses it as a standard, never when it is a product one buys (SD-0097). This is a product: it belongs in the maker's supplier catalogue and in a printer's vendor declaration as capability. Use the generic parent in the vocabulary; this URI keeps resolving."@en,
        "Et merke er en term bare når bransjen bruker det som en standard, aldri når det er et produkt man kjøper (SD-0097). Dette er et produkt: det hører hjemme i produsentens katalog og i trykkeriets leverandørdeklarasjon som kapasitet. Bruk den generiske forelderen i vokabularet; denne URI-en fortsetter å svare."@nb ;
    ptpge:elementType "reference" ;
    ptpge:group "standards" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.14 · p.166",
                "§6.15 · p.168",
                "§6.17 · p.172" ;
            ptpge:mappingRow "crosswalk row 4" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Color",
                "ColorSpaceConversionParams",
                "ColorantControl" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "deprecated" ;
    ptpge:version "2026-10-06" .

