@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/standards/certifications/quality> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:50:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/standards/certifications> ;
    skos:definition "Generiske ledelsessystemstandarder, der dokumenterer at en organisation har dokumenterede og vedligeholdte effektive kvalitetsprocesser."@da,
        "Allgemeine Managementsystem-Normen, die belegen, dass eine Organisation effektive Qualitätsprozesse dokumentiert und aufrechterhält."@de,
        "Generic management-system standards demonstrating that an organization has documented and maintains effective quality processes."@en,
        "Normas genéricas de sistemas de gestión que demuestran que una organización ha documentado y mantiene procesos de calidad efectivos."@es,
        "सामान्य प्रबंधन-प्रणाली मानक जो दर्शाते हैं कि संगठन ने प्रभावी गुणवत्ता प्रक्रियाएँ दस्तावेज़ीकृत की हैं और बनाए रखता है।"@hi,
        "組織が文書化された有効な品質プロセスを保有し維持していることを実証する、汎用的なマネジメントシステム規格。"@ja,
        "Generiske ledelsessystem-standarder som dokumenterer at en organisasjon har innført og opprettholder effektive kvalitetsprosesser."@nb,
        "Generieke managementsysteemstandaarden die aantonen dat een organisatie gedocumenteerde en onderhouden effectieve kwaliteitsprocessen heeft."@nl,
        "Ogólne standardy systemów zarządzania potwierdzające, że organizacja udokumentowała i utrzymuje skuteczne procesy jakości."@pl,
        "Normas genéricas de sistemas de gestão que demonstram que uma organização documentou e mantém processos de qualidade eficazes."@pt,
        "Generiska ledningssystemstandarder som visar att en organisation har dokumenterade och underhållna effektiva kvalitetsprocesser."@sv,
        "证明组织已记录并维护有效质量过程的通用管理系统标准。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/standards/certifications/quality/iso-9001> ;
    skos:notation "P:ST-CER-QUAL" ;
    skos:prefLabel "Kvalitet"@da,
        "Qualität"@de,
        "Quality"@en,
        "Calidad"@es,
        "गुणवत्ता"@hi,
        "品質"@ja,
        "Kvalitet"@nb,
        "Kwaliteit"@nl,
        "Jakościowe"@pl,
        "Qualidade"@pt,
        "Kvalitet"@sv,
        "质量"@zh-Hans ;
    skos:scopeNote "Im Mittelpunkt steht ISO 9001 — anwendbar auf Druckereien wie auf jede andere Organisation. Branchenspezifische Prozesszertifizierungen und Umweltmanagementsysteme werden separat geführt."@de,
        "Centered on ISO 9001 — applicable to printers as to any organization. Industry-specific process certifications and environmental management systems are tracked separately."@en,
        "Centrada en ISO 9001 — aplicable a imprentas como a cualquier organización. Las certificaciones específicas de procesos de impresión y los sistemas de gestión ambiental se rastrean por separado."@es,
        "ISO 9001 पर केंद्रित — प्रिंटरों पर वैसे ही लागू जैसे किसी भी संगठन पर। उद्योग-विशिष्ट प्रक्रिया प्रमाणन और पर्यावरण प्रबंधन प्रणालियाँ अलग दर्ज।"@hi,
        "ISO 9001を中心とする — 印刷会社にも他の組織と同様に適用される。業種固有の工程認証および環境マネジメントシステムは別途扱う。"@ja,
        "Sentrert rundt ISO 9001 — gyldig for trykkerier på lik linje med enhver organisasjon. Bransjespesifikke prosessertifiseringer og miljøledelsessystemer spores separat."@nb,
        "Centrada na ISO 9001 — aplicável a impressores como a qualquer organização. Certificações de processo específicas do setor e sistemas de gestão ambiental são registrados separadamente."@pt,
        "以ISO 9001为中心——适用于印刷厂以及任何组织。行业特定的工艺认证和环境管理系统另行跟踪。"@zh-Hans ;
    ptpge:group "standards" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§8.7 · p.336" ;
            ptpge:mappingRow "crosswalk row 5" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Certification" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

