    skos:altLabel "Dækhvid"@da,
        "Hvid"@da,
        "Hvidtryk"@da,
        "Deckweiß"@de,
        "Weißdruck"@de,
        "Weiße Farbe"@de,
        "White Ink"@en,
        "Blanco"@es,
        "Blanco de cobertura"@es,
        "Tinta blanca"@es,
        "व्हाइट अंडरप्रिंट"@hi,
        "व्हाइट इंक"@hi,
        "सफ़ेद स्याही"@hi,
        "ホワイトインキ"@ja,
        "白引き"@ja,
        "白版"@ja,
        "Hvit farge"@nb,
        "Hvitt trykk"@nb,
        "Dekwit"@nl,
        "Wit"@nl,
        "Witdruk"@nl,
        "biała farba"@pl,
        "biały nadruk"@pl,
        "branco de base"@pt,
        "tinta branca"@pt,
        "white ink"@pt,
        "Täckvitt"@sv,
        "Vitt"@sv,
        "Vittryck"@sv,
