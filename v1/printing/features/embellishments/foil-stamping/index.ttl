    skos:altLabel "Foil Printing"@en,
        "Hot Foil Stamping"@en,
        "गोल्ड फ़ॉइल छपाई"@hi,
        "फ़ॉइल प्रिंटिंग"@hi,
        "फ़ॉइलिंग"@hi,
        "हॉट फ़ॉइल स्टैंपिंग"@hi,
        "Folietrykk"@nb,
        "Varmpreging"@nb,
        "folie"@nl,
        "druk folią"@pl,
        "hot stamping"@pl,
        "hot-print"@pl,
        "złocenie folią"@pl,
