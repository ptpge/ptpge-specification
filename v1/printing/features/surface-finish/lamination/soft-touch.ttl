        "Velvet lamination"@en,
        "मखमली लैमिनेशन"@hi,
        "वेलवेट लैमिनेशन"@hi,
        "सॉफ़्ट टच"@hi,
        "स्वेड लैमिनेशन"@hi,
        "Fløyel-laminering"@nb,
        "Fløyelslaminat"@nb,
