    dcterms:modified "2026-09-23T06:18:57+00:00"^^xsd:dateTime ;
    skos:altLabel "Satin Lamination"@en,
        "Satin laminated"@en,
        "Satin lamination"@en,
        "Silk laminated"@en,
        "सिल्क लैमिनेट"@hi,
        "सैटिन फ़िनिश लैमिनेशन"@hi,
        "सैटिन लैमिनेशन"@hi,
        "Satenglaminering"@nb,
        "Silke-laminering"@nb,
        "Silkematt laminering"@nb,
        "folia satynowa"@pl,
        "folia silk"@pl,
        "laminat satynowy"@pl,
        "acetinado"@pt,
        "laminação cetim"@pt,
