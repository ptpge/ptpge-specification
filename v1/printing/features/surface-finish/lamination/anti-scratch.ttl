        "Anti-scratch laminering"@nb,
        "Krasvast laminaat"@nl,
        "Laminowanie antyzarysowaniowe"@pl,
        "Laminação antirrisco"@pt,
        "Reptålig laminering"@sv,
        "耐刮覆膜"@zh-Hans ;
