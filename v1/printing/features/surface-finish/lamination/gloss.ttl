    skos:altLabel "Gloss laminate"@en,
        "Gloss laminated"@en,
        "Glossy Lamination"@en,
        "Glossy lamination"@en,
        "High-gloss lamination"@en,
        "ग्लॉस लैमिनेट"@hi,
        "ग्लॉसी लैमिनेशन"@hi,
        "चमकीला लैमिनेशन"@hi,
        "हाई-ग्लॉस लैमिनेशन"@hi,
        "Blank laminering"@nb,
        "Glanslaminat"@nb,
        "Glanslaminering"@nb,
        "Glans laminaat"@nl,
        "Glanzend gelamineerd"@nl,
        "folia błysk"@pl,
        "folia błyszcząca"@pl,
        "laminat błyszczący"@pl,
        "BOPP brilho"@pt,
