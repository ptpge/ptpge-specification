    skos:altLabel "Partial varnish"@en,
        "Selective varnish"@en,
        "आंशिक वार्निश"@hi,
        "चुनिंदा वार्निश"@hi,
        "सेलेक्टिव वार्निश"@hi,
        "Punktlakk"@nb,
        "Spotlakk"@nb,
