@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/management/creation> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/management> ;
    skos:definition "Fasen før produktion, hvor indhold udtænkes, designes og klargøres til tryk — omfatter alt kreativt og prepress-arbejde, før filen sendes til en trykopgave."@da,
        "Die vorbereitende Phase, in der Inhalte konzipiert, gestaltet und für den Druck aufbereitet werden — umfasst alle gestalterischen und Druckvorstufen-Arbeiten, bevor die Datei für einen Druckauftrag freigegeben wird."@de,
        "The pre-production phase where content is conceived, designed, and prepared for printing — encompassing all creative and prepress work before the file is committed to a print job."@en,
        "La fase de pre-producción donde el contenido se concibe, diseña y prepara para impresión — abarcando todo el trabajo creativo y de pre-prensa antes de que el archivo se comprometa a un trabajo de impresión."@es,
        "पूर्व-उत्पादन चरण जहाँ सामग्री की कल्पना, डिज़ाइन और मुद्रण की तैयारी होती है — फ़ाइल को प्रिंट जॉब में सौंपने से पहले का सारा रचनात्मक और प्रीप्रेस कार्य।"@hi,
        "コンテンツが構想、設計、印刷準備される生産前の段階 — ファイルが印刷ジョブに送られる前の創造的および製版作業のすべてを含む。"@ja,
        "Pre-produksjonsfasen der innhold blir unnfanget, designet og forberedt for trykk — omfatter alt kreativt og prepress-arbeid før filen sendes til en trykkjobb."@nb,
        "De fase vóór productie waarin inhoud wordt bedacht, ontworpen en voorbereid voor druk — al het creatieve en prepresswerk voordat het bestand naar een drukopdracht gaat."@nl,
        "Faza przedprodukcyjna, w której treść jest wymyślana, projektowana i przygotowywana do druku — obejmuje całą pracę kreatywną i prepress przed przekazaniem pliku do zlecenia drukarskiego."@pl,
        "A fase de pré-produção em que o conteúdo é concebido, projetado e preparado para impressão — abrangendo todo o trabalho criativo e de pré-impressão antes de o arquivo ser confiado a um trabalho de impressão."@pt,
        "Förproduktionsfasen där innehåll utformas, designas och förbereds för tryck — omfattar allt kreativt arbete och prepress innan filen binds till ett tryckjobb."@sv,
        "内容构思、设计和印刷准备的预生产阶段——涵盖在文件提交印刷作业之前的所有创意和印前工作。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/management/creation/design-artwork>,
        <https://ptpge.org/v1/printing/management/creation/imaging-graphics>,
        <https://ptpge.org/v1/printing/management/creation/prepress-preparation>,
        <https://ptpge.org/v1/printing/management/creation/typography-layout> ;
    skos:notation "P:MG-CRE" ;
    skos:prefLabel "Kreation"@da,
        "Erstellung"@de,
        "Creation"@en,
        "Creación"@es,
        "निर्माण"@hi,
        "制作"@ja,
        "Opprettelse"@nb,
        "Creatie"@nl,
        "Tworzenie"@pl,
        "Criação"@pt,
        "Skapande"@sv,
        "创建"@zh-Hans ;
    skos:scopeNote "Umfasst Design und Reinzeichnung (visuelles Konzept, Branding, Illustration), Typografie und Layout (Textsatz, Seitengestaltung), Bildbearbeitung und Grafik (Fotobearbeitung, Vektorgrafik) sowie Druckvorstufen-Vorbereitung (Farbseparation, Trapping, Ausschießung). Ergebnis sind druckfertige Dateien, die an die Qualitätssicherung übergeben werden."@de,
        "Includes design and artwork (visual concept, branding, illustration), typography and layout (text composition, page design), imaging and graphics (photo editing, vector creation), and prepress preparation (color separation, trapping, imposition setup). Output is print-ready files handed off to Quality Assurance."@en,
        "Incluye diseño y arte (concepto visual, branding, ilustración), tipografía y maquetación (composición de texto, diseño de página), tratamiento de imagen y gráficos (edición fotográfica, creación vectorial) y preparación pre-prensa."@es,
        "डिज़ाइन और आर्टवर्क (दृश्य अवधारणा, ब्रांडिंग, चित्रण), टाइपोग्राफ़ी और लेआउट (पाठ संयोजन, पेज डिज़ाइन), इमेजिंग और ग्राफ़िक्स (फ़ोटो संपादन, वेक्टर निर्माण) और प्रीप्रेस तैयारी (रंग सेपरेशन, ट्रैपिंग, इम्पोज़िशन सेटअप) शामिल। आउटपुट गुणवत्ता आश्वासन को सौंपी गई प्रिंट-रेडी फ़ाइलें।"@hi,
        "デザインとアートワーク（視覚コンセプト、ブランディング、イラストレーション）、タイポグラフィとレイアウト（テキスト組版、ページデザイン）、画像とグラフィックス（写真編集、ベクター作成）、製版準備（色分解、トラッピング、面付け設定）を含む。出力はQuality Assuranceに引き渡される印刷可能ファイル。"@ja,
        "Inkluderer design og artwork (visuelt konsept, merkevarebygging, illustrasjon), typografi og layout (tekstkomposisjon, sidedesign), bildebehandling og grafikk (fotoredigering, vektorgrafikk) og prepress-forberedelse (fargeseparasjon, trapping, oppsett av impositioning). Resultat er trykkferdige filer som overleveres til Quality Assurance."@nb,
        "Inclui design e arte (conceito visual, branding, ilustração), tipografia e layout (composição de texto, design de página), imagem e gráficos (edição de foto, criação vetorial) e preparação de pré-impressão (separação de cor, trapping, configuração de imposição). A saída são arquivos prontos para impressão entregues à Garantia de qualidade."@pt,
        "包括设计与美术（视觉概念、品牌、插图）、字体与版式（文本组版、页面设计）、图像与图形（照片编辑、矢量创建）和印前准备。"@zh-Hans ;
    ptpge:group "management" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.4.11 · p.98" ;
            ptpge:mappingRow "crosswalk row 6" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "LayoutElementProduction" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

