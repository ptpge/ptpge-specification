<https://ptpge.org/v1/printing/management/quality-assurance/preflight-file-check/agfa-apogee-prepress> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
