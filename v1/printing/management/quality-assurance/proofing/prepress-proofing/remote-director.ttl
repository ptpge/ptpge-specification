<https://ptpge.org/v1/printing/management/quality-assurance/proofing/prepress-proofing/remote-director> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/management/quality-assurance/proofing/prepress-proofing> ;
    skos:definition "Remote Director — farvenøjagtigt soft-proofing- og fjerngodkendelsessystem, der synkroniserer farvekalibrerede skærme på flere lokationer, så alle ser præcis samme farvegengivelse."@da,
        "Remote Director — farbgenaues Soft-Proofing- und Remote-Freigabesystem, das farbkalibrierte Displays an mehreren Standorten synchronisiert, sodass Prüfer exakt dieselbe Farbdarstellung sehen. Eingesetzt von globalen Agenturen und Markeninhabern."@de,
        "Remote Director — color-accurate soft-proofing and remote-approval system that synchronizes color-calibrated displays at multiple locations so reviewers see exactly the same color rendering. Used by global agencies and brand owners."@en,
        "Sistema de prueba blanda colaborativa entre múltiples ubicaciones, sincronizando vista calibrada y comentarios entre cliente, agencia e imprenta."@es,
        "Remote Director — रंग-सटीक सॉफ़्ट-प्रूफ़िंग और दूरस्थ-अनुमोदन सिस्टम जो कई स्थानों पर रंग-अंशांकित डिस्प्ले सिंक्रनाइज़ करता है ताकि समीक्षक बिल्कुल वही रंग रेंडरिंग देखें। वैश्विक एजेंसियों और ब्रांड स्वामियों द्वारा प्रयुक्त।"@hi,
        "Remote Director — 複数拠点のキャリブレーション済みディスプレイを同期させ、レビュー担当者が全く同じ色再現を見ることができるようにする色精度の高いソフトプルーフおよび遠隔承認システム。グローバル代理店およびブランドオーナーが使用する。"@ja,
        "Remote Director — fargenøyaktig soft-proofing og fjern-godkjenningssystem som synkroniserer fargekalibrerte skjermer på flere lokasjoner slik at gjennomgangsdeltakere ser nøyaktig samme fargegjengivelse. Brukt av globale byråer og merkevareeiere."@nb,
        "Remote Director — kleurnauwkeurig soft-proofing- en goedkeuringssysteem op afstand dat kleurgekalibreerde schermen op meerdere locaties synchroniseert, zodat iedereen exact dezelfde kleurweergave ziet."@nl,
        "Remote Director — system wiernego barwnie soft-proofingu i zdalnej akceptacji, synchronizujący skalibrowane barwnie wyświetlacze w wielu lokalizacjach, tak aby recenzenci widzieli dokładnie to samo odwzorowanie barw. Używany przez globalne agencje i właścicieli marek."@pl,
        "Remote Director — sistema de prova de tela com cor precisa e aprovação remota que sincroniza monitores calibrados em vários locais para que os revisores vejam exatamente a mesma renderização de cor. Usado por agências globais e proprietários de marca."@pt,
        "Remote Director — färgriktigt skärmprovs- och distansgodkännandesystem som synkroniserar färgkalibrerade bildskärmar på flera platser så att granskare ser exakt samma färgåtergivning. Används av globala byråer och varumärkesägare."@sv,
        "在多个位置之间的协作软校样系统，在客户、代理和印刷厂之间同步校准视图和评论。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§REMOTE-DIRECTOR" ;
    skos:prefLabel "Remote Director"@da,
        "Remote Director"@de,
        "Remote Director"@en,
        "Remote Director"@es,
        "Remote Director"@hi,
        "Remote Director"@ja,
        "Remote Director"@nb,
        "Remote Director"@nl,
        "Remote Director"@pl,
        "Remote Director"@pt,
        "Remote Director"@sv,
        "Remote Director"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.5 · p.73",
                "§5.3.1 · p.87",
                "§6.3 · p.144" ;
            ptpge:mappingRow "crosswalk row 14" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Approval",
                "ApprovalParams",
                "ContentCheckIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

