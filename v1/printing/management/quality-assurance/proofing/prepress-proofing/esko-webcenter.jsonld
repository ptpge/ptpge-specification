  "definition": {
    "en": "Esko WebCenter — browser-based collaboration and approval platform for packaging and label projects. Integrates artwork management, soft-proofing, annotations, and approval routing across multi-stakeholder teams.",
    "nb": "Esko WebCenter — nettleserbasert samarbeids- og godkjenningsplattform for emballasje- og etikettprosjekter. Integrerer artwork-håndtering, soft-proofing, annoteringer og godkjenningsruting på tvers av team med flere interessenter.",
    "de": "Esko WebCenter — browser-basierte Plattform für Zusammenarbeit und Freigabe in Verpackungs- und Etikettenprojekten. Integriert Artwork-Management, Soft-Proofing, Annotationen und Freigabe-Workflows in mehrstufigen Teams.",
    "ja": "Esko WebCenter — パッケージおよびラベルプロジェクト向けのブラウザベースの協業および承認プラットフォーム。アートワーク管理、ソフトプルーフ、注釈、承認ルーティングを複数の関係者チーム横断で統合する。",
    "es": "Plataforma de Esko orientada a packaging para gestión de aprobaciones, revisión de pruebas y control de versiones de artwork.",
    "zh-Hans": "Esko面向包装的平台，用于批准管理、校样审查和artwork版本控制。",
    "sv": "Esko WebCenter — webbläsarbaserad samarbets- och godkännandeplattform för förpacknings- och etikettprojekt. Integrerar originalhantering, skärmprov, annoteringar och godkännandeflöden över team med många intressenter.",
    "da": "Esko WebCenter — browserbaseret samarbejds- og godkendelsesplatform for emballage- og etiketprojekter. Integrerer artwork-styring, soft-proofing, annotering og godkendelsesruter på tværs af flere parter.",
    "nl": "Esko WebCenter — browsergebaseerd samenwerkings- en goedkeuringsplatform voor verpakkings- en etikettenprojecten. Integreert artworkbeheer, soft-proofing, annotaties en goedkeuringsroutes over meerdere partijen.",
    "pl": "Esko WebCenter — przeglądarkowa platforma współpracy i akceptacji dla projektów opakowań i etykiet. Integruje zarządzanie grafiką, soft-proofing, adnotacje i obieg akceptacji między wieloma interesariuszami.",
    "pt": "Esko WebCenter — plataforma de colaboração e aprovação em navegador para projetos de embalagens e rótulos. Integra gestão de arte, provas de tela, anotações e roteamento de aprovação entre equipes com vários interessados.",
    "hi": "Esko WebCenter — पैकेजिंग और लेबल परियोजनाओं के लिए ब्राउज़र-आधारित सहयोग और अनुमोदन प्लेटफ़ॉर्म। बहु-हितधारक टीमों में आर्टवर्क प्रबंधन, सॉफ़्ट-प्रूफ़िंग, टिप्पणियाँ और अनुमोदन रूटिंग एकीकृत करता है।"
  },
  "creator": "https://ptpge.org/contributors/ptpge",
