    skos:altLabel "RIP"@en,
        "raster image processor"@en,
        "rasterising"@en,
        "RIP"@hi,
        "रास्टर इमेज प्रोसेसर"@hi,
        "रास्टराइज़िंग"@hi,
        "RIP"@nb,
