<https://ptpge.org/v1/printing/management/workflow/versioning-storage> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:54:01+00:00"^^xsd:dateTime ;
    skos:altLabel "file storage"@en,
        "version control"@en,
        "versioning"@en,
        "फ़ाइल भंडारण"@hi,
        "संस्करण"@hi,
        "संस्करण नियंत्रण"@hi,
        "fillagring"@nb,
        "versjonering"@nb,
        "kontrola wersji"@pl,
        "przechowywanie plików"@pl,
        "wersjonowanie"@pl,
        "armazenamento de arquivos"@pt,
        "controle de versão"@pt,
        "versionamento"@pt ;
    skos:broader <https://ptpge.org/v1/printing/management/workflow> ;
    skos:definition "Vedligeholdelse af en sporbar historik over filversioner og langtidslagring af godkendte produktionsfiler — til genoptryk, arkivkrav og tilbagerulning, hvis der opdages fejl efter produktion."@da,
        "Pflege einer überprüfbaren Versionshistorie von Dateien sowie Langzeitarchivierung freigegebener Produktionsdateien — für Nachdrucke, Archivierungs-Compliance und Rollback bei nachträglich entdeckten Fehlern."@de,
        "Maintaining an auditable history of file versions and providing long-term storage of approved production files — for reprints, archival compliance, and rollback if errors are discovered after delivery."@en,
        "Control de versiones de archivos del trabajo — qué versión es la aprobada, qué cambios se han hecho y dónde se almacena el histórico."@es,
        "फ़ाइल संस्करणों का ऑडिट-योग्य इतिहास बनाए रखना और अनुमोदित उत्पादन फ़ाइलों का दीर्घकालिक भंडारण — पुनर्मुद्रण, संग्रहण अनुपालन और डिलीवरी के बाद त्रुटि मिलने पर रोलबैक के लिए।"@hi,
        "ファイルバージョンの監査可能な履歴を維持し、承認済みの生産用ファイルを長期保存する — 増刷、アーカイブ準拠、納品後にエラーが発見された場合のロールバックのため。"@ja,
        "Vedlikeholde en revisjonssporbar historikk av filversjoner og gi langsiktig lagring av godkjente produksjonsfiler — for opptrykk, arkivkrav og tilbakerulling hvis feil oppdages etter levering."@nb,
        "Het bijhouden van een controleerbare historie van bestandsversies en langdurige opslag van goedgekeurde productiebestanden — voor herdrukken, archiefverplichtingen en terugdraaien als na productie fouten worden ontdekt."@nl,
        "Utrzymywanie audytowalnej historii wersji plików i długoterminowe przechowywanie zatwierdzonych plików produkcyjnych — do dodruków, zgodności archiwalnej i wycofania zmian, jeśli błędy zostaną wykryte po dostawie."@pl,
        "Manutenção de um histórico auditável de versões de arquivo e armazenamento de longo prazo dos arquivos de produção aprovados — para reimpressões, conformidade de arquivamento e reversão caso erros sejam descobertos após a entrega."@pt,
        "Upprätthållande av en spårbar historik över filversioner och långtidslagring av godkända produktionsfiler — för nytryck, arkivkrav och återställning om fel upptäcks efter leverans."@sv,
        "作业文件的版本控制 —— 哪个版本已批准、做了什么更改、历史在哪里存储。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:MG§VERSIONING-STORAGE" ;
    skos:prefLabel "Versionering & lagring"@da,
        "Versionierung & Speicherung"@de,
        "Versioning & Storage"@en,
        "Versionado y Almacenamiento"@es,
        "संस्करण और भंडारण"@hi,
        "バージョン管理とストレージ"@ja,
        "Versjonering & lagring"@nb,
        "Versiebeheer & opslag"@nl,
        "Wersjonowanie i przechowywanie"@pl,
        "Versionamento e armazenamento"@pt,
        "Versionering & lagring"@sv,
        "版本控制与存储"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "management" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

