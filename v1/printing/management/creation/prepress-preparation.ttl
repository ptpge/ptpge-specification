        "プリプレス準備"@ja,
        "Prepress-klargjøring"@nb,
        "Prepressvoorbereiding"@nl,
        "Przygotowanie prepress"@pl,
        "Preparação de pré-impressão"@pt,
        "Prepressförberedelse"@sv,
        "印前准备"@zh-Hans ;
