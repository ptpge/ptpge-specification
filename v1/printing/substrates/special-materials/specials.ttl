@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/substrates/special-materials/specials> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/substrates/special-materials> ;
    skos:definition "Specialsubstrater uden for standardkategorierne — nichematerialer valgt til specifikke funktionelle eller æstetiske krav, der ikke passer i plade-, ark-, rulle- eller objektsubstrater."@da,
        "Spezialbedruckstoffe außerhalb der Standardkategorien — Nischenmaterialien, die für spezifische funktionale oder ästhetische Anforderungen ausgewählt werden und nicht in die Kategorien Platten-, Bogen-, Rollen- oder Objektmaterialien passen."@de,
        "Specialty substrates outside standard categories — niche materials chosen for specific functional or aesthetic requirements that don't fit board, sheet, roll, or object substrates."@en,
        "Sustratos de nicho — papel transfer, plástico magnético, papel adhesivo, materiales fluorescentes — utilizados para aplicaciones específicas fuera de las categorías estándar."@es,
        "मानक श्रेणियों से बाहर के विशेष सब्सट्रेट — विशिष्ट कार्यात्मक या सौंदर्य आवश्यकताओं के लिए चुनी गई नीश सामग्री जो बोर्ड, शीट, रोल या वस्तु सब्सट्रेट में नहीं आती।"@hi,
        "標準カテゴリ外の特殊基材 — ボード、シート、ロール、立体物の基材に当てはまらない、特定の機能的または美的要件のために選ばれるニッチ材料。"@ja,
        "Spesialsubstrater utenfor standardkategoriene — nisjemateriealer valgt av spesifikke funksjonelle eller estetiske krav som ikke passer i board-, sheet-, roll- eller object-substrater."@nb,
        "Speciale substraten buiten de standaardcategorieën — nichematerialen gekozen om specifieke functionele of esthetische eisen die niet passen bij plaat-, vel-, rol- of objectsubstraten."@nl,
        "Podłoża specjalne spoza standardowych kategorii — materiały niszowe wybierane pod konkretne wymagania funkcjonalne lub estetyczne, niepasujące do podłoży płytowych, arkuszowych, zwojowych ani obiektowych."@pl,
        "Substratos especiais fora das categorias padrão — materiais de nicho escolhidos por requisitos funcionais ou estéticos específicos que não cabem em chapa, folha, rolo ou objeto."@pt,
        "Specialsubstrat utanför standardkategorierna — nischmaterial valda för specifika funktionella eller estetiska krav som inte passar skiv-, ark-, rull- eller objektsubstrat."@sv,
        "小众承印物 —— 转印纸、磁性塑料、自粘纸、荧光材料 —— 用于标准分类之外的特定应用。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:SB§SPECIALS" ;
    skos:prefLabel "Specialer"@da,
        "Spezialprodukte"@de,
        "Specials"@en,
        "Materiales Especiales"@es,
        "स्पेशल"@hi,
        "特殊製品"@ja,
        "Spesielt"@nb,
        "Specials"@nl,
        "Specjalne"@pl,
        "Especiais"@pt,
        "Specialer"@sv,
        "特殊材料"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "substrates" ;
    ptpge:level "element" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

