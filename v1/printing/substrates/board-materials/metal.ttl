@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/substrates/board-materials/metal> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/substrates/board-materials> ;
    skos:definition "Metalpaneler brugt som tryksubstrater — typisk trykt via UV-inkjet, serigrafi eller direkte metalsublimering."@da,
        "Metallplatten als Druckbedruckstoffe — typischerweise mit UV-Tintenstrahl, Siebdruck oder Direkt-Sublimationsdruck auf Metall bedruckt."@de,
        "Metal panels used as printing substrates — typically printed via UV inkjet, screen printing, or direct-to-metal sublimation."@en,
        "Paneles metálicos utilizados como sustratos de impresión — habitualmente impresos por inyección de tinta UV, serigrafía o sublimación directa sobre metal."@es,
        "छपाई सब्सट्रेट के रूप में प्रयुक्त धातु पैनल — आमतौर पर UV इंकजेट, स्क्रीन प्रिंटिंग या सीधे धातु पर सब्लिमेशन से।"@hi,
        "印刷基材として使用される金属パネル — 通常UVインクジェット、シルクスクリーン印刷、または金属への直接昇華転写で印刷される。"@ja,
        "Metallpaneler brukt som trykksubstrater — vanligvis trykt via UV-inkjet, silketrykk eller direkte sublimering på metall."@nb,
        "Metalen platen als druksubstraat — doorgaans bedrukt via UV-inkjet, zeefdruk of directe metaalsublimatie."@nl,
        "Płyty metalowe używane jako podłoża drukowe — zwykle zadrukowywane atramentem UV, sitodrukiem lub sublimacją bezpośrednio na metalu."@pl,
        "Painéis metálicos usados como substrato de impressão — normalmente impressos por jato de tinta UV, serigrafia ou sublimação direta no metal."@pt,
        "Metallskivor som trycksubstrat — trycks typiskt via UV-inkjet, screentryck eller direkt-till-metall-sublimering."@sv,
        "用作印刷承印物的金属板——通常通过UV喷墨、丝印或直接向金属热升华印刷。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/substrates/board-materials/metal/aluminium>,
        <https://ptpge.org/v1/printing/substrates/board-materials/metal/galvanized-steel>,
        <https://ptpge.org/v1/printing/substrates/board-materials/metal/stainless-steel> ;
    skos:notation "P:SB-BRD-META" ;
    skos:prefLabel "Metal"@da,
        "Metall"@de,
        "Metal"@en,
        "Metal"@es,
        "धातु"@hi,
        "金属"@ja,
        "Metall"@nb,
        "Metaal"@nl,
        "Metal"@pl,
        "Metal"@pt,
        "Metall"@sv,
        "金属"@zh-Hans ;
    skos:scopeNote "Umfasst Aluminium (leicht, witterungsbeständig, häufig für Außenbeschilderung), verzinkten Stahl (zinkbeschichtet zum Korrosionsschutz) und Edelstahl (hochwertig, langlebig, für Architektur- und Industrieanwendungen)."@de,
        "Includes aluminium (lightweight, weather-resistant, common for outdoor signage), galvanized steel (zinc-coated for corrosion protection), and stainless steel (premium, durable, used for architectural and industrial applications)."@en,
        "Incluye aluminio (ligero, resistente a la intemperie, común para señalética exterior), acero galvanizado (con recubrimiento de zinc para protección contra la corrosión) y acero inoxidable (prima, duradero, utilizado para señalética arquitectónica y premios). El acabado de superficie afecta a la adhesión de la tinta y al brillo del resultado."@es,
        "एल्युमिनियम (हल्का, मौसम-रोधी, बाहरी साइनेज में आम), गैल्वनाइज़्ड स्टील (जंग से बचाव के लिए ज़िंक-कोटेड) और स्टेनलेस स्टील (प्रीमियम, टिकाऊ, वास्तु और औद्योगिक अनुप्रयोग) शामिल।"@hi,
        "アルミニウム（軽量、耐候性、屋外サインで一般的）、亜鉛めっき鋼（防錆のための亜鉛コーティング）、ステンレス鋼（高級、耐久性、建築および工業用途）を含む。"@ja,
        "Inkluderer aluminium (lett, værbestandig, vanlig for utendørs skilting), galvanisert stål (sinkbelagt for korrosjonsbeskyttelse) og rustfritt stål (premium, holdbart, brukt til arkitektur- og industrianvendelser)."@nb,
        "Inclui alumínio (leve, resistente ao tempo, comum em sinalização externa), aço galvanizado (revestido de zinco contra corrosão) e aço inoxidável (premium, durável, para aplicações arquitetônicas e industriais)."@pt,
        "包括铝（轻质、耐候，常用于户外标识）、镀锌钢（锌涂层防腐蚀）和不锈钢（高端、耐用，用于建筑标识和奖项）。表面处理影响油墨附着力和成品光泽。"@zh-Hans ;
    ptpge:group "substrates" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 32" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

