@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/substrates/board-materials> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:altLabel "płyty"@pl ;
    skos:broader <https://ptpge.org/v1/printing/substrates> ;
    skos:definition "Stive fladpanel-substrater brugt som trykflader — typisk tykkere end 1 mm og kræver specialpresser eller storformatprintere."@da,
        "Starre flache Plattenmaterialien als Druckoberflächen — typischerweise dicker als 1 mm, erfordern spezialisierte Druckmaschinen oder Großformatdrucker."@de,
        "Rigid flat-panel substrates used as printing surfaces — typically thicker than 1 mm, requiring specialized presses or wide-format printers."@en,
        "Sustratos planos rígidos utilizados como superficies de impresión — habitualmente de más de 1 mm de grosor, requieren prensas especializadas o impresoras de gran formato."@es,
        "छपाई की सतह के रूप में प्रयुक्त कठोर सपाट पैनल सब्सट्रेट — आमतौर पर 1 मिमी से मोटे, विशेष प्रेस या वाइड-फॉर्मेट प्रिंटर की ज़रूरत।"@hi,
        "印刷面として使用される剛性のある平面パネル基材 — 通常1mmより厚く、専用の印刷機または大判プリンターを必要とする。"@ja,
        "Stive flatpanel-substrater brukt som trykkflater — vanligvis tykkere enn 1 mm, krever spesialiserte presser eller storformatskrivere."@nb,
        "Stijve vlakke plaatsubstraten als drukoppervlak — doorgaans dikker dan 1 mm, vereisen gespecialiseerde persen of grootformaatprinters."@nl,
        "Sztywne płaskie podłoża płytowe używane jako powierzchnie drukowe — zwykle grubsze niż 1 mm, wymagające specjalistycznych maszyn lub ploterów wielkoformatowych."@pl,
        "Substratos rígidos em painel plano usados como superfície de impressão — normalmente com mais de 1 mm, exigindo impressoras especializadas ou de grande formato."@pt,
        "Styva plana skivsubstrat som tryckytor — typiskt tjockare än 1 mm och kräver specialiserade pressar eller storformatsskrivare."@sv,
        "用作印刷表面的刚性平板承印物——通常厚度超过1毫米，需要专用印刷机或大幅面打印机。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/substrates/board-materials/acrylic>,
        <https://ptpge.org/v1/printing/substrates/board-materials/cardboard>,
        <https://ptpge.org/v1/printing/substrates/board-materials/foam>,
        <https://ptpge.org/v1/printing/substrates/board-materials/glass>,
        <https://ptpge.org/v1/printing/substrates/board-materials/metal>,
        <https://ptpge.org/v1/printing/substrates/board-materials/plastic>,
        <https://ptpge.org/v1/printing/substrates/board-materials/wood> ;
    skos:notation "P:SB-BRD" ;
    skos:prefLabel "Plader"@da,
        "Plattenmaterialien"@de,
        "Board Materials"@en,
        "Materiales en Placa"@es,
        "बोर्ड सामग्री"@hi,
        "ボード基材"@ja,
        "Plate-materialer"@nb,
        "Plaatmaterialen"@nl,
        "Materiały płytowe"@pl,
        "Materiais em chapa"@pt,
        "Skivmaterial"@sv,
        "板材"@zh-Hans ;
    skos:scopeNote "Umfasst Acryl-, Schaumstoff-, Glas-, Kunststoff-, Holz- und Metallplatten. Verwendet für Beschilderung, Messegrafiken, langlebige Displays und Architekturanwendungen. Industrielle Anwendungen wie Direktdruck auf Produkte fallen unter Object Materials."@de,
        "Includes acrylic, foam, glass, plastic, wood, and metal panels. Used for signage, exhibition graphics, durable displays, and architectural applications. Industrial uses such as direct-to-product printing fall under Object Materials."@en,
        "Incluye acrílico, foam, vidrio, plástico, madera y paneles metálicos. Utilizados para señalética, gráficos para exposiciones, expositores duraderos y aplicaciones arquitectónicas. Los usos industriales como la impresión directa sobre producto pertenecen a materiales-objeto."@es,
        "ऐक्रेलिक, फ़ोम, काँच, प्लास्टिक, लकड़ी और धातु पैनल शामिल। साइनेज, प्रदर्शनी ग्राफ़िक्स, टिकाऊ डिस्प्ले और वास्तु अनुप्रयोगों में। सीधे उत्पाद पर छपाई जैसे औद्योगिक उपयोग वस्तु सामग्री के अंतर्गत आते हैं।"@hi,
        "アクリル、フォーム、ガラス、プラスチック、木材、金属パネルを含む。サイン、展示グラフィック、耐久性のあるディスプレイ、建築用途に使用される。製品への直接印刷などの工業用途はObject Materialsに属する。"@ja,
        "Inkluderer akryl, skumplate, glass, plast, tre og metallpanel. Brukt til skilting, messegrafikk, holdbar visning og arkitekturanvendelser. Industrielle bruksområder som direkte-på-produkt trykk hører til Object Materials."@nb,
        "Inclui acrílico, espuma, vidro, plástico, madeira e painéis metálicos. Usados em sinalização, gráficos de exposição, displays duráveis e aplicações arquitetônicas. Usos industriais como impressão direta no produto ficam em Materiais-objeto."@pt,
        "包括亚克力、泡沫、玻璃、塑料、木材和金属面板。用于标识、展览图形、耐用展示和建筑应用。工业用途如直接对产品印刷属于物体材料。"@zh-Hans ;
    ptpge:group "substrates" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 32" ;
