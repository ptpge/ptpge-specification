        "Tungt papir (240–309 g/m²)"@nb,
        "Zwaar papier (240–309 g/m²)"@nl,
        "Papier ciężki (240–309 g/m²)"@pl,
        "Papel pesado (240–309 g/m²)"@pt,
        "Tungt papper (240–309 g/m²)"@sv,
        "重纸 (240–309克)"@zh-Hans ;
