        "中重量紙（180〜239 gsm）"@ja,
        "Tungt medium-papir (180–239 g/m²)"@nb,
        "Zwaar-medium papier (180–239 g/m²)"@nl,
        "Papier średnio ciężki (180–239 g/m²)"@pl,
        "Papel médio pesado (180–239 g/m²)"@pt,
        "Tungt mellanpapper (180–239 g/m²)"@sv,
        "中-重纸 (180–239克)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "substrates" ;
    ptpge:hasProperty [ ptpge:unit "gsm" ] ;
