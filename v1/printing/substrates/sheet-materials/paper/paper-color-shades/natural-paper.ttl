    skos:altLabel "Natural White"@en,
        "Off-White"@en,
        "ऑफ़-व्हाइट"@hi,
        "नैचुरल व्हाइट"@hi,
        "प्राकृतिक रंग का काग़ज़"@hi,
        "Naturhvit"@nb,
        "Offhvit"@nb,
