<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-suppliers/holmen> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-09T10:30:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-suppliers> ;
    skos:definition "Svensk papirproducent med speciale i publikationspapir — bog-, magasin- og avispapirkvaliteter. Kendt for bæredygtigt producerede papirer fra svenske skove."@da,
        "Schwedischer Papierhersteller, spezialisiert auf Publikationspapiere — Buch-, Magazin- und Zeitungspapiere. Bekannt für nachhaltig gewonnene Papiere aus schwedischen Wäldern."@de,
        "Swedish paper manufacturer specializing in publication papers — book, magazine, and newsprint grades. Known for sustainably sourced papers from Swedish forests."@en,
        "Holmen Paper — fabricante escandinavo de papeles para publicación, especializado en papeles ligeros para revistas, libros y catálogos."@es,
        "प्रकाशन काग़ज़ों में विशेषज्ञ स्वीडिश काग़ज़ निर्माता — पुस्तक, पत्रिका और न्यूज़प्रिंट ग्रेड। स्वीडिश जंगलों से टिकाऊ स्रोत वाले काग़ज़ों के लिए प्रसिद्ध।"@hi,
        "出版用紙（書籍、雑誌、新聞用紙）に特化したスウェーデンの紙メーカー。スウェーデンの森林から持続可能に調達された紙で知られる。"@ja,
        "Svensk papirprodusent spesialisert på publikasjonspapir — bok-, magasin- og avispapir-klasser. Kjent for bærekraftig innhentede papirer fra svenske skoger."@nb,
        "Zweedse papierfabrikant gespecialiseerd in publicatiepapier — boek-, magazine- en krantenpapierkwaliteiten. Bekend om duurzaam geproduceerd papier uit Zweedse bossen."@nl,
        "Szwedzki producent papieru specjalizujący się w papierach publikacyjnych — gatunkach książkowych, magazynowych i gazetowych. Znany z papierów pozyskiwanych w sposób zrównoważony ze szwedzkich lasów."@pl,
        "Fabricante sueco de papel especializado em papéis de publicação — qualidades para livro, revista e jornal. Conhecido por papéis de origem sustentável das florestas suecas."@pt,
        "Svensk papperstillverkare specialiserad på publikationspapper — bok-, tidskrifts- och tidningspapperskvaliteter. Känd för hållbart producerat papper från svenska skogar."@sv,
        "Holmen Paper —— 北欧出版用纸制造商，专长用于杂志、书籍和目录的轻量纸。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:SB-SHT-PAPR-PSUP-HOLM" ;
    skos:prefLabel "Holmen"@da,
        "Holmen"@de,
        "Holmen"@en,
        "Holmen"@es,
        "Holmen"@hi,
        "Holmen"@ja,
        "Holmen"@nb,
        "Holmen"@nl,
        "Holmen"@pl,
        "Holmen"@pt,
        "Holmen"@sv,
        "Holmen"@zh-Hans ;
    ptpge:deprecatedOn "2026-10-06"^^xsd:date ;
    ptpge:deprecationReason "Company names leave the vocabulary (SD-0097, 2026-10-06; SD-0101, 2026-10-09): a maker's identity is a register entry under /v1/suppliers/, created when the company claims it at ptpge.org/adopt, and its series and models live in its own catalogue. No register entry exists yet for this maker. This URI keeps resolving."@en,
        "Firmanavn går ut av vokabularet (SD-0097, 2026-10-06; SD-0101, 2026-10-09): en produsents identitet er en registeroppføring under /v1/suppliers/, opprettet når selskapet gjør identiteten gjeldende på ptpge.org/adopt, og serier og modeller lever i dens egen katalog. Ingen registeroppføring finnes ennå for denne produsenten. Denne URI-en fortsetter å svare."@nb ;
    ptpge:group "substrates" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.11 · p.79",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 29" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media",
                "MediaIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "deprecated" ;
    ptpge:version "2026-10-06" .

