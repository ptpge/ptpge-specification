@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-fibre> a skos:Concept ;
    dcterms:created "2026-09-23T16:40:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T16:40:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper> ;
    skos:definition "Fiberens oprindelse i basispapiret — genvundet (genbrug) eller frisk (jomfruelig) — uafhængigt af bestrygning og overflade. Valgfri præcisering i konfigurationer: ubundet betyder uspecificeret (SD-0069)."@da,
        "Herkunft der Faser im Rohpapier — Altpapier (recycelt) oder Frischfaser — unabhängig von Strich und Oberfläche. Optionale Präzisierung in Konfigurationen: ungebunden bedeutet unspezifiziert (SD-0069)."@de,
        "Origin of the fibre in the base paper — recovered (recycled) or fresh (virgin) — independent of coating and surface. Optional refinement in configurations: unbound means unspecified (SD-0069)."@en,
        "Origen de la fibra del papel base: recuperada (reciclada) o virgen, con independencia del estucado y la superficie. Refinamiento opcional en configuraciones: sin vincular significa sin especificar (SD-0069)."@es,
        "आधार काग़ज़ में रेशे का स्रोत — पुनर्प्राप्त (रीसाइकल्ड) या ताज़ा (वर्जिन) — कोटिंग और सतह से स्वतंत्र। कॉन्फ़िगरेशन में वैकल्पिक परिष्करण: अनबाउंड का अर्थ अनिर्दिष्ट (SD-0069)।"@hi,
        "原紙の繊維の由来 — 回収繊維（再生）か新しい繊維（バージン）か。塗工や表面とは独立。構成では任意の精密化：未束縛は未指定を意味する（SD-0069）。"@ja,
        "Fiberens opphav i råpapiret — gjenvunnet (resirkulert) eller ny (jomfruelig) — uavhengig av bestrykning og overflate. Valgfri presisjon i konfigurasjoner: ubundet betyr uspesifisert (SD-0069)."@nb,
        "Herkomst van de vezel in het basispapier — teruggewonnen (gerecycled) of vers (virgin) — los van strijklaag en oppervlak. Optionele verfijning in configuraties: ongebonden betekent niet gespecificeerd (SD-0069)."@nl,
        "Pochodzenie włókna w papierze bazowym — odzyskane (makulaturowe) lub świeże (pierwotne) — niezależnie od powłoki i powierzchni. Opcjonalne uściślenie w konfiguracjach: brak wartości oznacza nieokreślone (SD-0069)."@pl,
        "Origem da fibra do papel base — recuperada (reciclada) ou virgem — independente do revestimento e da superfície. Refinamento opcional nas configurações: não vinculado significa não especificado (SD-0069)."@pt,
        "Fiberns ursprung i baspappret — returfiber (återvunnet) eller färsk fiber (jungfrulig) — oberoende av bestrykning och yta. Valfri precisering i konfigurationer: obundet betyder ospecificerat (SD-0069)."@sv,
        "原纸纤维的来源——回收纤维（再生）或原生纤维，与涂布和表面无关。配置中为可选精化：未绑定即未指定（SD-0069）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-fibre/fresh-fibre>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-fibre/recycled-fibre> ;
    skos:notation "P:SB-SHT-PAPR-FIBR" ;
    skos:prefLabel "Papirfiber"@da,
        "Papierfaser"@de,
        "Paper Fibre"@en,
        "Fibra del papel"@es,
        "काग़ज़ का रेशा"@hi,
        "紙の繊維"@ja,
        "Papirfiber"@nb,
        "Papiervezel"@nl,
        "Włókno papieru"@pl,
        "Fibra do papel"@pt,
        "Pappersfiber"@sv,
        "纸张纤维"@zh-Hans ;
    ptpge:group "substrates" ;
    ptpge:level "sub-category" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-09-23" .

