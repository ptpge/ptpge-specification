@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:24:41+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/substrates/sheet-materials/paper> ;
    skos:definition "Overfladebehandlinger og finish, der afgør hvordan papiret interagerer med trykfarve, lys og læserens hånd."@da,
        "Oberflächenbehandlungen und -ausführungen, die bestimmen, wie Papier mit Druckfarbe, Licht und der Hand des Lesers interagiert."@de,
        "Surface treatments and finishes that determine how paper interacts with ink, light, and the reader's hand."@en,
        "Tratamientos de superficie y acabados que determinan cómo el papel interactúa con la tinta, la luz y la mano del lector."@es,
        "सतह उपचार और फ़िनिश जो तय करते हैं कि काग़ज़ स्याही, रोशनी और पाठक के हाथ से कैसे पेश आता है।"@hi,
        "紙がインキ、光、読者の手とどのように相互作用するかを決定する表面処理および仕上げ。"@ja,
        "Overflatebehandlinger og finishes som avgjør hvordan papir samspiller med blekk, lys og leserens hånd."@nb,
        "Oppervlaktebehandelingen en afwerkingen die bepalen hoe papier reageert op inkt, licht en de hand van de lezer."@nl,
        "Obróbki i wykończenia powierzchni decydujące o tym, jak papier współdziała z farbą, światłem i dłonią czytelnika."@pl,
        "Tratamentos e acabamentos de superfície que determinam como o papel interage com a tinta, a luz e a mão do leitor."@pt,
        "Ytbehandlingar och finish som avgör hur papperet samspelar med bläck, ljus och läsarens hand."@sv,
        "决定纸张与油墨、光线和读者手感互动的表面处理和饰面。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/glossy-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/matte-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/recycled-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/silk-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/specialized-paper>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-surfaces/textured-paper> ;
    skos:notation "P:SB-SHT-PAPR-PSUR" ;
    skos:prefLabel "Papiroverflader"@da,
        "Papieroberflächen"@de,
        "Paper Surfaces"@en,
        "Superficies de Papel"@es,
        "काग़ज़ की सतहें"@hi,
        "用紙表面"@ja,
        "Papiroverflater"@nb,
        "Papieroppervlakken"@nl,
        "Powierzchnie papieru"@pl,
        "Superfícies de papel"@pt,
        "Pappersytor"@sv,
        "纸张表面"@zh-Hans ;
    skos:scopeNote "Umfasst gestrichene Oberflächen (glänzend, seidenmatt, matt), die Lichtreflexion und Druckfarbenverhalten beeinflussen, ungestrichene Oberflächen (matt ungestrichen, recycelt), die Druckfarbe in die Faser aufnehmen, strukturierte Papiere (gerippt, gestreift, geprägt) und Spezialoberflächen (synthetisch, wasserfest, fluoreszierend)."@de,
        "Includes coated finishes (glossy, silk, matte) that affect how light reflects and how ink sits, uncoated finishes (matte uncoated, recycled) that absorb ink into the fiber, textured papers (laid, ribbed, embossed), and specialty surfaces (synthetic, water-resistant, fluorescent)."@en,
        "Incluye acabados estucados (brillante, satinado, mate) que afectan a cómo refleja la luz y a cómo se asienta la tinta, acabados sin estucar (mate sin estucar, reciclado) que absorben la tinta en la fibra, papeles texturados (verjurado, estriado, gofrado) y papeles especiales (pergamino, translúcido)."@es,
        "कोटेड फ़िनिश (ग्लॉसी, सिल्क, मैट) जो रोशनी के परावर्तन और स्याही के बैठने को प्रभावित करती हैं, अनकोटेड फ़िनिश (मैट अनकोटेड, रीसाइकल्ड) जो स्याही को रेशे में सोखती हैं, टेक्सचर्ड काग़ज़ (लेड, रिब्ड, एम्बॉस्ड) और विशेष सतहें (सिंथेटिक, जल-रोधी, फ़्लोरेसेंट) शामिल।"@hi,
        "光の反射やインキの定着に影響する塗工仕上げ（グロス、シルク、マット）、繊維にインキが浸透する非塗工仕上げ（マット非塗工、リサイクル）、テクスチャ紙（レイド、リブ、エンボス）、特殊表面（合成、耐水、蛍光）を含む。"@ja,
        "Inkluderer belagte overflater (blank, silke, matt) som påvirker hvordan lys reflekteres og hvordan blekk sitter, ubelagt overflater (matt ubelagt, resirkulert) som absorberer blekk inn i fiberen, strukturerte papirer (vannhalt, ribbet, preget), og spesialoverflater (syntetisk, vannbestandig, fluorescerende)."@nb,
        "Inclui acabamentos revestidos (brilhante, acetinado, fosco) que afetam como a luz reflete e como a tinta assenta, acabamentos não revestidos (fosco não revestido, reciclado) que absorvem a tinta na fibra, papéis texturizados (vergê, canelado, gofrado) e superfícies especiais (sintético, resistente à água, fluorescente)."@pt,
        "包括涂布饰面（光面、丝面、哑光），影响光线反射和油墨附着；未涂布饰面（未涂布哑光、再生），将油墨吸收到纤维中；带纹理纸（条纹、罗纹、压花）和特种纸（羊皮纸、半透明）。"@zh-Hans ;
    ptpge:group "substrates" ;
    ptpge:level "sub-category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.11 · p.79",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 29" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Media",
                "MediaIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

