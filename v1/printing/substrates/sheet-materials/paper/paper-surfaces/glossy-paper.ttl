        "Glossy Paper (Coated)"@en,
        "ग्लॉस कोटेड"@hi,
        "ग्लॉसी आर्ट पेपर"@hi,
        "चमकीला काग़ज़"@hi,
        "Blankt papir"@nb,
        "Blankt papir (bestrøket)"@nb,
        "Glanset papir"@nb,
        "Glanzend machinegestreken (MC)"@nl,
        "Glanzend papier (gestreken)"@nl,
        "Maco glanzend"@nl,
        "kreda błysk"@pl,
