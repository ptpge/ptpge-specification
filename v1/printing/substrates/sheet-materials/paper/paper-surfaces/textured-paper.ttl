        "Textured Paper"@en,
        "Papel Texturado"@es,
        "टेक्सचर्ड काग़ज़"@hi,
        "テクスチャ紙（コートまたは非コート）"@ja,
        "Strukturert papir"@nb,
        "Gestructureerd papier"@nl,
        "Papier fakturowany"@pl,
        "Papel texturizado"@pt,
        "Strukturpapper"@sv,
        "纹理纸"@zh-Hans ;
    ptpge:elementType "value" ;
