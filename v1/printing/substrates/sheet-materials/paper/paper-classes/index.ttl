        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps5-wood-free-uncoated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps6-super-calendered>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps7-improved-uncoated>,
        <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-classes/ps8-standard-uncoated> ;
    skos:notation "P:SB-SHT-PAPR-CLS" ;
    skos:prefLabel "Papirklasser"@da,
        "Papierklassen"@de,
        "Paper Classes"@en,
        "Clases de papel"@es,
        "काग़ज़ वर्ग"@hi,
