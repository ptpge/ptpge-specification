    skos:altLabel "Artist canvas"@en,
        "Poly-canvas"@en,
        "आर्टिस्ट कैनवास"@hi,
        "कैनवास रोल"@hi,
        "पॉली-कैनवास"@hi,
        "Lerret"@nb,
