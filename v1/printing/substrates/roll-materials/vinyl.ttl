    skos:altLabel "Adhesive vinyl"@en,
        "PVC vinyl"@en,
        "Self-adhesive vinyl"@en,
        "PVC विनाइल"@hi,
        "चिपकने वाला विनाइल"@hi,
        "विनाइल रोल"@hi,
        "सेल्फ़-एडहेसिव विनाइल"@hi,
