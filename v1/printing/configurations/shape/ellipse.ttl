    skos:altLabel "Elliptical"@en,
        "Oval"@en,
        "अंडाकार"@hi,
        "एलिप्स"@hi,
        "ओवल"@hi,
        "Elliptisk"@nb,
        "Oval"@nb,
        "eliptyczny"@pl,
