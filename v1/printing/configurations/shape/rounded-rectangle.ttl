    skos:altLabel "Radius corners"@en,
        "Round-cornered"@en,
        "Rounded corners"@en,
        "गोल कोने"@hi,
        "राउंडेड कॉर्नर"@hi,
        "रेडियस कोने"@hi,
        "Avrundede hjørner"@nb,
