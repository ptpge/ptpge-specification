<https://ptpge.org/v1/printing/configurations/orientation/square> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:altLabel "1:1"@en,
        "Equal sides"@en,
        "Square orientation"@en,
        "1:1"@hi,
        "चौकोर"@hi,
        "बराबर भुजाएँ"@hi,
        "स्क्वेयर"@hi,
        "Kvadratisk"@nb,
        "1:1"@pl,
        "kwadrat"@pl,
        "orientacja kwadratowa"@pl,
        "1:1"@pt,
        "lados iguais"@pt,
        "orientação quadrada"@pt ;
    skos:broader <https://ptpge.org/v1/printing/configurations/orientation> ;
    skos:definition "Rektangulær orientering, hvor vandret og lodret mål er ens — bruges til kunsttryk, indhold til sociale medier og designdrevne udgivelser."@da,
        "Rechteckige Ausrichtung, bei der horizontale und vertikale Abmessungen gleich sind — verwendet für Kunstdrucke, Social-Media-Inhalte und designorientierte Publikationen."@de,
        "Rectangular orientation where horizontal and vertical dimensions are equal — used for art prints, social media content, and design-driven publications."@en,
        "Producto impreso con relación de aspecto 1:1. Habitual en catálogos de arte, libros fotográficos premium y packaging."@es,
        "आयताकार अभिविन्यास जिसमें क्षैतिज और ऊर्ध्वाधर आयाम बराबर हैं — आर्ट प्रिंट, सोशल मीडिया सामग्री और डिज़ाइन-प्रधान प्रकाशनों में।"@hi,
        "水平方向と垂直方向の寸法が等しい長方形の向き — アートプリント、ソーシャルメディアコンテンツ、デザイン主導の出版物に使用される。"@ja,
        "Rektangulær orientering der horisontale og vertikale dimensjoner er like — brukt for kunsttrykk, sosiale medier-innhold og designdrevne publikasjoner."@nb,
        "Rechthoekige oriëntatie waarbij horizontale en verticale maat gelijk zijn — gebruikt voor kunstdrukken, socialemedia-content en designgedreven publicaties."@nl,
        "Orientacja prostokątna, w której wymiary poziomy i pionowy są równe — używana do wydruków artystycznych, treści do mediów społecznościowych i publikacji o charakterze projektowym."@pl,
        "Orientação retangular em que as dimensões horizontal e vertical são iguais — usada em impressões de arte, conteúdo para redes sociais e publicações orientadas por design."@pt,
        "Rektangulär orientering där horisontellt och vertikalt mått är lika — används för konsttryck, sociala medier-innehåll och designdrivna publikationer."@sv,
        "宽高比为1:1的印刷品。常见于艺术画册、高级摄影书和包装。"@zh-Hans ;
