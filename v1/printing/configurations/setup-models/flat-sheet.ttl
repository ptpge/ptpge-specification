        "Flatt ark oppsett"@nb,
        "Vlak-vel-opzet"@nl,
        "Konfiguracja arkusz płaski"@pl,
        "Montagem em folha plana"@pt,
        "Plant ark"@sv,
        "平张结构"@zh-Hans ;
    ptpge:elementType "value" ;
