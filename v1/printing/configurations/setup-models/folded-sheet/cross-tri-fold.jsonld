{
  "@context": "https://ptpge.org/v1/context.jsonld",
  "id": "https://ptpge.org/v1/printing/configurations/setup-models/folded-sheet/cross-tri-fold",
  "type": "skos:Concept",
  "version": "2026-06-05",
