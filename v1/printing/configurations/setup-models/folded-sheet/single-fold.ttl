    skos:altLabel "F4-1"@en,
        "FoldCatalog F4-1"@en,
        "F4-1"@hi,
        "FoldCatalog F4-1"@hi,
        "Halfgevouwen"@nl,
        "Tweeluik"@nl,
        "F4-1"@pl,
        "FoldCatalog F4-1"@pl,
