<https://ptpge.org/v1/printing/configurations/back-orientation/head-to-head> a skos:Concept ;
    dcterms:created "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:altLabel "TwoSidedHeadToHead"@en,
        "Work and turn"@en,
        "TwoSidedHeadToHead"@hi,
        "बग़ल से पलटना"@hi,
        "वर्क एंड टर्न"@hi,
        "TwoSidedHeadToHead"@pl,
        "odwracanie przez oś podłużną"@pl,
        "TwoSidedHeadToHead"@pt,
        "virar de lado"@pt,
        "work and turn"@pt ;
    skos:broader <https://ptpge.org/v1/printing/configurations/back-orientation> ;
    skos:definition "Bagsiden har samme vej op som forsiden — vend arket sidelæns og begge læses retvendt. XJDF: TwoSidedHeadToHead."@da,
        "Die Rückseite ist gleich ausgerichtet wie die Vorderseite — seitlich gewendet lesen sich beide aufrecht. XJDF: TwoSidedHeadToHead."@de,
        "The back side is oriented the same way up as the front — turn the sheet over sideways and both read upright. XJDF: TwoSidedHeadToHead."@en,
        "El reverso está orientado igual que el anverso: al girar la hoja lateralmente, ambos se leen derechos. XJDF: TwoSidedHeadToHead."@es,
        "पिछला हिस्सा सामने की ही दिशा में — शीट को बग़ल से पलटें तो दोनों सीधे पढ़े जाते हैं। XJDF: TwoSidedHeadToHead।"@hi,
        "裏面が表面と同じ天地方向。用紙を横に返すと両面とも正しい向きで読める。XJDF: TwoSidedHeadToHead。"@ja,
        "Baksiden har samme vei opp som forsiden — vend arket sideveis og begge leses rett. XJDF: TwoSidedHeadToHead."@nb,
        "De achterzijde staat dezelfde kant op als de voorzijde — zijwaarts omgedraaid lezen beide rechtop. XJDF: TwoSidedHeadToHead."@nl,
        "Rewers zorientowany tak samo do góry jak awers — po obróceniu arkusza wokół boku obie strony czyta się prosto. XJDF: TwoSidedHeadToHead."@pl,
        "O verso está orientado no mesmo sentido da frente — vire a folha de lado e ambos ficam na posição de leitura. XJDF: TwoSidedHeadToHead."@pt,
        "Baksidan har samma väg upp som framsidan — vänd arket i sidled och båda läses rättvända. XJDF: TwoSidedHeadToHead."@sv,
        "背面与正面天地同向——横向翻转纸张时两面均正向可读。XJDF：TwoSidedHeadToHead。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§HEAD-TO-HEAD" ;
    skos:prefLabel "Top-mod-top"@da,
        "Kopf-an-Kopf"@de,
        "Head-to-head"@en,
        "Cabeza con cabeza"@es,
        "हेड-टू-हेड"@hi,
        "天地同方向"@ja,
        "Topp-mot-topp"@nb,
        "Kop-aan-kop"@nl,
        "Głowa do głowy"@pl,
        "Cabeça com cabeça"@pt,
        "Huvud-mot-huvud"@sv,
        "天对天"@zh-Hans ;
    ptpge:elementType "value" ;
