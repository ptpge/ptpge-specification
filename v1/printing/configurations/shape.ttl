@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/shape> a skos:Concept ;
    dcterms:created "2026-06-19T10:33:11+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations> ;
    skos:definition "En tryksags konturform — rektangel, cirkel, ellipse, rektangel med runde hjørner eller en specialkontur. En selvstændig akse adskilt fra orientering; vælges via variablen Form."@da,
        "Die Umrissform eines Druckprodukts — Rechteck, Kreis, Ellipse, abgerundetes Rechteck oder eine individuelle Kontur. Eine von der Ausrichtung getrennte Achse; gewählt über die Variable Shape."@de,
        "The outline form of a printed product — rectangle, circle, ellipse, rounded rectangle, or a custom contour. A separate axis from orientation; selected via the Shape variable."@en,
        "La forma del contorno de un producto impreso — rectángulo, círculo, elipse, rectángulo redondeado o un contorno personalizado. Un eje separado de la orientación; se selecciona mediante la variable Shape."@es,
        "मुद्रित उत्पाद की रूपरेखा — आयत, वृत्त, दीर्घवृत्त, गोल कोनों वाला आयत या कस्टम कंटूर। ओरिएंटेशन से अलग अक्ष; आकृति वेरिएबल से चुना जाता है।"@hi,
        "印刷物の輪郭形状 — 長方形、円形、楕円、角丸長方形、または任意の輪郭。向きとは別の軸で、Shape 変数で選択される。"@ja,
        "Omrissformen til et trykkprodukt — rektangel, sirkel, ellipse, avrundet rektangel eller en egendefinert kontur. En egen akse fra orientering; velges via Shape-variabelen."@nb,
        "De contourvorm van drukwerk — rechthoek, cirkel, ellips, rechthoek met ronde hoeken of een maatwerkcontour. Een eigen as, gescheiden van oriëntatie; gekozen via de variabele Vorm."@nl,
        "Forma obrysu produktu drukowanego — prostokąt, koło, elipsa, prostokąt z zaokrąglonymi rogami lub kontur niestandardowy. Oś odrębna od orientacji; wybierana przez zmienną Kształt."@pl,
        "O contorno de um impresso — retângulo, círculo, elipse, retângulo arredondado ou contorno personalizado. Eixo separado da orientação; selecionado pela variável Forma."@pt,
        "En trycksaks konturform — rektangel, cirkel, ellips, rektangel med rundade hörn eller en anpassad kontur. En egen axel skild från orientering; väljs via variabeln Form."@sv,
        "印刷品的轮廓形状 — 矩形、圆形、椭圆、圆角矩形或自定义轮廓。与方向相互独立的轴，通过 Shape 变量选择。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/shape/circle>,
        <https://ptpge.org/v1/printing/configurations/shape/ellipse>,
        <https://ptpge.org/v1/printing/configurations/shape/freeform>,
        <https://ptpge.org/v1/printing/configurations/shape/rectangle>,
        <https://ptpge.org/v1/printing/configurations/shape/rounded-rectangle> ;
    skos:notation "P:CF-SHP" ;
    skos:prefLabel "Form"@da,
        "Form"@de,
        "Shape"@en,
        "Forma"@es,
        "आकृति"@hi,
        "形状"@ja,
        "Vorm"@nl,
        "Kształt"@pl,
        "Forma"@pt,
        "Form"@sv,
        "形状"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.13 · p.81" ;
            ptpge:mappingRow "crosswalk row 22" ;
            ptpge:matchDegree "partial" ;
            ptpge:sourceElement "ShapeCuttingIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

