<https://ptpge.org/v1/printing/configurations/formats/us/tabloid> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "11 x 17 in"@en,
        "11x17"@en,
        "11×17"@en,
        "ANSI B"@en,
        "Ledger"@en,
        "Tabloid size"@en,
        "format Tabloid"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/us> ;
    skos:definition "11 × 17 tommer (279.4 × 431.8 mm). Dobbelt areal af Letter — bruges til aviser, plakater og opslag. Samme dimensioner som Ledger, men i stående orientering."@da,
        "11 × 17 in (279,4 × 431,8 mm). Doppelte Fläche von Letter — verwendet für Zeitungen, Plakate und doppelseitige Spreads. Gleiche Maße wie Ledger, aber im Hochformat."@de,
        "11 × 17 in (279.4 × 431.8 mm). Twice the area of Letter — used for newspapers, posters, and double-page spreads. Same dimensions as Ledger but in portrait orientation."@en,
        "Tamaño Tabloide, 11 × 17 pulgadas (orientación vertical). Habitual para periódicos pequeños, boletines y carteles A3-equivalentes."@es,
        "11 × 17 in (279.4 × 431.8 mm). Letter का दोगुना क्षेत्रफल — अख़बारों, पोस्टरों और डबल-पेज स्प्रेड में। Ledger जैसे ही आयाम पर पोर्ट्रेट दिशा में।"@hi,
        "11×17インチ（279.4×431.8mm）。Letterの2倍の面積 — 新聞、ポスター、見開きに使用される。Ledgerと同一寸法だが縦向き。"@ja,
        "11 × 17 in (279,4 × 431,8 mm). Dobbelt areal av Letter — brukt til aviser, plakater og oppslagssider. Samme dimensjoner som Ledger, men i portrettorientering."@nb,
        "11 × 17 inch (279.4 × 431.8 mm). Dubbel het oppervlak van Letter — gebruikt voor kranten, posters en spreads. Dezelfde afmetingen als Ledger, maar in staande oriëntatie."@nl,
        "11 × 17 cali (279,4 × 431,8 mm). Dwukrotna powierzchnia Letter — używany do gazet, plakatów i rozkładówek. Te same wymiary co Ledger, lecz w orientacji pionowej."@pl,
        "11 × 17 in (279.4 × 431.8 mm). O dobro da área do Letter — usado em jornais, pôsteres e páginas duplas. Mesmas dimensões do Ledger, mas em orientação retrato."@pt,
        "11 × 17 tum (279.4 × 431.8 mm). Dubbla arean av Letter — används för tidningar, affischer och uppslag. Samma dimensioner som Ledger men i stående orientering."@sv,
        "Tabloid尺寸，11 × 17英寸（纵向）。常用于小报、通讯和A3等效海报。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§TABLOID" ;
    skos:prefLabel "Tabloid (11 x 17 tum)"@da,
        "Tabloid (11 x 17 in)"@de,
        "Tabloid (11 x 17 in)"@en,
        "Tabloid (279 × 432 mm / 11 × 17 in)"@es,
        "Tabloid (11 x 17 in)"@hi,
        "Tabloid (11 x 17 in)"@ja,
        "Tabloid (11 x 17 in)"@nb,
        "Tabloid (11 x 17 tum)"@nl,
        "Tabloid (11 x 17 in)"@pl,
        "Tabloid (11 x 17 in)"@pt,
        "Tabloid (11 x 17 tum)"@sv,
        "Tabloid (279 × 432 mm / 11 × 17 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 187.0 ;
            ptpge:aspectRatio 1.5455 ;
            ptpge:height 17.0 ;
            ptpge:standard "ANSI" ;
            ptpge:unit "in" ;
            ptpge:width 11.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

