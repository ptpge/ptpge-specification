<https://ptpge.org/v1/printing/configurations/formats/us/junior-legal> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "5 x 8 in"@en,
        "5x8"@en,
        "5×8"@en ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/us> ;
    skos:definition "5 × 8 tommer (127 × 203.2 mm). Bruges til memoblokke og små notesbøger på nordamerikanske kontorer."@da,
        "5 × 8 in (127 × 203,2 mm). Verwendet für Memo-Blöcke und kleine Notizbücher in nordamerikanischen Büros."@de,
        "5 × 8 in (127 × 203.2 mm). Used for memo pads and small notebooks in North American offices."@en,
        "Junior Legal, 5 × 8 pulgadas. Tamaño de bloc de notas profesional en Norteamérica."@es,
        "5 × 8 in (127 × 203.2 mm). उत्तर अमेरिकी दफ़्तरों में मेमो पैड और छोटी नोटबुक में।"@hi,
        "5×8インチ（127×203.2mm）。北米のオフィスでメモパッドおよび小型ノートに使用される。"@ja,
        "5 × 8 in (127 × 203,2 mm). Brukt til notatblokker og små bøker i nordamerikanske kontorer."@nb,
        "5 × 8 inch (127 × 203.2 mm). Gebruikt voor memoblokken en kleine notitieboeken op Noord-Amerikaanse kantoren."@nl,
        "5 × 8 cali (127 × 203,2 mm). Używany do bloczków na notatki i małych notesów w biurach północnoamerykańskich."@pl,
        "5 × 8 in (127 × 203.2 mm). Usado em blocos de memorando e cadernos pequenos em escritórios norte-americanos."@pt,
        "5 × 8 tum (127 × 203.2 mm). Används för memoblock och små anteckningsböcker på nordamerikanska kontor."@sv,
        "Junior Legal，5 × 8英寸。北美专业便签本尺寸。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§JUNIOR-LEGAL" ;
    skos:prefLabel "Junior Legal (5 x 8 tum)"@da,
        "Junior Legal (5 x 8 in)"@de,
        "Junior Legal (5 x 8 in)"@en,
        "Junior Legal (127 × 203 mm / 5 × 8 in)"@es,
        "Junior Legal (5 x 8 in)"@hi,
        "Junior Legal (5 x 8 in)"@ja,
        "Junior Legal (5 x 8 in)"@nb,
        "Junior Legal (5 x 8 tum)"@nl,
        "Junior Legal (5 x 8 in)"@pl,
        "Junior Legal (5 x 8 in)"@pt,
        "Junior Legal (5 x 8 tum)"@sv,
        "Junior Legal (127 × 203 mm / 5 × 8 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 40.0 ;
            ptpge:aspectRatio 1.6 ;
            ptpge:height 8.0 ;
            ptpge:standard "ANSI" ;
            ptpge:unit "in" ;
            ptpge:width 5.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

