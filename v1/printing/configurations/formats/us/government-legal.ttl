        "Government Legal (8.5 x 13 in)"@pt,
        "Government Legal (8.5 x 13 tum)"@sv,
        "Government Legal (216 × 330 mm / 8.5 × 13 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 110.5 ;
            ptpge:aspectRatio 1.5294 ;
            ptpge:height 13.0 ;
            ptpge:standard "ANSI" ;
            ptpge:unit "in" ;
            ptpge:width 8.5 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
