<https://ptpge.org/v1/printing/configurations/formats/a-series/a4h> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "10.5 x 29.7 cm"@en,
        "105 x 297 mm"@en,
        "105x297"@en,
        "105×297"@en,
        "DIN A4H"@en,
        "A4H-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/a-series> ;
    skos:definition "105 × 297 mm (4.13 × 11.69 tommer). Del af A-serien i ISO 216, med proportionen 1:√2. Halv A4 — langt smalt format, bruges til høje smalle tryksager som programmer, postkort og specialmarkedsføring."@da,
        "105 × 297 mm (4,13 × 11,69 in). Teil der ISO-216-A-Reihe mit dem Seitenverhältnis 1:√2. Halb-A4 — schmales, langes Format, eingesetzt für hohe, schmale Dokumente wie Programme, Postkarten oder spezielle Werbematerialien."@de,
        "105 × 297 mm (4.13 × 11.69 in). Part of the ISO 216 A series, sized at a 1:√2 aspect ratio. Half-A4 — long narrow format, used for tall thin documents like programs, postcards, or specialty marketing material."@en,
        "Formato A4H (half A4) — la mitad de A4 cortado a lo largo, utilizado para insertos estrechos, marcadores y publicidad."@es,
        "105 × 297 mm (4.13 × 11.69 in). ISO 216 A-सीरीज़ का हिस्सा, 1:√2 अनुपात में। आधा A4 — लंबा पतला फ़ॉर्मेट, कार्यक्रम, पोस्टकार्ड या विशेष मार्केटिंग सामग्री जैसे ऊँचे पतले दस्तावेज़ों में।"@hi,
        "105×297mm（4.13×11.69インチ）。ISO 216 Aシリーズの一部、1:√2のアスペクト比。ハーフA4 — 細長い形式で、プログラム、ハガキ、特殊マーケティング素材などの縦長で細い文書に使用される。"@ja,
        "105 × 297 mm (4,13 × 11,69 in). Del av ISO 216 A-serien, med 1:√2-sideforhold. Halv-A4 — langt smalt format, brukt til høye smale dokumenter som programmer, postkort eller spesialisert markedsmateriell."@nb,
        "105 × 297 mm (4.13 × 11.69 inch). Onderdeel van de A-reeks in ISO 216, met de verhouding 1:√2. Half A4 — lang smal formaat, gebruikt voor hoge smalle drukwerken zoals programma's, kaarten en bijzondere marketing."@nl,
        "105 × 297 mm (4,13 × 11,69 cala). Część serii A normy ISO 216 o proporcjach 1:√2. Połowa A4 — długi, wąski format używany do wysokich, smukłych dokumentów, takich jak programy, pocztówki czy specjalne materiały marketingowe."@pl,
        "105 × 297 mm (4.13 × 11.69 in). Faz parte da série A da ISO 216, com proporção 1:√2. Meio A4 — formato longo e estreito, usado em documentos altos e finos como programas, postais ou material de marketing especial."@pt,
        "105 × 297 mm (4.13 × 11.69 tum). Del av A-serien i ISO 216, med proportionen 1:√2. Halv-A4 — långt smalt format, används för höga smala trycksaker som program, vykort och specialmarknadsföring."@sv,
        "A4H（半A4）—— A4沿长边对半切，用于窄插页、书签和广告。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§A4H" ;
    skos:prefLabel "A4H (105 x 297 mm)"@da,
        "A4H (105 x 297 mm)"@de,
        "A4H (105 x 297 mm)"@en,
        "A4H (105 × 297 mm)"@es,
        "A4H (105 x 297 mm)"@hi,
        "A4H (105 x 297 mm)"@ja,
        "A4H (105 x 297 mm)"@nb,
        "A4H (105 x 297 mm)"@nl,
        "A4H (105 x 297 mm)"@pl,
        "A4H (105 x 297 mm)"@pt,
        "A4H (105 x 297 mm)"@sv,
        "A4H (105 × 297 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 31185.0 ;
            ptpge:aspectRatio 2.8286 ;
            ptpge:height 297.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 105.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

