<https://ptpge.org/v1/printing/configurations/formats/a-series/a9> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "3.7 x 5.2 cm"@en,
        "37 x 52 mm"@en,
        "37x52"@en,
        "37×52"@en,
        "DIN A9"@en,
        "A9-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/a-series> ;
    skos:definition "37 × 52 mm (1.46 × 2.05 tommer). Del af A-serien i ISO 216, med proportionen 1:√2. Halvdelen af arealet af A8. Bruges til meget små etiketter, smykkeetiketter og miniaturetryk."@da,
        "37 × 52 mm (1,46 × 2,05 in). Teil der ISO-216-A-Reihe mit dem Seitenverhältnis 1:√2. Hälfte der Fläche von A8. Verwendet für sehr kleine Etiketten, Schmuckanhänger und Miniatur-Druckerzeugnisse."@de,
        "37 × 52 mm (1.46 × 2.05 in). Part of the ISO 216 A series, sized at a 1:√2 aspect ratio. Half the area of A8. Used for very small labels, jewelry tags, and miniature print items."@en,
        "Formato A9 de la serie A de ISO 216, dimensiones 37 × 52 mm. Relación 1:√2 — al doblarlo por la mitad se obtiene el siguiente tamaño A."@es,
        "37 × 52 mm (1.46 × 2.05 in). ISO 216 A-सीरीज़ का हिस्सा, 1:√2 अनुपात में। A8 का आधा क्षेत्रफल। बहुत छोटे लेबल, आभूषण टैग और लघु मुद्रित वस्तुओं में।"@hi,
        "37×52mm（1.46×2.05インチ）。ISO 216 Aシリーズの一部、1:√2のアスペクト比。A8の半分の面積。超小型ラベル、ジュエリータグ、ミニ印刷物に使用される。"@ja,
        "37 × 52 mm (1,46 × 2,05 in). Del av ISO 216 A-serien, med 1:√2-sideforhold. Halvparten av A8. Brukt til svært små etiketter, smykkelapper og miniatyr-trykksaker."@nb,
        "37 × 52 mm (1.46 × 2.05 inch). Onderdeel van de A-reeks in ISO 216, met de verhouding 1:√2. De helft van het oppervlak van A8. Gebruikt voor zeer kleine etiketten, sieradenlabels en miniatuurdrukwerk."@nl,
        "37 × 52 mm (1,46 × 2,05 cala). Część serii A normy ISO 216 o proporcjach 1:√2. Połowa powierzchni A8. Używany do bardzo małych etykiet, metek jubilerskich i miniaturowych druków."@pl,
        "37 × 52 mm (1.46 × 2.05 in). Faz parte da série A da ISO 216, com proporção 1:√2. Metade da área do A8. Usado em etiquetas muito pequenas, tags de joias e itens em miniatura."@pt,
        "37 × 52 mm (1.46 × 2.05 tum). Del av A-serien i ISO 216, med proportionen 1:√2. Halva arean av A8. Används för mycket små etiketter, smyckesetiketter och miniatyrtryck."@sv,
        "ISO 216 A系列A9开本，尺寸37 × 52 mm。比例1:√2 —— 对折后得到下一个A尺寸。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§A9" ;
    skos:prefLabel "A9 (37 x 52 mm)"@da,
        "A9 (37 x 52 mm)"@de,
        "A9 (37 x 52 mm)"@en,
        "A9 (37 × 52 mm)"@es,
        "A9 (37 x 52 mm)"@hi,
        "A9 (37 x 52 mm)"@ja,
        "A9 (37 x 52 mm)"@nb,
        "A9 (37 x 52 mm)"@nl,
        "A9 (37 x 52 mm)"@pl,
        "A9 (37 x 52 mm)"@pt,
        "A9 (37 x 52 mm)"@sv,
        "A9 (37 × 52 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 1924.0 ;
            ptpge:aspectRatio 1.4054 ;
            ptpge:height 52.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 37.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

