        "A10 (26 x 37 mm)"@pl,
        "A10 (26 x 37 mm)"@pt,
        "A10 (26 x 37 mm)"@sv,
        "A10 (26 × 37 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 962.0 ;
            ptpge:aspectRatio 1.4231 ;
            ptpge:height 37.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 26.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
