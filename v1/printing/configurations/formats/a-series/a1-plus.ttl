        "A1+ (609 x 914 mm)"@nb,
        "A1+ (609 x 914 mm)"@nl,
        "A1+ (609 x 914 mm)"@pl,
        "A1+ (609 x 914 mm)"@pt,
        "A1+ (609 x 914 mm)"@sv,
        "A1+ (609 × 914 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 556626.0 ;
            ptpge:aspectRatio 1.5008 ;
            ptpge:height 914.0 ;
