<https://ptpge.org/v1/printing/configurations/formats/a-series/a13> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "0.9 x 1.3 cm"@en,
        "9 x 13 mm"@en,
        "9x13"@en,
        "9×13"@en,
        "DIN A13"@en,
        "A13-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/a-series> ;
    skos:definition "9 × 13 mm (0.35 × 0.51 tommer). Del af A-serien i ISO 216, med proportionen 1:√2. Halvdelen af arealet af A12 — det minsta standardformatet i A-serien. Bruges til meget små etiketter og mærkesedler."@da,
        "9 × 13 mm (0,35 × 0,51 in). Teil der ISO-216-A-Reihe mit dem Seitenverhältnis 1:√2. Hälfte der Fläche von A12 — das kleinste Standardformat der A-Reihe. Verwendet für winzige Etiketten und Anhänger."@de,
        "9 × 13 mm (0.35 × 0.51 in). Part of the ISO 216 A series, sized at a 1:√2 aspect ratio. Half the area of A12 — the smallest standard A-series size. Used for tiny labels and tags."@en,
        "Formato A13 de la serie A de ISO 216, dimensiones 9 × 13 mm. Relación 1:√2 — al doblarlo por la mitad se obtiene el siguiente tamaño A."@es,
        "9 × 13 mm (0.35 × 0.51 in). ISO 216 A-सीरीज़ का हिस्सा, 1:√2 अनुपात में। A12 का आधा क्षेत्रफल — A-सीरीज़ का सबसे छोटा मानक आकार। नन्हे लेबल और टैग में।"@hi,
        "9×13mm（0.35×0.51インチ）。ISO 216 Aシリーズの一部、1:√2のアスペクト比。A12の半分の面積 — Aシリーズの最小標準サイズ。極小ラベルおよびタグに使用される。"@ja,
        "9 × 13 mm (0,35 × 0,51 in). Del av ISO 216 A-serien, med 1:√2-sideforhold. Halvparten av A12 — den minste standard A-serie-størrelsen. Brukt til bittesmå etiketter og merkelapper."@nb,
        "9 × 13 mm (0.35 × 0.51 inch). Onderdeel van de A-reeks in ISO 216, met de verhouding 1:√2. De helft van het oppervlak van A12 — det minsta standardformatet in A-serien. Gebruikt voor zeer kleine etiketten en labels."@nl,
        "9 × 13 mm (0,35 × 0,51 cala). Część serii A normy ISO 216 o proporcjach 1:√2. Połowa powierzchni A12 — najmniejszy standardowy format serii A. Używany do maleńkich etykiet i metek."@pl,
        "9 × 13 mm (0.35 × 0.51 in). Faz parte da série A da ISO 216, com proporção 1:√2. Metade da área do A12 — o menor tamanho padrão da série A. Usado em etiquetas e tags minúsculas."@pt,
        "9 × 13 mm (0.35 × 0.51 tum). Del av A-serien i ISO 216, med proportionen 1:√2. Halva arean av A12 — det minsta standardformatet i A-serien. Används för mycket små etiketter och märklappar."@sv,
        "ISO 216 A系列A13开本，尺寸9 × 13 mm。比例1:√2 —— 对折后得到下一个A尺寸。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§A13" ;
    skos:prefLabel "A13 (9 x 13 mm)"@da,
        "A13 (9 x 13 mm)"@de,
        "A13 (9 x 13 mm)"@en,
        "A13 (9 × 13 mm)"@es,
        "A13 (9 x 13 mm)"@hi,
        "A13 (9 x 13 mm)"@ja,
        "A13 (9 x 13 mm)"@nb,
        "A13 (9 x 13 mm)"@nl,
        "A13 (9 x 13 mm)"@pl,
        "A13 (9 x 13 mm)"@pt,
        "A13 (9 x 13 mm)"@sv,
        "A13 (9 × 13 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 117.0 ;
            ptpge:aspectRatio 1.4444 ;
            ptpge:height 13.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 9.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

