@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/c-series/c10> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "2.8 x 4 cm"@en,
        "28 x 40 mm"@en,
        "28x40"@en,
        "28×40"@en,
        "DIN C10"@en,
        "C10-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/c-series> ;
    skos:definition "28 × 40 mm (1.1 × 1.57 tommer). Del af C-serien i ISO 269, dimensioneret mellem de tilsvarende A- og B-formater — bruges primært som kuvertformat. Rummer et A10-ark fladt — det minsta standardkuvertet i C-serien."@da,
        "28 × 40 mm (1,1 × 1,57 in). Teil der ISO-269-C-Reihe, dimensioniert zwischen A- und B-Reihe — hauptsächlich als Briefumschlagformat verwendet. Fasst einen A10-Bogen ungefaltet — der kleinste Standardbriefumschlag der C-Reihe."@de,
        "28 × 40 mm (1.1 × 1.57 in). Part of the ISO 269 C series, sized between the A and B series — primarily used as an envelope size. Holds an A10 sheet flat — the smallest standard C-series envelope."@en,
        "Sobre C10 de la serie C de ISO 269, dimensiones 28 × 40 mm. Diseñado para contener una hoja A del mismo número."@es,
        "28 × 40 mm (1.1 × 1.57 in). ISO 269 C-सीरीज़ का हिस्सा, A और B सीरीज़ के बीच — मुख्यतः लिफ़ाफ़े के आकार के रूप में। A10 शीट सपाट समाती है — C-सीरीज़ का सबसे छोटा मानक लिफ़ाफ़ा।"@hi,
        "28×40mm（1.1×1.57インチ）。ISO 269 Cシリーズの一部、AシリーズとBシリーズの中間 — 主に封筒サイズとして使用される。A10シートを折らずに収納 — Cシリーズの最小標準封筒。"@ja,
        "28 × 40 mm (1,1 × 1,57 in). Del av ISO 269 C-serien, dimensjonert mellom A- og B-serien — primært brukt som konvoluttstørrelse. Rommer et A10-ark uten brett — den minste standard C-serie-konvolutten."@nb,
        "28 × 40 mm (1.1 × 1.57 inch). Onderdeel van de C-reeks in ISO 269, bemeten tussen de overeenkomstige A- en B-formaten — voornamelijk gebruikt als envelopformaat. Biedt plaats aan een A10-ark vlak — det minsta standardenvelopet in C-serien."@nl,
        "28 × 40 mm (1,1 × 1,57 cala). Część serii C normy ISO 269, pomiędzy seriami A i B — używana głównie jako format kopert. Mieści arkusz A10 na płasko — najmniejsza standardowa koperta serii C."@pl,
        "28 × 40 mm (1.1 × 1.57 in). Faz parte da série C da ISO 269, entre as séries A e B — usada sobretudo como tamanho de envelope. Comporta uma folha A10 aberta — o menor envelope padrão da série C."@pt,
        "28 × 40 mm (1.1 × 1.57 tum). Del av C-serien i ISO 269, dimensionerad mellan motsvarande A- och B-format — används främst som kuvertformat. Rymmer ett A10-ark plant — det minsta standardkuvertet i C-serien."@sv,
        "ISO 269 C系列C10信封，尺寸28 × 40 mm。设计用于装相同编号的A纸。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§C10" ;
    skos:prefLabel "C10 (28 x 40 mm)"@da,
        "C10 (28 x 40 mm)"@de,
        "C10 (28 x 40 mm)"@en,
        "C10 (28 × 40 mm)"@es,
        "C10 (28 x 40 mm)"@hi,
        "C10 (28 x 40 mm)"@ja,
        "C10 (28 x 40 mm)"@nb,
        "C10 (28 x 40 mm)"@nl,
        "C10 (28 x 40 mm)"@pl,
        "C10 (28 x 40 mm)"@pt,
        "C10 (28 x 40 mm)"@sv,
        "C10 (28 × 40 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 1120.0 ;
            ptpge:aspectRatio 1.4286 ;
            ptpge:height 40.0 ;
            ptpge:standard "ISO 269" ;
            ptpge:unit "mm" ;
            ptpge:width 28.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

