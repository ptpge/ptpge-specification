    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 9234.0 ;
            ptpge:aspectRatio 1.4074 ;
            ptpge:height 114.0 ;
            ptpge:standard "ISO 269" ;
            ptpge:unit "mm" ;
