        "C2 (458 x 648 mm)"@nl,
        "C2 (458 x 648 mm)"@pl,
        "C2 (458 x 648 mm)"@pt,
        "C2 (458 x 648 mm)"@sv,
        "C2 (458 × 648 mm)"@zh-Hans ;
