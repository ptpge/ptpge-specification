<https://ptpge.org/v1/printing/configurations/formats/c-series/c9> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "4 x 5.7 cm"@en,
        "40 x 57 mm"@en,
        "40x57"@en,
        "40×57"@en,
        "DIN C9"@en,
        "C9-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/c-series> ;
    skos:definition "40 × 57 mm (1.57 × 2.24 tommer). Del af C-serien i ISO 269, dimensioneret mellem de tilsvarende A- og B-formater — bruges primært som kuvertformat. Rummer et A9-ark fladt."@da,
        "40 × 57 mm (1,57 × 2,24 in). Teil der ISO-269-C-Reihe, dimensioniert zwischen A- und B-Reihe — hauptsächlich als Briefumschlagformat verwendet. Fasst einen A9-Bogen ungefaltet."@de,
        "40 × 57 mm (1.57 × 2.24 in). Part of the ISO 269 C series, sized between the A and B series — primarily used as an envelope size. Holds an A9 sheet flat."@en,
        "Sobre C9 de la serie C de ISO 269, dimensiones 40 × 57 mm. Diseñado para contener una hoja A del mismo número."@es,
        "40 × 57 mm (1.57 × 2.24 in). ISO 269 C-सीरीज़ का हिस्सा, A और B सीरीज़ के बीच — मुख्यतः लिफ़ाफ़े के आकार के रूप में। A9 शीट सपाट समाती है।"@hi,
        "40×57mm（1.57×2.24インチ）。ISO 269 Cシリーズの一部、AシリーズとBシリーズの中間 — 主に封筒サイズとして使用される。A9シートを折らずに収納。"@ja,
        "40 × 57 mm (1,57 × 2,24 in). Del av ISO 269 C-serien, dimensjonert mellom A- og B-serien — primært brukt som konvoluttstørrelse. Rommer et A9-ark uten brett."@nb,
        "40 × 57 mm (1.57 × 2.24 inch). Onderdeel van de C-reeks in ISO 269, bemeten tussen de overeenkomstige A- en B-formaten — voornamelijk gebruikt als envelopformaat. Biedt plaats aan een A9-ark vlak."@nl,
        "40 × 57 mm (1,57 × 2,24 cala). Część serii C normy ISO 269, pomiędzy seriami A i B — używana głównie jako format kopert. Mieści arkusz A9 na płasko."@pl,
        "40 × 57 mm (1.57 × 2.24 in). Faz parte da série C da ISO 269, entre as séries A e B — usada sobretudo como tamanho de envelope. Comporta uma folha A9 aberta."@pt,
        "40 × 57 mm (1.57 × 2.24 tum). Del av C-serien i ISO 269, dimensionerad mellan motsvarande A- och B-format — används främst som kuvertformat. Rymmer ett A9-ark plant."@sv,
        "ISO 269 C系列C9信封，尺寸40 × 57 mm。设计用于装相同编号的A纸。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§C9" ;
    skos:prefLabel "C9 (40 x 57 mm)"@da,
        "C9 (40 x 57 mm)"@de,
        "C9 (40 x 57 mm)"@en,
        "C9 (40 × 57 mm)"@es,
        "C9 (40 x 57 mm)"@hi,
        "C9 (40 x 57 mm)"@ja,
        "C9 (40 x 57 mm)"@nb,
        "C9 (40 x 57 mm)"@nl,
        "C9 (40 x 57 mm)"@pl,
        "C9 (40 x 57 mm)"@pt,
        "C9 (40 x 57 mm)"@sv,
        "C9 (40 × 57 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 2280.0 ;
            ptpge:aspectRatio 1.425 ;
            ptpge:height 57.0 ;
            ptpge:standard "ISO 269" ;
            ptpge:unit "mm" ;
            ptpge:width 40.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

