@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/ansi-series/ansi-b> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "11 x 17 in"@en,
        "11x17"@en,
        "11×17"@en,
        "Ledger"@en,
        "Tabloid"@en,
        "Ledger"@pl,
        "Tabloid"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/ansi-series> ;
    skos:definition "11 × 17 tommer (279.4 × 431.8 mm). Samme dimensioner som Tabloid/Ledger — dobbelt så stort areal som ANSI A."@da,
        "11 × 17 in (279,4 × 431,8 mm). Identisch zu Tabloid/Ledger — doppelte Fläche von ANSI A. Verwendet für Plakate, Schaltpläne und doppelseitige Spreads."@de,
        "11 × 17 in (279.4 × 431.8 mm). Same dimensions as Tabloid/Ledger — twice the area of ANSI A. Used for posters, schematics, and double-page spreads."@en,
        "Tamaño ANSI B del estándar American National Standards Institute, 279 × 432 mm / 11 × 17 in."@es,
        "11 × 17 in (279.4 × 431.8 mm). Tabloid/Ledger जैसे ही आयाम — ANSI A का दोगुना क्षेत्रफल। पोस्टर, स्कीमैटिक और डबल-पेज स्प्रेड में।"@hi,
        "11×17インチ（279.4×431.8mm）。Tabloid/Ledgerと同一寸法 — ANSI Aの2倍の面積。ポスター、回路図、見開きに使用される。"@ja,
        "11 × 17 in (279,4 × 431,8 mm). Samme dimensjoner som Tabloid/Ledger — dobbelt areal av ANSI A. Brukt til plakater, skjemategninger og oppslagssider."@nb,
        "11 × 17 inch (279.4 × 431.8 mm). Samme dimensioner som Tabloid/Ledger — dubbel zo groot als ANSI A."@nl,
        "11 × 17 cali (279,4 × 431,8 mm). Te same wymiary co Tabloid/Ledger — dwukrotna powierzchnia ANSI A. Używany do plakatów, schematów i rozkładówek."@pl,
        "11 × 17 in (279.4 × 431.8 mm). Mesmas dimensões do Tabloid/Ledger — o dobro da área do ANSI A. Usado em pôsteres, esquemas e páginas duplas."@pt,
        "11 × 17 tum (279.4 × 431.8 mm). Samma dimensioner som Tabloid/Ledger — dubbla arean av ANSI A. Används för affischer, scheman och uppslag."@sv,
        "ANSI B尺寸，American National Standards Institute标准，279 × 432 mm / 11 × 17 in。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§ANSI-B" ;
    skos:prefLabel "ANSI B (11 x 17 tum)"@da,
        "ANSI B (11 x 17 in)"@de,
        "ANSI B (11 x 17 in)"@en,
        "ANSI B (279 × 432 mm / 11 × 17 in)"@es,
        "ANSI B (11 x 17 in)"@hi,
        "ANSI B (11 x 17 in)"@ja,
        "ANSI B (11 x 17 in)"@nb,
        "ANSI B (11 x 17 tum)"@nl,
        "ANSI B (11 x 17 in)"@pl,
        "ANSI B (11 x 17 in)"@pt,
        "ANSI B (11 x 17 tum)"@sv,
        "ANSI B (279 × 432 mm / 11 × 17 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 187.0 ;
            ptpge:aspectRatio 1.5455 ;
            ptpge:height 17.0 ;
            ptpge:standard "ANSI/ASME Y14.1" ;
            ptpge:unit "in" ;
            ptpge:width 11.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

