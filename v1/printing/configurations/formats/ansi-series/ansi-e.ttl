@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/ansi-series/ansi-e> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "34 x 44 in"@en,
        "34x44"@en,
        "34×44"@en ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/ansi-series> ;
    skos:definition "34 × 44 tommer (863.6 × 1117.6 mm). Dobbelt areal af ANSI D — det største ANSI-standardformat. Bruges til store tegninger og plakater i fuld størrelse."@da,
        "34 × 44 in (863,6 × 1117,6 mm). Doppelte Fläche von ANSI D — das größte ANSI-Standardformat. Verwendet für große Konstruktionszeichnungen und Plakate."@de,
        "34 × 44 in (863.6 × 1117.6 mm). Twice the area of ANSI D — the largest standard ANSI size. Used for large engineering drawings and posters."@en,
        "Tamaño ANSI E del estándar American National Standards Institute, 864 × 1118 mm / 34 × 44 in."@es,
        "34 × 44 in (863.6 × 1117.6 mm). ANSI D का दोगुना क्षेत्रफल — सबसे बड़ा मानक ANSI आकार। बड़े इंजीनियरिंग चित्रों और पोस्टरों में।"@hi,
        "34×44インチ（863.6×1117.6mm）。ANSI Dの2倍の面積 — ANSI標準の最大サイズ。大型エンジニアリング図面およびポスターに使用される。"@ja,
        "34 × 44 in (863,6 × 1117,6 mm). Dobbelt areal av ANSI D — den største standard ANSI-størrelsen. Brukt til store ingeniørtegninger og plakater."@nb,
        "34 × 44 inch (863.6 × 1117.6 mm). Dubbel het oppervlak van ANSI D — het grootste ANSI-standaardformaat. Gebruikt voor grote tekeningen en posters op ware grootte."@nl,
        "34 × 44 cale (863,6 × 1117,6 mm). Dwukrotna powierzchnia ANSI D — największy standardowy format ANSI. Używany do dużych rysunków inżynierskich i plakatów."@pl,
        "34 × 44 in (863.6 × 1117.6 mm). O dobro da área do ANSI D — o maior tamanho ANSI padrão. Usado em grandes desenhos de engenharia e pôsteres."@pt,
        "34 × 44 tum (863.6 × 1117.6 mm). Dubbla arean av ANSI D — det största ANSI-standardformatet. Används för stora ritningar och affischer."@sv,
        "ANSI E尺寸，American National Standards Institute标准，864 × 1118 mm / 34 × 44 in。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§ANSI-E" ;
    skos:prefLabel "ANSI E (34 x 44 tum)"@da,
        "ANSI E (34 x 44 in)"@de,
        "ANSI E (34 x 44 in)"@en,
        "ANSI E (864 × 1118 mm / 34 × 44 in)"@es,
        "ANSI E (34 x 44 in)"@hi,
        "ANSI E (34 x 44 in)"@ja,
        "ANSI E (34 x 44 in)"@nb,
        "ANSI E (34 x 44 tum)"@nl,
        "ANSI E (34 x 44 in)"@pl,
        "ANSI E (34 x 44 in)"@pt,
        "ANSI E (34 x 44 tum)"@sv,
        "ANSI E (864 × 1118 mm / 34 × 44 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 1496.0 ;
            ptpge:aspectRatio 1.2941 ;
            ptpge:height 44.0 ;
            ptpge:standard "ANSI/ASME Y14.1" ;
            ptpge:unit "in" ;
            ptpge:width 34.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

