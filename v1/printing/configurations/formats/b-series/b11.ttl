@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b11> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "2.2 x 3.1 cm"@en,
        "22 x 31 mm"@en,
        "22x31"@en,
        "22×31"@en,
        "DIN B11"@en,
        "B11-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "22 × 31 mm (0.87 × 1.22 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B10."@da,
        "22 × 31 mm (0,87 × 1,22 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B10."@de,
        "22 × 31 mm (0.87 × 1.22 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B10."@en,
        "Formato B11 de la serie B de ISO 216, dimensiones 22 × 31 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "22 × 31 mm (0.87 × 1.22 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B10 का आधा क्षेत्रफल।"@hi,
        "22×31mm（0.87×1.22インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B10の半分の面積。"@ja,
        "22 × 31 mm (0,87 × 1,22 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B10."@nb,
        "22 × 31 mm (0.87 × 1.22 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B10."@nl,
        "22 × 31 mm (0,87 × 1,22 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B10."@pl,
        "22 × 31 mm (0.87 × 1.22 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B10."@pt,
        "22 × 31 mm (0.87 × 1.22 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B10."@sv,
        "ISO 216 B系列B11开本，尺寸22 × 31 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B11" ;
    skos:prefLabel "B11 (22 x 31 mm)"@da,
        "B11 (22 x 31 mm)"@de,
        "B11 (22 x 31 mm)"@en,
        "B11 (22 × 31 mm)"@es,
        "B11 (22 x 31 mm)"@hi,
        "B11 (22 x 31 mm)"@ja,
        "B11 (22 x 31 mm)"@nb,
        "B11 (22 x 31 mm)"@nl,
        "B11 (22 x 31 mm)"@pl,
        "B11 (22 x 31 mm)"@pt,
        "B11 (22 x 31 mm)"@sv,
        "B11 (22 × 31 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 682.0 ;
            ptpge:aspectRatio 1.4091 ;
            ptpge:height 31.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 22.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

