@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b5> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "17.6 x 25 cm"@en,
        "176 x 250 mm"@en,
        "176x250"@en,
        "176×250"@en,
        "DIN B5"@en,
        "B5-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "176 × 250 mm (6.93 × 9.84 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B4. Almindeligt bogformat — lidt større end A5, bruges ofte til store paperbacks."@da,
        "176 × 250 mm (6,93 × 9,84 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B4. Übliches Buchformat — etwas größer als A5, häufig für Taschenbücher des Belletristikbereichs verwendet."@de,
        "176 × 250 mm (6.93 × 9.84 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B4. Common book size — slightly larger than A5, often used for trade paperbacks."@en,
        "Formato B5 de la serie B de ISO 216, dimensiones 176 × 250 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "176 × 250 mm (6.93 × 9.84 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B4 का आधा क्षेत्रफल। आम पुस्तक आकार — A5 से थोड़ा बड़ा, ट्रेड पेपरबैक में अक्सर।"@hi,
        "176×250mm（6.93×9.84インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B4の半分の面積。一般的な書籍サイズ — A5よりわずかに大きく、トレードペーパーバックでよく使用される。"@ja,
        "176 × 250 mm (6,93 × 9,84 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B4. Vanlig bokstørrelse — litt større enn A5, ofte brukt til pocketbøker."@nb,
        "176 × 250 mm (6.93 × 9.84 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B4. Gangbaar boekformaat — iets groter dan A5, vaak gebruikt voor grote paperbacks."@nl,
        "176 × 250 mm (6,93 × 9,84 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B4. Popularny format książkowy — nieco większy niż A5, często używany w wydaniach w miękkiej oprawie."@pl,
        "176 × 250 mm (6.93 × 9.84 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B4. Tamanho comum de livro — um pouco maior que A5, muito usado em brochuras comerciais."@pt,
        "176 × 250 mm (6.93 × 9.84 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B4. Vanligt bokformat — något större än A5, används ofta för storpocket."@sv,
        "ISO 216 B系列B5开本，尺寸176 × 250 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B5" ;
    skos:prefLabel "B5 (176 x 250 mm)"@da,
        "B5 (176 x 250 mm)"@de,
        "B5 (176 x 250 mm)"@en,
        "B5 (176 × 250 mm)"@es,
        "B5 (176 x 250 mm)"@hi,
        "B5 (176 x 250 mm)"@ja,
        "B5 (176 x 250 mm)"@nb,
        "B5 (176 x 250 mm)"@nl,
        "B5 (176 x 250 mm)"@pl,
        "B5 (176 x 250 mm)"@pt,
        "B5 (176 x 250 mm)"@sv,
        "B5 (176 × 250 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 44000.0 ;
            ptpge:aspectRatio 1.4205 ;
            ptpge:height 250.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 176.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

