@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b0> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "100 x 141.4 cm"@en,
        "1000 x 1414 mm"@en,
        "1000x1414"@en,
        "1000×1414"@en,
        "DIN B0"@en,
        "B0-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "1000 × 1414 mm (39.37 × 55.67 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Det største basis-B-format — geometrisk middelværdi mellem A0 og 2A0. Bruges til meget store plakater og skiltning."@da,
        "1000 × 1414 mm (39,37 × 55,67 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Das größte Basisformat der B-Reihe — geometrisches Mittel zwischen A0 und 2A0. Verwendet für sehr große Plakate und Beschilderungen."@de,
        "1000 × 1414 mm (39.37 × 55.67 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. The largest base B size — geometric mean between A0 and 2A0. Used for very large posters and signage."@en,
        "Formato B0 de la serie B de ISO 216, dimensiones 1000 × 1414 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "1000 × 1414 mm (39.37 × 55.67 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। सबसे बड़ा आधार B आकार — A0 और 2A0 का ज्यामितीय माध्य। बहुत बड़े पोस्टरों और साइनेज में।"@hi,
        "1000×1414mm（39.37×55.67インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。最大の基本Bサイズ — A0と2A0の幾何平均。超大型ポスターおよびサインに使用される。"@ja,
        "1000 × 1414 mm (39,37 × 55,67 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Den største grunn-B-størrelsen — geometrisk gjennomsnitt mellom A0 og 2A0. Brukt til svært store plakater og skilting."@nb,
        "1000 × 1414 mm (39.37 × 55.67 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. Het grootste basis-B-formaat — het meetkundig gemiddelde tussen A0 en 2A0. Gebruikt voor zeer grote posters en signalisatie."@nl,
        "1000 × 1414 mm (39,37 × 55,67 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Największy bazowy format B — średnia geometryczna między A0 a 2A0. Używany do bardzo dużych plakatów i oznakowania."@pl,
        "1000 × 1414 mm (39.37 × 55.67 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. O maior tamanho base B — média geométrica entre A0 e 2A0. Usado em pôsteres muito grandes e sinalização."@pt,
        "1000 × 1414 mm (39.37 × 55.67 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Det största bas-B-formatet — geometriskt medelvärde mellan A0 och 2A0. Används för mycket stora affischer och skyltning."@sv,
        "ISO 216 B系列B0开本，尺寸1000 × 1414 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B0" ;
    skos:prefLabel "B0 (1000 x 1414 mm)"@da,
        "B0 (1000 x 1414 mm)"@de,
        "B0 (1000 x 1414 mm)"@en,
        "B0 (1000 × 1414 mm)"@es,
        "B0 (1000 x 1414 mm)"@hi,
        "B0 (1000 x 1414 mm)"@ja,
        "B0 (1000 x 1414 mm)"@nb,
        "B0 (1000 x 1414 mm)"@nl,
        "B0 (1000 x 1414 mm)"@pl,
        "B0 (1000 x 1414 mm)"@pt,
        "B0 (1000 x 1414 mm)"@sv,
        "B0 (1000 × 1414 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 1414000.0 ;
            ptpge:aspectRatio 1.414 ;
            ptpge:height 1414.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 1000.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

