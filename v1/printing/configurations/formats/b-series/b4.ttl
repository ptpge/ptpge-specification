@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b4> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "25 x 35.3 cm"@en,
        "250 x 353 mm"@en,
        "250x353"@en,
        "250×353"@en,
        "DIN B4"@en,
        "B4-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "250 × 353 mm (9.84 × 13.9 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B3. Almindeligt til bøger og tidsskrifter lidt større end A4."@da,
        "250 × 353 mm (9,84 × 13,9 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B3. Üblich für Bücher und Magazine, die etwas größer als A4 sind."@de,
        "250 × 353 mm (9.84 × 13.9 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B3. Common for books and magazines slightly larger than A4."@en,
        "Formato B4 de la serie B de ISO 216, dimensiones 250 × 353 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "250 × 353 mm (9.84 × 13.9 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B3 का आधा क्षेत्रफल। A4 से थोड़ी बड़ी किताबों और पत्रिकाओं में आम।"@hi,
        "250×353mm（9.84×13.9インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B3の半分の面積。A4よりわずかに大きい書籍および雑誌で一般的。"@ja,
        "250 × 353 mm (9,84 × 13,9 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B3. Vanlig for bøker og magasiner litt større enn A4."@nb,
        "250 × 353 mm (9.84 × 13.9 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B3. Gebruikelijk voor boeken en tijdschriften die iets groter zijn dan A4."@nl,
        "250 × 353 mm (9,84 × 13,9 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B3. Typowy dla książek i czasopism nieco większych niż A4."@pl,
        "250 × 353 mm (9.84 × 13.9 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B3. Comum em livros e revistas um pouco maiores que A4."@pt,
        "250 × 353 mm (9.84 × 13.9 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B3. Vanligt för böcker och tidskrifter något större än A4."@sv,
        "ISO 216 B系列B4开本，尺寸250 × 353 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B4" ;
    skos:prefLabel "B4 (250 x 353 mm)"@da,
        "B4 (250 x 353 mm)"@de,
        "B4 (250 x 353 mm)"@en,
        "B4 (250 × 353 mm)"@es,
        "B4 (250 x 353 mm)"@hi,
        "B4 (250 x 353 mm)"@ja,
        "B4 (250 x 353 mm)"@nb,
        "B4 (250 x 353 mm)"@nl,
        "B4 (250 x 353 mm)"@pl,
        "B4 (250 x 353 mm)"@pt,
        "B4 (250 x 353 mm)"@sv,
        "B4 (250 × 353 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 88250.0 ;
            ptpge:aspectRatio 1.412 ;
            ptpge:height 353.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 250.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

