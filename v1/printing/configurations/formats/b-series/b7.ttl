@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b7> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "8.8 x 12.5 cm"@en,
        "88 x 125 mm"@en,
        "88x125"@en,
        "88×125"@en,
        "DIN B7"@en,
        "B7-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "88 × 125 mm (3.46 × 4.92 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B6. Bruges til dokument i passformat og små tryksager."@da,
        "88 × 125 mm (3,46 × 4,92 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B6. Verwendet für Dokumente in Passgröße und kleine Druckerzeugnisse."@de,
        "88 × 125 mm (3.46 × 4.92 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B6. Used for passport-size documents and small printed items."@en,
        "Formato B7 de la serie B de ISO 216, dimensiones 88 × 125 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "88 × 125 mm (3.46 × 4.92 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B6 का आधा क्षेत्रफल। पासपोर्ट-आकार दस्तावेज़ों और छोटी वस्तुओं में।"@hi,
        "88×125mm（3.46×4.92インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B6の半分の面積。パスポートサイズの文書および小型印刷物に使用される。"@ja,
        "88 × 125 mm (3,46 × 4,92 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B6. Brukt til passstørrelse-dokumenter og små trykksaker."@nb,
        "88 × 125 mm (3.46 × 4.92 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B6. Gebruikt voor dokument in passformat en kleine drukwerk."@nl,
        "88 × 125 mm (3,46 × 4,92 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B6. Używany do dokumentów formatu paszportowego i małych druków."@pl,
        "88 × 125 mm (3.46 × 4.92 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B6. Usado em documentos tamanho passaporte e itens pequenos."@pt,
        "88 × 125 mm (3.46 × 4.92 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B6. Används för dokument i passformat och små trycksaker."@sv,
        "ISO 216 B系列B7开本，尺寸88 × 125 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B7" ;
    skos:prefLabel "B7 (88 x 125 mm)"@da,
        "B7 (88 x 125 mm)"@de,
        "B7 (88 x 125 mm)"@en,
        "B7 (88 × 125 mm)"@es,
        "B7 (88 x 125 mm)"@hi,
        "B7 (88 x 125 mm)"@ja,
        "B7 (88 x 125 mm)"@nb,
        "B7 (88 x 125 mm)"@nl,
        "B7 (88 x 125 mm)"@pl,
        "B7 (88 x 125 mm)"@pt,
        "B7 (88 x 125 mm)"@sv,
        "B7 (88 × 125 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 11000.0 ;
            ptpge:aspectRatio 1.4205 ;
            ptpge:height 125.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 88.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

