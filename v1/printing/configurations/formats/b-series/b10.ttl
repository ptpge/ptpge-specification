@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b10> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "3.1 x 4.4 cm"@en,
        "31 x 44 mm"@en,
        "31x44"@en,
        "31×44"@en,
        "DIN B10"@en,
        "B10-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "31 × 44 mm (1.22 × 1.73 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B9."@da,
        "31 × 44 mm (1,22 × 1,73 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B9."@de,
        "31 × 44 mm (1.22 × 1.73 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B9."@en,
        "Formato B10 de la serie B de ISO 216, dimensiones 31 × 44 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "31 × 44 mm (1.22 × 1.73 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B9 का आधा क्षेत्रफल।"@hi,
        "31×44mm（1.22×1.73インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B9の半分の面積。"@ja,
        "31 × 44 mm (1,22 × 1,73 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B9."@nb,
        "31 × 44 mm (1.22 × 1.73 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B9."@nl,
        "31 × 44 mm (1,22 × 1,73 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B9."@pl,
        "31 × 44 mm (1.22 × 1.73 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B9."@pt,
        "31 × 44 mm (1.22 × 1.73 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B9."@sv,
        "ISO 216 B系列B10开本，尺寸31 × 44 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B10" ;
    skos:prefLabel "B10 (31 x 44 mm)"@da,
        "B10 (31 x 44 mm)"@de,
        "B10 (31 x 44 mm)"@en,
        "B10 (31 × 44 mm)"@es,
        "B10 (31 x 44 mm)"@hi,
        "B10 (31 x 44 mm)"@ja,
        "B10 (31 x 44 mm)"@nb,
        "B10 (31 x 44 mm)"@nl,
        "B10 (31 x 44 mm)"@pl,
        "B10 (31 x 44 mm)"@pt,
        "B10 (31 x 44 mm)"@sv,
        "B10 (31 × 44 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 1364.0 ;
            ptpge:aspectRatio 1.4194 ;
            ptpge:height 44.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 31.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

