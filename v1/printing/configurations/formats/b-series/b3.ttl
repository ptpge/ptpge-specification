@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b3> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "35.3 x 50 cm"@en,
        "353 x 500 mm"@en,
        "353x500"@en,
        "353×500"@en,
        "DIN B3"@en,
        "B3-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "353 × 500 mm (13.9 × 19.69 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B2. Dimensionerat mellem A3 og A2."@da,
        "353 × 500 mm (13,9 × 19,69 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B2. Liegt zwischen A3 und A2."@de,
        "353 × 500 mm (13.9 × 19.69 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B2. Sized between A3 and A2."@en,
        "Formato B3 de la serie B de ISO 216, dimensiones 353 × 500 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "353 × 500 mm (13.9 × 19.69 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B2 का आधा क्षेत्रफल। A3 और A2 के बीच।"@hi,
        "353×500mm（13.9×19.69インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B2の半分の面積。A3とA2の中間サイズ。"@ja,
        "353 × 500 mm (13,9 × 19,69 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B2. Dimensjonert mellom A3 og A2."@nb,
        "353 × 500 mm (13.9 × 19.69 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B2. Dimensionerat mellem A3 en A2."@nl,
        "353 × 500 mm (13,9 × 19,69 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B2. Rozmiar między A3 a A2."@pl,
        "353 × 500 mm (13.9 × 19.69 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B2. Entre A3 e A2."@pt,
        "353 × 500 mm (13.9 × 19.69 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B2. Dimensionerat mellan A3 och A2."@sv,
        "ISO 216 B系列B3开本，尺寸353 × 500 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B3" ;
    skos:prefLabel "B3 (353 x 500 mm)"@da,
        "B3 (353 x 500 mm)"@de,
        "B3 (353 x 500 mm)"@en,
        "B3 (353 × 500 mm)"@es,
        "B3 (353 x 500 mm)"@hi,
        "B3 (353 x 500 mm)"@ja,
        "B3 (353 x 500 mm)"@nb,
        "B3 (353 x 500 mm)"@nl,
        "B3 (353 x 500 mm)"@pl,
        "B3 (353 x 500 mm)"@pt,
        "B3 (353 x 500 mm)"@sv,
        "B3 (353 × 500 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 176500.0 ;
            ptpge:aspectRatio 1.4164 ;
            ptpge:height 500.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 353.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

