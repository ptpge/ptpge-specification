@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b12> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "1.5 x 2.2 cm"@en,
        "15 x 22 mm"@en,
        "15x22"@en,
        "15×22"@en,
        "DIN B12"@en,
        "B12-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "15 × 22 mm (0.59 × 0.87 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B11."@da,
        "15 × 22 mm (0,59 × 0,87 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B11."@de,
        "15 × 22 mm (0.59 × 0.87 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B11."@en,
        "Formato B12 de la serie B de ISO 216, dimensiones 15 × 22 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "15 × 22 mm (0.59 × 0.87 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B11 का आधा क्षेत्रफल।"@hi,
        "15×22mm（0.59×0.87インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B11の半分の面積。"@ja,
        "15 × 22 mm (0,59 × 0,87 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B11."@nb,
        "15 × 22 mm (0.59 × 0.87 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B11."@nl,
        "15 × 22 mm (0,59 × 0,87 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B11."@pl,
        "15 × 22 mm (0.59 × 0.87 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B11."@pt,
        "15 × 22 mm (0.59 × 0.87 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B11."@sv,
        "ISO 216 B系列B12开本，尺寸15 × 22 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B12" ;
    skos:prefLabel "B12 (15 x 22 mm)"@da,
        "B12 (15 x 22 mm)"@de,
        "B12 (15 x 22 mm)"@en,
        "B12 (15 × 22 mm)"@es,
        "B12 (15 x 22 mm)"@hi,
        "B12 (15 x 22 mm)"@ja,
        "B12 (15 x 22 mm)"@nb,
        "B12 (15 x 22 mm)"@nl,
        "B12 (15 x 22 mm)"@pl,
        "B12 (15 x 22 mm)"@pt,
        "B12 (15 x 22 mm)"@sv,
        "B12 (15 × 22 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 330.0 ;
            ptpge:aspectRatio 1.4667 ;
            ptpge:height 22.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 15.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

