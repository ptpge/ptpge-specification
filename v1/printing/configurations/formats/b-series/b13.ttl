@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b13> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "1.1 x 1.5 cm"@en,
        "11 x 15 mm"@en,
        "11x15"@en,
        "11×15"@en,
        "DIN B13"@en,
        "B13-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "11 × 15 mm (0.43 × 0.59 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B12 — det minsta standardformatet i B-serien."@da,
        "11 × 15 mm (0,43 × 0,59 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B12 — das kleinste Standardformat der B-Reihe."@de,
        "11 × 15 mm (0.43 × 0.59 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B12 — the smallest standard B-series size."@en,
        "Formato B13 de la serie B de ISO 216, dimensiones 11 × 15 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "11 × 15 mm (0.43 × 0.59 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B12 का आधा क्षेत्रफल — B-सीरीज़ का सबसे छोटा मानक आकार।"@hi,
        "11×15mm（0.43×0.59インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B12の半分の面積 — Bシリーズの最小標準サイズ。"@ja,
        "11 × 15 mm (0,43 × 0,59 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B12 — den minste standard B-serie-størrelsen."@nb,
        "11 × 15 mm (0.43 × 0.59 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B12 — det minsta standardformatet in B-serien."@nl,
        "11 × 15 mm (0,43 × 0,59 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B12 — najmniejszy standardowy format serii B."@pl,
        "11 × 15 mm (0.43 × 0.59 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B12 — o menor tamanho padrão da série B."@pt,
        "11 × 15 mm (0.43 × 0.59 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B12 — det minsta standardformatet i B-serien."@sv,
        "ISO 216 B系列B13开本，尺寸11 × 15 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B13" ;
    skos:prefLabel "B13 (11 x 15 mm)"@da,
        "B13 (11 x 15 mm)"@de,
        "B13 (11 x 15 mm)"@en,
        "B13 (11 × 15 mm)"@es,
        "B13 (11 x 15 mm)"@hi,
        "B13 (11 x 15 mm)"@ja,
        "B13 (11 x 15 mm)"@nb,
        "B13 (11 x 15 mm)"@nl,
        "B13 (11 x 15 mm)"@pl,
        "B13 (11 x 15 mm)"@pt,
        "B13 (11 x 15 mm)"@sv,
        "B13 (11 × 15 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 165.0 ;
            ptpge:aspectRatio 1.3636 ;
            ptpge:height 15.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 11.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

