@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/formats/b-series/b8> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "6.2 x 8.8 cm"@en,
        "62 x 88 mm"@en,
        "62x88"@en,
        "62×88"@en,
        "DIN B8"@en,
        "B8-format"@nb ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/b-series> ;
    skos:definition "62 × 88 mm (2.44 × 3.46 tommer). Del af B-serien i ISO 216 — lidt større end det tilsvarende A-format. Halvdelen af arealet af B7. Bruges til meget små tryksager."@da,
        "62 × 88 mm (2,44 × 3,46 in). Teil der ISO-216-B-Reihe — etwas größer als das entsprechende A-Format. Hälfte der Fläche von B7. Verwendet für sehr kleine Druckerzeugnisse."@de,
        "62 × 88 mm (2.44 × 3.46 in). Part of the ISO 216 B series — slightly larger than the corresponding A size. Half the area of B7. Used for very small printed items."@en,
        "Formato B8 de la serie B de ISO 216, dimensiones 62 × 88 mm. Cada B es la media geométrica entre los dos A correspondientes."@es,
        "62 × 88 mm (2.44 × 3.46 in). ISO 216 B-सीरीज़ का हिस्सा — संगत A आकार से थोड़ा बड़ा। B7 का आधा क्षेत्रफल। बहुत छोटी मुद्रित वस्तुओं में।"@hi,
        "62×88mm（2.44×3.46インチ）。ISO 216 Bシリーズの一部 — 対応するAサイズよりわずかに大きい。B7の半分の面積。超小型印刷物に使用される。"@ja,
        "62 × 88 mm (2,44 × 3,46 in). Del av ISO 216 B-serien — litt større enn tilsvarende A-størrelse. Halvparten av B7. Brukt til svært små trykksaker."@nb,
        "62 × 88 mm (2.44 × 3.46 inch). Onderdeel van de B-reeks in ISO 216 — iets groter dan het overeenkomstige A-formaat. De helft van het oppervlak van B7. Gebruikt voor zeer klein drukwerk."@nl,
        "62 × 88 mm (2,44 × 3,46 cala). Część serii B normy ISO 216 — nieco większa od odpowiadającego formatu A. Połowa powierzchni B7. Używany do bardzo małych druków."@pl,
        "62 × 88 mm (2.44 × 3.46 in). Faz parte da série B da ISO 216 — ligeiramente maior que o tamanho A correspondente. Metade da área do B7. Usado em itens impressos muito pequenos."@pt,
        "62 × 88 mm (2.44 × 3.46 tum). Del av B-serien i ISO 216 — något större än motsvarande A-format. Halva arean av B7. Används för mycket små trycksaker."@sv,
        "ISO 216 B系列B8开本，尺寸62 × 88 mm。每个B尺寸是对应两个A尺寸的几何平均。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§B8" ;
    skos:prefLabel "B8 (62 x 88 mm)"@da,
        "B8 (62 x 88 mm)"@de,
        "B8 (62 x 88 mm)"@en,
        "B8 (62 × 88 mm)"@es,
        "B8 (62 x 88 mm)"@hi,
        "B8 (62 x 88 mm)"@ja,
        "B8 (62 x 88 mm)"@nb,
        "B8 (62 x 88 mm)"@nl,
        "B8 (62 x 88 mm)"@pl,
        "B8 (62 x 88 mm)"@pt,
        "B8 (62 x 88 mm)"@sv,
        "B8 (62 × 88 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 5456.0 ;
            ptpge:aspectRatio 1.4194 ;
            ptpge:height 88.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 62.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

