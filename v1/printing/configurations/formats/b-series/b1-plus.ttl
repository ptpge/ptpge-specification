        "B1+ (720 x 1020 mm)"@nb,
        "B1+ (720 x 1020 mm)"@nl,
        "B1+ (720 x 1020 mm)"@pl,
        "B1+ (720 x 1020 mm)"@pt,
        "B1+ (720 x 1020 mm)"@sv,
        "B1+ (720 × 1020 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 734400.0 ;
            ptpge:aspectRatio 1.4167 ;
            ptpge:height 1020.0 ;
            ptpge:standard "ISO 216" ;
            ptpge:unit "mm" ;
            ptpge:width 720.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
