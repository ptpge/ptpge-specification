<https://ptpge.org/v1/printing/configurations/formats/international-envelopes/s65> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "11 x 22.5 cm"@en,
        "110 x 225 mm"@en,
        "110x225"@en,
        "110×225"@en ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/international-envelopes> ;
    skos:definition "110 × 225 mm. Langt smalt kuvert med samme bredde som DL, men lidt højere."@da,
        "110 × 225 mm. Langer, schmaler Briefumschlag mit ähnlicher Breite wie DL, aber etwas höher."@de,
        "110 × 225 mm. Long narrow envelope similar in width to DL but slightly taller."@en,
        "Sobre S65 — formato especializado utilizado en correspondencia europea, similar a DL ligeramente más alto."@es,
        "110 × 225 mm. लंबा पतला लिफ़ाफ़ा, चौड़ाई DL जैसी पर थोड़ा ऊँचा।"@hi,
        "110×225mm。DLと幅が似ているがわずかに高い細長い封筒。"@ja,
        "110 × 225 mm. Lang smal konvolutt med samme bredde som DL, men litt høyere."@nb,
        "110 × 225 mm. Lange smalle envelop met dezelfde breedte als DL, maar iets hoger."@nl,
        "110 × 225 mm. Długa, wąska koperta o szerokości zbliżonej do DL, lecz nieco wyższa."@pl,
        "110 × 225 mm. Envelope longo e estreito, de largura semelhante ao DL mas um pouco mais alto."@pt,
        "110 × 225 mm. Långt smalt kuvert med samma bredd som DL men något högre."@sv,
        "S65信封 —— 欧洲通信使用的专业格式，类似DL但稍高。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§S65" ;
    skos:prefLabel "S65 (110 x 225 mm)"@da,
        "S65 (110 x 225 mm)"@de,
        "S65 (110 x 225 mm)"@en,
        "S65 (110 × 225 mm)"@es,
        "S65 (110 x 225 mm)"@hi,
        "S65 (110 x 225 mm)"@ja,
        "S65 (110 x 225 mm)"@nb,
        "S65 (110 x 225 mm)"@nl,
        "S65 (110 x 225 mm)"@pl,
        "S65 (110 x 225 mm)"@pt,
        "S65 (110 x 225 mm)"@sv,
        "S65 (110 × 225 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 24750.0 ;
            ptpge:aspectRatio 2.0455 ;
            ptpge:height 225.0 ;
            ptpge:standard "ISO 269" ;
            ptpge:unit "mm" ;
