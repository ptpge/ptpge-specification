        "Envelope C5 (162 × 229 mm)"@pt,
        "Kuvert C5 (162 × 229 mm)"@sv,
        "C5 (162 × 229 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 37098.0 ;
            ptpge:aspectRatio 1.4136 ;
            ptpge:height 229.0 ;
            ptpge:standard "ISO 269" ;
            ptpge:unit "mm" ;
            ptpge:width 162.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
