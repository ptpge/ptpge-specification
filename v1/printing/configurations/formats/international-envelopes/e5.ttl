        "E5 (115 x 220 mm)"@pl,
        "E5 (115 x 220 mm)"@pt,
        "E5 (115 x 220 mm)"@sv,
        "E5 (115 × 220 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 25300.0 ;
            ptpge:aspectRatio 1.913 ;
            ptpge:height 220.0 ;
            ptpge:standard "ISO 269" ;
            ptpge:unit "mm" ;
            ptpge:width 115.0 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
