        "Envelope C6 (114 × 162 mm)"@pt,
        "Kuvert C6 (114 × 162 mm)"@sv,
        "C6 (114 × 162 mm)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 18468.0 ;
            ptpge:aspectRatio 1.4211 ;
            ptpge:height 162.0 ;
            ptpge:standard "ISO 269" ;
            ptpge:unit "mm" ;
