<https://ptpge.org/v1/printing/configurations/formats/business-cards/business-card-us> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:29:18+00:00"^^xsd:dateTime ;
    skos:altLabel "3.5 x 2 in"@en,
        "3.5x2"@en,
        "3.5×2"@en ;
    skos:broader <https://ptpge.org/v1/printing/configurations/formats/business-cards> ;
    skos:definition "3.5 × 2 tommer (88.9 × 50.8 mm). Standardvisitkortformatet i USA og Canada. Passar amerikanska plånbokfack."@da,
        "3,5 × 2 in (88,9 × 50,8 mm). Das Standardvisitenkartenformat in den Vereinigten Staaten und Kanada. Passt in Standardkartenfächer von US-Geldbörsen."@de,
        "3.5 × 2 in (88.9 × 50.8 mm). The standard business card size in the United States and Canada. Fits standard US wallet card slots."@en,
        "Tarjeta de visita estándar estadounidense, 3,5 × 2 pulgadas (88,9 × 50,8 mm)."@es,
        "3.5 × 2 in (88.9 × 50.8 mm). संयुक्त राज्य और कनाडा का मानक विज़िटिंग कार्ड आकार। मानक US बटुए के कार्ड स्लॉट में समाता है।"@hi,
        "3.5×2インチ（88.9×50.8mm）。米国およびカナダの標準名刺サイズ。米国の標準的な財布のカードスロットに収まる。"@ja,
        "3,5 × 2 in (88,9 × 50,8 mm). Standard visittkortstørrelse i USA og Canada. Passer i standard amerikanske lommebok-spor."@nb,
        "3.5 × 2 inch (88.9 × 50.8 mm). Standardvisitkortformatet in USA en Canada. Passar amerikanska plånbokfack."@nl,
        "3,5 × 2 cale (88,9 × 50,8 mm). Standardowy format wizytówki w Stanach Zjednoczonych i Kanadzie. Mieści się w standardowych amerykańskich portfelach."@pl,
        "3.5 × 2 in (88.9 × 50.8 mm). O tamanho padrão de cartão de visita nos Estados Unidos e no Canadá. Cabe nos compartimentos de cartão das carteiras americanas."@pt,
        "3.5 × 2 tum (88.9 × 50.8 mm). Standardvisitkortsformatet i USA och Kanada. Passar amerikanska plånbokfack."@sv,
        "美国标准名片，3.5 × 2英寸（88.9 × 50.8毫米）。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§BUSINESS-CARD-US" ;
    skos:prefLabel "Visitkort USA (3.5 x 2 tum)"@da,
        "Business Card US (3.5 x 2 in)"@de,
        "Business Card US (3.5 x 2 in)"@en,
        "Tarjeta de Visita EE. UU. (3,5 × 2 in)"@es,
        "विज़िटिंग कार्ड US (3.5 x 2 in)"@hi,
        "Business Card US (3.5 x 2 in)"@ja,
        "Business Card US (3.5 x 2 in)"@nb,
        "Visitekaartje VS (3.5 x 2 in)"@nl,
        "Business Card US (3.5 x 2 in)"@pl,
        "Cartão de visita EUA (3.5 x 2 in)"@pt,
        "Visitkort USA (3.5 x 2 tum)"@sv,
        "美国名片 (3.5 × 2 in)"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "configurations" ;
    ptpge:hasProperty [ ptpge:area 7.0 ;
            ptpge:aspectRatio 1.75 ;
            ptpge:height 2.0 ;
            ptpge:standard "convention" ;
            ptpge:unit "in" ;
            ptpge:width 3.5 ] ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78",
                "§6.57 · p.229" ;
            ptpge:mappingRow "crosswalk row 20" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent",
                "Media" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

