    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:altLabel "Position 6"@en,
        "Winding 6"@en,
        "WindingResult 6"@en,
        "Wound in, bottom leading"@en,
        "WindingResult 6"@pl,
        "nawijanie 6"@pl,
        "pozycja 6"@pl ;
    skos:broader <https://ptpge.org/v1/printing/configurations/winding-direction> ;
    skos:definition "FINAT-rulleposition 6: etiketter rullet med trykside ind, bundkanten forlader rullen først. XJDF Component/@WindingResult = 6."@da,
        "FINAT-Wickelposition 6: Etiketten mit Druckseite innen gewickelt, Unterkante verlässt die Rolle zuerst. XJDF Component/@WindingResult = 6."@de,
        "FINAT winding position 6: labels wound with the printed face in, bottom edge leaving the roll first. XJDF Component/@WindingResult = 6."@en,
        "Posición de bobinado FINAT 6: etiquetas bobinadas con la cara impresa hacia dentro, el borde inferior sale primero de la bobina. XJDF Component/@WindingResult = 6."@es,
        "FINAT वाइंडिंग स्थिति 6: छपा चेहरा अंदर, निचला किनारा रोल से पहले निकलता है। XJDF Component/@WindingResult = 6।"@hi,
        "FINAT 巻き位置 6：内巻きで巻かれ、下辺が先に繰り出される。XJDF Component/@WindingResult = 6。"@ja,
        "FINAT-viklingsposisjon 6: etiketter viklet med trykkside inn, bunnkanten forlater rullen først. XJDF Component/@WindingResult = 6."@nb,
        "FINAT-wikkelpositie 6: etiketten gewikkeld met beeld binnen, onderrand verlaat de rol als eerste. XJDF Component/@WindingResult = 6."@nl,
        "Pozycja nawijania FINAT 6: etykiety nawinięte zadrukowaną stroną do wewnątrz, dolna krawędź schodzi z roli pierwsza. XJDF Component/@WindingResult = 6."@pl,
        "Posição de enrolamento FINAT 6: rótulos enrolados com a face impressa para dentro, borda inferior saindo primeiro do rolo. XJDF Component/@WindingResult = 6."@pt,
        "FINAT-rullposition 6: etiketter rullade med tryck inåt, underkanten lämnar rullen först. XJDF Component/@WindingResult = 6."@sv,
        "FINAT 卷绕位置 6：印刷面朝内卷绕，下边先出卷。XJDF Component/@WindingResult = 6。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CF§FINAT-6" ;
    skos:prefLabel "FINAT 6"@da,
        "FINAT 6"@de,
        "FINAT 6"@en,
