  "definition": {
    "en": "FINAT winding position 8: labels wound with the printed face in, left edge leaving the roll first. XJDF Component/@WindingResult = 8.",
    "nb": "FINAT-viklingsposisjon 8: etiketter viklet med trykkside inn, venstre kant forlater rullen først. XJDF Component/@WindingResult = 8.",
    "de": "FINAT-Wickelposition 8: Etiketten mit Druckseite innen gewickelt, linke Kante verlässt die Rolle zuerst. XJDF Component/@WindingResult = 8.",
    "es": "Posición de bobinado FINAT 8: etiquetas bobinadas con la cara impresa hacia dentro, el borde izquierdo sale primero de la bobina. XJDF Component/@WindingResult = 8.",
    "ja": "FINAT 巻き位置 8：内巻きで巻かれ、左辺が先に繰り出される。XJDF Component/@WindingResult = 8。",
    "zh-Hans": "FINAT 卷绕位置 8：印刷面朝内卷绕，左边先出卷。XJDF Component/@WindingResult = 8。",
    "sv": "FINAT-rullposition 8: etiketter rullade med tryck inåt, vänsterkanten lämnar rullen först. XJDF Component/@WindingResult = 8.",
    "da": "FINAT-rulleposition 8: etiketter rullet med trykside ind, venstre kant forlader rullen først. XJDF Component/@WindingResult = 8.",
    "nl": "FINAT-wikkelpositie 8: etiketten gewikkeld met beeld binnen, linkerrand verlaat de rol als eerste. XJDF Component/@WindingResult = 8.",
    "pl": "Pozycja nawijania FINAT 8: etykiety nawinięte zadrukowaną stroną do wewnątrz, lewa krawędź schodzi z roli pierwsza. XJDF Component/@WindingResult = 8.",
    "pt": "Posição de enrolamento FINAT 8: rótulos enrolados com a face impressa para dentro, borda esquerda saindo primeiro do rolo. XJDF Component/@WindingResult = 8.",
    "hi": "FINAT वाइंडिंग स्थिति 8: छपा चेहरा अंदर, बायाँ किनारा रोल से पहले निकलता है। XJDF Component/@WindingResult = 8।"
  }
