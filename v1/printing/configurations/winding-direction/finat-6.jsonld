  "definition": {
    "en": "FINAT winding position 6: labels wound with the printed face in, bottom edge leaving the roll first. XJDF Component/@WindingResult = 6.",
    "nb": "FINAT-viklingsposisjon 6: etiketter viklet med trykkside inn, bunnkanten forlater rullen først. XJDF Component/@WindingResult = 6.",
    "de": "FINAT-Wickelposition 6: Etiketten mit Druckseite innen gewickelt, Unterkante verlässt die Rolle zuerst. XJDF Component/@WindingResult = 6.",
    "es": "Posición de bobinado FINAT 6: etiquetas bobinadas con la cara impresa hacia dentro, el borde inferior sale primero de la bobina. XJDF Component/@WindingResult = 6.",
    "ja": "FINAT 巻き位置 6：内巻きで巻かれ、下辺が先に繰り出される。XJDF Component/@WindingResult = 6。",
    "zh-Hans": "FINAT 卷绕位置 6：印刷面朝内卷绕，下边先出卷。XJDF Component/@WindingResult = 6。",
    "sv": "FINAT-rullposition 6: etiketter rullade med tryck inåt, underkanten lämnar rullen först. XJDF Component/@WindingResult = 6.",
    "da": "FINAT-rulleposition 6: etiketter rullet med trykside ind, bundkanten forlader rullen først. XJDF Component/@WindingResult = 6.",
    "nl": "FINAT-wikkelpositie 6: etiketten gewikkeld met beeld binnen, onderrand verlaat de rol als eerste. XJDF Component/@WindingResult = 6.",
    "pl": "Pozycja nawijania FINAT 6: etykiety nawinięte zadrukowaną stroną do wewnątrz, dolna krawędź schodzi z roli pierwsza. XJDF Component/@WindingResult = 6.",
    "pt": "Posição de enrolamento FINAT 6: rótulos enrolados com a face impressa para dentro, borda inferior saindo primeiro do rolo. XJDF Component/@WindingResult = 6.",
    "hi": "FINAT वाइंडिंग स्थिति 6: छपा चेहरा अंदर, निचला किनारा रोल से पहले निकलता है। XJDF Component/@WindingResult = 6।"
  }
