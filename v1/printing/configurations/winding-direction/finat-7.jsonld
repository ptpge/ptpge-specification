  "definition": {
    "en": "FINAT winding position 7: labels wound with the printed face in, right edge leaving the roll first. XJDF Component/@WindingResult = 7.",
    "nb": "FINAT-viklingsposisjon 7: etiketter viklet med trykkside inn, høyre kant forlater rullen først. XJDF Component/@WindingResult = 7.",
    "de": "FINAT-Wickelposition 7: Etiketten mit Druckseite innen gewickelt, rechte Kante verlässt die Rolle zuerst. XJDF Component/@WindingResult = 7.",
    "es": "Posición de bobinado FINAT 7: etiquetas bobinadas con la cara impresa hacia dentro, el borde derecho sale primero de la bobina. XJDF Component/@WindingResult = 7.",
    "ja": "FINAT 巻き位置 7：内巻きで巻かれ、右辺が先に繰り出される。XJDF Component/@WindingResult = 7。",
    "zh-Hans": "FINAT 卷绕位置 7：印刷面朝内卷绕，右边先出卷。XJDF Component/@WindingResult = 7。",
    "sv": "FINAT-rullposition 7: etiketter rullade med tryck inåt, högerkanten lämnar rullen först. XJDF Component/@WindingResult = 7.",
    "da": "FINAT-rulleposition 7: etiketter rullet med trykside ind, højre kant forlader rullen først. XJDF Component/@WindingResult = 7.",
    "nl": "FINAT-wikkelpositie 7: etiketten gewikkeld met beeld binnen, rechterrand verlaat de rol als eerste. XJDF Component/@WindingResult = 7.",
    "pl": "Pozycja nawijania FINAT 7: etykiety nawinięte zadrukowaną stroną do wewnątrz, prawa krawędź schodzi z roli pierwsza. XJDF Component/@WindingResult = 7.",
    "pt": "Posição de enrolamento FINAT 7: rótulos enrolados com a face impressa para dentro, borda direita saindo primeiro do rolo. XJDF Component/@WindingResult = 7.",
    "hi": "FINAT वाइंडिंग स्थिति 7: छपा चेहरा अंदर, दायाँ किनारा रोल से पहले निकलता है। XJDF Component/@WindingResult = 7।"
  }
