  "definition": {
    "en": "FINAT winding position 3: labels wound with the printed face out, right edge leaving the roll first. XJDF Component/@WindingResult = 3.",
    "nb": "FINAT-viklingsposisjon 3: etiketter viklet med trykkside ut, høyre kant forlater rullen først. XJDF Component/@WindingResult = 3.",
    "de": "FINAT-Wickelposition 3: Etiketten mit Druckseite außen gewickelt, rechte Kante verlässt die Rolle zuerst. XJDF Component/@WindingResult = 3.",
    "es": "Posición de bobinado FINAT 3: etiquetas bobinadas con la cara impresa hacia fuera, el borde derecho sale primero de la bobina. XJDF Component/@WindingResult = 3.",
    "ja": "FINAT 巻き位置 3：外巻きで巻かれ、右辺が先に繰り出される。XJDF Component/@WindingResult = 3。",
    "zh-Hans": "FINAT 卷绕位置 3：印刷面朝外卷绕，右边先出卷。XJDF Component/@WindingResult = 3。",
    "sv": "FINAT-rullposition 3: etiketter rullade med tryck utåt, högerkanten lämnar rullen först. XJDF Component/@WindingResult = 3.",
    "da": "FINAT-rulleposition 3: etiketter rullet med trykside ud, højre kant forlader rullen først. XJDF Component/@WindingResult = 3.",
    "nl": "FINAT-wikkelpositie 3: etiketten gewikkeld met beeld buiten, rechterrand verlaat de rol als eerste. XJDF Component/@WindingResult = 3.",
    "pl": "Pozycja nawijania FINAT 3: etykiety nawinięte zadrukowaną stroną na zewnątrz, prawa krawędź schodzi z roli pierwsza. XJDF Component/@WindingResult = 3.",
    "pt": "Posição de enrolamento FINAT 3: rótulos enrolados com a face impressa para fora, borda direita saindo primeiro do rolo. XJDF Component/@WindingResult = 3.",
    "hi": "FINAT वाइंडिंग स्थिति 3: छपा चेहरा बाहर, दायाँ किनारा रोल से पहले निकलता है। XJDF Component/@WindingResult = 3।"
  }
