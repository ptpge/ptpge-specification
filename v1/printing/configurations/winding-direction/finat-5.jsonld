  "definition": {
    "en": "FINAT winding position 5: labels wound with the printed face in, top edge leaving the roll first. XJDF Component/@WindingResult = 5.",
    "nb": "FINAT-viklingsposisjon 5: etiketter viklet med trykkside inn, toppkanten forlater rullen først. XJDF Component/@WindingResult = 5.",
    "de": "FINAT-Wickelposition 5: Etiketten mit Druckseite innen gewickelt, Oberkante verlässt die Rolle zuerst. XJDF Component/@WindingResult = 5.",
    "es": "Posición de bobinado FINAT 5: etiquetas bobinadas con la cara impresa hacia dentro, el borde superior sale primero de la bobina. XJDF Component/@WindingResult = 5.",
    "ja": "FINAT 巻き位置 5：内巻きで巻かれ、上辺が先に繰り出される。XJDF Component/@WindingResult = 5。",
    "zh-Hans": "FINAT 卷绕位置 5：印刷面朝内卷绕，上边先出卷。XJDF Component/@WindingResult = 5。",
    "sv": "FINAT-rullposition 5: etiketter rullade med tryck inåt, överkanten lämnar rullen först. XJDF Component/@WindingResult = 5.",
    "da": "FINAT-rulleposition 5: etiketter rullet med trykside ind, topkanten forlader rullen først. XJDF Component/@WindingResult = 5.",
    "nl": "FINAT-wikkelpositie 5: etiketten gewikkeld met beeld binnen, bovenrand verlaat de rol als eerste. XJDF Component/@WindingResult = 5.",
    "pl": "Pozycja nawijania FINAT 5: etykiety nawinięte zadrukowaną stroną do wewnątrz, górna krawędź schodzi z roli pierwsza. XJDF Component/@WindingResult = 5.",
    "pt": "Posição de enrolamento FINAT 5: rótulos enrolados com a face impressa para dentro, borda superior saindo primeiro do rolo. XJDF Component/@WindingResult = 5.",
    "hi": "FINAT वाइंडिंग स्थिति 5: छपा चेहरा अंदर, ऊपरी किनारा रोल से पहले निकलता है। XJDF Component/@WindingResult = 5।"
  }
