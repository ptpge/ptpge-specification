@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/printing/configurations/orientation> a skos:Concept ;
    dcterms:created "2026-05-18T12:24:03+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:34:00+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/configurations> ;
    skos:definition "Et rektangulært produkts proportionsorientering — stående, liggende eller kvadratisk. En selvstændig akse adskilt fra form; vælges via variablen Orientering."@da,
        "Die Seitenverhältnis-Ausrichtung eines rechteckigen Produkts — Hochformat, Querformat oder quadratisch. Eine von der Form getrennte Achse; gewählt über die Variable Orientation."@de,
        "The aspect-ratio orientation of a rectangular product — portrait, landscape or square. A separate axis from shape; selected via the Orientation variable."@en,
        "La orientación (relación de aspecto) de un producto rectangular — vertical, horizontal o cuadrado. Un eje separado de la forma; se selecciona mediante la variable Orientation."@es,
        "आयताकार उत्पाद का अनुपात-अभिविन्यास — पोर्ट्रेट, लैंडस्केप या वर्गाकार। आकृति से अलग अक्ष; ओरिएंटेशन वेरिएबल से चुना जाता है।"@hi,
        "長方形製品の縦横比の向き — 縦位置、横位置、正方形。形状とは別の軸で、Orientation 変数で選択される。"@ja,
        "Sideforhold-orienteringen til et rektangulært produkt — stående, liggende eller kvadratisk. En egen akse fra form; velges via Orientation-variabelen."@nb,
        "De verhoudingsoriëntatie van een rechthoekig product — staand, liggend of vierkant. Een eigen as, gescheiden van vorm; gekozen via de variabele Oriëntatie."@nl,
        "Orientacja proporcji prostokątnego produktu — pionowa, pozioma lub kwadratowa. Oś odrębna od kształtu; wybierana przez zmienną Orientacja."@pl,
        "A orientação de proporção de um produto retangular — retrato, paisagem ou quadrado. Eixo separado da forma; selecionado pela variável Orientação."@pt,
        "En rektangulär produkts proportionsorientering — stående, liggande eller kvadratisk. En egen axel skild från form; väljs via variabeln Orientering."@sv,
        "矩形产品的纵横比方向 — 竖向、横向或正方形。与形状相互独立的轴，通过 Orientation 变量选择。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/printing/configurations/orientation/landscape>,
        <https://ptpge.org/v1/printing/configurations/orientation/portrait>,
        <https://ptpge.org/v1/printing/configurations/orientation/square> ;
    skos:notation "P:CF-ORI" ;
    skos:prefLabel "Orientering"@da,
        "Ausrichtung"@de,
        "Orientation"@en,
        "Orientación"@es,
        "ओरिएंटेशन"@hi,
        "向き"@ja,
        "Orientering"@nb,
        "Oriëntatie"@nl,
        "Orientacja"@pl,
        "Orientação"@pt,
        "Orientering"@sv,
        "方向"@zh-Hans ;
    skos:scopeNote "Umfasst rechteckige Ausrichtungen (Hochformat, Querformat, Quadrat) und nicht rechteckige Formen (Ellipse, organisch / gestanzt). Konkrete Stanzwerkzeuge und Weiterverarbeitungsmethoden zur Herstellung nicht rechteckiger Formen werden unter Completions › Finishing geführt."@de,
        "Covers rectangular orientations (portrait, landscape, square) and non-rectangular shapes (ellipse, organic / die-cut). Specific die-cutting tools and finishing methods used to achieve non-rectangular shapes are tracked under Completions › Finishing."@en,
        "Cubre orientaciones rectangulares (vertical, horizontal, cuadrado) y formas no rectangulares (elipse, orgánico/troquelado). Las herramientas de troquelado específicas y los métodos de acabado usados para obtener formas no rectangulares pertenecen a Acabados."@es,
        "आयताकार अभिविन्यास (पोर्ट्रेट, लैंडस्केप, वर्गाकार) और ग़ैर-आयताकार आकृतियाँ (दीर्घवृत्त, मुक्त / डाई-कट) कवर करता है। ग़ैर-आयताकार आकृतियों के लिए विशिष्ट डाई-कटिंग उपकरण और फ़िनिशिंग विधियाँ फ़िनिशिंग के अंतर्गत हैं।"@hi,
        "長方形の向き（縦、横、正方形）と非長方形の形状（楕円、有機的／打抜き）を扱う。非長方形の形状を実現するための具体的な抜き型および後加工方法はCompletions › Finishingで扱う。"@ja,
        "Dekker rektangulære orienteringer (portrett, landskap, kvadrat) og ikke-rektangulære former (ellipse, organisk / stanset). Spesifikke stanseverktøy og etterbehandlingsmetoder for å oppnå ikke-rektangulære former spores under Completions › Finishing."@nb,
        "Cobre orientações retangulares (retrato, paisagem, quadrado) e formas não retangulares (elipse, orgânica / corte especial). As ferramentas de corte e os métodos de acabamento usados para formas não retangulares ficam em Acabamentos."@pt,
        "涵盖矩形方向（纵向、横向、方形）和非矩形形状（椭圆、有机/模切）。用于实现非矩形形状的具体模切工具和印后方法属于印后加工。"@zh-Hans ;
    ptpge:group "configurations" ;
    ptpge:level "category" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.10 · p.78" ;
            ptpge:mappingRow "crosswalk row 21" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "LayoutIntent" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

