<https://ptpge.org/v1/printing/completions/packaging/postal-trays> a skos:Concept ;
    dcterms:created "2026-08-12T11:02:25+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-23T06:12:20+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/printing/completions/packaging> ;
    skos:definition "Pakning af færdigt tryk i genbrugelige postbakker eller -kasser til indlevering i poststrømmen — standard for direct mail, magasiner og adresseret distribution."@da,
        "Verpacken fertiger Drucksachen in wiederverwendbare Postbehälter für die Einspeisung in den Postweg — Standard für Direktwerbung, Magazine und adressierte Distribution."@de,
        "Packing finished print in reusable postal trays or crates for injection into the mail stream — standard for direct mail, magazines and addressed distribution."@en,
        "Empaquetado del impreso terminado en bandejas o cajas postales reutilizables para su inyección en el circuito postal — estándar para publicidad directa, revistas y distribución con dirección."@es,
        "तैयार मुद्रित सामग्री को डाक प्रवाह में डालने के लिए पुन: प्रयोज्य डाक ट्रे या क्रेट में भरना — डायरेक्ट मेल, पत्रिकाओं और पते वाले वितरण के लिए मानक।"@hi,
        "完成した印刷物を再利用可能な郵便トレイやコンテナに詰め、郵便網に引き渡す方法。DM、雑誌、宛名付き配布の標準。"@ja,
        "Pakking av ferdig trykksak i gjenbrukbare postbakker eller -kasser for innlevering i postgangen — standard for direktereklame, magasiner og adressert distribusjon."@nb,
        "Afgewerkt drukwerk verpakken in herbruikbare postbakken of -kratten voor aanlevering aan de poststroom — standaard voor direct mail, magazines en geadresseerde distributie."@nl,
        "Pakowanie gotowego druku do zwrotnych pojemników lub skrzynek pocztowych w celu nadania do obiegu pocztowego — standard dla direct mail, czasopism i dystrybucji adresowanej."@pl,
        "Acondicionar o impresso acabado em bandejas ou caixas postais reutilizáveis para entrada no fluxo postal — padrão para mala direta, revistas e distribuição endereçada."@pt,
        "Packning av färdigt tryck i återanvändbara postbackar eller postlådor för inmatning i postflödet — standard för direktreklam, tidskrifter och adresserad distribution."@sv,
        "将成品印刷品装入可重复使用的邮政周转箱以进入邮政系统 — 直邮、杂志与具名投递的标准做法。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "P:CP§POSTAL-TRAYS" ;
    skos:prefLabel "Postbakker"@da,
        "Postbehälter"@de,
        "Postal Trays"@en,
        "Bandejas postales"@es,
        "डाक ट्रे"@hi,
        "郵便トレイ"@ja,
        "Postbakker"@nb,
        "Postbakken"@nl,
        "Pojemniki pocztowe"@pl,
        "Caixas postais (bandejas)"@pt,
        "Postbackar"@sv,
        "邮政周转箱"@zh-Hans ;
    ptpge:elementType "value" ;
    ptpge:group "completions" ;
    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§5.6.25 · p.126",
                "§5.6.28 · p.128",
                "§5.6.3 · p.113",
                "§5.6.39 · p.135",
                "§6.10 · p.161" ;
            ptpge:mappingRow "crosswalk row 48" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "BoxPacking",
                "Bundle",
                "Palletizing",
                "Shrinking",
                "Wrapping" ;
            ptpge:sourceStandard "XJDF" ;
            ptpge:sourceVersion "2.2" ] ;
    ptpge:status "proposed" ;
    ptpge:version "2026-08-12" .

