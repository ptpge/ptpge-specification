  "label": {
    "en": "Pole Pocket",
    "nb": "Stanglomme",
    "de": "Hohlsaum",
    "ja": "ポールポケット",
    "es": "Vaina para barra",
    "zh-Hans": "穿杆袋",
    "sv": "Stångficka",
    "da": "Stanglomme",
