        "Left"@en,
        "Izquierda"@es,
        "बाएँ"@hi,
        "左"@ja,
        "Venstre"@nb,
        "Links"@nl,
        "Lewa"@pl,
        "Esquerda"@pt,
        "Vänster"@sv,
        "左"@zh-Hans ;
