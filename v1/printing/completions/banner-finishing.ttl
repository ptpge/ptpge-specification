        "Bannerkonfektion"@de,
        "Banner Finishing"@en,
        "Acabado de banners"@es,
        "बैनर फ़िनिशिंग"@hi,
        "バナー仕上げ"@ja,
        "Bannerferdiggjøring"@nb,
        "Bannerafwerking"@nl,
        "Wykończenie banerów"@pl,
        "Acabamento de banners"@pt,
        "Bannerkonfektion"@sv,
        "横幅加工"@zh-Hans ;
    ptpge:group "completions" ;
