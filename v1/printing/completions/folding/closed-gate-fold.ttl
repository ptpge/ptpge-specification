    ptpge:level "element" ;
    ptpge:semanticSource [ dcterms:bibliographicCitation "§4.7 · p.75",
                "§5.6.15 · p.120",
                "§6.36 · p.202",
                "§8.21 · p.349" ;
            ptpge:mappingRow "crosswalk row 38" ;
            ptpge:matchDegree "exact" ;
