        "Tríptico Cruzado"@es,
        "क्रॉस ट्राई-फ़ोल्ड"@hi,
        "クロス三つ折り"@ja,
        "Krysset trippel-fold"@nb,
        "Kruis-wikkelvouw"@nl,
        "Złam krzyżowy na C"@pl,
        "Tríptico cruzado"@pt,
        "Kors- och C-fals"@sv,
        "十字三折"@zh-Hans ;
