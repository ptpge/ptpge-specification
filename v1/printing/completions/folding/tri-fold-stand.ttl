                "§8.21 · p.349" ;
            ptpge:mappingRow "crosswalk row 38" ;
            ptpge:matchDegree "exact" ;
            ptpge:sourceElement "Fold",
                "Folding",
                "FoldingIntent",
                "FoldingParams" ;
            ptpge:sourceStandard "XJDF" ;
