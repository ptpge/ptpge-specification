@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/production/technology> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "छपाई की तकनीक"@hi,
        "प्रिंटिंग प्रोसेस"@hi,
        "मुद्रण तकनीक"@hi,
        "technika druku"@pl,
        "processo de impressão"@pt,
        "tecnologia de impressão"@pt ;
    skos:broader <https://ptpge.org/v1/variables/production> ;
    skos:definition "Konfigurerbar akse: Teknologi. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Technologie. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Technology. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Tecnología. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: तकनीक। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：印刷方式。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Teknologi. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Technologie. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Technologia. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Tecnologia. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Teknik. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：印刷方式。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:PD§TECHNOLOGY" ;
    skos:prefLabel "Teknologi"@da,
        "Technologie"@de,
        "Technology"@en,
        "Tecnología"@es,
        "तकनीक"@hi,
        "印刷方式"@ja,
        "Teknologi"@nb,
        "Technologie"@nl,
        "Technologia"@pl,
        "Tecnologia"@pt,
        "Teknik"@sv,
        "印刷方式"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Trykt hvordan?"@da,
        "Wie gedruckt?"@de,
        "Printed how?"@en,
        "¿Impreso cómo?"@es,
        "छपाई कैसे?"@hi,
        "印刷方式は？"@ja,
        "Trykt hvordan?"@nb,
        "Hoe gedrukt?"@nl,
        "Jak drukowany?"@pl,
        "Impresso como?"@pt,
        "Tryckt hur?"@sv,
        "如何印刷？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/technologies/printing-technologies> ;
    ptpge:version "2026-06-05" .

