@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/production/press-type> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "प्रेस टाइप"@hi,
        "मशीन का प्रकार"@hi,
        "rodzaj maszyny drukującej"@pl,
        "tipo de máquina"@pt,
        "tipo de prensa"@pt ;
    skos:broader <https://ptpge.org/v1/variables/production> ;
    skos:definition "Konfigurerbar akse: Pressetype. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Maschinentyp. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Press Type. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Tipo de prensa. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: प्रेस का प्रकार। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：印刷機タイプ。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Pressetype. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Perstype. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Typ maszyny. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Tipo de Impressora. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Presstyp. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：印刷机类型。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:PD§PRESS-TYPE" ;
    skos:prefLabel "Pressetype"@da,
        "Maschinentyp"@de,
        "Press Type"@en,
        "Tipo de prensa"@es,
        "प्रेस का प्रकार"@hi,
        "印刷機タイプ"@ja,
        "Pressetype"@nb,
        "Perstype"@nl,
        "Typ maszyny"@pl,
        "Tipo de impressora"@pt,
        "Presstyp"@sv,
        "印刷机类型"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "På hvilken type presse?"@da,
        "Auf welcher Art Maschine?"@de,
        "On which kind of press?"@en,
        "¿En qué tipo de prensa?"@es,
        "किस प्रकार की प्रेस पर?"@hi,
        "どの種類の印刷機で？"@ja,
        "På hvilken type presse?"@nb,
        "Op welk soort pers?"@nl,
        "Na jakim typie maszyny?"@pl,
        "Em que tipo de prensa?"@pt,
        "På vilken typ av press?"@sv,
        "用哪种印刷机？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/technologies/printing-finishing-equipment/printing-presses> ;
    ptpge:version "2026-06-05" .

