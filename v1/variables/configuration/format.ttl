@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/configuration/format> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Dimensions"@en,
        "Size"@en,
        "आकार"@hi,
        "माप"@hi,
        "साइज़"@hi,
        "Papirformat"@nb,
        "Størrelse"@nb,
        "rozmiar"@pl,
        "wymiary"@pl,
        "dimensões"@pt,
        "medida"@pt,
        "tamanho"@pt ;
    skos:broader <https://ptpge.org/v1/variables/configuration> ;
    skos:definition "Konfigurerbar akse: Format. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Format. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Format. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Formato. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: फ़ॉर्मेट। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：判型。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Format. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Formaat. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Format. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Formato. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Format. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：幅面。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CF§FORMAT" ;
    skos:prefLabel "Format"@da,
        "Format"@de,
        "Format"@en,
        "Formato"@es,
        "फ़ॉर्मेट"@hi,
        "判型"@ja,
        "Format"@nb,
        "Formaat"@nl,
        "Format"@pl,
        "Formato"@pt,
        "Format"@sv,
        "幅面"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvilken størrelse?"@da,
        "Welche Größe?"@de,
        "What size?"@en,
        "¿Qué tamaño?"@es,
        "कौन-सा आकार?"@hi,
        "サイズは？"@ja,
        "Hvilken størrelse?"@nb,
        "Welk formaat?"@nl,
        "Jaki rozmiar?"@pl,
        "Que tamanho?"@pt,
        "Vilken storlek?"@sv,
        "什么尺寸？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/configurations/formats> ;
    ptpge:version "2026-06-05" .

