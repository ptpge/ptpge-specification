@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/configuration/setup-model> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Product Setup"@en,
        "Topology"@en,
        "उत्पाद सेटअप"@hi,
        "टोपोलॉजी"@hi,
        "बनावट"@hi,
        "Oppsett"@nb,
        "Produktoppsett"@nb,
        "konstrukcja produktu"@pl,
        "topologia"@pl,
        "montagem do produto"@pt,
        "tipo de montagem"@pt,
        "topologia"@pt ;
    skos:broader <https://ptpge.org/v1/variables/configuration> ;
    skos:definition "Konfigurerbar akse: Opsætningsmodel. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Setup-Modell. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Setup Model. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Modelo de configuración física. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: सेटअप मॉडल। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：セットアップモデル。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Oppsettsmodell. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Opbouwmodel. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Model konstrukcji. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Modelo de Montagem. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Uppbyggnadsmodell. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：构成方式。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CF§SETUP-MODEL" ;
    skos:prefLabel "Opsætningsmodel"@da,
        "Setup-Modell"@de,
        "Setup Model"@en,
        "Modelo de configuración física"@es,
        "सेटअप मॉडल"@hi,
        "セットアップモデル"@ja,
        "Oppsettsmodell"@nb,
        "Opbouwmodel"@nl,
        "Model konstrukcji"@pl,
        "Modelo de montagem"@pt,
        "Uppbyggnadsmodell"@sv,
        "构成方式"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvordan er den sat sammen?"@da,
        "Wie ist es aufgebaut?"@de,
        "How is it put together?"@en,
        "¿Cómo está compuesto?"@es,
        "यह कैसे बना है?"@hi,
        "どのような構成ですか？"@ja,
        "Hvordan er den satt sammen?"@nb,
        "Hoe is het opgebouwd?"@nl,
        "Jak jest zbudowany?"@pl,
        "Como é montado?"@pt,
        "Hur är den uppbyggd?"@sv,
        "它是如何构成的？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/configurations/setup-models> ;
    ptpge:version "2026-06-05" .

