    "sv": "Åt vilket håll är den rullad?",
    "da": "Hvilken vej er den rullet?",
    "nl": "Welke kant op is het gewikkeld?",
    "pl": "W którą stronę jest nawinięty?",
    "pt": "Em que sentido está enrolado?",
    "hi": "किस दिशा में लपेटा गया है?"
  },
