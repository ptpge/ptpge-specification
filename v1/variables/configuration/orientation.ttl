@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/configuration/orientation> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Portrait/Landscape"@en,
        "खड़ा/लेटा"@hi,
        "दिशा"@hi,
        "पोर्ट्रेट/लैंडस्केप"@hi,
        "Retning"@nb,
        "Stående/liggende"@nb,
        "pionowa/pozioma"@pl,
        "portret/pejzaż"@pl,
        "retrato/paisagem"@pt,
        "vertical/horizontal"@pt ;
    skos:broader <https://ptpge.org/v1/variables/configuration> ;
    skos:definition "Konfigurerbar akse: Orientering. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Ausrichtung. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Orientation. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Orientación. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: ओरिएंटेशन। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：向き。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Orientering. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Oriëntatie. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Orientacja. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Orientação. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Orientering. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：方向。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CF§ORIENTATION" ;
    skos:prefLabel "Orientering"@da,
        "Ausrichtung"@de,
        "Orientation"@en,
        "Orientación"@es,
        "ओरिएंटेशन"@hi,
        "向き"@ja,
        "Orientering"@nb,
        "Oriëntatie"@nl,
        "Orientacja"@pl,
        "Orientação"@pt,
        "Orientering"@sv,
        "方向"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Stående eller liggende?"@da,
        "Hochformat oder Querformat?"@de,
        "Portrait or landscape?"@en,
        "¿Vertical u horizontal?"@es,
        "पोर्ट्रेट या लैंडस्केप?"@hi,
        "縦向きですか、横向きですか？"@ja,
        "Stående eller liggende?"@nb,
        "Staand of liggend?"@nl,
        "Pionowo czy poziomo?"@pl,
        "Vertical ou horizontal?"@pt,
        "Stående eller liggande?"@sv,
        "竖向还是横向？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/configurations/orientation> ;
    ptpge:version "2026-06-05" .

