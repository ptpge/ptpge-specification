        "PMS colour"@en,
        "Pantone number"@en,
        "Spot colour reference"@en,
        "Número Pantone"@es,
        "Numéro Pantone"@fr,
        "PANTONE 指定"@ja,
        "パントン番号"@ja,
        "Navngitt spotfarge"@nb,
        "PMS-farge"@nb,
        "Pantone-nummer"@nb,
        "PMS-kleur"@nl,
