        "什么交货条款？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/ordering/distribution/incoterms> ;
    ptpge:version "2026-06-26" .

