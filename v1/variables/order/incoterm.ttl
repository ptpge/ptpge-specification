    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvilke leveringsbetingelser?"@da,
        "Welche Lieferbedingungen?"@de,
        "Which delivery terms?"@en,
        "¿Qué condiciones de entrega?"@es,
        "कौन-सी डिलीवरी शर्तें?"@hi,
        "取引条件は？"@ja,
        "Hvilke leveringsbetingelser?"@nb,
