<https://ptpge.org/v1/variables/finishing/folding> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Fold"@en,
        "तह"@hi,
        "फ़ोल्ड"@hi,
        "मोड़"@hi,
        "Brett"@nb,
        "Fals"@nb,
        "złam"@pl,
        "dobradura"@pt,
        "tipo de dobra"@pt ;
    skos:broader <https://ptpge.org/v1/variables/finishing> ;
    skos:definition "Konfigurerbar akse: Fals. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Falzung. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Fold. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Plegado. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: फ़ोल्ड। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：折り。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Bretting. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Vouw. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Składanie. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Dobra. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Fals. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：折页。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:FN§FOLDING" ;
    skos:prefLabel "Falsning"@da,
        "Falzung"@de,
        "Folding"@en,
        "Plegado"@es,
        "फ़ोल्डिंग"@hi,
        "折り"@ja,
        "Bretting"@nb,
        "Vouwen"@nl,
        "Składanie"@pl,
        "Dobra"@pt,
        "Falsning"@sv,
        "折页"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvordan er den falset?"@da,
        "Wie ist es gefalzt?"@de,
        "How is it folded?"@en,
        "¿Cómo está plegado?"@es,
        "फ़ोल्ड कैसे?"@hi,
        "折り方は？"@ja,
        "Hvordan er den brettet?"@nb,
        "Hoe is het gevouwen?"@nl,
        "Jak jest złożony?"@pl,
        "Como é dobrado?"@pt,
        "Hur är den falsad?"@sv,
        "如何折叠？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/completions/folding> ;
    ptpge:version "2026-06-05" .

