@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/finishing/structural-finishing> a skos:Concept ;
    dcterms:created "2026-06-17T10:05:31+00:00"^^xsd:dateTime ;
    dcterms:creator "https://ptpge.org/contributors/ptpge" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "कटिंग फ़िनिशिंग"@hi,
        "डाई-कटिंग और क्रीज़िंग"@hi,
        "पंचिंग और परफ़ोरेशन"@hi,
        "corte e vinco"@pt,
        "faca especial"@pt,
        "picote e vinco"@pt ;
    skos:broader <https://ptpge.org/v1/variables/finishing> ;
    skos:definition "Konfigurerbar akse: Strukturel efterbehandling. Skære-/formningsoperationer (udstansning, kiss-cut, laserskæring, perforering, fræsning, rilning), flervalg. Værdier fra printing/completions/structural-finishing."@da,
        "Konfigurierbare Achse: Strukturelle Verarbeitung. Schneid-/Formoperationen (Stanzen, Kiss-Cut, Laserschnitt, Perforation, Fräsen, Rillen), Mehrfachauswahl. Werte aus printing/completions/structural-finishing."@de,
        "Configurable axis: Structural Finishing. Cutting/shaping operations (die-cut, kiss-cut, laser-cut, perforation, routing, scoring), multi-select. Values from printing/completions/structural-finishing."@en,
        "Eje configurable: Acabado estructural. Operaciones de corte y conformado (troquelado, kiss-cut, corte láser, perforado, fresado, hendido), selección múltiple. Valores de printing/completions/structural-finishing."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: संरचनात्मक फ़िनिशिंग। कटाई/आकार देने की क्रियाएँ (डाई-कट, किस-कट, लेज़र-कट, परफ़ोरेशन, राउटिंग, स्कोरिंग), बहु-चयन। मान printing/completions/structural-finishing से।"@hi,
        "構成可能な軸：構造加工。切断・成形加工（型抜き、キスカット、レーザーカット、ミシン目、ルーター加工、スジ入れ）、複数選択。値は printing/completions/structural-finishing から。"@ja,
        "Konfigurerbar akse: Strukturell etterbehandling. Skjære-/formingsoperasjoner (stansing, kiss-cut, laserskjæring, perforering, fresing, bigging), flervalg. Verdier fra printing/completions/structural-finishing."@nb,
        "Configureerbare as: Structurele afwerking. Snij-/vormbewerkingen (stansen, kiss-cut, lasersnijden, perforeren, frezen, rillen), meerkeuze. Waarden uit printing/completions/structural-finishing."@nl,
        "Oś konfigurowalna: Wykończenie strukturalne. Operacje cięcia/kształtowania (wykrawanie, kiss-cut, cięcie laserowe, perforacja, frezowanie, bigowanie), wybór wielokrotny. Wartości z printing/completions/structural-finishing."@pl,
        "Eixo configurável: Acabamento Estrutural. Operações de corte/conformação (corte especial, meio-corte, corte a laser, picote, fresagem, vinco), seleção múltipla. Valores de printing/completions/structural-finishing."@pt,
        "Konfigurerbar axel: Strukturell efterbehandling. Skär-/formningsoperationer (stansning, kiss-cut, laserskärning, perforering, fräsning, bigning), flerval. Värden från printing/completions/structural-finishing."@sv,
        "可配置轴：结构加工。切割/成形工艺（模切、半切、激光切割、打孔线、铣切、压痕），多选。取值来自 printing/completions/structural-finishing。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:FN§STRUCTURAL-FINISHING" ;
    skos:prefLabel "Strukturel efterbehandling"@da,
        "Strukturelle Verarbeitung"@de,
        "Structural Finishing"@en,
        "Acabado estructural"@es,
        "संरचनात्मक फ़िनिशिंग"@hi,
        "構造加工"@ja,
        "Strukturell etterbehandling"@nb,
        "Structurele afwerking"@nl,
        "Wykończenie strukturalne"@pl,
        "Acabamento estrutural"@pt,
        "Strukturell efterbehandling"@sv,
        "结构加工"@zh-Hans ;
    ptpge:cardinality "multiple" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Nogen strukturel efterbehandling?"@da,
        "Eine strukturelle Weiterverarbeitung?"@de,
        "Any structural finishing?"@en,
        "¿Algún acabado estructural?"@es,
        "कोई संरचनात्मक फ़िनिशिंग?"@hi,
        "構造的な加工はありますか？"@ja,
        "Noen strukturell etterbehandling?"@nb,
        "Een structurele nabewerking?"@nl,
        "Jakaś obróbka strukturalna?"@pl,
        "Algum acabamento estrutural?"@pt,
        "Någon strukturell efterbehandling?"@sv,
        "需要结构加工吗？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/completions/structural-finishing> ;
    ptpge:version "2026-06-05" .

