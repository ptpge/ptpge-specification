@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/compliance/climate-documentation> a skos:Concept ;
    dcterms:created "2026-07-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/variables/compliance> ;
    skos:definition "Konfigurerbar kravsakse: den CO₂-regnskabsdokumentation køberen kræver, at tilbuddet bærer. Værdierne refererer til anerkendte regnskabsmetoder (ISO 14067, GHG Protocol Product Standard, ClimateCalc)."@da,
        "Konfigurierbare Anforderungsachse: die CO₂-Bilanzierungsdokumentation, die der Käufer vom Angebot verlangt. Werte referenzieren anerkannte Bilanzierungsmethoden (ISO 14067, GHG Protocol Product Standard, ClimateCalc); die deklarierten Fußabdruckswerte selbst stehen im Angebot und Vendor-Profil, nicht in der Konfiguration."@de,
        "Configurable requirement axis: the carbon-accounting documentation the buyer requires the offer to carry. Values reference recognized accounting methods (ISO 14067, GHG Protocol Product Standard, ClimateCalc); the declared footprint figures themselves live in the offer and vendor profile, not in the configuration."@en,
        "Eje de requisito configurable: la documentación de contabilidad de carbono que el comprador exige que lleve la oferta. Los valores referencian métodos reconocidos (ISO 14067, GHG Protocol, ClimateCalc); las cifras declaradas viven en la oferta y el perfil del proveedor, no en la configuración."@es,
        "कॉन्फ़िगर करने योग्य आवश्यकता अक्ष: कार्बन-लेखांकन का वह दस्तावेज़ जो खरीदार ऑफ़र में चाहता है। मान मान्यता-प्राप्त लेखांकन विधियों (ISO 14067, GHG Protocol Product Standard, ClimateCalc) को संदर्भित करते हैं; घोषित फ़ुटप्रिंट के आँकड़े ऑफ़र और विक्रेता प्रोफ़ाइल में रहते हैं, कॉन्फ़िगरेशन में नहीं।"@hi,
        "設定可能な要件軸：買い手がオファーに求めるカーボン会計文書。値は認知された会計手法（ISO 14067、GHGプロトコル製品基準、ClimateCalc）を参照する。宣言されたフットプリント数値自体はオファーとベンダープロファイルにあり、構成には含まれない。"@ja,
        "Konfigurerbar krav-akse: karbonregnskaps-dokumentasjonen kjøperen krever at tilbudet bærer. Verdier refererer anerkjente regnskapsmetoder (ISO 14067, GHG Protocol Product Standard, ClimateCalc); selve de deklarerte fotavtrykkstallene bor i tilbudet og vendor-profilen, ikke i konfigurasjonen."@nb,
        "Configureerbare eisen-as: de CO₂-boekhoudingsdocumentatie die de koper eist dat de aanbieding draagt. De waarden verwijzen naar erkende rekenmethoden (ISO 14067, GHG Protocol Product Standard, ClimateCalc)."@nl,
        "Konfigurowalna oś wymagań: dokumentacja rachunkowości węglowej, której nabywca wymaga od oferty. Wartości odwołują się do uznanych metod rachunkowości (ISO 14067, GHG Protocol Product Standard, ClimateCalc); same deklarowane wartości śladu żyją w ofercie i profilu dostawcy, nie w konfiguracji."@pl,
        "Eixo de requisito configurável: a documentação de contabilidade de carbono que o comprador exige que a oferta carregue. Os valores referenciam métodos de contabilização reconhecidos (ISO 14067, GHG Protocol Product Standard, ClimateCalc); os números de pegada declarados vivem na oferta e no perfil do fornecedor, não na configuração."@pt,
        "Konfigurerbar kravaxel: den koldioxidredovisning köparen kräver att erbjudandet bär. Värdena refererar erkända redovisningsmetoder (ISO 14067, GHG Protocol Product Standard, ClimateCalc); de deklarerade utsläppssiffrorna själva bor i erbjudandet och leverantörsprofilen, inte i konfigurationen."@sv,
        "可配置的要求轴：买方要求报价携带的碳核算文档。取值引用公认的核算方法（ISO 14067、GHG 核算体系产品标准、ClimateCalc）；声明的碳足迹数值本身位于报价和供应商档案中，而非配置中。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:CM§CLIMATE-DOCUMENTATION" ;
    skos:prefLabel "Klimadokumentation"@da,
        "Klimadokumentation"@de,
        "Climate Documentation"@en,
        "Documentación climática"@es,
        "जलवायु दस्तावेज़ीकरण"@hi,
        "気候文書化"@ja,
        "Klimadokumentasjon"@nb,
        "Klimaatdocumentatie"@nl,
        "Dokumentacja klimatyczna"@pl,
        "Documentação climática"@pt,
        "Klimatdokumentation"@sv,
        "气候文档"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Nogen klimadokumentation?"@da,
        "Eine Klimadokumentation?"@de,
        "Any climate documentation?"@en,
        "¿Alguna documentación climática?"@es,
        "कोई जलवायु दस्तावेज़?"@hi,
        "気候関連の証明書はありますか？"@ja,
        "Noen klimadokumentasjon?"@nb,
        "Een klimaatdocumentatie?"@nl,
        "Jakaś dokumentacja klimatyczna?"@pl,
        "Alguma documentação climática?"@pt,
        "Någon klimatdokumentation?"@sv,
        "需要气候文件吗？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/standards/certifications/environmental/carbon> ;
    ptpge:version "2026-07-18" .

