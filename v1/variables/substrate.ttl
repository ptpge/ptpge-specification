@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/substrate> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:broader <https://ptpge.org/v1/variables> ;
    skos:definition "Substrat-konfigurationsvariabler — de substratakser et trykt produkt kan konfigureres langs."@da,
        "Bedruckstoff-Konfigurationsvariablen — die Bedruckstoffachsen, entlang derer ein Druckprodukt konfiguriert werden kann."@de,
        "Substrate configuration variables — the substrate axes a printed product can be configured along."@en,
        "Variables de configuración de sustrato — los ejes de sustrato a lo largo de los cuales puede configurarse un producto impreso."@es,
        "सब्सट्रेट कॉन्फ़िगरेशन वेरिएबल — वे सब्सट्रेट (छपाई सामग्री) अक्ष जिनके साथ मुद्रित उत्पाद कॉन्फ़िगर किया जा सकता है।"@hi,
        "基材の構成変数 — 印刷物を構成できる基材の軸。"@ja,
        "Substrat konfigurasjonsvariabler — substrat-aksene et trykkprodukt kan konfigureres langs."@nb,
        "Substraat-configuratievariabelen — de substraatassen waarlangs een drukproduct kan worden geconfigureerd."@nl,
        "Zmienne konfiguracyjne podłoża — osie podłoża, wzdłuż których można skonfigurować produkt drukowany."@pl,
        "Variáveis de configuração de substrato — os eixos de substrato ao longo dos quais um impresso pode ser configurado."@pt,
        "Konfigurationsvariabler för substrat — de substrataxlar en trycksak kan konfigureras längs."@sv,
        "承印材料配置变量 — 印刷品可沿其配置的承印材料轴。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:narrower <https://ptpge.org/v1/variables/substrate/substrate-class>,
        <https://ptpge.org/v1/variables/substrate/substrate-coating>,
        <https://ptpge.org/v1/variables/substrate/substrate-color>,
        <https://ptpge.org/v1/variables/substrate/substrate-fibre>,
        <https://ptpge.org/v1/variables/substrate/substrate-finish>,
        <https://ptpge.org/v1/variables/substrate/substrate-thickness>,
        <https://ptpge.org/v1/variables/substrate/substrate-type>,
        <https://ptpge.org/v1/variables/substrate/substrate-weight> ;
    skos:notation "VAR:SB" ;
    skos:prefLabel "Substrat"@da,
        "Bedruckstoff"@de,
        "Substrate"@en,
        "Sustrato"@es,
        "सब्सट्रेट"@hi,
        "基材"@ja,
        "Substrat"@nb,
        "Substraat"@nl,
        "Podłoże"@pl,
        "Substrato"@pt,
        "Substrat"@sv,
        "承印材料"@zh-Hans ;
    ptpge:level "group" ;
    ptpge:status "proposed" ;
    ptpge:version "2026-06-05" .

