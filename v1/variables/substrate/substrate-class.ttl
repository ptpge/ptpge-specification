        "सब्सट्रेट वर्ग"@hi,
        "用紙クラス"@ja,
        "Papirklasse"@nb,
        "Papierklasse"@nl,
        "Klasa podłoża"@pl,
        "Classe de substrato"@pt,
        "Pappersklass"@sv,
        "纸张类别"@zh-Hans ;
