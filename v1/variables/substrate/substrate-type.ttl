@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ptpge: <https://ptpge.org/ns/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ptpge.org/v1/variables/substrate/substrate-type> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Material"@en,
        "Paper Type"@en,
        "काग़ज़ का प्रकार"@hi,
        "पेपर टाइप"@hi,
        "मटीरियल"@hi,
        "सामग्री"@hi,
        "Materiale"@nb,
        "Papirtype"@nb,
        "materiał"@pl,
        "rodzaj papieru"@pl,
        "material"@pt,
        "suporte"@pt,
        "tipo de papel"@pt ;
    skos:broader <https://ptpge.org/v1/variables/substrate> ;
    skos:definition "Konfigurerbar akse: Substrattype. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Bedruckstoffart. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Substrate Type. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Tipo de sustrato. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: सब्सट्रेट का प्रकार। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：基材の種類。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Substrattype. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Substraattype. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Typ podłoża. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Tipo de Substrato. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Substrattyp. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：承印材料类型。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:SB§SUBSTRATE-TYPE" ;
    skos:prefLabel "Substrattype"@da,
        "Bedruckstoffart"@de,
        "Substrate Type"@en,
        "Tipo de sustrato"@es,
        "सब्सट्रेट का प्रकार"@hi,
        "基材の種類"@ja,
        "Substrattype"@nb,
        "Substraattype"@nl,
        "Typ podłoża"@pl,
        "Tipo de substrato"@pt,
        "Substrattyp"@sv,
        "承印材料类型"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvilket materiale?"@da,
        "Welches Material?"@de,
        "Which material?"@en,
        "¿Qué material?"@es,
        "कौन-सी सामग्री?"@hi,
        "素材は？"@ja,
        "Hvilket materiale?"@nb,
        "Welk materiaal?"@nl,
        "Jaki materiał?"@pl,
        "Que material?"@pt,
        "Vilket material?"@sv,
        "什么材料？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/substrates> ;
    ptpge:version "2026-06-05" .

