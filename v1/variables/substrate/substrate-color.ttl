<https://ptpge.org/v1/variables/substrate/substrate-color> a skos:Concept ;
    dcterms:created "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-06T19:16:59+00:00"^^xsd:dateTime ;
    skos:altLabel "Paper Color"@en,
        "Substrate Colour"@en,
        "काग़ज़ का रंग"@hi,
        "पेपर कलर"@hi,
        "Papirfarge"@nb,
        "barwa podłoża"@pl,
        "kolor papieru"@pl,
        "cor do papel"@pt,
        "tonalidade do papel"@pt ;
    skos:broader <https://ptpge.org/v1/variables/substrate> ;
    skos:definition "Konfigurerbar akse: Substratfarve. Et trykt produkt konfigureres langs denne variabel (enum, enkeltvalg). Tilladte værdier hentes fra det refererede værdidomæne."@da,
        "Konfigurierbare Achse: Bedruckstofffarbe. Ein Druckprodukt wird entlang dieser Variablen konfiguriert (Enum, Einfachauswahl). Zulässige Werte stammen aus der referenzierten valueDomain."@de,
        "Configurable axis: Substrate Colour. A printed product is configured along this variable (enum, single selection). Allowed values are drawn from the referenced valueDomain."@en,
        "Eje configurable: Color del sustrato. Un producto impreso se configura a lo largo de esta variable (enum, selección única). Los valores permitidos provienen del valueDomain referenciado."@es,
        "कॉन्फ़िगर करने योग्य अक्ष: सब्सट्रेट का रंग। मुद्रित उत्पाद इस वेरिएबल के साथ कॉन्फ़िगर होता है (enum, एकल चयन)। अनुमत मान संदर्भित valueDomain से लिए जाते हैं।"@hi,
        "構成可能な軸：基材の色。印刷物はこの変数に沿って構成される（列挙型、単一選択）。許容値は参照先の valueDomain から取得される。"@ja,
        "Konfigurerbar akse: Substratfarge. Et trykkprodukt konfigureres langs denne variabelen (enum, single valg). Verdier hentes fra value-domain."@nb,
        "Configureerbare as: Substraatkleur. Een drukproduct wordt langs deze variabele geconfigureerd (enum, enkelvoudig). Toegestane waarden komen uit het gerefereerde waardedomein."@nl,
        "Oś konfigurowalna: Kolor podłoża. Produkt drukowany jest konfigurowany wzdłuż tej zmiennej (enum, wybór pojedynczy). Dozwolone wartości pochodzą z przywołanej valueDomain."@pl,
        "Eixo configurável: Cor do Substrato. Um impresso é configurado ao longo desta variável (enumeração, seleção única). Os valores permitidos vêm do valueDomain referenciado."@pt,
        "Konfigurerbar axel: Substratfärg. En trycksak konfigureras längs denna variabel (uppräkning, enkelval). Tillåtna värden hämtas ur den refererade värdedomänen (valueDomain)."@sv,
        "可配置轴：承印材料颜色。印刷品沿此变量进行配置（枚举，单选）。允许的取值来自所引用的 valueDomain。"@zh-Hans ;
    skos:inScheme <https://ptpge.org/v1/scheme> ;
    skos:notation "VAR:SB§SUBSTRATE-COLOR" ;
    skos:prefLabel "Substratfarve"@da,
        "Bedruckstofffarbe"@de,
        "Substrate Color"@en,
        "Color del sustrato"@es,
        "सब्सट्रेट का रंग"@hi,
        "基材の色"@ja,
        "Substratfarge"@nb,
        "Substraatkleur"@nl,
        "Kolor podłoża"@pl,
        "Cor do substrato"@pt,
        "Substratfärg"@sv,
        "承印材料颜色"@zh-Hans ;
    ptpge:cardinality "single" ;
    ptpge:datatype "enum" ;
    ptpge:elementType "variable" ;
    ptpge:level "element" ;
    ptpge:question "Hvilken papirfarve?"@da,
        "Welche Papierfarbe?"@de,
        "Which paper colour?"@en,
        "¿Qué color de papel?"@es,
        "कागज़ का रंग?"@hi,
        "紙の色は？"@ja,
        "Hvilken papirfarge?"@nb,
        "Welke papierkleur?"@nl,
        "Jaki kolor papieru?"@pl,
        "Que cor de papel?"@pt,
        "Vilken pappersfärg?"@sv,
        "纸张什么颜色？"@zh-Hans ;
    ptpge:scope "product" ;
    ptpge:status "proposed" ;
    ptpge:valueDomain <https://ptpge.org/v1/printing/substrates/sheet-materials/paper/paper-color-shades> ;
    ptpge:version "2026-06-05" .

